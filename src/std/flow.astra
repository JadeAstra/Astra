// ---- The event loop ----

// One per program, on the main thread. It runs the tasks posted to it and the timers, one at
// a time, after the script itself has finished, and the program ends when there is nothing
// left for it to wait for. A window's events will arrive through the same loop.
//
//   EventLoop.post { refresh() }                    // from any thread: run this on the main thread
//   val tick = EventLoop.every(1000) { print("tick") }
//   EventLoop.after(5500) { tick.cancel() }
object EventLoop {
  // Runs the task on the main thread, soon. Safe to call from any thread.
  fun post(task : () -> unit) {
    __loop.post(task)
  }

  // Runs the task once, `millis` from now, or again and again that far apart. Each gives a
  // Timer, whose cancel() calls it off.
  fun after(millis : int, task : () -> unit) : Timer => Timer(__loop.timer(millis, task))
  fun every(millis : int, task : () -> unit) : Timer => Timer(__loop.timer(millis, task, millis))

  // Whether the code asking is running on the loop's thread.
  val isLoopThread : bool
    get() => __loop.isLoopThread()

  // Runs the loop here until there is nothing left for it to wait for. A program need not
  // call this: the loop runs by itself when the script ends. It is for a script that has
  // something to do after that.
  fun run() {
    __loop.run()
  }
}

class Timer(private val id : int) {
  fun cancel() {
    __loop.cancel(id)
  }
}

// ---- Flows ----
// A flow is a function that can set itself aside in the middle of a call and be taken up
// again later, where it was, without holding a thread meanwhile (Kotlin's coroutine). Code
// that asks one thing and then another reads top to bottom:
//
//   suspend fun ask(question) => suspendCoroutine { c -> dialog.prompt(question) { answer -> c.resume(answer) } }
//
//   startCoroutine {
//     val name = ask("Name?")
//     val colour = ask("Favourite colour, $name?")
//     save(name, colour)
//   }
//
// A suspending function is called like any other, where waiting is possible: `suspend` on
// its declaration says that it may wait, and the checker holds callers to it (R1). The names
// are those of kotlin.coroutines.

// How something turned out: a value, or the error that was thrown instead.
class Result<T> {
  private val ok : bool
  private val held : any?

  fun init(ok : bool, held : any?) {
    this.ok = ok
    this.held = held
  }

  static {
    fun <T> success(value : T) : Result<T> => Result<T>(true, value)
    fun <T> failure(error : any?) : Result<T> => Result<T>(false, error)
  }
  val isSuccess : bool
    get() => ok
  val isFailure : bool
    get() => !ok
  fun getOrNull() : T? => ok ? held as T : null
  fun exceptionOrNull() : any? => ok ? null : held
  fun getOrDefault(defaultValue : T) : T => ok ? held as T : defaultValue
  fun getOrElse(onFailure : (any?) -> T) : T => ok ? held as T : onFailure(held)

  fun getOrThrow() : T {
    if (!ok) { throw held }
    return held as T
  }

  fun onSuccess(action : (T) -> unit) : Result<T> {
    if (ok) { action(held as T) }
    return this
  }

  fun onFailure(action : (any?) -> unit) : Result<T> {
    if (!ok) { action(held) }
    return this
  }

  override fun toString() : string => ok ? "Success($held)" : "Failure($held)"
}

// Runs the block and gives its value, or the error it threw, as a Result.
fun <T> runCatching(block : () -> T) : Result<T> {
  try {
    return Result.success(block())
  } catch (e) {
    return Result.failure(e)
  }
}

// Stands where Kotlin wants a coroutine context. There is nothing in it.
object EmptyCoroutineContext

// Something to be told how a wait or a flow turned out. suspendCoroutine hands one to its
// block; Continuation { result -> ... } makes one to give to startCoroutine.
class Continuation {
  val context : any?
  private val handler : (Result<any?>) -> unit

  // Continuation { result -> ... }, or with Kotlin's context in front.
  fun init(context : any? = null, handler : ((Result<any?>) -> unit)? = null) {
    this.context = handler == null ? null : context
    this.handler = (handler == null ? context : handler) as (Result<any?>) -> unit
  }

  fun resumeWith(result : Result<any?>) {
    handler(result)
  }

  fun resume(value : any?) {
    handler(Result.success<any?>(value))
  }

  fun resumeWithException(error : any?) {
    handler(Result.failure<any?>(error))
  }
}

// Starts a flow that runs this function, and returns when the flow has finished or has
// first set itself aside. `completion` is told how it turned out, when it has. Without one,
// an error the flow does not catch goes to whoever was running it at the time: the caller of
// startCoroutine, or of the resume that took it up.
fun Function.startCoroutine(completion : Continuation? = null) {
  val body = this
  __flow.start {
    val result = runCatching<any?>(body)
    if (completion != null) { completion.resumeWith(result) } else { result.getOrThrow() }
  }
}

// The same, with the function as an argument: startCoroutine { ... }, or with what is to be
// told how it turned out: startCoroutine({ ... }, completion).
fun startCoroutine(block : suspend () -> any?) {
  block.startCoroutine()
}

fun startCoroutine(block : suspend () -> any?, completion : Continuation) {
  block.startCoroutine(completion)
}

// Sets the flow aside until the continuation handed to `block` is resumed, and gives the
// value it is resumed with, or throws the error. The continuation may be resumed from any
// thread, once; the flow goes on there and then.
//
// On a thread that is not running a flow, this waits on that thread instead.
suspend fun suspendCoroutine(block : (Continuation) -> unit) : any? {
  val flow = __flow.current()
  if (flow == null) {
    if (__loop.isLoopThread()) {
      throw Error("suspendCoroutine was called outside a flow on the main thread, which would stop the event loop that " +
                  "is to bring the answer; start a flow with startCoroutine { ... }")
    }
    val answer = Future<Result<any?>>()
    block(Continuation { result -> answer.complete(result) })
    return answer.get().getOrThrow()
  }
  val wait = __flow.prepare()
  block(Continuation { result ->
    __flow.resume(flow, wait, result.isSuccess, result.isSuccess ? result.getOrNull() : result.exceptionOrNull())
  })
  return __flow.wait(wait)
}

// Waits `millis` milliseconds. In a flow on the main thread the flow is set aside meanwhile
// and the event loop goes on; anywhere else the thread sleeps.
suspend fun delay(millis : int) {
  if (__flow.current() != null and __loop.isLoopThread()) {
    suspendCoroutine { continuation -> __loop.timer(millis, { continuation.resume(null) }) }
  } else {
    Thread.sleep(millis)
  }
}
