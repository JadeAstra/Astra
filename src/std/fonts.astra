// ---- Fonts, text and pictures ----
// The text engine: reading font files, measuring text and drawing it into a picture, all by
// code of Astra's own. The system is asked for one thing only, which font files are
// installed. The same font file gives the same numbers and the same pixels everywhere.
//
//   val font = TextFont("Segoe UI", 14, bold = true)
//   val page = Picture(font.width("Hello") + 20, font.height + 20, Picture.white)
//   page.drawText("Hello", 10, 10 + font.ascent, font)
//   page.save("hello.png")
//
// Measuring and drawing go by one rule. A character's width is its width in the font, scaled
// to the size and rounded to a whole pixel; a text's width is the sum of its characters'
// widths; and each character is drawn where the widths before it add up to. So width("abc")
// is exactly where "abc" ends when drawn, and a caret placed by measuring sits on the text.
//
// On a dense screen a font is made with a scale (1.5, 2): its numbers are then in the
// screen's own pixels, which is where the rounding has to happen, and a size in the units
// the layout works in is the number divided by the scale.
//
// What it does not do yet: scripts whose letters join or reorder (Arabic, Devanagari),
// right-to-left text, and marks placed on other letters. One character is one glyph.
// The work is done by the built-in __text (src/text).

// One axis a variable font can be varied along: "wght" (weight), "wdth" (width), "opsz"
// (the size it is to be read at) and so on.
data FontAxis(val tag, val minimum, val defaultValue, val maximum)

// One font out of a font file: a family in one style, at no particular size.
class Typeface {
  val handle          // the engine's number for it
  val path
  val index
  val family          // "Segoe UI"
  val style           // "Bold Italic"
  val fullName        // "Segoe UI Bold Italic"
  val legacyFamily    // the family as programs that know four styles see it: "Segoe UI Semibold"
  val weight          // 100 to 900: 400 is regular, 700 bold
  val stretch         // 1 to 9: 5 is the normal width
  val isItalic
  val isMonospace
  val isSymbol        // a symbol font: its characters are not letters
  val isVariable      // one file holding every weight
  val hasCubicOutlines  // the .otf kind of outline
  val hasColor        // has colour glyphs (emoji)
  val glyphCount
  val unitsPerEm

  fun init(handle) {
    this.handle = handle
    val info = __text.faceInfo(handle)
    path = info[0]; index = info[1]; family = info[2]; style = info[3]; fullName = info[4]
    weight = info[5]; stretch = info[6]; isItalic = info[7]; isMonospace = info[8]; isSymbol = info[9]
    isVariable = info[10]; hasCubicOutlines = info[11]; hasColor = info[12]; glyphCount = info[13]
    unitsPerEm = info[14]; legacyFamily = info[15]
  }

  // The axes of a variable font; none for any other.
  get axes() => __text.faceAxes(handle).map { FontAxis(it[0], it[1], it[2], it[3]) }

  // Whether the font has a character: a one-character string, or its number.
  fun has(character) => __text.faceGlyph(handle, character) != 0

  // The number of the glyph for a character; 0, the "missing" glyph, if it has none.
  fun glyph(character) => __text.faceGlyph(handle, character)

  // This typeface at a size. See TextFont.
  fun font(size, bold = false, italic = false, weight = null, scale = 1, hinting = true) => TextFont(this, size, bold, italic, weight, scale, hinting)

  // In the font's own units, for a weight (which only a variable font has more than one of).
  fun advance(glyph, weight = null) => __text.faceAdvance(handle, glyph, weight ?: this.weight)

  // A glyph's outline as a list: "M" x y, "L" x y, "Q" cx cy x y, "C" c1x c1y c2x c2y x y,
  // "Z". In the font's units with y upwards; empty for a glyph that draws nothing.
  fun outline(glyph, weight = null) => __text.faceOutline(handle, glyph, weight ?: this.weight)

  // Reads every `step`th glyph's outline, to test the reader:
  // [how many have one, how many points, how many are damaged].
  fun check(step = 1, weight = null) => __text.faceCheck(handle, 0, step, weight ?: this.weight)

  op ==(other) => other is Typeface and other.handle == handle
  fun hashCode() => handle
  override fun toString() => "Typeface($fullName)"
}

// The fonts installed on this machine.
object Fonts {
  // Every family's name, in alphabetical order.
  fun families() => __text.families()

  // Whether a family is installed. "SansSerif", "Serif" and "Monospaced" always are, if
  // any font is: they are the system's own font of each kind.
  fun has(family) => __text.hasFamily(family)

  // The typefaces of a family, or every one installed.
  fun typefaces(family = null) => __text.typefaces(family).map { Typeface(it) }

  // The typeface of a family nearest to a weight and style; null if it is not installed.
  fun find(family, weight = 400, italic = false) {
    val found = __text.find(family, weight, italic)
    return found == null ? null : Typeface(found[0])
  }

  // A typeface that has a character, for text in a font that lacks it; null if none has.
  fun fallback(character, weight = 400, italic = false) {
    val found = __text.fallback(character, weight, italic)
    return found == null ? null : Typeface(found[0])
  }

  // A font from a file that is not installed, or from the bytes of one. A collection
  // (.ttc) holds several: `count` says how many, `index` picks one.
  fun load(path, index = 0) => Typeface(path is Bytes ? __text.fromBytes(path, index) : __text.load(path is File ? path.path : path, index))
  fun count(path) => __text.countIn(path is File ? path.path : path)
}

// A typeface at a size: what text is measured and drawn with.
//
//   TextFont("Consolas", 13)                      by family; "SansSerif", "Serif" and
//   TextFont("Segoe UI", 12, bold = true)         "Monospaced" are the system's own
//   TextFont("Bahnschrift", 20, weight = 350)     any weight, where the font has it
//   TextFont(Fonts.load("my.ttf"), 16)            a typeface of your own
//   TextFont("Segoe UI", 12, scale = 1.5)         for a screen at 150%
//
// A family that is not installed gives the system's sans-serif font: `family` says which
// was used. A style the family lacks is made up, a bold by thickening and an italic by
// slanting. Every number is in pixels of the picture or screen drawn on.
class TextFont {
  val handle       // the engine's number for it
  val typeface
  val size
  val scale
  val weight
  val isBold
  val isItalic
  val ascent       // from the baseline up to the top of the line
  val descent      // from the baseline down to its bottom
  val leading      // extra room between one line and the next
  val xHeight      // the height of a small letter such as x
  val capHeight    // the height of a capital

  fun init(family, size, bold = false, italic = false, weight = null, scale = 1, hinting = true) {
    val wanted = weight ?: (bold ? 700 : 400)
    var face = family
    var set = wanted
    var fakeBold = false
    var fakeItalic = false
    if (family is Typeface) {
      // The typeface as it is, set to the weight if it is variable.
      set = weight ?: (bold ? Math.max(700, family.weight) : family.weight)
      fakeBold = bold and !family.isVariable and family.weight <= 500
      fakeItalic = italic and !family.isItalic
    } else {
      val found = __text.find(str(family), wanted, italic) ?: __text.find("SansSerif", wanted, italic)
      if (found == null) { throw Error("no fonts are installed") }
      face = Typeface(found[0])
      set = found[1]
      fakeBold = found[2]
      fakeItalic = found[3]
    }
    this.typeface = face
    this.size = size
    this.scale = scale
    this.handle = __text.font(face.handle, size, scale, set, fakeBold, fakeItalic, hinting)
    val info = __text.fontInfo(handle)
    ascent = info[0]; descent = info[1]; leading = info[2]; xHeight = info[3]; capHeight = info[4]
    this.weight = info[5]
    this.isBold = this.weight >= 600 or fakeBold
    this.isItalic = face.isItalic or fakeItalic
  }

  get family() => typeface.family

  // The height of a line: ascent, descent and leading.
  get height() => ascent + descent + leading

  // A text's width: the sum of its characters' widths, and where it ends when drawn.
  fun width(text) => __text.width(handle, text)
  fun charWidth(character) => __text.charWidth(handle, character)

  // Where each character of a text starts and where the last one ends: one more number
  // than the text has characters. offsets("abc") is [0, width("a"), width("ab"), width("abc")].
  fun offsets(text) => __text.offsets(handle, text)

  // The typeface a character is drawn from: this font's own, or another one that has the
  // character when this one does not. Null if no installed font has it.
  fun typefaceFor(character) {
    val found = __text.faceFor(handle, character)
    return found == null ? null : Typeface(found)
  }

  // What a character's drawn shape takes up, as [left, top, width, height, isColor, advance]:
  // `left` from where the character starts, `top` above the baseline. Null if it draws nothing.
  fun glyphBox(character) => __text.glyphBox(handle, character)

  // The same font at another size or scale.
  fun derive(size = null, scale = null) => TextFont(typeface, size ?: this.size, isBold, isItalic, weight, scale ?: this.scale)

  override fun toString() => "TextFont(${typeface.fullName}, $size)"
}

// A picture: `width` by `height` pixels, each a colour that may be see-through.
//
// A colour is one number, 0xAARRGGBB: alpha (255 solid, 0 clear), red, green, blue.
// 0xFF000000 is black, 0xFFFFFFFF white, 0x80FF0000 a half-clear red. Picture.rgb makes one.
//
// `pixels` is the picture itself as bytes, four for each pixel (red, green, blue, alpha),
// top row first: pixel (x, y) starts at (y * width + x) * 4.
class Picture {
  val width
  val height
  val pixels

  static val black = 0xFF000000
  static val white = 0xFFFFFFFF
  static val clear = 0

  static fun rgb(red, green, blue, alpha = 255) => (alpha << 24) | (red << 16) | (green << 8) | blue

  // A picture of one colour: clear, unless another is given.
  fun init(width, height, color = 0, pixels = null) {
    if (width < 0 or height < 0 or width > 32768 or height > 32768) { throw Error("a picture is from 0 to 32768 pixels each way, not $width by $height") }
    this.width = width
    this.height = height
    if (pixels != null) {
      if (pixels.size != width * height * 4) { throw Error("the pixels do not fit a picture of $width by $height") }
      this.pixels = pixels
    } else {
      this.pixels = Bytes(width * height * 4)
      if (color != 0) { __text.fill(this.pixels, width, height, 0, 0, width, height, color) }
    }
  }

  // Reads a PNG file, or the bytes of one.
  static fun load(source) {
    val data = source is Bytes ? source : (source is File ? source : File(source)).readBytes()
    val read = __text.decodePng(data)
    return Picture(read[0], read[1], 0, read[2])
  }

  // Writes the picture as a PNG file. Nothing is lost: loading it gives the same pixels.
  fun save(path) {
    (path is File ? path : File(path)).writeBytes(__text.encodePng(pixels, width, height))
  }

  // The bytes of the PNG file that save() would write.
  fun toPng() => __text.encodePng(pixels, width, height)

  // The colour of a pixel; clear outside the picture.
  fun get(x, y) {
    if (x < 0 or y < 0 or x >= width or y >= height) { return 0 }
    val at = (y * width + x) * 4
    return (pixels[at + 3] << 24) | (pixels[at] << 16) | (pixels[at + 1] << 8) | pixels[at + 2]
  }

  fun set(x, y, color) {
    if (x < 0 or y < 0 or x >= width or y >= height) { return }
    val at = (y * width + x) * 4
    pixels[at] = (color >> 16) & 255
    pixels[at + 1] = (color >> 8) & 255
    pixels[at + 2] = color & 255
    pixels[at + 3] = (color >> 24) & 255
  }

  // Sets every pixel, or every pixel of a rectangle, to a colour.
  fun fill(color) {
    __text.fill(pixels, width, height, 0, 0, width, height, color)
  }

  fun fillRect(x, y, w, h, color) {
    __text.fill(pixels, width, height, x, y, w, h, color)
  }

  // Lays a colour over a rectangle: what is underneath shows through a see-through colour.
  fun blendRect(x, y, w, h, color) {
    __text.blend(pixels, width, height, x, y, w, h, color)
  }

  // Draws a line of text starting at x, with its baseline at y: letters sit on that row
  // and tails hang below it. (For text whose top is at `top`, the baseline is
  // top + font.ascent.) Returns the text's width, which is font.width(text).
  fun drawText(text, x, y, font, color = 0xFF000000) => __text.drawText(pixels, width, height, font.handle, str(text), x, y, color)

  // Lays another picture over this one, its top-left corner at (x, y).
  fun draw(other, x, y) {
    __text.draw(pixels, width, height, other.pixels, other.width, other.height, x, y)
  }

  // A part of the picture as a picture of its own.
  fun crop(x, y, w, h) {
    val out = Picture(Math.max(w, 0), Math.max(h, 0))
    for (row in 0..<out.height) {
      for (col in 0..<out.width) { out.set(col, row, get(x + col, y + row)) }
    }
    return out
  }

  fun copy() => Picture(width, height, 0, Bytes(pixels))

  // The same size and the same pixels.
  op ==(other) => other is Picture and other.width == width and other.height == height and other.pixels == pixels

  // The smallest rectangle outside which every pixel is `background`, as [x, y, width,
  // height]; null if the whole picture is.
  fun inkBox(background = 0) {
    var minX = width
    var minY = height
    var maxX = -1
    var maxY = -1
    for (y in 0..<height) {
      for (x in 0..<width) {
        if (get(x, y) != background) {
          if (x < minX) { minX = x }
          if (x > maxX) { maxX = x }
          if (y < minY) { minY = y }
          if (y > maxY) { maxY = y }
        }
      }
    }
    return maxX < 0 ? null : [minX, minY, maxX - minX + 1, maxY - minY + 1]
  }

  override fun toString() => "Picture($width x $height)"
}
