// ---- Ranges ----
// A range can be looped over, and has the methods of a list that only read: each makes a
// list of its numbers where it needs one.

fun Range.forEach(action : (int) -> unit) {
  for number in this { action(number) }
}

fun <R> Range.map(transform : (int) -> R) : List<R> {
  val out : List<R> = []
  for number in this { out.add(transform(number)) }
  return out
}

fun <R> Range.mapNotNull(transform : (int) -> R?) : List<R> {
  val out : List<R> = []
  for number in this {
    val made = transform(number)
    if (made != null) { out.add(made) }
  }
  return out
}

fun <R> Range.flatMap(transform : (int) -> List<R>) : List<R> {
  val out : List<R> = []
  for number in this { out.addAll(transform(number)) }
  return out
}

fun Range.filter(predicate : (int) -> bool) : List<int> {
  val out : List<int> = []
  for number in this {
    if (predicate(number)) { out.add(number) }
  }
  return out
}

fun Range.any() : bool => this.size > 0

fun Range.any(predicate : (int) -> bool) : bool {
  for number in this {
    if (predicate(number)) { return true }
  }
  return false
}

fun Range.all(predicate : (int) -> bool) : bool {
  for number in this {
    if (!predicate(number)) { return false }
  }
  return true
}

fun Range.none() : bool => this.size == 0

fun Range.none(predicate : (int) -> bool) : bool {
  for number in this {
    if (predicate(number)) { return false }
  }
  return true
}

fun Range.count() : int => this.size

fun Range.count(predicate : (int) -> bool) : int {
  var total = 0
  for number in this {
    if (predicate(number)) { total += 1 }
  }
  return total
}

fun Range.firstOrNull() : int? => this.size == 0 ? null : this.start

fun Range.firstOrNull(predicate : (int) -> bool) : int? {
  for number in this {
    if (predicate(number)) { return number }
  }
  return null
}

fun Range.find(predicate : (int) -> bool) : int? => this.firstOrNull(predicate)

fun Range.sum() : int {
  var total = 0
  for number in this { total += number }
  return total
}

fun <R : Number> Range.sumOf(selector : (int) -> R) : R {
  var total : Number = 0
  for number in this { total += selector(number) }
  return total as R
}

fun <V> Range.associateWith(valueSelector : (int) -> V) : Map<int, V> {
  val out : Map<int, V> = {:}
  for number in this { out[number] = valueSelector(number) }
  return out
}

fun Range.isNotEmpty() : bool => this.size > 0
fun Range.reversed() : List<int> => this.toList().reversed()
fun Range.toMutableList() : List<int> => this.toList()
fun Range.toSet() : Set<int> => Set(this)

fun Range.random() : int {
  if (this.size == 0) { throw Error("random() of an empty range") }
  return this.start + Math.randomInt(0, this.size - 1) * this.step
}

fun Range.joinToString(separator : string = ", ", prefix : string = "", postfix : string = "", limit : int = -1,
                       truncated : string = "...", transform : ((int) -> any?)? = null) : string {
  return this.toList().joinToString(separator, prefix, postfix, limit, truncated, transform)
}
