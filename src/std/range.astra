// ---- Ranges ----
// A range can be looped over, and has the methods of a list that only read: each makes a
// list of its numbers where it needs one.

fun Range.forEach(action) {
  for number in this { action(number) }
}

fun Range.map(transform) {
  val out = []
  for number in this { out.add(transform(number)) }
  return out
}

fun Range.mapNotNull(transform) {
  val out = []
  for number in this {
    val made = transform(number)
    if (made != null) { out.add(made) }
  }
  return out
}

fun Range.flatMap(transform) {
  val out = []
  for number in this { out.addAll(transform(number)) }
  return out
}

fun Range.filter(predicate) {
  val out = []
  for number in this {
    if (predicate(number)) { out.add(number) }
  }
  return out
}

fun Range.any(predicate = null) {
  if (predicate == null) { return this.length > 0 }
  for number in this {
    if (predicate(number)) { return true }
  }
  return false
}

fun Range.all(predicate) {
  for number in this {
    if (!predicate(number)) { return false }
  }
  return true
}

fun Range.none(predicate = null) {
  if (predicate == null) { return this.length == 0 }
  for number in this {
    if (predicate(number)) { return false }
  }
  return true
}

fun Range.count(predicate = null) {
  if (predicate == null) { return this.length }
  var total = 0
  for number in this {
    if (predicate(number)) { total += 1 }
  }
  return total
}

fun Range.firstOrNull(predicate = null) {
  for number in this {
    if (predicate == null or predicate(number)) { return number }
  }
  return null
}

fun Range.find(predicate) => this.firstOrNull(predicate)

fun Range.sum() {
  var total = 0
  for number in this { total += number }
  return total
}

fun Range.sumOf(selector) {
  var total = 0
  for number in this { total += selector(number) }
  return total
}

fun Range.associateWith(valueSelector) {
  val out = {:}
  for number in this { out[number] = valueSelector(number) }
  return out
}

fun Range.isNotEmpty() => this.length > 0
fun Range.reversed() => this.toList().reversed()
fun Range.toMutableList() => this.toList()
fun Range.toSet() => Set(this)

fun Range.random() {
  if (this.length == 0) { throw Error("random() of an empty range") }
  return this.start + Math.randomInt(0, this.length - 1) * this.step
}

fun Range.joinToString(separator = ", ", prefix = "", postfix = "", limit = -1, truncated = "...", transform = null) {
  return this.toList().joinToString(separator, prefix, postfix, limit, truncated, transform)
}
