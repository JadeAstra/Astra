// ---- Parallel sections ----
// The items of a list worked on by several cores at once, on the objects themselves:
//
//   balls.parallelStream().forEach { it.move(width, height, steps) }
//   val totals = orders.parallelStream().map { priceOf(it) }.toList()
//
// Threads take turns, and workers work on copies. Here the cores really run at the same time
// on the same objects, which is safe because of one rule that the runtime holds each core to:
//
//   - a core may change the item it was given, and anything it makes itself;
//   - everything else it may read and not change: the variables around the lambda, other
//     lists and objects, and whatever an item holds that is an object of its own.
//
// A lambda that keeps to that runs on every core. One that does not, { it.move(); moved.add(it) }
// say, gets an error the first time it runs: it never damages anything. Results come back by
// being returned: map, filter, sumOf and the rest put them together afterwards.
//
// Nothing waits inside a section: no lock, no reading or writing, no setting a task aside.
// The section itself is an ordinary call, which returns when every core has finished. A
// section may start sections of its own, and parallel({ a }, { b }) runs functions at once
// (D96); the cores share the work out between them as they come free. What every core may
// change is an Atomic, an `atomic var` field, a SharedMap or a SharedSet (D85, D92, D94);
// gather gives each core a result of its own, merged at the end (D93).

// Inside Astra: the work is done by the built-in __parallel (parallel.cpp).

// A list's items for every core to work on at once, from parallelStream(): the items
// themselves, not copies. map, filter and the like give a new stream; toList() and the totals end one.
class ParallelStream<T> {
  private val items : List<T>

  fun init(source : List<T>) {
    this.items = source
  }

  // Runs the action on every item, the items dealt out to the cores.
  fun forEach(action : (T) -> unit) {
    __parallel.run(items, action, false)
  }

  // Each item replaced by what the function gives for it, the items dealt out to the cores. An item
  // of a list of values is where its result goes: balls.parallelStream().replaceAll { it.moved() }
  // builds each new ball where the old one was, with nothing made on the side.
  fun replaceAll(transform : (T) -> T) {
    __parallel.replace(items, transform)
  }

  // What the function gives for each item, in the order of the items, as a stream to go on from.
  fun <R> map(transform : (T) -> R) : ParallelStream<R> => ParallelStream<R>(__parallel.run(items, transform, true))

  // What the function gives for each item, the nulls left out, in the order of the items, as a
  // stream to go on from.
  fun <R> mapNotNull(transform : (T) -> R?) : ParallelStream<R> {
    val made : open List<R?> = __parallel.run(items, transform, true)
    return ParallelStream(made.filterNotNull())
  }

  // The items for which the condition holds.
  fun filter(predicate : (T) -> bool) : ParallelStream<T> {
    val keep : open List<bool> = __parallel.run(items, predicate, true)
    val out : open List<T> = []
    for index in 0..<items.size {
      if (keep[index]) { out.add(items[index]) }
    }
    return ParallelStream(out)
  }

  // How many items there are.
  fun count() : int => items.size
  // How many items `predicate` is true for, each tested on one of the cores.
  fun count(predicate : (T) -> bool) : int => tests(predicate).count { it }
  // Whether `predicate` is true for any item; every item is tested, on the cores. False when
  // there are none.
  fun any(predicate : (T) -> bool) : bool => tests(predicate).any { it }
  // Whether `predicate` is true for every item; every item is tested, on the cores. True when
  // there are none.
  fun all(predicate : (T) -> bool) : bool => tests(predicate).all { it }
  // Whether `predicate` is true for no item; every item is tested, on the cores. True when there
  // are none.
  fun none(predicate : (T) -> bool) : bool => !tests(predicate).any { it }

  private fun tests(predicate : (T) -> bool) : open List<bool> => __parallel.run(items, predicate, true)

  // The total of what `selector` gives for each item, each worked out on one of the cores; 0 for none.
  fun <R : Number> sumOf(selector : (T) -> R) : R => (__parallel.run(items, selector, true) as List<R>).sum()
  // The largest of what `selector` gives for each item, each worked out on one of the cores:
  // NoSuchElementException when there are none.
  fun <R> maxOf(selector : (T) -> R) : R => (__parallel.run(items, selector, true) as List<R>).max()
  // The smallest of what `selector` gives for each item, each worked out on one of the cores:
  // NoSuchElementException when there are none.
  fun <R> minOf(selector : (T) -> R) : R => (__parallel.run(items, selector, true) as List<R>).min()
  // The total of the items, which have to be numbers (ClassCastException otherwise); 0 for
  // none.
  fun sum() : any? => (items as List<Number>).sum()
  // The largest item, in natural order: NoSuchElementException when there are none.
  fun max() : T => items.max()
  // The smallest item, in natural order: NoSuchElementException when there are none.
  fun min() : T => items.min()

  // The items as a list: after map or filter, what they came to.
  fun toList() : open List<T> => items.toList()
  // The items as a new set, each once, in the order they first come.
  fun toSet() : open Set<T> => Set(items)
  // The items in their natural order, as a new list.
  fun sorted() : open List<T> => items.sorted()
  // The items as text, `separator` between each two: [3, 1].parallelStream().join() is "3, 1".
  fun join(separator : string = ", ") : string => items.join(separator)

  // What the function gives for each item, every list of them joined into one, in order.
  fun <R> flatMap(transform : (T) -> List<R>) : ParallelStream<R> {
    val made : List<List<R>> = __parallel.run(items, transform, true)
    return ParallelStream(made.flatten())
  }

  // One answer from every item, as on a list: the items combined two at a time, each core's
  // share on its own, then the cores' answers. `operation` has to give the same whichever way
  // its operands are grouped, as + and max do.
  fun reduce(operation : (T, T) -> T) : T {
    if (items.isEmpty()) { throw UnsupportedOperationException("an empty stream cannot be reduced") }
    val parts : List<List<T>> = __parallel.gather(items, {
      val part : open List<T> = []
      part
    }, { part, item -> (part as open List<T>).add(item) })
    val answers = parts.filter { it.isNotEmpty() }.parallelStream().map { it.reduce(operation) }.toList()
    return answers.reduce(operation)
  }

  // One answer from every item, starting from `initial`, as on a list: the items in order.
  fun <R> fold(initial : R, operation : (R, T) -> R) : R => items.fold(initial, operation)

  // A result of its own for each core, made empty by `into`, every item added to one of them by
  // `each`, and the results merged into the first by `merge` once every core is done (D93).
  // Nothing is shared while the cores work:
  //
  //   val counts = words.parallelStream().gather(
  //     into = { val counts : open Map<string, int> = {:}; counts },
  //     each = { counts, word -> counts[word] = (counts[word] ?: 0) + 1 },
  //     merge = { a, b -> for ((word, n) in b) { a[word] = (a[word] ?: 0) + n } })
  fun <R> gather(into : () -> R, each : (R, T) -> unit, merge : (R, R) -> unit) : R {
    val parts : List<R> = __parallel.gather(items, into, each)
    val first = parts[0]
    for (i in 1..<parts.size) { merge(first, parts[i]) }
    return first
  }
}

// A stream of the list's items for the cores to work on, the items themselves: what forEach
// does to them it does to the list's.
fun <T> List<T>.parallelStream() : ParallelStream<T> => ParallelStream(this)
// A stream of the range's numbers, in order, for the cores to work on.
fun Range.parallelStream() : ParallelStream<int> => ParallelStream(this.toList())

// The buffer in as many parts as there are cores, each core given the positions of one part:
// it may write those and no others.
//
//   pixels.parallelChunks { positions -> for i in positions { pixels[i] = shade(i) } }
fun Bytes.parallelChunks(action : (Range) -> unit) {
  __parallel.chunks(this, action)
}

// The same for a list of numbers or of values (D96): each core writes the positions of its part.
fun <T> open List<T>.parallelChunks(action : (Range) -> unit) {
  __parallel.chunks(this, action)
}

// Runs the functions at once, on whatever cores are free, and gives what they return when all
// are done, in order (D96). What a function captures every one may read and none may change; a
// view of a list from splitAt that a function captures is that function's own to write.
//
//   val (left, right) = parallel({ count(a) }, { count(b) })
fun <T> parallel(vararg work : () -> T) : List<T> => __parallel.functions(work)

// The list sorted in place, its parts on every core (D96): in their natural order, as sort()
// gives it, an object's by its compareTo.
fun <T> open List<T>.parallelSort() {
  if (size < 8192 or availableProcessors() == 1) {
    sort()
    return
  }
  if (!__parallel.owns(this)) { throw IllegalStateException("parallelSort changes the list, which this code may only read") }
  __parallelSort(ListView(__viewKey, this, 0, size))
}

fun <T> __parallelSort(view : ListView<T>) {
  if (view.size < 8192) {
    view.sort()
    return
  }
  val mid = view.size / 2
  view.splitAt(mid) { left, right -> parallel({ __parallelSort(left) }, { __parallelSort(right) }) }
  __parallel.viewSort(view, mid)
}

// ---- Views of a list (D96) ----
// A stretch of a list, read and changed in place: what splitAt hands out. Two views from one
// splitAt never overlap, so each may go to a function of its own in a parallel(...), which
// writes through it whatever else is going on, and divide and conquer can be written in place:
//
//   fun increment(view : ListView<int>) {
//     if (view.size < 1000) { for (i in view.indices) { view[i] += 1 } }
//     else view.splitAt(view.size / 2) { left, right -> parallel({ increment(left) }, { increment(right) }) }
//   }
//   xs.splitAt(xs.size / 2) { left, right -> ... }
class ListView<T> {
  internal val list : open List<T>
  internal val start : int
  // How many items the view has.
  val size : int
  internal var lent = false

  // Made only by splitAt: two views can never overlap.
  fun init(key : __ViewKey, list : open List<T>, start : int, size : int) {
    this.list = list
    this.start = start
    this.size = size
  }

  // The item at `index`, counted from the view's start: IndexOutOfBoundsException outside
  // 0..<size.
  op [](index : int) : T => __parallel.viewGet(this, index) as T
  // Sets the item at `index`, counted from the view's start, in the list itself:
  // IndexOutOfBoundsException outside 0..<size. IllegalStateException while the view is split, or
  // in a parallel section if the view is not this piece's own.
  op []=(index : int, item : T) {
    __parallel.viewSet(this, index, item)
  }

  // The view's positions, 0..<size.
  val indices : Range
    get() => 0..<size
  // Whether the view has no items.
  fun isEmpty() : bool => size == 0

  // Its first `mid` items and the rest, as two views, to the block; meanwhile this one is lent
  // to them, and nothing is written through it.
  fun splitAt(mid : int, block : (ListView<T>, ListView<T>) -> unit) {
    if (mid < 0 or mid > size) { throw IndexOutOfBoundsException("a view of $size items is split at 0 to $size, not $mid") }
    lent = true
    try {
      block(ListView(__viewKey, list, start, mid), ListView(__viewKey, list, start + mid, size - mid))
    } finally {
      lent = false
    }
  }

  // Its items sorted in place, in their natural order.
  fun sort() {
    __parallel.viewSort(this, null)
  }

  // The view's items, copied into a new list.
  fun toList() : open List<T> => List(size) { this[it] }
  // For a for: the view's items, copied into a list first.
  fun iterator() : List<T> => toList()
  // The view's items written as a list: [1, 2].
  override fun toString() : string => "${toList()}"
}

// The key a ListView is made with, which only the standard library has.
class __ViewKey
val __viewKey = __ViewKey()

// The list's first `mid` items and the rest, as two views that never overlap, to the block.
fun <T> open List<T>.splitAt(mid : int, block : (ListView<T>, ListView<T>) -> unit) {
  if (!__parallel.owns(this)) { throw IllegalStateException("splitAt hands out views to change the list through, and this code may only read it") }
  ListView(__viewKey, this, 0, size).splitAt(mid, block)
}

// ---- Shared collections (D94) ----
// A map and a set any core of a parallel section may change, each change done whole:
//
//   val seen = SharedSet<string>()
//   pages.parallelStream().forEach { page -> for (link in page.links) { seen.add(link) } }
//
// Keys and values are what every core may read: values, text, frozen data, or objects not
// changed in the section. There is no shared list: cores adding as they finish would give a
// different order each run; map, flatMap and gather collect results in order, with nothing shared.

// A map any core of a parallel section may change, each change done whole. In a section, a key
// or a value that is an object the core itself made, and may still change, is an
// IllegalStateException.
class SharedMap<K, V> {
  private val entries : any = __parallel.sharedMap()

  // The key's value, or null if it has none.
  op [](key : K) : V? => __parallel.sharedGet(entries, key) as V?
  // Sets the key's value.
  op []=(key : K, value : V) {
    __parallel.sharedPut(entries, key, value)
  }
  // The key's value, or null if it has none: the same as [key].
  fun get(key : K) : V? => __parallel.sharedGet(entries, key) as V?
  // Sets the key's value, giving the one it had.
  fun put(key : K, value : V) : V? => __parallel.sharedPut(entries, key, value) as V?
  // Takes the key out, giving its value.
  fun remove(key : K) : V? => __parallel.sharedRemove(entries, key) as V?
  // Whether the key has a value.
  fun containsKey(key : K) : bool => __parallel.sharedHas(entries, key)
  // How many keys it holds now.
  val size : int
    get() => __parallel.sharedSize(entries)

  // The key's value, made by `make` and put in if there is none: `make` may run on two cores
  // at once for one key, and only one value is kept.
  fun putIfAbsent(key : K, make : () -> V) : V {
    val there = get(key)
    if (there != null) { return there }
    val made = make()
    if (__parallel.sharedSwap(entries, key, null, made)) { return made }
    return get(key)!!
  }

  // Sets the key's value to what `change` gives for the one it has (null for none), in one step:
  // `change` may run more than once when cores contend. Gives the new value.
  fun update(key : K, change : (V?) -> V) : V {
    while (true) {
      val old = get(key)
      val made = change(old)
      if (__parallel.sharedSwap(entries, key, old, made)) { return made }
    }
  }

  // A copy of what it holds now, an ordinary map.
  fun toMap() : open Map<K, V> => __parallel.sharedCopy(entries) as open Map<K, V>
  // What it holds now, written as a map: {"x": 1}.
  override fun toString() : string => "${toMap()}"
}

// A set any core of a parallel section may change, each change done whole. In a section, an
// item that is an object the core itself made, and may still change, is an IllegalStateException.
class SharedSet<T> {
  private val entries : any = __parallel.sharedMap()

  // Adds the item: whether it was not there.
  fun add(item : T) : bool => __parallel.sharedAdd(entries, item, true)
  // Takes the item out: whether it was there.
  fun remove(item : T) : bool => __parallel.sharedRemove(entries, item) != null
  // Whether the item is in it.
  fun contains(item : T) : bool => __parallel.sharedHas(entries, item)
  // How many items it holds now.
  val size : int
    get() => __parallel.sharedSize(entries)
  // A copy of what it holds now, an ordinary set.
  fun toSet() : open Set<T> => Set((__parallel.sharedCopy(entries) as Map<T, bool>).keys)
  // What it holds now, written as a set: {1, 2}.
  override fun toString() : string => "${toSet()}"
}

// How many cores a parallel section uses on this machine.
fun availableProcessors() : int => __parallel.cores()
