// ---- Sets and deques ----

// A set holds each value once, in the order the values were first added; two values are the
// same one if a map would take them as one key. It is built in (Set(), add, remove, contains,
// addAll, removeAll, retainAll, clear, toList, first, last, `set + x` and `set - x`); what it
// does besides is here, each reading its items in order, and those that make a collection
// making a list, as a list's do. A map's keys and entries are sets too, live views of it (D77).
//
//   val seen = Set<string>()        setOf(1, 2, 3)        [1, 2, 2].toSet()

fun <T> Set<T>.containsAll(from : List<T>) : bool => from.all { this.contains(it) }
fun <T> Set<T>.containsAll(from : Set<T>) : bool => from.toList().all { this.contains(it) }
fun <T> open Set<T>.removeIf(predicate : (T) -> bool) : bool => this.removeAll(predicate)

fun <T> Set<T>.toOpenList() : open List<T> => this.toList()
fun <T> Set<T>.toSet() : open Set<T> => Set(this)
fun <T> Set<T>.toOpenSet() : open Set<T> => Set(this)

// The sets made of both, of what is in both, and of what is only in this one.
fun <T> Set<T>.union(other : any) : open Set<T> {
  val out : open Set<T> = Set(this)
  out.addAll(other)
  return out
}

fun <T> Set<T>.intersect(other : any) : open Set<T> {
  val out : open Set<T> = Set()
  for item in Set<T>(other) {
    if (this.contains(item)) { out.add(item) }
  }
  return out
}

fun <T> Set<T>.subtract(other : any) : open Set<T> {
  val out : open Set<T> = Set(this)
  out.removeAll(Set<T>(other))
  return out
}

fun <T> Set<T>.plus(item : T) : open Set<T> => this + item
fun <T> Set<T>.plus(other : List<T>) : open Set<T> => this.union(other)
fun <T> Set<T>.plus(other : Set<T>) : open Set<T> => this.union(other)
fun <T> Set<T>.minus(item : T) : open Set<T> => this - item
fun <T> Set<T>.minus(other : List<T>) : open Set<T> => this.subtract(other)
fun <T> Set<T>.minus(other : Set<T>) : open Set<T> => this.subtract(other)

// What a list has for reading.
fun <T> Set<T>.firstOrNull() : T? => this.isEmpty() ? null : this.first()
inline fun <T> Set<T>.firstOrNull(predicate : (T) -> bool) : T? => this.toList().firstOrNull(predicate)
fun <T> Set<T>.lastOrNull() : T? => this.isEmpty() ? null : this.last()
inline fun <T> Set<T>.lastOrNull(predicate : (T) -> bool) : T? => this.toList().lastOrNull(predicate)
inline fun <T> Set<T>.find(predicate : (T) -> bool) : T? => this.toList().firstOrNull(predicate)
fun <T> Set<T>.single() : T => this.toList().single()
fun <T> Set<T>.singleOrNull() : T? => this.toList().singleOrNull()
inline fun <T> Set<T>.forEach(action : (T) -> unit) {
  for item in this { action(item) }
}
inline fun <T, R> Set<T>.map(transform : (T) -> R) : open List<R> => this.toList().map(transform)
inline fun <T, R> Set<T>.mapNotNull(transform : (T) -> R?) : open List<R> => this.toList().mapNotNull(transform)
inline fun <T, R> Set<T>.flatMap(transform : (T) -> List<R>) : open List<R> => this.toList().flatMap(transform)
inline fun <T> Set<T>.filter(predicate : (T) -> bool) : open List<T> => this.toList().filter(predicate)
inline fun <T> Set<T>.filterNot(predicate : (T) -> bool) : open List<T> => this.toList().filterNot(predicate)
fun <T> Set<T>.any() : bool => this.isNotEmpty()
inline fun <T> Set<T>.any(predicate : (T) -> bool) : bool {
  for item in this {
    if (predicate(item)) { return true }
  }
  return false
}
inline fun <T> Set<T>.all(predicate : (T) -> bool) : bool {
  for item in this {
    if (!predicate(item)) { return false }
  }
  return true
}
fun <T> Set<T>.none() : bool => this.isEmpty()
inline fun <T> Set<T>.none(predicate : (T) -> bool) : bool => !this.any(predicate)
fun <T> Set<T>.count() : int => this.size
inline fun <T> Set<T>.count(predicate : (T) -> bool) : int {
  var total = 0
  for item in this {
    if (predicate(item)) { total += 1 }
  }
  return total
}
inline fun <T, R> Set<T>.fold(initial : R, operation : (R, T) -> R) : R => this.toList().fold(initial, operation)
fun <T> Set<T>.sum() : any? => (this.toList() as List<Number>).sum()
inline fun <T, R : Number> Set<T>.sumOf(selector : (T) -> R) : R => this.toList().sumOf(selector)
fun <T> Set<T>.max() : T => this.toList().max()
fun <T> Set<T>.min() : T => this.toList().min()
fun <T> Set<T>.maxOrNull() : T? => this.toList().maxOrNull()
fun <T> Set<T>.minOrNull() : T? => this.toList().minOrNull()
inline fun <T, R> Set<T>.maxOf(selector : (T) -> R) : R => this.toList().maxOf(selector)
inline fun <T, R> Set<T>.minOf(selector : (T) -> R) : R => this.toList().minOf(selector)
inline fun <T> Set<T>.maxByOrNull(selector : (T) -> any?) : T? => this.toList().maxByOrNull(selector)
inline fun <T> Set<T>.minByOrNull(selector : (T) -> any?) : T? => this.toList().minByOrNull(selector)
fun <T> Set<T>.sorted() : open List<T> => this.toList().sorted()
fun <T> Set<T>.sortedDescending() : open List<T> => this.toList().sortedDescending()
fun <T> Set<T>.sortedBy(selector : (T) -> any?) : open List<T> => this.toList().sortedBy(selector)
fun <T> Set<T>.sortedByDescending(selector : (T) -> any?) : open List<T> => this.toList().sortedByDescending(selector)
fun <T> Set<T>.sortedWith(comparator : (T, T) -> int) : open List<T> => this.toList().sortedWith(comparator)
inline fun <T, V> Set<T>.associateWith(valueSelector : (T) -> V) : open Map<T, V> => this.toList().associateWith(valueSelector)
inline fun <T, K> Set<T>.associateBy(keySelector : (T) -> K) : open Map<K, T> => this.toList().associateBy(keySelector)
inline fun <T, K> Set<T>.groupBy(keySelector : (T) -> K) : open Map<K, open List<T>> => this.toList().groupBy(keySelector)
inline fun <T> Set<T>.partition(predicate : (T) -> bool) : Pair<List<T>, List<T>> => this.toList().partition(predicate)
fun <T> Set<T>.join(separator : string = ", ", prefix : string = "", postfix : string = "", limit : int = -1,
                    truncated : string = "...", transform : ((T) -> any?)? = null) : string {
  return this.toList().join(separator, prefix, postfix, limit, truncated, transform)
}

// A queue open at both ends: adding and removing are quick at the front as well as the back,
// where a list is quick only at the back.
//
//   val queue = Deque<Job>()        queue.addLast(job)        val next = queue.removeFirst()
class Deque<T> {
  // The items are items[head ..< items.size]; what is before `head` has been taken from the
  // front, or is room made for adding there.
  private var items : open List<T?> = []
  private var head = 0

  fun init(from : any? = null) {
    if (from != null) { items.addAll(from) }
  }

  val size : int
    get() => items.size - head
  val lastIndex : int
    get() => items.size - head - 1
  val indices : Range
    get() => 0..<(items.size - head)
  fun isEmpty() : bool => items.size == head
  fun isNotEmpty() : bool => items.size != head

  fun addLast(item : T) {
    items.add(item)
  }

  fun add(item : T) : bool {
    items.add(item)
    return true
  }

  fun addAll(from : any) : bool {
    return items.addAll(from)
  }

  fun addFirst(item : T) {
    if (head == 0) {
      // No room in front: make as much as the deque holds, so that it is seldom done.
      val room = items.size > 8 ? items.size : 8
      val grown : open List<T?> = List(room) { null }
      grown.addAll(items)
      items = grown
      head = room
    }
    head -= 1
    items[head] = item
  }

  fun removeFirst() : T {
    if (items.size == head) { throw Error("removeFirst() from an empty deque") }
    val item = items[head]
    items[head] = null
    head += 1
    tidy()
    return item as T
  }

  fun removeLast() : T {
    if (items.size == head) { throw Error("removeLast() from an empty deque") }
    val item = items.removeLast()
    tidy()
    return item as T
  }

  fun removeFirstOrNull() : T? => items.size == head ? null : removeFirst()
  fun removeLastOrNull() : T? => items.size == head ? null : removeLast()

  // Gives back the room in front once it is most of the list.
  private fun tidy() {
    if (head == items.size) {
      items.clear()
      head = 0
    } else if (head > 32 and head * 4 > items.size * 3) {
      items = items[head..]
      head = 0
    }
  }

  fun first() : T {
    if (items.size == head) { throw Error("first() of an empty deque") }
    return items[head] as T
  }

  fun last() : T {
    if (items.size == head) { throw Error("last() of an empty deque") }
    return items[items.size - 1] as T
  }

  fun firstOrNull() : T? => items.size == head ? null : items[head]
  fun lastOrNull() : T? => items.size == head ? null : items[items.size - 1]

  // deque[0] is the front.
  fun get(index : int) : T {
    if (index < 0 or index >= items.size - head) {
      throw Error("get: index $index is out of range (size ${items.size - head})")
    }
    return items[head + index] as T
  }

  fun getOrNull(index : int) : T? => index >= 0 and index < items.size - head ? items[head + index] : null

  fun set(index : int, item : T) {
    if (index < 0 or index >= items.size - head) {
      throw Error("set: index $index is out of range (size ${items.size - head})")
    }
    items[head + index] = item
  }

  op [](index : int) : T => get(index)
  op []=(index : int, item : T) { set(index, item) }

  fun indexOf(item : T) : int {
    for index in head..<items.size {
      if (items[index] == item) { return index - head }
    }
    return -1
  }

  fun contains(item : T) : bool => indexOf(item) >= 0

  // Takes out the first item equal to this one. True if there was one.
  fun remove(item : T) : bool {
    val index = indexOf(item)
    if (index < 0) { return false }
    items.removeAt(head + index)
    tidy()
    return true
  }

  fun removeAt(index : int) : T {
    val item = get(index)
    items.removeAt(head + index)
    tidy()
    return item
  }

  fun clear() {
    items.clear()
    head = 0
  }

  // A for loop goes through the items as they were when it began, front to back.
  fun iterator() : List<T> => toList()
  // A list of T made of them: the items are kept as T? (what is before `head` is null), and a
  // List<T?> is no List<T> (M6.6).
  fun toList() : open List<T> {
    val out : open List<T> = []
    for (i in head ..< items.size) { out.add(items[i] as T) }
    return out
  }
  fun toOpenList() : open List<T> => toList()

  fun forEach(action : (T) -> unit) { toList().forEach(action) }
  fun <R> map(transform : (T) -> R) : open List<R> => toList().map(transform)
  fun filter(predicate : (T) -> bool) : open List<T> => toList().filter(predicate)
  fun any() : bool => items.size != head
  fun any(predicate : (T) -> bool) : bool => toList().any(predicate)
  fun all(predicate : (T) -> bool) : bool => toList().all(predicate)
  fun none() : bool => items.size == head
  fun none(predicate : (T) -> bool) : bool => toList().none(predicate)
  fun count() : int => items.size - head
  fun count(predicate : (T) -> bool) : int => toList().count(predicate)
  fun find(predicate : (T) -> bool) : T? => toList().firstOrNull(predicate)
  fun reversed() : open List<T> => toList().reversed()

  fun join(separator : string = ", ", prefix : string = "", postfix : string = "", limit : int = -1,
           truncated : string = "...", transform : ((T) -> any?)? = null) : string {
    return toList().join(separator, prefix, postfix, limit, truncated, transform)
  }

  op ==(other : any?) : bool => other is Deque and other.toList() == toList()
  fun hashCode() : int => toList().hashCode()

  // As a list shows itself: [1, 2, 3]
  fun toString() : string => "${items[head..]}"
}
