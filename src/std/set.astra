// ---- Sets and deques ----

// A collection that holds each value once, in the order the values were first added. Two
// values are the same one if they are ==, as for the keys of a map: a number, a string, a
// list or a data object by what it holds, any other object by being itself.
//
//   val seen = Set<string>()        setOf(1, 2, 3)        [1, 2, 2].toSet()
class Set<T> {
  private val items : Map<T, bool> = {:}

  // From anything a for loop takes: a list, a range, another set.
  fun init(from : any? = null) {
    if (from != null) {
      for item in from { items[item as T] = true }
    }
  }

  get size() : int => items.size
  get length() : int => items.size
  fun isEmpty() : bool => items.size == 0
  fun isNotEmpty() : bool => items.size != 0

  // `item in set` asks this.
  fun contains(item : T) : bool => items.has(item)

  fun containsAll(from : List<T>) : bool {
    for item in from {
      if (!items.has(item)) { return false }
    }
    return true
  }

  fun containsAll(from : Set<T>) : bool => containsAll(from.toList())

  // True if the item was not there before.
  fun add(item : T) : bool {
    if (items.has(item)) { return false }
    items[item] = true
    return true
  }

  fun addAll(from : any) : bool {
    val before = items.size
    for item in from { items[item as T] = true }
    return items.size != before
  }

  // True if the item was there.
  fun remove(item : T) : bool => items.remove(item) != null

  // removeAll and retainAll take a condition or a collection. True if anything went.
  fun removeAll(predicate : (T) -> bool) : bool {
    val before = items.size
    for item in items.keys {
      if (predicate(item)) { items.remove(item) }
    }
    return items.size != before
  }

  fun removeAll(from : List<T>) : bool => removeAll { from.contains(it) }
  fun removeAll(from : Set<T>) : bool => removeAll { from.contains(it) }

  fun retainAll(predicate : (T) -> bool) : bool => removeAll { !predicate(it) }
  fun retainAll(from : List<T>) : bool => removeAll { !from.contains(it) }
  fun retainAll(from : Set<T>) : bool => removeAll { !from.contains(it) }

  fun removeIf(predicate : (T) -> bool) : bool => removeAll(predicate)

  fun clear() {
    items.clear()
  }

  // A for loop goes through the items as they were when it began.
  fun iterator() : List<T> => items.keys
  fun toList() : List<T> => items.keys
  fun toMutableList() : List<T> => items.keys
  fun toSet() : Set<T> => Set(this)
  fun toMutableSet() : Set<T> => Set(this)

  // The sets made of both, of what is in both, and of what is only in this one.
  fun union(other : any) : Set<T> {
    val out : Set<T> = Set(this)
    out.addAll(other)
    return out
  }

  fun intersect(other : any) : Set<T> {
    val out : Set<T> = Set()
    for item in other {
      if (items.has(item as T)) { out.add(item as T) }
    }
    return out
  }

  fun subtract(other : any) : Set<T> {
    val out : Set<T> = Set(this)
    for item in other { out.remove(item as T) }
    return out
  }

  // set + item, set + collection, and the same with -, each giving a new set.
  op +(item : T) : Set<T> {
    val out : Set<T> = Set(this)
    out.add(item)
    return out
  }

  op +(other : List<T>) : Set<T> => union(other)
  op +(other : Set<T>) : Set<T> => union(other)
  op +(other : Range) : Set<T> => union(other)

  op -(item : T) : Set<T> {
    val out : Set<T> = Set(this)
    out.remove(item)
    return out
  }

  op -(other : List<T>) : Set<T> => subtract(other)
  op -(other : Set<T>) : Set<T> => subtract(other)
  op -(other : Range) : Set<T> => subtract(other)

  fun plus(item : T) : Set<T> => this + item
  fun plus(other : List<T>) : Set<T> => this + other
  fun plus(other : Set<T>) : Set<T> => this + other
  fun minus(item : T) : Set<T> => this - item
  fun minus(other : List<T>) : Set<T> => this - other
  fun minus(other : Set<T>) : Set<T> => this - other

  // Two sets are equal if they hold the same items, whatever the order.
  op ==(other : any?) : bool => other is Set and other.size == items.size and containsAll(other.toList() as List<T>)

  fun first() : T {
    if (items.size == 0) { throw Error("first() of an empty set") }
    return items.keys[0]
  }

  fun last() : T {
    if (items.size == 0) { throw Error("last() of an empty set") }
    return items.keys[items.size - 1]
  }

  // What a list has for reading: each works on the items in order, and those that make a
  // collection make a list.
  fun firstOrNull() : T? => items.keys.firstOrNull()
  fun firstOrNull(predicate : (T) -> bool) : T? => items.keys.firstOrNull(predicate)
  fun lastOrNull() : T? => items.keys.lastOrNull()
  fun lastOrNull(predicate : (T) -> bool) : T? => items.keys.lastOrNull(predicate)
  fun find(predicate : (T) -> bool) : T? => items.keys.firstOrNull(predicate)
  fun single() : T => items.keys.single()
  fun singleOrNull() : T? => items.keys.singleOrNull()
  fun forEach(action : (T) -> unit) { items.keys.forEach(action) }
  fun <R> map(transform : (T) -> R) : List<R> => items.keys.map(transform)
  fun <R> mapNotNull(transform : (T) -> R?) : List<R> => items.keys.mapNotNull(transform)
  fun <R> flatMap(transform : (T) -> List<R>) : List<R> => items.keys.flatMap(transform)
  fun filter(predicate : (T) -> bool) : List<T> => items.keys.filter(predicate)
  fun filterNot(predicate : (T) -> bool) : List<T> => items.keys.filterNot(predicate)
  fun any() : bool => items.size > 0
  fun any(predicate : (T) -> bool) : bool => items.keys.any(predicate)
  fun all(predicate : (T) -> bool) : bool => items.keys.all(predicate)
  fun none() : bool => items.size == 0
  fun none(predicate : (T) -> bool) : bool => items.keys.none(predicate)
  fun count() : int => items.size
  fun count(predicate : (T) -> bool) : int => items.keys.count(predicate)
  fun <R> fold(initial : R, operation : (R, T) -> R) : R => items.keys.fold(initial, operation)
  fun sum() : any? => (items.keys as List<Number>).sum()
  fun <R : Number> sumOf(selector : (T) -> R) : R => items.keys.sumOf(selector)
  fun maxOrNull() : T? => items.keys.maxOrNull()
  fun minOrNull() : T? => items.keys.minOrNull()
  fun <R> maxOf(selector : (T) -> R) : R => items.keys.maxOf(selector)
  fun <R> minOf(selector : (T) -> R) : R => items.keys.minOf(selector)
  fun maxByOrNull(selector : (T) -> any?) : T? => items.keys.maxByOrNull(selector)
  fun minByOrNull(selector : (T) -> any?) : T? => items.keys.minByOrNull(selector)
  fun sorted() : List<T> => items.keys.sorted()
  fun sortedDescending() : List<T> => items.keys.sortedDescending()
  fun sortedBy(selector : (T) -> any?) : List<T> => items.keys.sortedBy(selector)
  fun sortedByDescending(selector : (T) -> any?) : List<T> => items.keys.sortedByDescending(selector)
  fun sortedWith(comparator : (T, T) -> int) : List<T> => items.keys.sortedWith(comparator)
  fun <V> associateWith(valueSelector : (T) -> V) : Map<T, V> => items.keys.associateWith(valueSelector)
  fun <K> associateBy(keySelector : (T) -> K) : Map<K, T> => items.keys.associateBy(keySelector)
  fun <K> groupBy(keySelector : (T) -> K) : Map<K, List<T>> => items.keys.groupBy(keySelector)
  fun partition(predicate : (T) -> bool) : Pair<List<T>, List<T>> => items.keys.partition(predicate)

  fun joinToString(separator : string = ", ", prefix : string = "", postfix : string = "", limit : int = -1,
                   truncated : string = "...", transform : ((T) -> any?)? = null) : string {
    return items.keys.joinToString(separator, prefix, postfix, limit, truncated, transform)
  }

  // {1, 2, 3}, with each item as a list shows it.
  fun toString() : string {
    val text = str(items.keys)
    return "{" + text.substring(1, text.size - 1) + "}"
  }
}

// A queue open at both ends: adding and removing are quick at the front as well as the back,
// where a list is quick only at the back.
//
//   val queue = Deque<Job>()        queue.addLast(job)        val next = queue.removeFirst()
class Deque<T> {
  // The items are items[head ..< items.size]; what is before `head` has been taken from the
  // front, or is room made for adding there.
  private var items : List<T?> = []
  private var head = 0

  fun init(from : any? = null) {
    if (from != null) { items.addAll(from) }
  }

  get size() : int => items.size - head
  get length() : int => items.size - head
  get lastIndex() : int => items.size - head - 1
  get indices() : Range => 0..<(items.size - head)
  fun isEmpty() : bool => items.size == head
  fun isNotEmpty() : bool => items.size != head

  fun addLast(item : T) {
    items.add(item)
  }

  fun add(item : T) : bool {
    items.add(item)
    return true
  }

  fun addAll(from : any) : bool {
    return items.addAll(from)
  }

  fun addFirst(item : T) {
    if (head == 0) {
      // No room in front: make as much as the deque holds, so that it is seldom done.
      val room = items.size > 8 ? items.size : 8
      val grown : List<T?> = List(room) { null }
      grown.addAll(items)
      items = grown
      head = room
    }
    head -= 1
    items[head] = item
  }

  fun removeFirst() : T {
    if (items.size == head) { throw Error("removeFirst() from an empty deque") }
    val item = items[head]
    items[head] = null
    head += 1
    tidy()
    return item as T
  }

  fun removeLast() : T {
    if (items.size == head) { throw Error("removeLast() from an empty deque") }
    val item = items.removeLast()
    tidy()
    return item as T
  }

  fun removeFirstOrNull() : T? => items.size == head ? null : removeFirst()
  fun removeLastOrNull() : T? => items.size == head ? null : removeLast()

  // Gives back the room in front once it is most of the list.
  private fun tidy() {
    if (head == items.size) {
      items.clear()
      head = 0
    } else if (head > 32 and head * 4 > items.size * 3) {
      items = items.slice(head)
      head = 0
    }
  }

  fun first() : T {
    if (items.size == head) { throw Error("first() of an empty deque") }
    return items[head] as T
  }

  fun last() : T {
    if (items.size == head) { throw Error("last() of an empty deque") }
    return items[items.size - 1] as T
  }

  fun firstOrNull() : T? => items.size == head ? null : items[head]
  fun lastOrNull() : T? => items.size == head ? null : items[items.size - 1]

  // deque[0] is the front.
  fun get(index : int) : T {
    if (index < 0 or index >= items.size - head) {
      throw Error("get: index " + str(index) + " is out of range (size " + str(items.size - head) + ")")
    }
    return items[head + index] as T
  }

  fun getOrNull(index : int) : T? => index >= 0 and index < items.size - head ? items[head + index] : null

  fun set(index : int, item : T) {
    if (index < 0 or index >= items.size - head) {
      throw Error("set: index " + str(index) + " is out of range (size " + str(items.size - head) + ")")
    }
    items[head + index] = item
  }

  op [](index : int) : T => get(index)
  op []=(index : int, item : T) { set(index, item) }

  fun indexOf(item : T) : int {
    for index in head..<items.size {
      if (items[index] == item) { return index - head }
    }
    return -1
  }

  fun contains(item : T) : bool => indexOf(item) >= 0

  // Takes out the first item equal to this one. True if there was one.
  fun remove(item : T) : bool {
    val index = indexOf(item)
    if (index < 0) { return false }
    items.removeAt(head + index)
    tidy()
    return true
  }

  fun removeAt(index : int) : T {
    val item = get(index)
    items.removeAt(head + index)
    tidy()
    return item
  }

  fun clear() {
    items.clear()
    head = 0
  }

  // A for loop goes through the items as they were when it began, front to back.
  fun iterator() : List<T> => toList()
  fun toList() : List<T> => items.slice(head) as List<T>
  fun toMutableList() : List<T> => toList()

  fun forEach(action : (T) -> unit) { toList().forEach(action) }
  fun <R> map(transform : (T) -> R) : List<R> => toList().map(transform)
  fun filter(predicate : (T) -> bool) : List<T> => toList().filter(predicate)
  fun any() : bool => items.size != head
  fun any(predicate : (T) -> bool) : bool => toList().any(predicate)
  fun all(predicate : (T) -> bool) : bool => toList().all(predicate)
  fun none() : bool => items.size == head
  fun none(predicate : (T) -> bool) : bool => toList().none(predicate)
  fun count() : int => items.size - head
  fun count(predicate : (T) -> bool) : int => toList().count(predicate)
  fun find(predicate : (T) -> bool) : T? => toList().firstOrNull(predicate)
  fun reversed() : List<T> => toList().reversed()

  fun joinToString(separator : string = ", ", prefix : string = "", postfix : string = "", limit : int = -1,
                   truncated : string = "...", transform : ((T) -> any?)? = null) : string {
    return toList().joinToString(separator, prefix, postfix, limit, truncated, transform)
  }

  op ==(other : any?) : bool => other is Deque and other.toList() == toList()

  // As a list shows itself: [1, 2, 3]
  fun toString() : string => str(items.slice(head))
}
