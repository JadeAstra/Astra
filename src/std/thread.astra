// ---- Threads ----
// Threads share everything: a variable or an object is the same one on every thread. One
// thread runs Astra code at a time, and they change places at calls and at the ends of loop
// bodies, so anything longer than that which must not be interrupted takes a lock.
// The names are Java's and Kotlin's. The work is done by the built-in __thread (threads.cpp).

// What a time limit is counted in. A limit is a number and one of these; with no unit it is
// milliseconds: future.get(2, TimeUnit.seconds)
object TimeUnit {
  const nanoseconds = 0.000001
  const microseconds = 0.001
  const milliseconds = 1
  const seconds = 1000
  const minutes = 60000
  const hours = 3600000
  const days = 86400000

  // A limit in milliseconds, or null for none.
  fun toMillis(amount : Number?, unit : Number? = null) : Number? => amount == null ? null : (unit == null ? amount : amount * unit)
}

// A thread of execution. Thread { ... } makes one that will run the lambda, start() sets it
// going, and join() waits for it to finish:
//
//   val worker = Thread({ load(file) }, "loader")
//   worker.isDaemon = true        // a daemon does not keep the program alive
//   worker.start()
//
// A program ends when its script has finished, every thread that is not a daemon has too,
// and the event loop has nothing left.
class Thread {
  static {
    var made = 0
    fun currentThread() : Thread {
      var current : Thread? = __thread.current()
      if (current == null) {
        // The main thread, which no program made.
        val main = Thread(null, __thread.currentName())
        main.id = __thread.currentId()
        __thread.setCurrent(main)
        return main
      }
      return current
    }
    fun sleep(millis : Number) {
      if (!__thread.sleep(millis)) { throw InterruptedException() }
    }
    // Whether the running thread has been interrupted. Asking clears the mark.
    fun interrupted() : bool => __thread.interrupted()
    // Lets another thread run, if one is waiting to.
    fun yield() {
      __thread.yield()
    }
  }

  var name : string = ""
  var isDaemon = false
  private var task : (() -> any?)? = null
  private var id = 0      // 0 until it is started

  // Thread(task), Thread(task, name) or Thread(name) { task }.
  fun init(task : any? = null, name : any? = null) {
    // A lambda after the call lands on the last parameter: tell the two apart by what they are.
    val swapped = task is string or (name != null and !(name is string))
    this.task = (swapped ? name : task) as (() -> any?)?
    val named = swapped ? task : name
    Thread.made += 1
    this.name = named == null ? "Thread-${Thread.made}" : "$named"
  }

  // What the thread does. A class that extends Thread can replace this instead of being
  // given a function.
  fun run() {
    val work = task
    if (work != null) { work() }
  }

  fun start() : Thread {
    if (id != 0) { throw IllegalStateException("thread '$name' has already been started") }
    val self = this
    id = __thread.start({ self.run() }, this, name, isDaemon)
    return this
  }

  // Waits for the thread to finish, for `millis` at most if that is given.
  fun join(millis : Number? = null) {
    if (id != 0 and __thread.join(id, millis) == 2) { throw InterruptedException() }
  }

  val isAlive : bool
    get() => id != 0 and __thread.isAlive(id)

  // Marks the thread as interrupted, and wakes it if it is waiting: the wait then throws
  // InterruptedException. A thread that is working sees the mark only by asking for it.
  fun interrupt() {
    if (id != 0) { __thread.interrupt(id) }
  }

  val isInterrupted : bool
    get() => id != 0 and __thread.isInterrupted(id)

  override fun toString() : string => "Thread($name)"

  // -- The thread that is running --

}

// Makes a thread for the lambda and starts it, as Kotlin's thread { ... } does.
fun thread(start : bool = true, isDaemon : bool = false, name : string? = null, block : suspend () -> any?) : Thread {
  val made = Thread(block, name)
  made.isDaemon = isDaemon
  if (start) { made.start() }
  return made
}

// ---- Locks ----

// Runs the block while holding `lock`, which may be any object: no other thread is inside a
// synchronized on the same object at the same time. A thread may take a lock it already holds.
inline fun <T> synchronized(lock : any, block : () -> T) : T {
  __thread.enter(lock)
  try {
    return block()
  } finally {
    __thread.exit(lock)
  }
}

// A lock as an object of its own, with a way to wait on it for something to change:
//
//   lock.withLock {
//     while (queue.isEmpty()) { lock.wait() }     // lets go of the lock while it waits
//     ...
//   }
//
// and in the thread that changes it:   lock.withLock { queue.add(x); lock.notifyAll() }
class Lock {
  fun lock() {
    __thread.enter(this)
  }

  fun unlock() {
    __thread.exit(this)
  }

  // Takes the lock if no other thread has it; false if one has.
  fun tryLock() : bool => __thread.tryEnter(this)

  val isHeldByCurrentThread : bool
    get() => __thread.holds(this)

  inline fun <T> withLock(block : () -> T) : T {
    __thread.enter(this)
    try {
      return block()
    } finally {
      __thread.exit(this)
    }
  }

  // Gives the lock up and waits for notify(), then takes it again; with `millis`, for that
  // long at most. True if it was notified, false if the time ran out. It can also return
  // early for no reason, so the condition waited for is checked again in a loop.
  fun wait(millis : Number? = null) : bool {
    val status = __thread.wait(this, millis)
    if (status == 2) { throw InterruptedException() }
    return status == 0
  }

  // Wakes one thread that is waiting on this lock, or all of them.
  fun notify() {
    __thread.notify(this)
  }

  fun notifyAll() {
    __thread.notifyAll(this)
  }
}

class ReentrantLock : Lock

// ---- Values shared between threads ----
// Each method here is done in one piece: no other thread sees it half done.

class AtomicInteger(private var held : int = 0) {
  fun get() : int => held
  fun set(value : int) { held = value }
  var value : int
    get() => held
    set(newValue) { held = newValue }
  fun incrementAndGet() : int { held += 1; return held }
  fun decrementAndGet() : int { held -= 1; return held }
  fun getAndIncrement() : int { val before = held; held += 1; return before }
  fun getAndDecrement() : int { val before = held; held -= 1; return before }
  fun addAndGet(delta : int) : int { held += delta; return held }
  fun getAndAdd(delta : int) : int { val before = held; held += delta; return before }
  fun getAndSet(value : int) : int { val before = held; held = value; return before }
  fun compareAndSet(expected : int, value : int) : bool {
    if (held === expected) { held = value; return true }
    return false
  }
  override fun toString() : string => "$held"
}

class AtomicLong(initial : int = 0) : AtomicInteger(initial)

class AtomicBoolean(private var held : bool = false) {
  fun get() : bool => held
  fun set(value : bool) { held = value }
  var value : bool
    get() => held
    set(newValue) { held = newValue }
  fun getAndSet(value : bool) : bool { val before = held; held = value; return before }
  fun compareAndSet(expected : bool, value : bool) : bool {
    if (held === expected) { held = value; return true }
    return false
  }
  override fun toString() : string => "$held"
}

class AtomicReference<T>(private var held : T? = null) {
  fun get() : T? => held
  fun set(value : T?) { held = value }
  var value : T?
    get() => held
    set(newValue) { held = newValue }
  fun getAndSet(value : T?) : T? { val before = held; held = value; return before }
  // Compares by identity: the very object that is expected.
  fun compareAndSet(expected : T?, value : T?) : bool {
    if (held === expected) { held = value; return true }
    return false
  }
  override fun toString() : string => "$held"
}

// ---- A queue that threads hand things over on ----

// take() waits for an item if there is none, and with a capacity put() waits for room.
//
//   val jobs = BlockingQueue<Job>()
//   thread { while (true) { run(jobs.take()) } }
//   jobs.put(job)
class BlockingQueue<T> {
  private val items : Deque<T> = Deque()
  private val lock = Lock()
  private var capacity : int?

  fun init(capacity : int? = null) {
    this.capacity = capacity
  }

  val size : int
    get() => items.size
  fun isEmpty() : bool => items.isEmpty()
  fun isNotEmpty() : bool => items.isNotEmpty()

  // Whether there is no room for one more.
  private fun full() : bool {
    val most = capacity
    return most != null and items.size >= most
  }

  // Adds an item at the back, waiting while the queue is full.
  fun put(item : T) {
    __thread.enter(lock)
    try {
      while (full()) { lock.wait() }
      items.addLast(item)
      lock.notifyAll()
    } finally {
      __thread.exit(lock)
    }
  }

  // Adds an item if there is room, without waiting. False if there was none.
  fun offer(item : T) : bool {
    __thread.enter(lock)
    try {
      if (full()) { return false }
      items.addLast(item)
      lock.notifyAll()
      return true
    } finally {
      __thread.exit(lock)
    }
  }

  fun add(item : T) : bool {
    if (!offer(item)) { throw IllegalStateException("the queue is full") }
    return true
  }

  // Takes the item at the front, waiting until there is one.
  fun take() : T {
    __thread.enter(lock)
    try {
      while (items.isEmpty()) { lock.wait() }
      val item = items.removeFirst()
      lock.notifyAll()
      return item
    } finally {
      __thread.exit(lock)
    }
  }

  // Takes the item at the front, waiting for it up to the time given; null if none came.
  fun poll(timeout : Number = 0, unit : Number? = null) : T? {
    val limit = clock() + (TimeUnit.toMillis(timeout, unit) as Number) / 1000.0
    __thread.enter(lock)
    try {
      while (items.isEmpty()) {
        val left = (limit - clock()) * 1000
        if (left <= 0) { return null }
        lock.wait(left)
      }
      val item = items.removeFirst()
      lock.notifyAll()
      return item
    } finally {
      __thread.exit(lock)
    }
  }

  // The item at the front without taking it; null if there is none.
  fun peek() : T? => items.firstOrNull()

  fun clear() {
    __thread.enter(lock)
    try {
      items.clear()
      lock.notifyAll()
    } finally {
      __thread.exit(lock)
    }
  }

  fun toList() : open List<T> => items.toList()
  override fun toString() : string => "${items.toList()}"
}

// ---- Waiting for other threads ----

// Opens once countDown() has been called `count` times; await() waits for that.
class CountDownLatch(private var remaining : int) {
  private val lock = Lock()

  val count : int
    get() => remaining

  fun countDown() {
    __thread.enter(lock)
    try {
      if (remaining > 0) { remaining -= 1 }
      if (remaining == 0) { lock.notifyAll() }
    } finally {
      __thread.exit(lock)
    }
  }

  // Waits until the count reaches zero. With a time limit, false if it ran out first.
  fun await() : bool {
    __thread.enter(lock)
    try {
      while (remaining > 0) { lock.wait() }
      return true
    } finally {
      __thread.exit(lock)
    }
  }

  fun await(timeout : Number, unit : Number? = null) : bool {
    val limit = clock() + (TimeUnit.toMillis(timeout, unit) as Number) / 1000.0
    __thread.enter(lock)
    try {
      while (remaining > 0) {
        val left = (limit - clock()) * 1000
        if (left <= 0) { return false }
        lock.wait(left)
      }
      return true
    } finally {
      __thread.exit(lock)
    }
  }
}

// A result that is not there yet. A task handed to an executor gives one; a thread can also
// make one itself and complete() it when the answer arrives.
//
//   val answer = executor.submit { compute() }
//   answer.get(2, TimeUnit.seconds)       // waits; TimeoutException if it takes longer
class Future<T> {
  private val lock = Lock()
  private var state = 0       // 0 not done, 1 has a value, 2 failed, 3 cancelled
  private var held : any? = null
  private val listeners : open List<(T?, Throwable?) -> unit> = []
  var runner : Thread? = null  // the thread working on it, which cancel(true) interrupts

  val isDone : bool
    get() => state != 0
  val isCancelled : bool
    get() => state == 3
  val isCompletedExceptionally : bool
    get() => state >= 2

  private fun finish(newState : int, value : any?) : bool {
    var waiting : open List<(T?, Throwable?) -> unit> = []
    __thread.enter(lock)
    try {
      if (state != 0) { return false }
      state = newState
      held = value
      waiting = listeners.toList()
      listeners.clear()
      lock.notifyAll()
    } finally {
      __thread.exit(lock)
    }
    for listener in waiting { listener(newState == 1 ? value as T : null, newState == 1 ? null : failure()) }
    return true
  }

  private fun failure() : Throwable => state == 3 ? CancellationException() : held as Throwable

  // Each gives true if this is what finished it, false if it was finished already.
  fun complete(value : T) : bool => finish(1, value)
  fun completeExceptionally(error : Throwable) : bool => finish(2, error)

  // With true, the thread working on the task is interrupted as well.
  fun cancel(mayInterruptIfRunning : bool = false) : bool {
    val worker = runner
    if (!finish(3, null)) { return false }
    if (mayInterruptIfRunning and worker != null) { worker.interrupt() }
    return true
  }

  // Waits for the result and gives it. Throws ExecutionException if the task failed,
  // CancellationException if it was cancelled, and TimeoutException if a time limit ran out.
  fun get() : T throws ExecutionException {
    __thread.enter(lock)
    try {
      while (state == 0) { lock.wait() }
    } finally {
      __thread.exit(lock)
    }
    return outcome()
  }

  fun get(timeout : Number, unit : Number? = null) : T throws ExecutionException | TimeoutException {
    val limit = clock() + (TimeUnit.toMillis(timeout, unit) as Number) / 1000.0
    __thread.enter(lock)
    try {
      while (state == 0) {
        val left = (limit - clock()) * 1000
        if (left <= 0) { throw TimeoutException() }
        lock.wait(left)
      }
    } finally {
      __thread.exit(lock)
    }
    return outcome()
  }

  private fun outcome() : T {
    if (state == 2) { throw ExecutionException(held as Throwable) }
    if (state == 3) { throw CancellationException() }
    return held as T
  }

  // The result if it is there, and otherwise the value given.
  fun getNow(valueIfAbsent : T? = null) : T? => state == 1 ? held as T : valueIfAbsent

  // Calls action(value, error) when the future is done, with one of the two null: at once if
  // it already is, and otherwise on the thread that finishes it.
  fun whenComplete(action : (T?, Throwable?) -> unit) : Future<T> {
    var done = false
    __thread.enter(lock)
    try {
      done = state != 0
      if (!done) { listeners.add(action) }
    } finally {
      __thread.exit(lock)
    }
    if (done) { action(state == 1 ? held as T : null, state == 1 ? null : failure()) }
    return this
  }

  // In a flow: sets the flow aside until the future is done, and gives its value or throws
  // what the task threw. The flow goes on from the event loop.
  suspend fun await() : T {
    if (state == 0) {
      // The event loop is told that something is on its way, so that it waits for it.
      __loop.hold()
      return suspendCoroutine { continuation ->
        whenComplete { value, error ->
          EventLoop.post {
            __loop.release()
            if (error == null) { continuation.resume(value) } else { continuation.resumeWithException(error) }
          }
        }
      } as T
    }
    if (state == 1) { return held as T }
    __rethrow(failure())  // as the task threw it, checked where it was
  }

  static {
    // Runs `supplier` on a thread of its own and gives a future for what it returns.
    fun <T> supplyAsync(supplier : suspend () -> T) : Future<T> {
      val result = Future<T>()
      // The thread may wait for what the supplier waits for.
      val body : suspend () -> unit = {
        try {
          result.complete(supplier())
        } catch (e) {
          result.completeExceptionally(e)
        }
      }
      val worker = Thread(body, "async")
      worker.isDaemon = true
      result.runner = worker
      worker.start()
      return result
    }
  }
}

// ---- Executors ----

// Threads that take tasks from a queue. submit() gives a Future for the task's result.
//
//   val pool = Executors.newFixedThreadPool(4)
//   val total = pool.submit { sum(numbers) }
//   print(total.get())
//   pool.shutdown()          // its threads keep the program alive until then
class Executor {
  static {
    var made = 0
  }

  // Each job is a task and the future for it; null tells a thread to end.
  private val queue : BlockingQueue<List<any?>?> = BlockingQueue()
  private val workers : open List<Thread> = []
  private val lock = Lock()
  private var limit : int?                                  // how many threads at most; null for as many as are needed
  private var threadFactory : ((() -> unit) -> Thread)?     // makes a Thread for a function; null for a plain one
  private var number = 0
  private var idle = 0
  private var stopped = false

  fun init(threads : int? = 1, threadFactory : ((() -> unit) -> Thread)? = null) {
    this.limit = threads
    this.threadFactory = threadFactory
    Executor.made += 1
    this.number = Executor.made
  }

  // Runs the task on one of the executor's threads. The future gives what it returns.
  fun <T> submit(task : suspend () -> T) : Future<T> {
    val future = Future<T>()
    __thread.enter(lock)
    try {
      if (stopped) { throw IllegalStateException("the executor has been shut down") }
      queue.put([task, future])
      // One more thread, if every one there is busy and more are allowed.
      val most = limit
      if (idle == 0 and (most == null or workers.size < most)) { addWorker() }
    } finally {
      __thread.exit(lock)
    }
    return future
  }

  fun execute(task : suspend () -> any?) {
    submit(task)
  }

  private fun addWorker() {
    val self = this
    val body = { self.work() }
    val factory = threadFactory
    val worker = factory == null ? Thread(body, "pool-$number-thread-${workers.size + 1}") : factory(body)
    workers.add(worker)
    worker.start()
  }

  // What each of its threads does: take a task, run it, give the future its result.
  private fun work() {
    val me = Thread.currentThread()
    while (true) {
      var job : List<any?>? = null
      __thread.enter(lock)
      idle += 1
      __thread.exit(lock)
      try {
        // A thread of a pool without a limit gives up after a minute with nothing to do.
        job = limit == null ? queue.poll(60000) : queue.take()
      } catch (e : InterruptedException) {
        job = null
      } finally {
        __thread.enter(lock)
        idle -= 1
        __thread.exit(lock)
      }
      if (job == null) { break }

      val task = job[0] as () -> any?
      val future = job[1] as Future<any?>
      if (future.isDone) { continue }
      future.runner = me
      try {
        future.complete(task())
      } catch (e) {
        future.completeExceptionally(e)
      }
      future.runner = null
      Thread.interrupted()      // an interrupt meant for that task is not for the next one
    }
    __thread.enter(lock)
    workers.remove(me)
    lock.notifyAll()
    __thread.exit(lock)
  }

  // No more tasks are taken; those already handed in are still run, and then the threads end.
  fun shutdown() {
    __thread.enter(lock)
    try {
      if (stopped) { return }
      stopped = true
      for worker in workers { queue.put(null) }
    } finally {
      __thread.exit(lock)
    }
  }

  // Stops now: the tasks still waiting are not run (they are returned), and the threads are
  // interrupted, which a task notices if it is waiting or asks.
  fun shutdownNow() : open List<() -> any?> {
    val waiting : open List<() -> any?> = []
    __thread.enter(lock)
    try {
      stopped = true
      while (queue.isNotEmpty()) {
        val job = queue.poll()
        if (job != null) {
          (job[1] as Future<any?>).cancel()
          waiting.add(job[0] as () -> any?)
        }
      }
      for worker in workers {
        queue.put(null)
        worker.interrupt()
      }
    } finally {
      __thread.exit(lock)
    }
    return waiting
  }

  val isShutdown : bool
    get() => stopped
  val isTerminated : bool
    get() => stopped and workers.isEmpty()

  // Waits for its threads to end after a shutdown. False if the time ran out first.
  fun awaitTermination() : bool {
    __thread.enter(lock)
    try {
      while (workers.isNotEmpty()) { lock.wait() }
      return true
    } finally {
      __thread.exit(lock)
    }
  }

  fun awaitTermination(timeout : Number, unit : Number? = null) : bool {
    val limitAt = clock() + (TimeUnit.toMillis(timeout, unit) as Number) / 1000.0
    __thread.enter(lock)
    try {
      while (workers.isNotEmpty()) {
        val left = (limitAt - clock()) * 1000
        if (left <= 0) { return false }
        lock.wait(left)
      }
      return true
    } finally {
      __thread.exit(lock)
    }
  }
}

// Java's ways of making an executor. `threadFactory` is a function that takes what the thread
// is to run and gives the Thread for it, not yet started:
//   Executors.newSingleThreadExecutor { work -> Thread(work, "saver").apply { isDaemon = true } }
object Executors {
  fun newSingleThreadExecutor(threadFactory : ((() -> unit) -> Thread)? = null) : Executor => Executor(1, threadFactory)
  fun newFixedThreadPool(threads : int, threadFactory : ((() -> unit) -> Thread)? = null) : Executor => Executor(threads, threadFactory)
  fun newCachedThreadPool(threadFactory : ((() -> unit) -> Thread)? = null) : Executor => Executor(null, threadFactory)
}
