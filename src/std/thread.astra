// ---- Threads (D117) ----
// Threads share everything: a variable or an object is the same one on every thread. One
// thread runs Astra code at a time, and they change places at calls and at the ends of loop
// bodies, so anything longer than that which must not be interrupted holds a Lock's key. They
// are for blocking work and ported code; workers and parallel sections use the cores.
//
//   val loading = thread(name = "loader") { load(file) }    // a Job of what the block gives
//   loading.then { shown = it }                              // on the event loop, when it is done
//
// A program ends when its script has finished, every thread that is not a daemon has too, and
// the event loop has nothing left.

// Inside Astra: the work is done by the built-in __thread (threads.cpp).

// A thread of its own, running `task` or, in a class that extends Thread, its own run(), once
// start() is called. thread { } is the shorter way, giving a Job of what the block returns.
class Thread {
  static {
    // How many threads have been given no name of their own: the number in the name Thread-N of
    // the last. The main thread, and one given a name, are not counted.
    var made = 0
    // The thread running this code. On the main thread, a Thread named "main", made the first time
    // it is asked for.
    fun currentThread() : Thread {
      var current : Thread? = __thread.current()
      if (current == null) {
        // The main thread, which no program made.
        val main = Thread(null, __thread.currentName())
        main.id = __thread.currentId()
        __thread.setCurrent(main)
        return main
      }
      return current
    }
    // Waits for the time given: InterruptedException if the thread is interrupted meanwhile.
    suspend fun sleep(time : Duration) {
      if (!__thread.sleep(time.inWholeMilliseconds)) { throw InterruptedException() }
    }
    // Whether the running thread has been interrupted. Asking clears the mark.
    fun interrupted() : bool => __thread.interrupted()
    // Lets another thread run, if one is waiting to.
    fun yield() {
      __thread.yield()
    }
  }

  // Its name: the one given, or Thread-N. The name it has at start() is the one the running
  // thread is known by, as in the report of an error it does not catch.
  var name : string = ""
  // Whether the thread is a daemon, which does not keep the program alive: false unless set
  // before start().
  var isDaemon = false
  private var task : (suspend () -> any?)? = null
  private var id = 0      // 0 until it is started

  // Thread(task) or Thread(task, name); a class that extends Thread gives none and replaces run().
  fun init(task : (suspend () -> any?)? = null, name : string? = null) {
    this.task = task
    if (name == null) { Thread.made += 1 }
    this.name = name ?: "Thread-${Thread.made}"
  }

  // What the thread does.
  suspend fun run() {
    val work = task
    if (work != null) { work() }
  }

  // Starts the thread running run(), and gives the thread itself. Starting it a second time is an
  // IllegalStateException.
  fun start() : Thread {
    if (id != 0) { throw IllegalStateException("thread '$name' has already been started") }
    val self = this
    val body : suspend () -> unit = { self.run() }
    id = __thread.start(body, this, name, isDaemon)
    return this
  }

  // Waits for the thread to finish, `timeout` at most if that is given: whether it finished.
  suspend fun join(timeout : Duration? = null) : bool {
    if (id == 0) { return true }
    val status = __thread.join(id, timeout?.inWholeMilliseconds)
    if (status == 2) { throw InterruptedException() }
    return status == 0
  }

  // Whether the thread has started and not yet ended. The main thread's is true.
  val isAlive : bool
    get() => id != 0 and __thread.isAlive(id)

  // Marks the thread as interrupted, and wakes it if it is waiting: the wait then throws
  // InterruptedException. A thread that is working sees the mark only by asking for it.
  fun interrupt() {
    if (id != 0) { __thread.interrupt(id) }
  }

  // Whether the thread has been interrupted and has not yet seen it: asking here does not clear
  // the mark. False before it starts and after it ends.
  val isInterrupted : bool
    get() => id != 0 and __thread.isInterrupted(id)

  // The thread written with its name: Thread(main).
  override fun toString() : string => "Thread($name)"
}

// Starts a thread running the block and gives a Job of what it returns, as task { } and a
// pool's submit { } do: then { } runs on the event loop, get() waits, cancel(interrupt = true)
// interrupts the thread. An error the block throws fails the job, and ends the thread as any
// thread's error does, reported.
fun <T> thread(name : string? = null, daemon : bool = false, block : suspend () -> T throws Exception) : Job<T> {
  val job = Job<T>()
  val made = Thread({
    try {
      job.complete(block())
    } catch (e) {
      job.fail(e)
      __rethrow(e)
    }
  }, name)
  made.isDaemon = daemon
  job.interrupter = { made.interrupt() }
  made.start()
  return job
}

// ---- Jobs (D89) ----
// A result to come: from task { }, thread { }, a pool's submit { }, or made by hand, Job<int>(),
// and given its value with complete(42) or its error with fail(e).

// A result of type T to come, finished once: with a value, with an error, or cancelled.
// Threads and tasks may wait for it with get(); then { } and onError { } run on the event loop.
class Job<T> {
  private val lock = Lock()
  private var state = 0          // 0 not done, 1 done with a value, 2 failed, 3 cancelled
  private var held : any? = null
  private val whenDone : open List<() -> unit> = []
  internal var interrupter : (() -> unit)? = null   // what cancel(interrupt = true) does

  // Whether it has finished: with a value, with an error, or cancelled.
  val isDone : bool
    get() => state != 0
  // Whether it was cancelled.
  val isCancelled : bool
    get() => state == 3
  // Whether it failed, or was cancelled.
  val failed : bool
    get() => state >= 2

  // Each gives whether this is what finished it: false if it was finished already.
  fun complete(value : T) : bool => finish(1, value)
  // Finishes it with `error`: get() then throws ExecutionException with `error` as its cause.
  // False if it was finished already.
  fun fail(error : Throwable) : bool => finish(2, error)
  // With `interrupt`, the thread working on it is interrupted as well.
  fun cancel(interrupt : bool = false) : bool {
    if (!finish(3, CancellationException())) { return false }
    val stop = interrupter
    if (interrupt and stop != null) { stop() }
    return true
  }

  private fun finish(newState : int, value : any?) : bool {
    var then : List<() -> unit> = []
    val first = lock.useKey {
      if (state != 0) {
        false
      } else {
        state = newState
        held = value
        then = whenDone.toList()
        whenDone.clear()
        true
      }
    }
    for (action in then) { action() }
    return first
  }

  // Runs `action` once it is done: at once if it is, and otherwise on the thread that finishes it.
  internal fun onDone(action : () -> unit) {
    val now = lock.useKey {
      if (state == 0) { whenDone.add(action) }
      state != 0
    }
    if (now) { action() }
  }

  // Its value if it has one; null if it has not, or failed.
  fun getOrNull() : T? => state == 1 ? held as T : null

  // Its value, waited for if it is not done: a thread blocks, a task on the main thread is set
  // aside. A job that failed throws ExecutionException, its error in `cause`; one that was
  // cancelled throws CancellationException.
  suspend fun get() : T throws ExecutionException {
    lock.useKey {
      while (state == 0) { lock.await(null) }
    }
    return outcome()
  }

  // The same, waiting `timeout` at most: TimeoutException after that.
  suspend fun get(timeout : Duration) : T throws ExecutionException | TimeoutException {
    val deadline = __deadline(timeout)
    lock.useKey {
      while (state == 0) {
        if (!lock.await(deadline)) { throw TimeoutException() }
      }
    }
    return outcome()
  }

  private fun outcome() : T throws ExecutionException {
    if (state == 2) { throw ExecutionException(held as Throwable) }
    if (state == 3) { throw CancellationException() }
    return held as T
  }

  // Runs `action` with its value once it is done, on the event loop: normally the main thread,
  // so a window may be changed there. Not if it fails; then onError's runs.
  fun then(action : (T) -> unit) : Job<T> {
    __loop.hold()
    onDone {
      EventLoop.post {
        __loop.release()
        if (state == 1) { action(held as T) }
      }
    }
    return this
  }

  // Runs `action` with its error if it fails or is cancelled, on the event loop.
  fun onError(action : (Throwable) -> unit) : Job<T> {
    __loop.hold()
    onDone {
      EventLoop.post {
        __loop.release()
        if (state >= 2) { action(held as Throwable) }
      }
    }
    return this
  }

  // Job(running), Job(42) with its value, Job(failed: <the error>) or Job(cancelled).
  override fun toString() : string => state == 0 ? "Job(running)" : state == 1 ? "Job($held)" : state == 2 ? "Job(failed: $held)" : "Job(cancelled)"

  static {
    // A job of every job's value, in order, once all are done; it fails with the first error.
    fun <T> all(jobs : List<Job<T>>) : Job<List<T>> {
      val result = Job<List<T>>()
      if (jobs.isEmpty()) {
        result.complete([])
        return result
      }
      val count = Lock()
      var left = jobs.size
      for (job in jobs) {
        job.onDone {
          if (job.state != 1) {
            result.fail(job.held as Throwable)
          } else {
            val last = count.useKey {
              left -= 1
              left == 0
            }
            if (last) { result.complete(jobs.map { it.held as T }) }
          }
        }
      }
      return result
    }

    // A job of the value of the first job to succeed; it fails with the last error if all fail.
    fun <T> any(jobs : List<Job<T>>) : Job<T> {
      val result = Job<T>()
      if (jobs.isEmpty()) {
        result.fail(NoSuchElementException("Job.any was given no jobs"))
        return result
      }
      val count = Lock()
      var failures = 0
      for (job in jobs) {
        job.onDone {
          if (job.state == 1) {
            result.complete(job.held as T)
          } else {
            val all = count.useKey {
              failures += 1
              failures == jobs.size
            }
            if (all) { result.fail(job.held as Throwable) }
          }
        }
      }
      return result
    }
  }
}

// The clock() time `timeout` from now.
fun __deadline(timeout : Duration) : float => clock() + timeout.inSeconds

// ---- Locks (D86) ----
// One key: whoever has it opens the lock, everyone else waits until it is given back.
//
//   val drawing = Lock()
//   drawing.useKey { paint() }
//
//   val counts = LockBox<open Map<string, int>>({:})    // reached only with the key
//   counts.useKey { it["clicks"] = (it["clicks"] ?: 0) + 1 }
//
// Inside either, waitUntil { condition } gives the key back until the condition holds, checked
// again whenever another thread gives a key back: Java's wait and notify, with no notify to
// forget. A thread that has the key may take it again. Nothing waits in a parallel section.

// A lock with one key: useKey takes it, waiting while another thread holds it. A thread that
// holds the key may take it again.
class Lock {
  internal val tasks : open List<(bool) -> unit> = []   // the tasks waiting, each to be taken up

  // Runs `block` holding the key, waiting for it if another thread holds it, and gives it back
  // when the block ends, even by an error: gives what the block gives. Waiting threads and tasks
  // look at their conditions again then. In a parallel section it is an IllegalStateException.
  inline fun <T> useKey(block : () -> T) : T {
    __thread.enter(this)
    try {
      return block()
    } finally {
      __lockWake(this)
      __thread.exit(this)
    }
  }

  // With the key held: gives it back and waits until another thread or task gives a key back,
  // or until the clock() time `deadline`, then takes it again. False if the time ran out. A task
  // on the main thread is set aside meanwhile; a thread blocks, and InterruptedException ends
  // its wait if it is interrupted.
  internal suspend fun await(deadline : float?) : bool {
    var left = -1
    if (deadline != null) {
      left = Math.round((deadline - clock()) * 1000.0)
      if (left <= 0) { return false }
    }
    // Giving the key back is a key given back: those waiting look again.
    __lockWake(this)
    val running = __task.current()
    if (running == null or !__loop.isLoopThread()) {
      val status = __thread.wait(this, deadline == null ? null : left)
      if (status == 2) { throw InterruptedException() }
      return status == 0
    }
    val wait = __task.prepare()
    var answered = false
    var timer = -1
    val resume : (bool) -> unit = { told ->
      if (!answered) {
        answered = true
        if (timer >= 0) { __loop.cancel(timer) }
        __loop.release()
        __task.resume(running, wait, true, told)
      }
    }
    tasks.add(resume)
    __loop.hold()
    if (deadline != null) {
      val self = this
      timer = __loop.timer(left, {
        __thread.enter(self)
        self.tasks.remove(resume)
        __thread.exit(self)
        resume(false)
      })
    }
    val count = __thread.letGo(this)
    val told = __task.wait(wait) as bool
    __thread.takeBack(this, count)
    return told
  }
}

// What useKey does as it gives the key back: every thread and task waiting looks again.
fun __lockWake(lock : Lock) {
  __thread.notifyAll(lock)
  if (lock.tasks.isNotEmpty()) {
    val waiting = lock.tasks.toList()
    lock.tasks.clear()
    for (resume in waiting) { EventLoop.post { resume(true) } }
  }
}

// Data reached only with the key: useKey gives the block the value.
class LockBox<T>(private val value : T) {
  private val lock = Lock()

  // Runs `block` with the value, holding the box's key: gives what the block gives.
  fun <R> useKey(block : (T) -> R) : R => lock.useKey { block(value) }
}

// Inside useKey: gives the key back until `condition` holds, checked again each time a key is
// given back, then goes on with it held. With a time limit, false if it ran out first.
suspend fun waitUntil(timeout : Duration? = null, condition : () -> bool) : bool {
  val held = __thread.innermost()
  if (!(held is Lock)) { throw IllegalStateException("waitUntil is for inside useKey { }: it gives that key back while it waits") }
  val deadline = timeout == null ? null : __deadline(timeout)
  while (!condition()) {
    if (!held.await(deadline)) { return false }
  }
  return true
}

// ---- Channels (D87) ----
// Items handed from one thread or task to another, in order, each to one receiver:
//
//   val frames = Channel<Frame>(capacity = 2)    // a send waits while it holds 2
//   val jobs = Channel<Job>.unbounded()          // a send never waits
//   val handoff = Channel<int>(capacity = 0)     // each send waits for a receive
//
// receive() waits for an item, and a for over a channel takes its items until it is closed and
// empty. Waiting blocks a thread, and sets a task on the main thread aside.

// Items handed from one thread or task to another, in order, each to one receiver: made with a
// capacity, Channel<T>(2), or with none, Channel<T>.unbounded().
class Channel<T> {
  private val lock = Lock()
  private val items : Deck<T> = Deck()
  private val capacity : int        // int.maxValue: any number
  private var closed = false
  private var sent = 0              // capacity 0: the sends made, and how many of them were taken
  private var taken = 0
  private var receiving = 0         // receivers waiting

  // A channel that holds `capacity` items, a send waiting while it is full; with 0, each send
  // waits for a receive to take it. Channel<T>.unbounded() holds any number.
  fun init(capacity : int) {
    if (capacity < 0) { throw IllegalArgumentException("a channel holds 0 items or more; Channel<T>.unbounded() holds any number") }
    this.capacity = capacity
  }

  static {
    // A channel that holds any number of items: a send never waits.
    fun <T> unbounded() : Channel<T> => Channel<T>(int.maxValue)
  }

  // Hands over an item, waiting while the channel is full; with capacity 0, until it is
  // received. Sending to a closed channel is an IllegalStateException.
  suspend fun send(item : T) {
    lock.useKey {
      if (closed) { throw IllegalStateException("the channel is closed") }
      if (capacity == 0) {
        items.addLast(item)
        sent += 1
        val ticket = sent
        while (taken < ticket and !closed) { lock.await(null) }
        if (taken < ticket) { throw IllegalStateException("the channel was closed before the item was received") }
      } else {
        while (items.size >= capacity and !closed) { lock.await(null) }
        if (closed) { throw IllegalStateException("the channel is closed") }
        items.addLast(item)
      }
    }
  }

  // Hands over an item if that can be done without waiting: whether it was.
  fun trySend(item : T) : bool => lock.useKey {
    val room = capacity == 0 ? receiving > items.size : items.size < capacity
    if (closed or !room) {
      false
    } else {
      items.addLast(item)
      if (capacity == 0) { sent += 1 }
      true
    }
  }

  // Takes the next item, waiting for one; a closed channel that is empty throws IllegalStateException.
  suspend fun receive() : T => lock.useKey {
    receiving += 1
    try {
      while (items.isEmpty()) {
        if (closed) { throw IllegalStateException("the channel is closed, and empty") }
        lock.await(null)
      }
    } finally {
      receiving -= 1
    }
    taken += 1
    items.removeFirst()
  }

  // The same, waiting `timeout` at most: null if nothing came.
  suspend fun receive(timeout : Duration) : T? {
    val deadline = __deadline(timeout)
    return lock.useKey {
      receiving += 1
      var waited = true
      try {
        while (items.isEmpty() and waited) {
          if (closed) { throw IllegalStateException("the channel is closed, and empty") }
          waited = lock.await(deadline)
        }
      } finally {
        receiving -= 1
      }
      if (items.isEmpty()) {
        null
      } else {
        taken += 1
        items.removeFirst()
      }
    }
  }

  // Takes the next item if there is one: null if there is not.
  fun tryReceive() : T? => lock.useKey {
    if (items.isEmpty()) {
      null
    } else {
      taken += 1
      items.removeFirst()
    }
  }

  // Takes no more items: what it holds can still be received, then a receive throws, and a for
  // over it ends.
  fun close() {
    lock.useKey { closed = true }
  }

  // Whether close() has been called; it may still hold items to receive.
  val isClosed : bool
    get() => closed

  // For a for: the next item put in `into`, waiting for it; false once the channel is closed and empty.
  internal suspend fun receiveInto(into : open List<T>) : bool => lock.useKey {
    receiving += 1
    try {
      while (items.isEmpty() and !closed) { lock.await(null) }
    } finally {
      receiving -= 1
    }
    if (items.isEmpty()) {
      false
    } else {
      taken += 1
      into.add(items.removeFirst())
      true
    }
  }

  // For a for: each item as it comes, waited for, until the channel is closed and empty.
  fun iterator() : __ChannelItems<T> => __ChannelItems(this)
}

// A for over a channel.
class __ChannelItems<T>(private val channel : Channel<T>) {
  private val pending : open List<T> = []

  suspend fun hasNext() : bool => pending.isNotEmpty() or channel.receiveInto(pending)
  fun next() : T {
    if (pending.isEmpty()) { throw NoSuchElementException("the channel is closed, and empty") }
    return pending.removeAt(0)
  }
}

// ---- Thread pools (D88) ----
// Threads that run the jobs given to them, each submit { } giving a Job of the job's result:
//
//   val pool = ThreadPool(threads = 4)
//   val total = pool.submit { sum(numbers) }
//   pool.every(5.seconds) { autosave() }
//   pool.close()                     // its threads keep the program alive until then
//
// Threads take turns, so a pool overlaps waiting, not computing: tasks are the first choice for
// plain waiting, and parallel sections and workers for computing.

// Threads that run the jobs given to them, submit { } giving a Job of what a job returns. Close
// it when it is done with: until then its threads may keep the program alive, unless it is made
// with daemon = true.
class ThreadPool : AutoCloseable {
  static {
    // How many pools have been made, JobQueues among them: the number in the name pool-N.
    var made = 0
  }

  private val lock = Lock()
  private val queue : Deck<__PoolJob> = Deck()
  private val workers : open List<Thread> = []
  private val timed : open List<__PoolJob> = []        // jobs waiting for their time, with `due`
  private var keeper : Thread? = null                   // the thread that hands them over at their time
  private var limit : int?
  private var name : string
  private var daemon : bool
  private var idle = 0
  private var closed = false

  // At most `threads` jobs at once; null: as many threads as jobs come, each ending after a
  // minute with nothing to do. A pool of daemon threads does not keep the program alive.
  fun init(threads : int?, name : string? = null, daemon : bool = false) {
    if (threads != null and threads < 1) { throw IllegalArgumentException("a pool has 1 thread or more, or null for as many as are needed") }
    ThreadPool.made += 1
    this.limit = threads
    this.name = name ?: "pool-${ThreadPool.made}"
    this.daemon = daemon
  }

  // Runs the job on one of the pool's threads: a Job of what it returns.
  fun <T> submit(job : suspend () -> T throws Exception) : Job<T> {
    val result = Job<T>()
    hand(__PoolJob(__poolRun(result, job), result))
    return result
  }

  // Runs the job once, `delay` from now.
  fun <T> after(delay : Duration, job : suspend () -> T throws Exception) : Job<T> {
    val result = Job<T>()
    later(__PoolJob(__poolRun(result, job), result, clock() + delay.inSeconds))
    return result
  }

  // Runs the job every `period`, the first time a period from now, until the Job it gives is
  // cancelled or the pool is closed. An error the job throws stops it, failing the Job.
  fun every(period : Duration, job : suspend () -> unit throws Exception) : Job<unit> {
    val result = Job<unit>()
    val self = this
    var again : (suspend () -> unit)? = null
    val run : suspend () -> unit = {
      if (!result.isDone) {
        try {
          job()
          self.later(__PoolJob(again!!, result, clock() + period.inSeconds))
        } catch (e) {
          result.fail(e)
        }
      }
    }
    again = run
    later(__PoolJob(run, result, clock() + period.inSeconds))
    return result
  }

  private fun hand(job : __PoolJob) {
    lock.useKey {
      if (closed) { throw IllegalStateException("the pool '$name' is closed: it takes no more jobs") }
      queue.addLast(job)
      val most = limit
      if (idle == 0 and (most == null or workers.size < most)) { addWorker() }
    }
  }

  internal fun later(job : __PoolJob) {
    lock.useKey {
      if (!closed) {
        timed.add(job)
        if (keeper == null) {
          val self = this
          val made = Thread({ self.keepTime() }, "$name-timer")
          made.isDaemon = daemon
          keeper = made
          made.start()
        }
      }
    }
  }

  private fun addWorker() {
    val self = this
    val worker = Thread({ self.work() }, "$name-${workers.size + 1}")
    worker.isDaemon = daemon
    workers.add(worker)
    worker.start()
  }

  // What each of its threads does: take a job and run it, until the pool is closed and empty.
  private suspend fun work() {
    val me = Thread.currentThread()
    var going = true
    while (going) {
      val next = lock.useKey {
        idle += 1
        var waited = true
        try {
          while (queue.isEmpty() and !closed and waited) {
            waited = lock.await(limit == null ? __deadline(1.minutes) : null)
          }
        } catch (e : InterruptedException) {
          waited = false
        } finally {
          idle -= 1
        }
        val taken = queue.removeFirstOrNull()
        if (taken == null) { workers.remove(me) }
        taken
      }
      if (next == null) {
        going = false
      } else {
        next.run()
        Thread.interrupted()      // an interrupt meant for that job is not for the next one
      }
    }
  }

  // What the timer thread does: hand each timed job over at its time.
  private suspend fun keepTime() {
    var going = true
    while (going) {
      val due = lock.useKey {
        var found : __PoolJob? = null
        while (found == null and !closed) {
          timed.removeAll { it.result.isDone }
          if (timed.isEmpty()) {
            lock.await(null)
          } else {
            val first = timed.minBy { it.due }
            if (first.due <= clock()) {
              timed.remove(first)
              found = first
            } else {
              lock.await(first.due)
            }
          }
        }
        found
      }
      if (due == null) {
        going = false
      } else {
        try { hand(due) } catch (e : IllegalStateException) { going = false }
      }
    }
  }

  // Takes no more jobs, and waits for those it has to finish; timed jobs not yet due are dropped.
  override fun close() {
    val those = lock.useKey {
      closed = true
      for (job in timed) { job.result.cancel() }
      timed.clear()
      workers.toList()
    }
    for (worker in those) { __threadJoin(worker) }
  }

  // Takes no more jobs, cancels those not started, and interrupts the threads running the others.
  fun closeNow() {
    lock.useKey {
      closed = true
      while (queue.isNotEmpty()) { queue.removeFirst().result.cancel() }
      for (job in timed) { job.result.cancel() }
      timed.clear()
      for (worker in workers) { worker.interrupt() }
    }
  }

  // Whether close() or closeNow() has been called: it takes no more jobs.
  val isClosed : bool
    get() => closed
}

// One thread running its jobs one at a time, in the order they were given.
class JobQueue(name : string? = null, daemon : bool = false) : ThreadPool(1, name, daemon)

// A job a pool holds: what runs it, the Job it answers, and for a timed one when it is due.
class __PoolJob(val run : suspend () -> unit, val result : Job<*>, val due : float = 0.0)

// What a pool's thread runs for a job: its result into the Job, and the thread to interrupt for
// cancel(interrupt = true) meanwhile.
fun <T> __poolRun(result : Job<T>, job : suspend () -> T throws Exception) : suspend () -> unit => {
  if (!result.isDone) {
    val me = Thread.currentThread()
    result.interrupter = { me.interrupt() }
    try {
      result.complete(job())
    } catch (e) {
      result.fail(e)
    }
    result.interrupter = null
  }
}

// Waits for a thread to end, as join() does, from code that cannot be set aside: close().
fun __threadJoin(thread : Thread) {
  while (thread.isAlive) { __thread.sleep(5) }
}

// ---- Countdown (D118) ----
// Opens once countDown() has been called `count` times; await() waits for that.
//
//   val done = Countdown(3)
//   repeat(3) { thread { work(); done.countDown() } }
//   done.await(timeout = 10.seconds)

// Opens once countDown() has been called `remaining` times, starting at 0 or more:
// IllegalArgumentException if `remaining` is negative.
class Countdown(private var remaining : int) {
  private val lock = Lock()

  init {
    if (remaining < 0) { throw IllegalArgumentException("a countdown starts at 0 or more") }
  }

  // How many countDown() calls are still to come.
  val count : int
    get() => remaining

  // Counts one down, waking those that await() once it reaches 0; at 0 it does nothing.
  fun countDown() {
    lock.useKey {
      if (remaining > 0) { remaining -= 1 }
    }
  }

  // Waits until it reaches 0: a thread blocks, a task on the main thread is set aside. With a
  // time limit, false if it ran out first.
  suspend fun await(timeout : Duration? = null) : bool {
    val deadline = timeout == null ? null : __deadline(timeout)
    return lock.useKey {
      var inTime = true
      while (remaining > 0 and inTime) { inTime = lock.await(deadline) }
      remaining == 0
    }
  }
}

// ---- Atomic values (D85) ----
// A value threads and the cores of a parallel section change in one step each, with the
// processor's own operations underneath:
//
//   val hits = Atomic(0)
//   items.parallelStream().forEach { if (matches(it)) { hits.increment() } }
//
// In a parallel section only values are stored in one: numbers, bools, small values and frozen
// data, never an object a core has just made. update { } may run its lambda more than once when
// cores contend, so the lambda only works out the new value from the old. For totals over all
// items, count { }, sumOf { } and gather share nothing and are faster still.

// A value threads and the cores of a parallel section change in one step each, `initial` to
// begin with. In a parallel section only values are stored in one: storing an object, there, that
// a core may still change is an IllegalStateException.
class Atomic<T>(initial : T) {
  internal val cell : List<any?> = __atomic.make(initial)

  // The value it holds now.
  fun get() : T => __atomic.get(cell) as T
  // Sets the value it holds.
  fun set(value : T) {
    __atomic.set(cell, value)
  }
  // Sets it, giving the value it held.
  fun exchange(value : T) : T => __atomic.exchange(cell, value) as T
  // Sets it to `value` if it holds `expected` (a number or a bool equal to it, or the very same
  // object): whether it did.
  fun compareAndSet(expected : T, value : T) : bool => __atomic.compareAndSet(cell, expected, value)
  // Works out the new value from the old and sets it, in one step: giving the new value.
  fun update(change : (T) -> T) : T {
    while (true) {
      val old = get()
      val made = change(old)
      if (compareAndSet(old, made)) { return made }
    }
  }

  // The value it holds now, as text.
  override fun toString() : string => "${get()}"
}

// On an Atomic<int>, each giving the new value.
fun Atomic<int>.increment() : int => __atomic.add(this.cell, 1)
// Takes 1 off, giving the new value.
fun Atomic<int>.decrement() : int => __atomic.add(this.cell, -1)
// Adds `amount`, giving the new value: an ArithmeticException if the total does not fit in an
// int, and nothing is changed.
fun Atomic<int>.add(amount : int) : int => __atomic.add(this.cell, amount)
