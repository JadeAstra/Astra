// ---- Tests (D153): what `astra test` runs ----
// A function written @Test is a test: `astra test file.astra` runs it, and it passes unless it
// throws. Around each test run the functions written @BeforeTest and @AfterTest, and around
// all of a file's tests those written @BeforeAll and @AfterAll. A test may be a method of a
// class, which is made anew for each of its tests, with no arguments; its own @BeforeTest and
// @AfterTest methods run on that object, and its static @BeforeAll and @AfterAll methods once.
//
//   @Test fun adds() { assertEquals(4, 2 + 2) }
//   @Test @Timeout(500) fun quick() { ... }
//   @Test fun writes(@TempDir dir : Path) { Path(dir, "a.txt").writeText("hi") }

// Makes a function, or a method of a class, a test that `astra test` runs; it passes unless it
// throws. It takes no parameters but those written @TempDir.
annotation Test
// Makes a function one that runs before each test of the file, or a method one that runs before
// each test of its class, on the object made for it; where it throws, the test fails unrun.
annotation BeforeTest
// Makes a function one that runs after each test of the file, or a method one that runs after each
// test of its class, on its object; it runs where the test failed too, and where it throws, the
// test fails.
annotation AfterTest
// Makes a function one that runs once before all of the file's tests, or a static method one that
// runs once before its class's tests; where it throws, that is a failure and those tests do not run.
annotation BeforeAll
// Makes a function one that runs once after all of the file's tests, or a static method one that
// runs once after its class's tests; where it throws, that is a failure.
annotation AfterAll
// The longest the test may run, in milliseconds: once that is past it fails, stopped where it is.
annotation Timeout(val millis : int)
// A test's parameter that is given a Path naming a new, empty directory of its own, deleted
// with what it holds once the test is over.
annotation TempDir

// -- What a test checks, as Kotlin's: each throws an AssertionError where it does not hold --
// Each takes a `message` too, which when it is given begins the error's text.

fun __failed(message : string?, what : string) : nothing {
  throw AssertionError(message == null ? what : message + ". " + what)
}

// Fails at once: throws an AssertionError with `message`, or with none.
fun fail(message : string? = null) : nothing {
  throw AssertionError(message)
}

// Checks that `actual` is equal to `expected` by `==`, so that lists, sets and maps are compared by
// what they hold; the error shows both.
fun assertEquals(expected : any?, actual : any?, message : string? = null) {
  if (expected != actual) { __failed(message, "Expected <$expected>, actual <$actual>.") }
}

// Checks that `actual` is not equal to `illegal` by `==`.
fun assertNotEquals(illegal : any?, actual : any?, message : string? = null) {
  if (illegal == actual) { __failed(message, "Illegal value: <$actual>.") }
}

// A float near enough to what was expected.
fun assertEquals(expected : float, actual : float, absoluteTolerance : float, message : string? = null) {
  if (!(Math.abs(expected - actual) <= absoluteTolerance)) {
    __failed(message, "Expected <$expected> with absolute tolerance <$absoluteTolerance>, actual <$actual>.")
  }
}

// Checks that `actual` and `expected` are the same by `===`, not merely equal.
fun assertSame(expected : any?, actual : any?, message : string? = null) {
  if (expected !== actual) { __failed(message, "Expected <$expected>, actual <$actual> is not same.") }
}

// Checks that `actual` and `illegal` are not the same by `===`.
fun assertNotSame(illegal : any?, actual : any?, message : string? = null) {
  if (illegal === actual) { __failed(message, "Expected not same as <$actual>.") }
}

// Checks that `actual` is true.
fun assertTrue(actual : bool, message : string? = null) {
  if (!actual) { __failed(message, "Expected value to be true.") }
}

// Checks that `actual` is false.
fun assertFalse(actual : bool, message : string? = null) {
  if (actual) { __failed(message, "Expected value to be false.") }
}

// Checks that `actual` is null; the error shows what it was.
fun assertNull(actual : any?, message : string? = null) {
  if (actual != null) { __failed(message, "Expected value to be null, but was: <$actual>.") }
}

// Checks that `actual` is not null, and gives it back, typed as not null.
//   val user = assertNotNull(findUser("ann"))
fun <T> assertNotNull(actual : T?, message : string? = null) : T {
  if (actual == null) { __failed(message, "Expected value to be not null.") }
  return actual!!
}

// Checks that `items` has an item equal to `element`.
fun <T> assertContains(items : List<T>, element : T, message : string? = null) {
  if (!items.contains(element)) { __failed(message, "Expected the collection to contain the element.\nCollection <$items>, element <$element>.") }
}

// Checks that `text` has `other` in it.
fun assertContains(text : string, other : string, message : string? = null) {
  if (!text.contains(other)) { __failed(message, "Expected the char sequence to contain the substring.\nCharSequence <$text>, substring <$other>.") }
}

// What the block throws, which it has to: an Exception or an Error.
fun assertFails(block : () -> unit) : Throwable {
  try {
    block()
  } catch (e : Throwable) {
    return e
  }
  __failed(null, "Expected an exception to be thrown, but was completed successfully.")
}

// What the block throws, which has to be a T.
fun <T> assertFailsWith(message : string? = null, block : () -> unit) : T {
  try {
    block()
  } catch (e : Throwable) {
    if (e is T) { return e as T }
    __failed(message, "Expected an exception of the class asked for to be thrown, but was $e.")
  }
  __failed(message, "Expected an exception to be thrown, but was completed successfully.")
}
