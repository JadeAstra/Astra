// ---- What the C++ provides, declared ----
//
// The built-in functions, and the methods and properties of the built-in types, are written
// in C++ (src/builtins.cpp, src/stdlib.cpp, src/vm.cpp). They are declared here so that their
// types and parameter names are known to the type checker. An `external` declaration has no
// body and compiles to nothing; the compiler checks that the C++ has what it names, taking as
// many arguments as it says.
//
// Where one name takes different shapes (`add(item)` and `add(index, item)`), each is declared:
// the checker chooses the form a call means, and the C++ tells them apart when it runs.

// -- Functions --

external fun print(vararg items : any?)
external fun write(vararg items : any?)
external fun type(value : any?) : string
external fun Range(first : int, end : int = 0, step : int = 1) : Range
external fun Bytes(source : any) : Bytes
external fun args() : open List<string>
external fun assert(condition : bool, message : string = "assertion failed")
// The hash of several values together, wrapping at 32 bits inside, as Java's Objects.hash (D148).
external fun hash(vararg values : any?) : int
external fun __hashCode(value : any?) : int
external fun clock() : float
external fun compareValues(a : any?, b : any?) : int
external fun exit(code : int = 0) : nothing
external fun flush()
external fun input(prompt : string = "") : string?
external fun <T> maxOf(first : T, vararg rest : T) : T
external fun <T> minOf(first : T, vararg rest : T) : T
external fun <T, R> with(receiver : T, block : T.() -> R) : R

