// ---- Maps ----
// The methods a map has besides the built-in ones. A function given to one of them takes an
// entry, which has a `key` and a `value` and can be taken apart: { (key, value) -> ... }

fun <K, V> Map<K, V>.getOrPut(key : K, defaultValue : () -> V) : V {
  val had = this[key]
  if (had != null) { return had }
  val made = defaultValue()
  this[key] = made
  return made
}

fun <K, V> Map<K, V>.getOrElse(key : K, defaultValue : () -> V) : V {
  val had = this[key]
  return had == null ? defaultValue() : had
}

// Changing what a key holds, where a key that is not there starts from `start`, for a change
// that is not one operator (L118; counting is counts[word, default = 0]++). Gives the new value.
fun <K, V> Map<K, V>.update(key : K, start : V, change : (V) -> V) : V {
  val value = change(this.containsKey(key) ? this[key] as V : start)
  this[key] = value
  return value
}

// Takes another map, or a list of pairs.
fun <K, V> Map<K, V>.putAll(from : Map<K, V>) {
  for key in from.keys { this[key] = from[key] as V }
}

fun <K, V> Map<K, V>.putAll(pairs : List<Pair<K, V>>) {
  for (key, value) in pairs { this[key] = value }
}

fun <K, V> Map<K, V>?.orEmpty() : Map<K, V> => this == null ? {:} : this
fun <K, V> Map<K, V>.ifEmpty(defaultValue : () -> Map<K, V>) : Map<K, V> => this.size == 0 ? defaultValue() : this

// forEach { entry -> }, forEach { (key, value) -> } or forEach { key, value -> }: the function
// says which it wants by how many parameters it has.
fun <K, V> Map<K, V>.forEach(action : (MapEntry<K, V>) -> unit) {
  for entry in this.entries { action(entry) }
}

fun <K, V> Map<K, V>.forEach(action : (K, V) -> unit) {
  for entry in this.entries { action(entry.key, entry.value) }
}

// -- Asking about the entries --

fun <K, V> Map<K, V>.any() : bool => this.size > 0

fun <K, V> Map<K, V>.any(predicate : (MapEntry<K, V>) -> bool) : bool {
  for entry in this.entries {
    if (predicate(entry)) { return true }
  }
  return false
}

fun <K, V> Map<K, V>.all(predicate : (MapEntry<K, V>) -> bool) : bool {
  for entry in this.entries {
    if (!predicate(entry)) { return false }
  }
  return true
}

fun <K, V> Map<K, V>.none() : bool => this.size == 0

fun <K, V> Map<K, V>.none(predicate : (MapEntry<K, V>) -> bool) : bool {
  for entry in this.entries {
    if (predicate(entry)) { return false }
  }
  return true
}

fun <K, V> Map<K, V>.count() : int => this.size

fun <K, V> Map<K, V>.count(predicate : (MapEntry<K, V>) -> bool) : int {
  var total = 0
  for entry in this.entries {
    if (predicate(entry)) { total += 1 }
  }
  return total
}

// -- Making a list --

fun <K, V, R> Map<K, V>.map(transform : (MapEntry<K, V>) -> R) : List<R> {
  val out : List<R> = []
  for entry in this.entries { out.add(transform(entry)) }
  return out
}

fun <K, V, R> Map<K, V>.mapNotNull(transform : (MapEntry<K, V>) -> R?) : List<R> {
  val out : List<R> = []
  for entry in this.entries {
    val made = transform(entry)
    if (made != null) { out.add(made) }
  }
  return out
}

fun <K, V, R> Map<K, V>.flatMap(transform : (MapEntry<K, V>) -> List<R>) : List<R> {
  val out : List<R> = []
  for entry in this.entries { out.addAll(transform(entry)) }
  return out
}

// The entries as a list of pairs.
fun <K, V> Map<K, V>.toList() : List<Pair<K, V>> {
  val out : List<Pair<K, V>> = []
  for entry in this.entries { out.add(Pair(entry.key, entry.value)) }
  return out
}

// -- Making another map --

fun <K, V, R> Map<K, V>.mapValues(transform : (MapEntry<K, V>) -> R) : Map<K, R> {
  val out : Map<K, R> = {:}
  for entry in this.entries { out[entry.key] = transform(entry) }
  return out
}

fun <K, V, R> Map<K, V>.mapKeys(transform : (MapEntry<K, V>) -> R) : Map<R, V> {
  val out : Map<R, V> = {:}
  for entry in this.entries { out[transform(entry)] = entry.value }
  return out
}

fun <K, V> Map<K, V>.filter(predicate : (MapEntry<K, V>) -> bool) : Map<K, V> {
  val out : Map<K, V> = {:}
  for entry in this.entries {
    if (predicate(entry)) { out[entry.key] = entry.value }
  }
  return out
}

fun <K, V> Map<K, V>.filterNot(predicate : (MapEntry<K, V>) -> bool) : Map<K, V> {
  val out : Map<K, V> = {:}
  for entry in this.entries {
    if (!predicate(entry)) { out[entry.key] = entry.value }
  }
  return out
}

fun <K, V> Map<K, V>.filterKeys(predicate : (K) -> bool) : Map<K, V> {
  val out : Map<K, V> = {:}
  for entry in this.entries {
    if (predicate(entry.key)) { out[entry.key] = entry.value }
  }
  return out
}

fun <K, V> Map<K, V>.filterValues(predicate : (V) -> bool) : Map<K, V> {
  val out : Map<K, V> = {:}
  for entry in this.entries {
    if (predicate(entry.value)) { out[entry.key] = entry.value }
  }
  return out
}

// A new map with a pair, a list of pairs or another map added.
fun <K, V> Map<K, V>.plus(pair : Pair<K, V>) : Map<K, V> {
  val out = this.toMutableMap()
  out[pair.first] = pair.second
  return out
}

fun <K, V> Map<K, V>.plus(pairs : List<Pair<K, V>>) : Map<K, V> {
  val out = this.toMutableMap()
  out.putAll(pairs)
  return out
}

fun <K, V> Map<K, V>.plus(other : Map<K, V>) : Map<K, V> {
  val out = this.toMutableMap()
  out.putAll(other)
  return out
}

// A new map without a key, or without each key of a list or a set.
fun <K, V> Map<K, V>.minus(key : K) : Map<K, V> {
  val out = this.toMutableMap()
  out.remove(key)
  return out
}

fun <K, V> Map<K, V>.minus(keys : List<K>) : Map<K, V> {
  val out = this.toMutableMap()
  for each in keys { out.remove(each) }
  return out
}

fun <K, V> Map<K, V>.minus(keys : Set<K>) : Map<K, V> => this.minus(keys.toList())

// -- Picking an entry --

fun <K, V> Map<K, V>.maxByOrNull(selector : (MapEntry<K, V>) -> any?) : MapEntry<K, V>? => this.entries.maxByOrNull(selector)
fun <K, V> Map<K, V>.minByOrNull(selector : (MapEntry<K, V>) -> any?) : MapEntry<K, V>? => this.entries.minByOrNull(selector)
fun <K, V> Map<K, V>.firstOrNull() : MapEntry<K, V>? => this.entries.firstOrNull()
fun <K, V> Map<K, V>.firstOrNull(predicate : (MapEntry<K, V>) -> bool) : MapEntry<K, V>? => this.entries.firstOrNull(predicate)
fun <K, V, R : Number> Map<K, V>.sumOf(selector : (MapEntry<K, V>) -> R) : R => this.entries.sumOf(selector)
