// ---- Streams, processes and sockets ----
// Reading and writing a piece at a time, programs started from this one, and connections
// over the network. The names are Java's, which is what Kotlin code uses.
//
// Anything here that waits (a read, an accept, waitFor) is written as an ordinary call:
//   - on a thread it blocks that thread, and the other threads go on;
//   - in a flow on the main thread the flow is set aside meanwhile, and the event loop goes
//     on, so a window stays live;
//   - on the main thread outside a flow it blocks the main thread.
// The work is done by the built-in __io (io.cpp). What it hands out to stand for an open
// file, process or socket is a handle of the C++'s own, an `any` to Astra.

// Thrown when reading, writing, connecting or starting a program goes wrong.
class IOException(message : string) : Error(message)

// Something to read from: a file, what a process writes, a socket. Text is UTF-8.
class InputStream {
  private val handle : any

  fun init(handle : any) {
    this.handle = handle
  }

  // Up to `count` bytes as soon as there are any; null at the end.
  fun read(count : int = 65536) : Bytes? => __io.read(handle, count)

  // Everything up to the end, as bytes or as text.
  fun readBytes() : Bytes => __io.readAll(handle)
  fun readAllBytes() : Bytes => __io.readAll(handle)
  fun readText() : string => readBytes().decodeToString()

  // The next line without its line end; null at the end.
  fun readLine() : string? => __io.readLine(handle)

  // The lines that are left.
  fun readLines() : open List<string> {
    val lines : open List<string> = []
    while (true) {
      val line : string? = __io.readLine(handle)
      if (line == null) { break }
      lines.add(line)
    }
    return lines
  }

  fun lines() : open List<string> => readLines()

  fun forEachLine(action : (string) -> unit) {
    while (true) {
      val line : string? = __io.readLine(handle)
      if (line == null) { break }
      action(line)
    }
  }

  // Runs the block on the lines and closes the stream afterwards.
  fun <R> useLines(block : (List<string>) -> R) : R {
    try {
      return block(readLines())
    } finally {
      close()
    }
  }

  fun close() {
    __io.close(handle)
  }

  get isOpen() : bool => __io.isOpen(handle)

  // Runs the block on this stream and closes it afterwards, whatever happens.
  fun <R> use(block : (InputStream) -> R) : R {
    try {
      return block(this)
    } finally {
      close()
    }
  }

  // Kotlin wraps a stream to read text from it; here the stream reads text itself.
  fun bufferedReader(charset : any? = null) : InputStream => this
  fun reader(charset : any? = null) : InputStream => this
  fun buffered() : InputStream => this
}

// Something to write to: a file, what a process reads, a socket. A write returns when the
// system has taken all of it, so flush() has nothing left to do.
class OutputStream {
  private val handle : any

  fun init(handle : any) {
    this.handle = handle
  }

  // Text, or bytes. Anything else is written as print would show it.
  fun write(data : any?) {
    __io.write(handle, data)
  }

  fun print(value : any?) {
    __io.write(handle, "$value")
  }

  fun println(value : any? = "") {
    __io.write(handle, "$value\n")
  }

  fun newLine() {
    __io.write(handle, "\n")
  }

  fun append(value : any?) : OutputStream {
    __io.write(handle, "$value")
    return this
  }

  fun flush() {
  }

  fun close() {
    __io.close(handle)
  }

  get isOpen() : bool => __io.isOpen(handle)

  fun <R> use(block : (OutputStream) -> R) : R {
    try {
      return block(this)
    } finally {
      close()
    }
  }

  fun bufferedWriter(charset : any? = null) : OutputStream => this
  fun writer(charset : any? = null) : OutputStream => this
  fun printWriter(charset : any? = null) : OutputStream => this
  fun buffered() : OutputStream => this
}

// ---- Processes ----

// A program started from this one.
//
//   val process = ProcessBuilder("git", "status").directory(folder).start()
//   for line in process.inputStream.readLines() { print(line) }
//   print("exit code", process.waitFor())
//
// inputStream is what the program writes, errorStream what it writes as errors, and
// outputStream what it reads. Each is null when it was sent somewhere other than a pipe.
class Process {
  private val handle : any
  val outputStream : OutputStream?
  val inputStream : InputStream?
  val errorStream : InputStream?

  fun init(handles : List<any?>) {
    this.handle = handles[0] as any
    this.outputStream = handles[1] == null ? null : OutputStream(handles[1] as any)
    this.inputStream = handles[2] == null ? null : InputStream(handles[2] as any)
    this.errorStream = handles[3] == null ? null : InputStream(handles[3] as any)
  }

  // Waits for the program to end and gives its exit code. With a time limit it gives true
  // if the program ended in that time and false if it is still running.
  fun waitFor() : int => __io.processWait(handle)
  fun waitFor(timeout : Number, unit : Number? = null) : bool => __io.processWait(handle, TimeUnit.toMillis(timeout, unit)) != null

  // The exit code of a program that has ended.
  fun exitValue() : int {
    val code : int? = __io.processWait(handle, 0)
    if (code == null) { throw Error("the process has not ended yet") }
    return code
  }

  get isAlive() : bool => __io.processAlive(handle)
  fun pid() : int => __io.processId(handle)

  // Ends the program now.
  fun destroy() {
    __io.processKill(handle)
  }

  fun destroyForcibly() : Process {
    __io.processKill(handle)
    return this
  }

  // -- This program --

  // What started this program: the path of its executable and, when it is a script run by
  // astra, the script. ProcessBuilder(Process.currentCommand() + ["--second"]) starts it again.
  static fun currentCommand() : open List<string> => __io.selfCommand()
  static fun currentPid() : int => __io.currentPid()
}

// Says how a program is to be started, then starts it.
class ProcessBuilder {
  // Where a stream of the new program goes, for redirectInput, redirectOutput and redirectError.
  static {
    const pipe = "pipe"           // this program reads or writes it (the default)
    const inherit = "inherit"     // the same place as this program's own
    const discard = "discard"     // nowhere
  }

  private var parts : List<string>
  private var folder : string? = null
  private var input = "pipe"
  private var output = "pipe"
  private var error = "pipe"
  private val variables : open Map<string, string?> = {:}

  // ProcessBuilder("git", "status") or ProcessBuilder(["git", "status"]).
  fun init(vararg command : any) {
    this.parts = command.size == 1 and command[0] is List ? (command[0] as List<string>).toList() : command as List<string>
  }

  fun command() : List<string> => parts

  // The folder the program starts in; this program's own if none is given.
  fun directory(folder : any) : ProcessBuilder {
    this.folder = folder is File ? folder.path : "$folder"
    return this
  }

  // Changes to the environment the program gets, which is otherwise this program's: a map
  // to put names and values in. A value of null takes the name out.
  fun environment() : open Map<string, string?> => variables

  // Sends what the program writes as errors to the same place as its ordinary output.
  fun redirectErrorStream(merge : bool = true) : ProcessBuilder {
    error = merge ? "merge" : "pipe"
    return this
  }

  // Each takes ProcessBuilder.pipe, .inherit or .discard, or a File to read from or write to.
  fun redirectInput(source : any) : ProcessBuilder {
    input = source is File ? "<" + source.path : "$source"
    return this
  }

  fun redirectOutput(target : any) : ProcessBuilder {
    output = target is File ? ">" + target.path : "$target"
    return this
  }

  fun redirectError(target : any) : ProcessBuilder {
    error = target is File ? ">" + target.path : "$target"
    return this
  }

  // All three streams go where this program's own go.
  fun inheritIO() : ProcessBuilder {
    input = "inherit"
    output = "inherit"
    error = "inherit"
    return this
  }

  fun start() : Process {
    if (parts.isEmpty()) { throw Error("ProcessBuilder has no program to start") }
    return Process(__io.spawn(parts, folder, input, output, error, variables))
  }
}

// ---- Sockets ----

// One end of a TCP connection.
//
//   val socket = Socket("example.org", 80)
//   socket.outputStream.write("GET / HTTP/1.0\r\n\r\n")
//   print(socket.inputStream.readLine())
//   socket.close()
class Socket {
  private var handle : any? = null
  private var input : InputStream? = null
  private var output : OutputStream? = null
  private var readLimit = 0

  // Socket(host, port) connects at once; Socket() waits for connect().
  fun init(host : string? = null, port : int = 0) {
    if (host != null) { connect(host, port) }
  }

  // With a time limit in milliseconds, gives up when it runs out.
  fun connect(host : string, port : int, timeout : int? = null) : Socket {
    if (handle != null) { throw IOException("the socket is already connected") }
    adopt(__io.connect(host, port, timeout))
    return this
  }

  // Takes over a connection the system has already made.
  fun adopt(connection : any) : Socket {
    handle = connection
    input = InputStream(connection)
    output = OutputStream(connection)
    if (readLimit > 0) { __io.socketTimeout(connection, readLimit) }
    return this
  }

  private fun connected() : any {
    val held = handle
    if (held == null) { throw IOException("the socket is not connected") }
    return held
  }

  get inputStream() : InputStream { connected(); return input as InputStream }
  get outputStream() : OutputStream { connected(); return output as OutputStream }
  fun getInputStream() : InputStream => inputStream
  fun getOutputStream() : OutputStream => outputStream

  get isConnected() : bool => handle != null
  get isClosed() : bool => handle != null and !__io.isOpen(handle)
  get localPort() : int => __io.socketInfo(connected())[0]
  get remoteAddress() : string => __io.socketInfo(connected())[1]
  get port() : int => __io.socketInfo(connected())[2]

  // How long a read waits before it fails, in milliseconds; 0 for as long as it takes.
  get soTimeout() : int => readLimit
  set soTimeout(millis) {
    readLimit = millis
    if (handle != null) { __io.socketTimeout(handle, millis) }
  }

  // Says that nothing more will be written: the other side reads the end.
  fun shutdownOutput() {
    __io.shutdownOutput(connected())
  }

  fun close() {
    if (handle != null) { __io.close(handle) }
  }

  fun <R> use(block : (Socket) -> R) : R {
    try {
      return block(this)
    } finally {
      close()
    }
  }
}

// A socket that waits for connections to this machine.
//
//   val server = ServerSocket(8080)
//   while (true) {
//     val client = server.accept()          // a Socket
//     thread { serve(client) }
//   }
//
// Port 0 lets the system pick a free one (see localPort). With no address it takes
// connections from anywhere; "127.0.0.1" keeps it to programs on this machine.
class ServerSocket {
  private val handle : any

  fun init(port : int = 0, backlog : int = 50, bindAddress : string? = null) {
    this.handle = __io.listen(port, bindAddress, backlog)
  }

  get localPort() : int => __io.socketInfo(handle)[0]
  get isClosed() : bool => !__io.isOpen(handle)

  // Waits for a connection and gives it.
  fun accept() : Socket => Socket().adopt(__io.accept(handle))

  // Stops listening. A thread waiting in accept() gets an IOException.
  fun close() {
    __io.close(handle)
  }

  fun <R> use(block : (ServerSocket) -> R) : R {
    try {
      return block(this)
    } finally {
      close()
    }
  }
}
