// ---- Readers, writers, processes and sockets ----
// Reading and writing a piece at a time, programs started from this one, and connections
// over the network.
//
// Anything here that waits (a read, an accept, waitFor) is written as an ordinary call:
//   - on a thread it blocks that thread, and the other threads go on;
//   - in a task on the main thread the task is set aside meanwhile, and the event loop goes
//     on, so a window stays live;
//   - on the main thread outside a task it blocks the main thread.
// The work is done by the built-in __io (io.cpp). What it hands out to stand for an open
// file, process or socket is a handle of the C++'s own, an `any` to Astra.

// ---- Character sets (D127) ----
// What text is read and written in. Astra's own text is UTF-8, the default everywhere; the
// others are for files, programs and protocols that use them (mail's Latin-1, Windows'
// UTF-16). A character the set has no place for is written as '?', and bytes that spell no
// character are read as U+FFFD.
enum Charset { utf8, latin1, ascii, utf16le, utf16be }

// ---- Reader and Writer (D119) ----

// Something to read from, bytes or text: a file, what a program writes, a socket. It reads
// ahead into a buffer of its own, so there is nothing to wrap it in.
class Reader : AutoCloseable {
  private val handle : any
  var charset : Charset         // what text is read or written in; it may change as the reading goes on

  fun init(handle : any, charset : Charset = Charset.utf8) {
    this.handle = handle
    this.charset = charset
  }

  // Up to `count` bytes as soon as there are any; null at the end.
  fun read(count : int = 65536) : Bytes? throws IOException => __io.read(handle, count)

  // Everything up to the end, as bytes or as text.
  fun readBytes() : Bytes throws IOException => __io.readAll(handle)
  fun readText() : string throws IOException => __io.readText(handle, charset)

  // The next line without its line end; null at the end.
  fun readLine() : string? throws IOException => __io.readLine(handle, charset)

  // The lines that are left.
  fun readLines() : open List<string> throws IOException {
    val lines : open List<string> = []
    while (true) {
      val line : string? = __io.readLine(handle, charset)
      if (line == null) { break }
      lines.add(line)
    }
    return lines
  }

  fun forEachLine(action : (string) -> unit) throws IOException {
    while (true) {
      val line : string? = __io.readLine(handle, charset)
      if (line == null) { break }
      action(line)
    }
  }

  // The lines that are left as a sequence, each read when it is asked for. A read that fails
  // there throws an UncheckedIOException, its cause the IOException.
  fun lineSequence() : Sequence<string> {
    val reader = this
    return generateSequence {
      try {
        reader.readLine()
      } catch (e : IOException) {
        throw UncheckedIOException(e)
      }
    }
  }

  // The block given the lines as a sequence, read as it goes; the reader is closed afterwards.
  fun <R> useLines(block : (Sequence<string>) -> R) : R throws IOException {
    try {
      return block(lineSequence())
    } finally {
      close()
    }
  }

  override fun close() {
    __io.close(handle)
  }

  val isOpen : bool
    get() => __io.isOpen(handle)
}

// Something to write to, bytes or text: a file, what a program reads, a socket. A write
// returns when the system has taken all of it, so flush() has nothing left to do.
class Writer : AutoCloseable {
  private val handle : any
  var charset : Charset         // what text is read or written in; it may change as the writing goes on

  fun init(handle : any, charset : Charset = Charset.utf8) {
    this.handle = handle
    this.charset = charset
  }

  // Text, or bytes. Anything else is written as print would show it.
  fun write(data : any?) throws IOException {
    __io.write(handle, data, charset)
  }

  fun print(value : any?) throws IOException {
    __io.write(handle, "$value", charset)
  }

  fun println(value : any? = "") throws IOException {
    __io.write(handle, "$value\n", charset)
  }

  fun newLine() throws IOException {
    __io.write(handle, "\n", charset)
  }

  fun append(value : any?) : Writer throws IOException {
    __io.write(handle, "$value", charset)
    return this
  }

  fun flush() {
  }

  override fun close() {
    __io.close(handle)
  }

  val isOpen : bool
    get() => __io.isOpen(handle)
}

// ---- Processes (D91) ----

// Where a stream of a program started from this one goes: pipe (this program reads or writes
// it, the default), inherit (the same place as this program's own), discard (nowhere), and for
// errors toOutput (into the output). A Path in their place reads or writes that file.
enum Stream { pipe, inherit, discard, toOutput }

// A program started from this one.
//
//   val git = Process("git", "status", directory = repo)
//   for line in git.output.readLines() { print(line) }
//   print("exit code", git.waitFor())
//
//   val result = Process.run("git", "status", directory = repo)   // runs it to its end
//   if (result.exitCode == 0) { print(result.output) }
//
// The command is the program and its arguments, as separate words or one list. `environment`
// holds variables added to this program's own (null takes one out). input is what the
// program reads, a Writer; output and error what it writes, Readers; each is there when it is
// a pipe.
class Process {
  private val handle : any
  private val toProgram : Writer?
  private val fromProgram : Reader?
  private val fromErrors : Reader?

  fun init(vararg command : any, directory : (Path | string)? = null, environment : Map<string, string?>? = null,
           input : Stream | Path = Stream.pipe, output : Stream | Path = Stream.pipe, error : Stream | Path = Stream.pipe,
           charset : Charset = Charset.utf8) throws IOException {
    val words = __processWords(command)
    val handles : List<any?> = __io.spawn(words, directory == null ? null : "$directory", __redirect(input, "input", "<"),
                                         __redirect(output, "output", ">"), __redirect(error, "error", ">"), environment)
    this.handle = handles[0] as any
    this.toProgram = handles[1] == null ? null : Writer(handles[1] as any, charset)
    this.fromProgram = handles[2] == null ? null : Reader(handles[2] as any, charset)
    this.fromErrors = handles[3] == null ? null : Reader(handles[3] as any, charset)
  }

  static {
    // Runs a program to its end and gives what it wrote, as text: Process(...)'s arguments,
    // its output and errors read whatever they are said to be, and its input nothing unless
    // said.
    fun run(vararg command : any, directory : (Path | string)? = null, environment : Map<string, string?>? = null,
            input : Stream | Path = Stream.discard, error : Stream | Path = Stream.pipe, charset : Charset = Charset.utf8) : ProcessResult throws IOException {
      val words = __processWords(command)
      val handles : List<any?> = __io.spawn(words, directory == null ? null : "$directory", __redirect(input, "input", "<"),
                                           "pipe", __redirect(error, "error", ">"), environment)
      if (handles[1] != null) { __io.close(handles[1] as any) }
      val ended : List<any?> = __io.collect(handles[0], handles[2], handles[3], charset)
      for k in 0..3 {
        if (k != 1 and handles[k] != null) { __io.close(handles[k] as any) }
      }
      return ProcessResult(ended[0] as int, ended[1] as string, ended[2] as string)
    }

    // What started this program: the path of its executable and, when it is a script run by
    // astra, the script. Process(Process.currentCommand() + ["--second"]) starts it again.
    fun currentCommand() : open List<string> => __io.selfCommand()
    fun currentPid() : int => __io.currentPid()
  }

  // What the program reads, writes and writes as errors, where each is a pipe.
  val input : Writer
    get() => toProgram ?: throw IllegalStateException("the program's input was not a pipe: start it with input = pipe to write to it")
  val output : Reader
    get() => fromProgram ?: throw IllegalStateException("the program's output was not a pipe: start it with output = pipe to read it")
  val error : Reader
    get() => fromErrors ?: throw IllegalStateException("the program's errors were not a pipe: start it with error = pipe to read them")

  // Waits for the program to end and gives its exit code; with a time limit, null if it is
  // still running when the time is up.
  fun waitFor() : int => __io.processWait(handle) as int
  fun waitFor(timeout : Duration) : int? => __io.processWait(handle, timeout.inWholeMilliseconds)

  // Its exit code once it has ended; null while it runs.
  val exitCode : int?
    get() => __io.processWait(handle, 0)

  val isAlive : bool
    get() => __io.processAlive(handle)
  val pid : int
    get() => __io.processId(handle)

  // Ends the program now.
  fun kill() {
    __io.processKill(handle)
  }
}

// What a program run to its end with Process.run gave.
data ProcessResult(val exitCode : int, val output : string, val error : string)

// The command's words: separate ones, or one list.
fun __processWords(command : List<any>) : List<string> {
  val words : List<any> = command.size == 1 and command[0] is List ? command[0] as List<any> : command
  if (words.isEmpty()) { throw IllegalArgumentException("a process is started from its command: the program, then its arguments") }
  return words.map { "$it" }
}

// What io.cpp is told for a stream: "pipe", "inherit", "discard", "merge", or a file.
fun __redirect(target : Stream | Path, which : string, toFile : string) : string {
  if (target is Path) { return toFile + target.text }
  return when (target as Stream) {
    Stream.pipe -> "pipe"
    Stream.inherit -> "inherit"
    Stream.discard -> "discard"
    Stream.toOutput -> {
      if (which != "error") { throw IllegalArgumentException("toOutput is for a program's errors, not its $which") }
      "merge"
    }
  }
}

// ---- Sockets (D120) ----

// One end of a TCP connection.
//
//   Socket("example.org", 80).use { socket ->
//     socket.writer.write("GET / HTTP/1.0\r\n\r\n")
//     print(socket.reader.readLine())
//   }
//
// Its reads and writes block the thread they run on; a server serves each connection from a
// thread or a pool's job.
class Socket : AutoCloseable {
  private var handle : any? = null
  private var input : Reader? = null
  private var output : Writer? = null
  private var readLimit : Duration? = null

  // Socket(host, port) connects at once; Socket() waits for connect().
  fun init(host : string? = null, port : int = 0) throws IOException {
    if (host != null) { connect(host, port) }
  }

  // With a time limit, gives up when it runs out.
  fun connect(host : string, port : int, timeout : Duration? = null) : Socket throws IOException {
    if (handle != null) { throw IOException("the socket is already connected") }
    adopt(__io.connect(host, port, timeout?.inWholeMilliseconds))
    return this
  }

  // Takes over a connection the system has already made.
  internal fun adopt(connection : any) : Socket {
    handle = connection
    input = Reader(connection)
    output = Writer(connection)
    val limit = readLimit
    if (limit != null) { __io.socketTimeout(connection, limit.inWholeMilliseconds) }
    return this
  }

  private fun connected() : any {
    val held = handle
    if (held == null) { throw IllegalStateException("the socket is not connected") }
    return held
  }

  // What comes from the other side, and what goes to it.
  val reader : Reader
    get() { connected(); return input as Reader }
  val writer : Writer
    get() { connected(); return output as Writer }

  val isConnected : bool
    get() => handle != null
  val isClosed : bool
    get() => handle != null and !__io.isOpen(handle)
  val localPort : int
    get() => __io.socketInfo(connected())[0] as int
  val remoteAddress : string
    get() => __io.socketInfo(connected())[1] as string
  val port : int
    get() => __io.socketInfo(connected())[2] as int

  // How long a read waits before it fails with a TimeoutException; null for as long as it
  // takes (Java's soTimeout).
  var readTimeout : Duration?
    get() => readLimit
    set(limit) {
      readLimit = limit
      val held = handle
      if (held != null) { __io.socketTimeout(held, limit == null ? 0 : limit.inWholeMilliseconds) }
    }

  // Says that nothing more will be written: the other side reads the end.
  fun shutdownOutput() throws IOException {
    __io.shutdownOutput(connected())
  }

  override fun close() {
    val held = handle
    if (held != null) { __io.close(held) }
  }
}

// A socket that waits for connections to this machine.
//
//   val server = ServerSocket(8080)
//   while (true) {
//     val client = server.accept()          // a Socket
//     thread { serve(client) }
//   }
//
// Port 0 lets the system pick a free one (see localPort). With no address it takes
// connections from anywhere; "127.0.0.1" keeps it to programs on this machine.
class ServerSocket : AutoCloseable {
  private val handle : any

  fun init(port : int = 0, backlog : int = 50, bindAddress : string? = null) throws IOException {
    this.handle = __io.listen(port, bindAddress, backlog)
  }

  val localPort : int
    get() => __io.socketInfo(handle)[0] as int
  val isClosed : bool
    get() => !__io.isOpen(handle)

  // Waits for a connection and gives it.
  fun accept() : Socket throws IOException => Socket().adopt(__io.accept(handle))

  // Stops listening. A thread waiting in accept() gets an IOException.
  override fun close() {
    __io.close(handle)
  }
}

// What the classes above are built on (io.cpp), declared with its types and what it throws.
// A handle is a number of the C++'s own.
external object __io {
  fun open(path : string, mode : string) : any throws IOException
  fun read(handle : any, count : int) : Bytes? throws IOException
  fun readAll(handle : any) : Bytes throws IOException
  fun readText(handle : any, charset : Charset = Charset.utf8) : string throws IOException
  fun readLine(handle : any, charset : Charset = Charset.utf8) : string? throws IOException
  fun write(handle : any, data : any?, charset : Charset = Charset.utf8) throws IOException
  fun close(handle : any)
  fun isOpen(handle : any?) : bool
  fun spawn(command : List<string>, directory : string?, input : string, output : string, error : string,
            environment : Map<string, string?>?) : List<any?> throws IOException
  fun collect(process : any?, output : any?, error : any?, charset : Charset) : List<any?> throws IOException
  fun processWait(handle : any, timeout : int? = null) : int?
  fun processAlive(handle : any) : bool
  fun processKill(handle : any)
  fun processId(handle : any) : int
  fun currentPid() : int
  fun selfCommand() : open List<string>
  fun connect(host : string, port : int, timeout : int? = null) : any throws IOException
  fun listen(port : int, bindAddress : string? = null, backlog : int = 50) : any throws IOException
  fun accept(handle : any) : any throws IOException
  fun socketInfo(handle : any) : List<any?>
  fun socketTimeout(handle : any, millis : int)
  fun shutdownOutput(handle : any) throws IOException
}
