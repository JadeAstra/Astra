// The standard library, the part written in Astra. These files are packed into astra.exe by
// the build and loaded before every program, after the prelude in compiler.cpp. The names
// are Kotlin's, so that code ported from it reads the same.
//
// Inside an extension function a bare name is looked for on `this` first. The library
// writes `this.` out, which goes straight to the member.

// ---- Small values that functions hand out ----

// Two values, made with `a to b` or Pair(a, b).
value Pair<A, B>(val first : A, val second : B) {
  fun toList() : open List<any?> => [first, second]
}

value Triple<A, B, C>(val first : A, val second : B, val third : C) {
  fun toList() : open List<any?> => [first, second, third]
}

// One key of a map with its value: what map.entries holds.
value MapEntry<K, V>(val key : K, val value : V) {
  fun toPair() : Pair<K, V> => Pair(key, value)
}

// An item with its position: what withIndex() gives.
value IndexedValue<T>(val index : int, val value : T)

// Thrown when the system cannot give the program the memory it asks for: a list, a string or
// a buffer too large. Like any error, it can be caught.
class OutOfMemoryError(message : string = "out of memory") : Error(message)

// ---- Checks ----

// Each throws an Error unless the condition holds. The message is a function, so that it is
// only worked out when it is needed: require(n > 0) { "n is $n" }
fun require(condition : bool, lazyMessage : (() -> any?)? = null) {
  if (!condition) { throw Error(lazyMessage == null ? "Failed requirement." : "${lazyMessage()}") }
}

fun check(condition : bool, lazyMessage : (() -> any?)? = null) {
  if (!condition) { throw Error(lazyMessage == null ? "Check failed." : "${lazyMessage()}") }
}

fun <T> requireNotNull(value : T?, lazyMessage : (() -> any?)? = null) : T {
  if (value == null) { throw Error(lazyMessage == null ? "Required value was null." : "${lazyMessage()}") }
  return value
}

fun <T> checkNotNull(value : T?, lazyMessage : (() -> any?)? = null) : T {
  if (value == null) { throw Error(lazyMessage == null ? "Required value was null." : "${lazyMessage()}") }
  return value
}

fun error(message : any?) : nothing {
  throw Error("$message")
}

// Runs `action` that many times, giving it 0, 1, 2 and so on.
fun repeat(times : int, action : (int) -> unit) {
  for index in 0..<times { action(index) }
}

// ---- Every value ----

fun any?.toString() : string => "$this"
fun any?.equals(other : any?) : bool => this == other
// Equal values give equal hashes: by what they hold for strings, numbers, frozen collections,
// data classes and values; an object of any other class by which object it is (D26).
fun any?.hashCode() : int => __hashCode(this)
fun any.compareTo(other : any?) : int => compareValues(this, other)
fun <T> T.takeIf(predicate : (T) -> bool) : T? => predicate(this) ? this : null
fun <T> T.takeUnless(predicate : (T) -> bool) : T? => predicate(this) ? null : this

// For a string, a list, a map or a set that may be null. It is one function for all of them,
// since null does not say which of them it would have been.
fun any?.isNullOrEmpty() : bool {
  if (this == null) { return true }
  if (this is string) { return this.isEmpty() }
  if (this is List) { return this.isEmpty() }
  if (this is Map) { return this.isEmpty() }
  if (this is Set) { return this.isEmpty() }
  return false
}

// ---- Functions ----

// callback.invoke(a, b) is callback(a, b); with ?. it calls a function that may be null.
fun Function.invoke(vararg arguments : any?) : any? {
  val callee = this
  return callee(*arguments)
}

// ---- Comparators ----
// A comparator is a function of two values that gives a negative number, zero or a positive
// one. sort, sortedWith and the like take one.

// Orders by what each selector gives, the first that tells two values apart deciding.
fun <T> compareBy(vararg selectors : (T) -> any?) : (T, T) -> int {
  return { a, b ->
    var order = 0
    for selector in selectors {
      order = compareValues(selector(a), selector(b))
      if (order != 0) { break }
    }
    order
  }
}

fun <T> compareByDescending(selector : (T) -> any?) : (T, T) -> int => { a, b -> compareValues(selector(b), selector(a)) }
fun <T> naturalOrder() : (T, T) -> int => { a, b -> compareValues(a, b) }
fun <T> reverseOrder() : (T, T) -> int => { a, b -> compareValues(b, a) }

fun Function.compare(a : any?, b : any?) : int {
  val comparator = this
  return comparator(a, b)
}

// A comparator that falls back on a selector, or on another comparator, where this one
// finds two values equal.
fun <T> Function.thenBy(selector : (T) -> any?) : (T, T) -> int {
  val first = this
  return { a, b ->
    val order : int = first(a, b)
    order != 0 ? order : compareValues(selector(a), selector(b))
  }
}

fun <T> Function.thenByDescending(selector : (T) -> any?) : (T, T) -> int {
  val first = this
  return { a, b ->
    val order : int = first(a, b)
    order != 0 ? order : compareValues(selector(b), selector(a))
  }
}

fun <T> Function.then(comparator : (T, T) -> int) : (T, T) -> int {
  val first = this
  return { a, b ->
    val order : int = first(a, b)
    order != 0 ? order : comparator(a, b)
  }
}

fun <T> Function.reversed() : (T, T) -> int {
  val comparator = this
  return { a, b -> comparator(b, a) }
}

// ---- Making collections ----

fun <T> listOf(vararg items : T) : open List<T> => items
fun <T> mutableListOf(vararg items : T) : open List<T> => items
fun <T> arrayListOf(vararg items : T) : open List<T> => items
fun <T> emptyList() : List<T> => []
fun <T> listOfNotNull(vararg items : T?) : open List<T> => items.filterNotNull()

// List(3) { it * 2 } is [0, 2, 4]: `size` items, each worked out from its position.
fun <T> List(size : int, init : (int) -> T) : open List<T> {
  val out : open List<T> = []
  for index in 0..<size { out.add(init(index)) }
  return out
}

fun <T> MutableList(size : int, init : (int) -> T) : open List<T> => List(size, init)

// mapOf("a" to 1, "b" to 2)
fun <K, V> mapOf(vararg pairs : Pair<K, V>) : open Map<K, V> {
  val out : open Map<K, V> = {:}
  for (key, value) in pairs { out[key] = value }
  return out
}

fun <K, V> mutableMapOf(vararg pairs : Pair<K, V>) : open Map<K, V> => mapOf(*pairs)
fun <K, V> hashMapOf(vararg pairs : Pair<K, V>) : open Map<K, V> => mapOf(*pairs)
fun <K, V> linkedMapOf(vararg pairs : Pair<K, V>) : open Map<K, V> => mapOf(*pairs)
fun <K, V> emptyMap() : Map<K, V> => {:}

fun <T> setOf(vararg items : T) : open Set<T> => Set(items)
fun <T> mutableSetOf(vararg items : T) : open Set<T> => Set(items)
fun <T> hashSetOf(vararg items : T) : open Set<T> => Set(items)
fun <T> linkedSetOf(vararg items : T) : open Set<T> => Set(items)
fun <T> emptySet() : Set<T> => Set()

// Each runs the lambda on a new collection, so that add(...), put(...) or append(...) inside
// it fill that collection, and gives what was built.
fun <T> buildList(builder : open List<T>.() -> unit) : open List<T> {
  val out : open List<T> = []
  with(out, builder)
  return out
}

fun <K, V> buildMap(builder : open Map<K, V>.() -> unit) : open Map<K, V> {
  val out : open Map<K, V> = {:}
  with(out, builder)
  return out
}

fun <T> buildSet(builder : open Set<T>.() -> unit) : open Set<T> {
  val out : open Set<T> = Set()
  with(out, builder)
  return out
}

fun buildString(builder : StringBuilder.() -> unit) : string {
  val out = StringBuilder()
  with(out, builder)
  return out.toString()
}
