// Animation on several cores: tens of thousands of balls bouncing around a window. The balls
// are moved by workers, each with a share of them and a core of its own, and this program
// only draws. Click to add a hundred more; Space pauses.
//
// Threads would not do here: they take turns at running Astra code. A worker is a second
// copy of the runtime, so the moving and the drawing really happen at the same time. The
// workers run bounce_worker.astra. They move their balls sixty times a second whatever this
// program is doing, and say where the balls are whenever it asks, which is once a frame.
//
// bounce.astra is the same thing in one loop on one core, and bounce_threads.astra
// with threads.
import Jade.*

val startingBalls = 50000
val workerCount = 3
val palette = [Color.red, Color.blue, Color.green, Color.orange, Color(160, 60, 200), Color.cyan, Color.pink]

// What this program knows of one worker's balls: how big each is, told once when it is made,
// and where each was when the worker last said (x then y for each, in one list).
class Share(val worker : Worker, val number : int) {
  val radii : List<Number> = []
  var places : List<Number> = []
  var moves = 0          // how often the worker has moved its balls since this was last looked at
  var asked = false      // a request for the places is on its way, or its answer is
}

val shares = (0..<workerCount).map { n ->
  // A daemon: the workers do not keep the program going once the window is closed.
  val share = Share(Worker("bounce_worker.astra", isDaemon = true), n)
  share.worker.onMessage = { message ->
    val got = message as Map<string, any?>
    if (got.containsKey("added")) { share.radii.addAll(got["added"] as List<Number>) }
    if (got.containsKey("at")) {
      share.places = got["at"] as List<Number>
      share.moves += got["moves"] as int
      share.asked = false
    }
  }
  share
}

// Each worker makes its own balls: nothing goes from here but the request.
fun addBalls(count : int, x : Number? = null, y : Number? = null) {
  for (n, share) in shares.withIndex() {
    val part = count / workerCount + (n < count % workerCount ? 1 : 0)
    if part > 0 { share.worker.post({"add": part, "x": x, "y": y}) }
  }
}

// ---- The window ----
val window = NativeWindow("Bounce", 780, 580)
val background = Color(0x202830)
val statusFont = Font("Segoe UI", Font.plain, 12)
val statusHeight = 24

var paused = false
window.onInput = { event ->
  if event is RawInput.PointerDown { addBalls(100, event.x, event.y) }
  if event is RawInput.KeyDown and event.key == KeyCode.space and !event.repeat {
    paused = !paused
    shares.forEach { it.worker.post({"paused": paused}) }
  }
}

var width = 0
var height = 0
var frames = 0
var measuredAt = clock()
var rates = "measuring..."

// Draws the balls where the workers last said they were, and asks where they are now.
fun frame() {
  val canvas = window.canvas()
  val w = canvas.width
  val h = canvas.height - statusHeight
  if w != width or h != height {
    width = w
    height = h
    shares.forEach { it.worker.post({"size": [w, h]}) }
  }

  canvas.color = background
  canvas.fillRect(0, 0, w, h)
  var count = 0
  for share in shares {
    val places = share.places
    val radii = share.radii
    val known = Math.min(places.size / 2, radii.size)
    for i in 0..<known {
      // Colours go round by the ball's place among all the balls, as in the other versions,
      // not by which worker moves it.
      canvas.color = palette[(i * workerCount + share.number) % palette.size]
      val radius = radii[i]
      canvas.fillOval(places[2 * i] - radius, places[2 * i + 1] - radius, 2 * radius, 2 * radius)
    }
    count += known
    // One request at a time: a worker is never sent more than this program can draw.
    if !share.asked {
      share.asked = true
      share.worker.post({"where": true})
    }
  }

  // Once a second: how many frames were drawn, and how often each worker moved its balls.
  frames += 1
  val now = clock()
  if now - measuredAt >= 1 {
    val seconds = now - measuredAt
    rates = "%.0f frames and %.0f moves a second".format(frames / seconds, shares.sumOf { it.moves } / seconds / workerCount)
    shares.forEach { it.moves = 0 }
    frames = 0
    measuredAt = now
  }
  val status = "$count balls on $workerCount workers: $rates" + (paused ? " (paused)" : "") + ". Click for more; Space pauses."
  canvas.color = Color(0x101418)
  canvas.fillRect(0, h, w, statusHeight)
  canvas.color = Color(0xC9D1D9)
  canvas.font = statusFont
  canvas.drawString(status, 8, h + 16)
  window.present()
}


addBalls(startingBalls)
// While an edge is dragged the window is drawn at every size it passes through, not only
// when the timer next comes round.
window.onResize = { width, height -> frame() }
window.show()
// Sixty times a second, or as often as the screen shows a new picture. When the window
// is closed the timer is called off, and with nothing left to wait for the program ends.
val timer = EventLoop.every(16, frame)
window.onCloseRequest = {
  timer.cancel()
  window.close()
}
