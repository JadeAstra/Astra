// Animation with tasks: tens of thousands of balls bouncing around a window. Each of a few
// tasks moves its own share of the balls, waits a sixtieth of a second, and moves them again,
// for as long as the program runs. Click to add a hundred more; Space pauses.
//
// A task is a function that sets itself aside while it waits and goes on later where it was
// (Kotlin's coroutine). These tasks wait with delay(), which on the main thread sets the task
// aside and lets the event loop go on: the frame timer runs, the window takes its input, and
// a sixtieth of a second later the task takes up its loop again. Everything happens on the
// main thread, one thing at a time, so nothing needs a lock or a volatile variable, and no
// thread is made. Each mover reads like a loop of its own, though none of them holds a thread.
//
// A task has a stack of its own, a megabyte or so, which is why there are a few tasks each
// moving a group of balls rather than a task for every ball.
//
// Where `suspend` would go if Astra required it, as Kotlin does: nowhere in this file. The one
// function here that waits is delay(), which the standard library declares `suspend fun
// delay`; the call where the task is set aside is marked `// suspends`, and the block given to
// task { }, which is the task's own code, is what Kotlin types a suspend lambda, with nothing
// written. examples/dots.astra has waiting functions of its own, each written `suspend fun`.
//
// bounce.astra is the same thing in one loop, bounce_threads.astra with threads, and
// bounce_workers.astra with workers on other cores.
import Jade.*

val startingBalls = 50000
val taskCount = 4

class Ball(var x : Number, var y : Number, var dx : Number, var dy : Number, val radius : Number, val color : Color) {
  // Moves on by `steps` sixtieths of a second, turning back at the edges.
  fun move(width : Number, height : Number, steps : Number) {
    x += dx * steps
    y += dy * steps
    if x < radius { x = radius; dx = dx.absoluteValue }
    if x > width - radius { x = Math.max(radius, width - radius); dx = -dx.absoluteValue }
    if y < radius { y = radius; dy = dy.absoluteValue }
    if y > height - radius { y = Math.max(radius, height - radius); dy = -dy.absoluteValue }
  }
}

val palette = [Color.red, Color.blue, Color.green, Color.orange, Color(160, 60, 200), Color.cyan, Color.pink]

// Each task moves the balls of one group. All of this lives on the main thread.
val groups = List(taskCount) { [] }
var ballCount = 0
var width : Number = 760.0
var height : Number = 520.0
var paused = false
var running = true                   // the tasks go round until the window is closed
var moves = 0                        // how many times a group has been moved, for the status line

fun addBall(x : Number, y : Number) {
  val speed = 1 + Math.random() * 3
  val angle = Math.random() * 2 * Math.pi
  val ball = Ball(x, y, Math.cos(angle) * speed, Math.sin(angle) * speed, 3 + Math.randomInt(0, 4), palette[ballCount % palette.size])
  groups[ballCount % taskCount].add(ball)
  ballCount += 1
}

// ---- The tasks that move the balls ----
// Each goes round up to sixty times a second. It measures how long it really was since last
// time, so the balls keep their speed when a frame takes longer and the task gets its turn late.
// delay() is called like any other function; the task is set aside inside it.
for group in groups {
  task {                                     // a suspend lambda: the task's own code
    var last = clock()
    while (running) {
      val now = clock()
      val elapsed = Math.min((now - last) * 60, 6)      // in sixtieths of a second
      last = now
      if !paused {
        for ball in group { ball.move(width, height, elapsed) }
        moves += 1
      }
      delay(16.milliseconds)                                        // suspends
    }
  }
}

// ---- The window ----
val window = NativeWindow("Bounce", 780, 580)
val background = Color(0x202830)
val statusFont = Font("Segoe UI", Font.plain, 12)
val statusHeight = 24

window.onInput = { event ->
  if event is RawInput.PointerDown { repeat(100) { addBall(event.x, event.y) } }
  if event is RawInput.KeyDown and event.key == KeyCode.space and !event.repeat { paused = !paused }
}

var frames = 0
var measuredAt = clock()
var rates = "measuring..."

// Draws the balls where the tasks have put them.
fun frame() {
  val canvas = window.canvas()
  val w = canvas.width
  val h = canvas.height - statusHeight
  width = w
  height = h
  canvas.color = background
  canvas.fillRect(0, 0, w, h)
  for group in groups {
    for ball in group {
      canvas.color = ball.color
      canvas.fillOval(ball.x - ball.radius, ball.y - ball.radius, 2 * ball.radius, 2 * ball.radius)
    }
  }

  // Once a second: how many frames were drawn, and how often each task moved its balls.
  frames += 1
  val now = clock()
  if now - measuredAt >= 1 {
    val seconds = now - measuredAt
    rates = "%.0f frames and %.0f moves a second".format(frames / seconds, moves / seconds / taskCount)
    frames = 0
    moves = 0
    measuredAt = now
  }
  val status = "$ballCount balls in $taskCount tasks: $rates" + (paused ? " (paused)" : "") + ". Click for more; Space pauses."
  canvas.color = Color(0x101418)
  canvas.fillRect(0, h, w, statusHeight)
  canvas.color = Color(0xC9D1D9)
  canvas.font = statusFont
  canvas.drawString(status, 8, h + 16)
  window.present()
}

repeat(startingBalls) { addBall(Math.random() * width, Math.random() * height) }
// While an edge is dragged the window is drawn at every size it passes through, not only
// when the timer next comes round.
window.onResize = { width, height -> frame() }
window.show()
// Sixty times a second, or as often as the screen shows a new picture. When the window is
// closed the timer is called off and the tasks are told to stop: a task waiting in delay()
// waits on a timer of the event loop, which keeps the program alive like any other timer, so
// each task finishes its loop at its next turn, and with nothing left to wait for the program ends.
val timer = EventLoop.every(16.milliseconds, frame)
window.onCloseRequest = {
  timer.cancel()
  running = false
  window.close()
}
