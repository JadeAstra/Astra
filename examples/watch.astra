// Three things going on at once: a program started from this one and read line by line, a
// thread counting in the background, and the event loop ticking. Nothing waits for anything
// else: reading the other program's output sets the flow aside, it does not stop the loop.
//
// Run with no argument. (With "work" the program plays the part of the one that is started.)

if (args().contains("work")) {
  // The other program: five steps, a little apart.
  for step in 1..5 {
    Thread.sleep(120)
    print("step $step of 5")
    flush()                     // what is printed to another program is sent on when asked
  }
  exit(3)
}

// ---- A thread that works on its own, and shares a counter with the rest ----
val lock = Lock()
var checks = 0
var working = true
val checker = thread(name = "checker", isDaemon = true) {
  while (working) {
    synchronized(lock) { checks += 1 }       // shared with the main thread, so under a lock
    Thread.sleep(10)
  }
}

// ---- The event loop, ticking ----
var ticks = 0
val ticker = EventLoop.every(50) { ticks += 1 }

// ---- The other program, read in a flow ----
// A flow runs later, where nothing can catch what goes wrong in it: it catches its own.
startCoroutine {
  val started = clock()
  try {
    val worker = ProcessBuilder(Process.currentCommand() + ["work"]).start()
    print("started process", worker.pid())

    // readLine() sets this flow aside until a line arrives. The loop and the thread go on.
    while (true) {
      val line = worker.inputStream!!.readLine()
      if (line == null) { break }
      val soFar = synchronized(lock) { checks }
      print("  %-12s (%d ticks, %d checks so far)".format(line, ticks, soFar))
    }

    val code = worker.waitFor()
    print("it ended with exit code $code after %.1f seconds".format(clock() - started))
  } catch (e : IOException) {
    print("the other program could not be run: ${e.message}")
  }
  working = false
  ticker.cancel()
  print("meanwhile the loop ticked $ticks times and the thread checked $checks times")
}

print("the script has reached its end; the flow, the thread and the loop carry on")
