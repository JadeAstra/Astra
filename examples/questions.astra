// A task that asks two questions in turn. The questions are answered through callbacks, as
// a dialog in a window would answer: asking returns at once and the answer comes later. The
// task is written top to bottom all the same, with no callback inside a callback.
//
// Type an answer and press Enter for each question.

// ---- Something that asks and answers later ----
// A thread reads what is typed, and hands each line to whoever asked, on the main thread.
val waiting = Channel<(string) -> unit>.unbounded()

// Asks a question. `done` is called with the answer, later, on the main thread.
fun prompt(question : string, done : (string) -> unit) {
  write(question + " ")
  flush()
  waiting.trySend(done)        // an unbounded channel takes it at once
}

thread(name = "reader", daemon = true) {
  while (true) {
    val done = waiting.receive()
    val line = input()
    EventLoop.post { done(line == null ? "" : line.trim()) }
  }
}

// ---- The same, as a function a task can simply call ----
// suspendTask sets the task aside and hands over `resume`; calling it gives the task its answer
// and takes it up again where it was.
suspend fun ask(question : string) : string => suspendTask { resume ->
  prompt(question) { answer -> resume(answer) }
}

// ---- While it waits, the program is not stuck ----
var beats = 0
val heart = EventLoop.every(100.milliseconds) { beats += 1 }

task {
  val name = ask("What is your name?")
  val colour = ask("And your favourite colour, ${name.ifBlank { "stranger" }}?")
  heart.cancel()
  print()
  print("Hello, ${name.ifBlank { "stranger" }}. ${colour.ifBlank { "No colour" }.replaceFirstChar { it.upper() }} it is.")
  print("While you were typing, the event loop ran $beats times.")
}
