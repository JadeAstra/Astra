// Custom error classes, try/catch, closures and maps.

class InsufficientFunds : Error {
  val shortfall : number

  fun init(needed : number, available : number) {
    super.init("need ${needed} but only ${available} available")
    this.shortfall = needed - available
  }
}

class Account(val owner : string, var balance : number) {
  val history : list = []

  fun deposit(amount : number) : Account {
    if amount <= 0 { throw Error("deposit must be positive") }
    this.balance += amount
    this.history.push({kind: "deposit", amount: amount})
    return this
  }

  fun withdraw(amount : number) : Account {
    if amount > this.balance { throw InsufficientFunds(amount, this.balance) }
    this.balance -= amount
    this.history.push({kind: "withdraw", amount: amount})
    return this
  }

  fun toString() : string => "${this.owner}: ${this.balance}"
}

class Bank {
  val accounts : map = {}

  fun open(owner : string, balance : number) : Account {
    this.accounts[owner] = Account(owner, balance)
    return this.accounts[owner]
  }

  fun transfer(from : string, to : string, amount : number) {
    val source : Account? = this.accounts[from]
    val target : Account? = this.accounts[to]
    if source == null || target == null { throw Error("unknown account") }
    source.withdraw(amount)
    target.deposit(amount)
  }
}

val bank : Bank = Bank()
bank.open("ada", 100)
bank.open("grace", 20)

// Each attempt reports how it went instead of stopping the program.
fun attempt(label : string, action : function) {
  try {
    action()
    print("ok      ", label)
  } catch (e) {
    if e is InsufficientFunds {
      print("declined", label, "- short by", e.shortfall)
    } else {
      print("failed  ", label, "-", e.message)
    }
  }
}

attempt("ada -> grace 30", fun() { bank.transfer("ada", "grace", 30) })
attempt("grace -> ada 500", fun() { bank.transfer("grace", "ada", 500) })
attempt("ada -> nobody 1", fun() { bank.transfer("ada", "nobody", 1) })
attempt("deposit -5", fun() { bank.accounts["ada"].deposit(-5) })
attempt("deposit \"ten\"", fun() { bank.accounts["ada"].deposit("ten") })

for owner in bank.accounts {
  val account : Account = bank.accounts[owner]
  print(account, "after", account.history.length, "transaction(s)")
}
