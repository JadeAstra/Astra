// A small bank: an enum, a data class, an object, errors of our own, try / catch / finally
// and lambdas.

enum Kind { paidIn, paidOut }

data Entry(val kind : Kind, val amount : Number)

class InsufficientFunds(val needed : Number, val available : Number)
    : Error("need $needed but only $available available") {
  val shortfall = needed - available
}

class Account(val owner : string, var balance : Number = 0) {
  val history = []

  fun deposit(amount : Number) : Account {
    if amount <= 0 { throw Error("a deposit has to be more than nothing") }
    balance += amount
    history.add(Entry(paidIn, amount))         // the parameter is a Kind, so the bare name will do
    return this
  }

  fun withdraw(amount : Number) : Account {
    if amount > balance { throw InsufficientFunds(amount, balance) }
    balance -= amount
    history.add(Entry(paidOut, amount))
    return this
  }

  fun total(kind : Kind) => history.filter { it.kind == kind }.sumOf { it.amount }

  override fun toString() => "%-6s %7.2f".format(owner, balance)
}

// One bank, so an object rather than a class.
object Bank {
  val accounts = {:}

  fun open(owner : string, balance : Number = 0) : Account {
    val account = Account(owner, balance)
    accounts[owner] = account
    return account
  }

  fun find(owner : string) : Account => accounts[owner] ?: throw Error("there is no account for $owner")

  fun transfer(from : string, to : string, amount : Number) {
    val source = find(from)
    val target = find(to)
    source.withdraw(amount)
    target.deposit(amount)
  }
}

Bank.open("ada", 100)
Bank.open("grace", 20)

// Each attempt reports how it went instead of stopping the program.
var attempts = 0
fun attempt(label : string, action : () -> unit) {
  try {
    action()
    print("ok      ", label)
  } catch (e : InsufficientFunds) {
    print("declined", label, "- short by", e.shortfall)
  } catch (e) {
    print("failed  ", label, "-", e.message)
  } finally {
    attempts++
  }
}

attempt("ada -> grace 30") { Bank.transfer("ada", "grace", 30) }
attempt("grace -> ada 500") { Bank.transfer("grace", "ada", 500) }
attempt("ada -> nobody 1") { Bank.transfer("ada", "nobody", 1) }
attempt("deposit -5") { Bank.find("ada").deposit(-5) }
// deposit("ten") is not tried: deposit takes a Number, which is checked when compiling.

print(attempts, "attempts")
for account in (Bank.accounts.values.sortedByDescending { it.balance }) {
  print(account, "- paid in ${account.total(paidIn)}, paid out ${account.total(paidOut)}")
  account.history.forEach { print("   ", it) }
}
print("in the bank altogether:", Bank.accounts.values.sumOf { it.balance })
