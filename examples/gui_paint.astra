// Drawing with the mouse on a canvas. Drag to draw; the buttons pick a colour.
import gui.*

val window = Window("Paint", 560, 420)

val tools = window.row()
var color = Color.black
var thickness = 3
for (name, shade) in mapOf("Black" to Color.black, "Red" to Color.red, "Green" to Color.green, "Blue" to Color.blue).entries {
  tools.button(name, { color = shade }, width = 70)
}
val thick = tools.checkBox("Thick", onChange = { on -> thickness = on ? 9 : 3 })
tools.spacer()
tools.button("Clear", { canvas.clear() })

val canvas = window.canvas(fill = true)
val hint = window.label("Drag on the white area to draw.")

// The last point of the stroke being drawn, or null between strokes.
var lastX = null
var lastY = null

canvas.onMouseDown = { x, y, button ->
  lastX = x
  lastY = y
  canvas.fillCircle(x, y, thickness / 2.0, color)
}

canvas.onMouseMove = { x, y, button ->
  if button == 1 and lastX != null {
    canvas.line(lastX, lastY, x, y, color, thickness)
    lastX = x
    lastY = y
  }
  hint.text = "$x, $y"
}

canvas.onMouseUp = { x, y, button ->
  lastX = null
  lastY = null
}

window.show()
App.run()
