// Animation: balls bouncing around a canvas, redrawn sixty times a second.
// Click the canvas to add a ball; Space pauses.
import gui.*

class Ball(var x : number, var y : number, var dx : number, var dy : number, val radius : number, val color : int) {
  fun move(width : number, height : number) {
    x += dx
    y += dy
    if x < radius or x > width - radius { dx = -dx }
    if y < radius or y > height - radius { dy = -dy }
    x = Math.max(radius, Math.min(x, width - radius))
    y = Math.max(radius, Math.min(y, height - radius))
  }
}

val palette = [Color.red, Color.blue, Color.green, Color.orange, Color.purple, Color.cyan, Color.pink]
val balls = []

fun addBall(x : number, y : number) {
  val speed = 2 + Math.random() * 4
  val angle = Math.random() * 2 * Math.pi
  balls.push(Ball(x, y, Math.cos(angle) * speed, Math.sin(angle) * speed,
                  10 + Math.randomInt(0, 14), palette[balls.length % palette.length]))
}

val window = Window("Bounce", 520, 400, padding = 0, spacing = 0)
val canvas = window.canvas(fill = true)
val status = window.label("  Click to add a ball. Space pauses.")

var paused = false
canvas.onMouseDown = { x, y, button -> addBall(x, y) }
canvas.onKeyDown = { key -> if key == "Space" { paused = !paused } }

fun frame() {
  val (width, height) = canvas.size()
  if !paused {
    for ball in balls { ball.move(width, height) }
  }
  canvas.clear(0x202830)
  for ball in balls { canvas.fillCircle(ball.x, ball.y, ball.radius, ball.color) }
  status.text = "  ${balls.length} balls" + (paused ? " (paused)" : "") + ". Click to add one; Space pauses."
}

for i in 0..5000 { addBall(100 + i * 60, 80 + i * 40) }
window.show()
canvas.focus()
App.every(16, frame)
App.run()
