// Animation: thousands of balls bouncing around a canvas, moved and drawn by one loop.
// Click the canvas to add a hundred more; Space pauses.
//
// This is the version with no threads at all. gui_bounce_parallel.astra is this with one
// line changed, so that every core moves balls; gui_bounce_threads.astra moves them on
// background threads, and gui_bounce_workers.astra in workers.
import gui.*

val startingBalls = 50000

class Ball(var x : number, var y : number, var dx : number, var dy : number, val radius : number, val color : int) {
  // Moves on by `steps` sixtieths of a second, turning back at the edges.
  fun move(width : number, height : number, steps : number) {
    x += dx * steps
    y += dy * steps
    if x < radius { x = radius; dx = dx.absoluteValue }
    if x > width - radius { x = Math.max(radius, width - radius); dx = -dx.absoluteValue }
    if y < radius { y = radius; dy = dy.absoluteValue }
    if y > height - radius { y = Math.max(radius, height - radius); dy = -dy.absoluteValue }
  }
}

val palette = [Color.red, Color.blue, Color.green, Color.orange, Color.purple, Color.cyan, Color.pink]
val balls = []

fun addBall(x : number, y : number) {
  val speed = 1 + Math.random() * 3
  val angle = Math.random() * 2 * Math.pi
  balls.add(Ball(x, y, Math.cos(angle) * speed, Math.sin(angle) * speed, 3 + Math.randomInt(0, 4), palette[balls.size % palette.size]))
}

val window = Window("Bounce", 780, 580, padding = 0, spacing = 0)
val canvas = window.canvas(fill = true)
val status = window.label("")

var paused = false
canvas.onMouseDown = { x, y, button -> repeat(100) { addBall(x, y) } }
canvas.onKeyDown = { key -> if key == "Space" { paused = !paused } }

var last = clock()
var frames = 0
var measuredAt = clock()
var rate = "measuring..."

// One frame: move every ball by the time that has really passed, then draw them all.
fun frame() {
  val (width, height) = canvas.size()
  val now = clock()
  val steps = Math.min((now - last) * 60, 6)       // in sixtieths of a second
  last = now
  if !paused {
    for ball in balls { ball.move(width, height, steps) }
  }
  canvas.clear(0x202830)
  for ball in balls { canvas.fillCircle(ball.x, ball.y, ball.radius, ball.color) }

  frames += 1
  if now - measuredAt >= 1 {
    rate = "%.0f frames a second".format(frames / (now - measuredAt))
    frames = 0
    measuredAt = now
  }
  status.text = "  ${balls.size} balls: $rate" + (paused ? " (paused)" : "") + ". Click for more; Space pauses."
}

repeat(startingBalls) { addBall(Math.random() * 760, Math.random() * 520) }
window.show()
canvas.focus()
App.every(16, frame)
App.run()
