// A page of text in several fonts and sizes, drawn into an image by Astra's own text
// engine and saved as text_page.png. Nothing but the font files comes from the system.
//
//   astra examples/text_page.astra [scale]
//
// Under every line is a rule exactly as long as the line was measured to be, with a tick
// where each character was measured to start: the text sits on them, because measuring and
// drawing use the same numbers. The program checks that for every line and says so.
//
// A scale (1.5, 2) draws the page as a dense screen would show it: every font that many times
// the size, which is what a font at that scale is.

val scale = Program.arguments.size > 0 ? Program.arguments[0].toFloat() : 1
val ink = Color(0x1B1F23)
val faint = Color(0x8A9199)
val rule = Color(0x2F81F7)
val paper = Color.white

fun px(n : Number) : int => Math.round(n * scale).toInt()

val page = Image(px(900), px(1070), paper)
val canvas = page.canvas()
var y = px(24)
var lines = 0
var checked = 0

// One line of text at the left margin, with its measured width ruled underneath.
fun line(text : string, font : Font, color : Color = ink, note : string? = null) {
  val x = px(28)
  y += font.ascent
  canvas.font = font
  canvas.color = color
  val drawn = canvas.drawString(text, x, y)
  val measured = font.width(text)
  val offsets = font.offsets(text)
  // Measured as a whole, drawn, and added up a character at a time: three ways, one number.
  var sum = 0
  for (c in text) { sum += font.width(c) }
  if (drawn != measured or sum != measured or offsets.last() != measured) {
    throw Exception("measured $measured, drew $drawn, characters add up to $sum: $text")
  }
  checked += 1
  val below = y + font.descent + px(1)
  canvas.color = rule
  canvas.fillRect(x, below, measured, 1)
  for (at in offsets) { canvas.fillRect(x + at, below - px(2), 1, px(2) + 1) }
  if (note != null) {
    canvas.font = notes
    canvas.color = faint
    canvas.drawString(note, x + measured + px(14), y)
  }
  y += font.descent + px(9)
  lines += 1
}

fun heading(text : string) {
  y += px(10)
  canvas.font = small
  canvas.color = faint
  canvas.drawString(text, px(28), y + small.ascent)
  y += small.lineHeight + px(4)
}

val notes = Font("Segoe UI", 10 * scale, italic = true)
val small = Font("Segoe UI", 10 * scale, bold = true)
val pangram = "The quick brown fox jumps over the lazy dog 0123456789"

line("Text, by Astra's own engine", Font("Segoe UI", 30 * scale, weight = 600))

heading("ONE FAMILY, MANY SIZES")
for (size in [9, 10, 11, 12, 13, 14, 16, 20]) {
  val font = Font("Segoe UI", size * scale)
  line(pangram, font, ink, "${font.family} $size")
}

heading("STYLES")
line("Regular, and the same family in bold,", Font("Segoe UI", 15 * scale))
line("in bold, which is a font of its own,", Font("Segoe UI", 15 * scale, bold = true))
line("in italic, and in bold italic.", Font("Segoe UI", 15 * scale, bold = true, italic = true))
line("Serif: Times New Roman, 17, with its italic following.", Font("Serif", 17 * scale))
line("Quoth the raven, “Nevermore.” — fi fl ff & ½ × ÷ © § ¶", Font("Serif", 17 * scale, italic = true))
line("fun main() { print(\"monospaced: every character 0O1lI| the same width\") }", Font("Monospaced", 13 * scale))

heading("ONE FILE, EVERY WEIGHT (VARIABLE FONTS)")
for (weight in [300, 400, 500, 600, 700]) {
  line("Bahnschrift at weight $weight: Hamburgefonstiv 0123456789", Font("Bahnschrift", 16 * scale, weight = weight))
}
line("Segoe UI Variable, small: the cut made for small sizes is chosen by itself", Font("Segoe UI Variable", 9 * scale))
line("Segoe UI Variable, large: and the display cut here", Font("Segoe UI Variable", 26 * scale))

heading("THE OTHER KIND OF OUTLINE (CUBIC CURVES, .OTF)")
var cubic : Typeface? = null
for (face in Fonts.typefaces()) {
  if (cubic == null and face.hasCubicOutlines and face.has("a") and !face.isItalic and face.weight <= 500) { cubic = face }
}
if (cubic != null) {
  line("${cubic.fullName}: Sphinx of black quartz, judge my vow. אבגדהוזחטי", Font(cubic, 19 * scale))
} else {
  line("(no font with cubic outlines is installed)", notes)
}

heading("CHARACTERS THE FONT LACKS COME FROM ONE THAT HAS THEM")
val body = Font("Segoe UI", 15 * scale)
line("English, Ελληνικά, Русский, Tiếng Việt, 中文, 日本語のテキスト, 한국어", body)
line("Symbols → ∑ ∞ ≠ ≤ √ ∂ ♠ ♥ ♦ ♣ ♪ ✓ ✗ ★ ☂ and emoji 😀 🎉 🚀 🌈 🍎 🐢 👍", body)
line("😀😃😄😁🤖👾🎨🔥💧🌍", Font("Segoe UI", 30 * scale))

heading("STYLES A FAMILY LACKS ARE MADE UP; HINTING")
line("Bahnschrift has no italic, so this one is slanted: made-up italic", Font("Bahnschrift", 15 * scale, italic = true))
line("Segoe UI Emoji has no bold, so this one is thickened", Font("Segoe UI Emoji", 15 * scale, bold = true))
line("Hinting: the tops and bottoms of letters on pixel edges, even this small — minimum", Font("Segoe UI", 11 * scale))

page.save("text_page.png")
print("$lines lines in ${page.width} x ${page.height} pixels, saved as text_page.png")
print("every line's measured width, drawn width and sum of character widths agree ($checked checked)")

// And the image comes back from its file as it went in.
print("read back the same:", Image.load("text_page.png") == page)
