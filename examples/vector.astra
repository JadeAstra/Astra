// A data class that behaves like a number: operators, a property, destructuring, and
// extension functions.

data Vec2(val x : number, val y : number) {
  static val zero = Vec2(0, 0)

  op +(other : Vec2) => Vec2(x + other.x, y + other.y)
  op -(other : Vec2) => Vec2(x - other.x, y - other.y)
  op *(scale : number) => Vec2(x * scale, y * scale)
  op -() => Vec2(-x, -y)
  op <(other : Vec2) => length < other.length
  op [](i : int) => i == 0 ? x : y

  get length() => Math.sqrt(x * x + y * y)
  override fun toString() => "($x, $y)"
}

fun Vec2.dot(other : Vec2) => x * other.x + y * other.y
fun number.times(v : Vec2) => v * this        // so that 2.times(v) reads the other way round

val a = Vec2(3, 4)
val b = Vec2(1, 2)

print("a + b  =", a + b)
print("a - b  =", a - b)
print("a * 2  =", a * 2, "  2.times(a) =", 2.times(a))
print("-a     =", -a)
print("|a|    =", a.length)
print("a . b  =", a.dot(b))
print("a == b :", a == b, "  a == (3, 4):", a == Vec2(3, 4))     // a data class: equal when x and y are
print("b < a  :", b < a)
print("a[0], a[1] =", a[0], a[1])

// A data object comes apart into its fields, and copy changes some of them.
val (x, y) = a
print("x and y:", x, y, "  ten to the right:", a.copy(x = x + 10))

// Compound assignment works through the same operators.
var position = Vec2.zero
val velocity = Vec2(1.5, -0.5)
for step in 1..4 { position += velocity }
print("after 4 steps:", position)

// A data object is a map key, and an item of a set, by what it holds: an equal vector finds
// the entry. Here, the squares a walk has been through.
val visited = Set()
var here = Vec2.zero
for move in [Vec2(1, 0), Vec2(0, 1), Vec2(-1, 0), Vec2(0, -1), Vec2(1, 0)] {
  visited.add(here)
  here += move
}
print("visited", visited.size, "squares:", visited.joinToString(" "), "- back at the start:", Vec2(0, 0) in visited)

// Types are enforced: a vector cannot be added to a plain number.
try {
  print(a + 1)
} catch (e) {
  print("error:", e.message)
}
