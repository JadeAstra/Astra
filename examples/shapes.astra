// Shapes: an abstract class, an interface, override, static members, init blocks and an
// extension function.

interface Drawable {
  fun outline() : string
}

abstract class Shape(val name : string) : Drawable {
  static {
    var made = 0
    fun round2(x : Number) : string => "%.2f".format(x)
  }

  init { made += 1 }                         // runs for every shape that is made

  abstract fun area() : Number                // for each kind of shape to write
  abstract fun perimeter() : Number

  override fun outline() => "$name, ${round2(perimeter())} around"
  override fun toString() => "$name: area ${round2(area())}, perimeter ${round2(perimeter())}"
}

class Circle(val radius : Number) : Shape("circle") {
  override fun area() => Math.pi * radius * radius
  override fun perimeter() => 2 * Math.pi * radius
}

class Rect(val width : Number, val height : Number, name : string = "rectangle") : Shape(name) {
  override fun area() => width * height
  override fun perimeter() => 2 * (width + height)
}

class Square(side : Number) : Rect(side, side, "square")

// An extension function adds to a type from outside. `this` is the shape it is called on.
fun Shape.describe() => when (this) {
  is Circle -> "a circle of radius $radius"
  is Square -> "a square of side $width"
  is Rect -> "a $width by $height rectangle"
  else -> "some shape"
}

val shapes = [Circle(1.5), Rect(3, 4.5), Square(2)]
for shape in shapes { print(shape) }
shapes.forEach { print("  ", it.describe(), "-", it.outline()) }

val largest = shapes.maxBy { it.area() }
print("largest is the ${largest.name};", Shape.made, "shapes were made")
print("squares are rectangles:", shapes[2] is Rect, "- circles are not:", shapes[0] is Rect)

print("by area:", shapes.sortedBy { it.area() }.join(" < ") { it.name })
print("total area: %.1f, of which rectangles: %.1f".format(shapes.sumOf { it.area() }, shapes.filter { it is Rect }.sumOf { it.area() }))

// An abstract class is never made itself.
try { Shape("blob") } catch (e) { print(e.message) }
