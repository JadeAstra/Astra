// Animation with threads: tens of thousands of balls bouncing around a window. Background threads
// move the balls, each its own share of them, and the main thread only draws.
// Click to add a hundred more; Space pauses.
//
// One thread runs Astra code at a time, so four threads do not move the balls four times as
// fast. What they give is that the moving does not wait for the drawing: each thread goes
// round as often as it gets a turn, up to sixty times a second, whatever a frame costs.
//
// bounce.astra is the same thing in one loop, and bounce_workers.astra with the
// moving done on other cores.
import Jade.*

val startingBalls = 50000
val threadCount = 4

class Ball(var x : Number, var y : Number, var dx : Number, var dy : Number, val radius : Number, val color) {
  // Moves on by `steps` sixtieths of a second, turning back at the edges.
  fun move(width : Number, height : Number, steps : Number) {
    x += dx * steps
    y += dy * steps
    if x < radius { x = radius; dx = dx.absoluteValue }
    if x > width - radius { x = Math.max(radius, width - radius); dx = -dx.absoluteValue }
    if y < radius { y = radius; dy = dy.absoluteValue }
    if y > height - radius { y = Math.max(radius, height - radius); dy = -dy.absoluteValue }
  }
}

val palette = [Color.red, Color.blue, Color.green, Color.orange, Color(160, 60, 200), Color.cyan, Color.pink]

// What the threads share. Each thread moves the balls of one group. A list is never seen
// half changed, so a ball can be added to a group while its thread is going through it.
val groups = List(threadCount) { [] }
var ballCount = 0
@Volatile var width = 760.0
@Volatile var height = 520.0
@Volatile var paused = false
val steps = AtomicInteger()          // how many times a group has been moved, for the status line

fun addBall(x : Number, y : Number) {
  val speed = 1 + Math.random() * 3
  val angle = Math.random() * 2 * Math.pi
  val ball = Ball(x, y, Math.cos(angle) * speed, Math.sin(angle) * speed, 3 + Math.randomInt(0, 4), palette[ballCount % palette.size])
  groups[ballCount % threadCount].add(ball)
  ballCount += 1
}

// ---- The threads that move the balls ----
// Each goes round up to sixty times a second. It measures how long it really was since
// last time, so the balls keep their speed when the drawing leaves the threads fewer turns.
for group in groups {
  thread(isDaemon = true) {
    var last = clock()
    while (true) {
      val now = clock()
      val elapsed = Math.min((now - last) * 60, 6)      // in sixtieths of a second
      last = now
      if !paused {
        for ball in group { ball.move(width, height, elapsed) }
        steps.incrementAndGet()
      }
      Thread.sleep(16)
    }
  }
}

// ---- The window, on the main thread ----
val window = NativeWindow("Bounce", 780, 580)
val background = Color(0x202830)
val statusFont = Font("Segoe UI", Font.plain, 12)
val statusHeight = 24

window.onInput = { event ->
  if event is RawInput.PointerDown { repeat(100) { addBall(event.x, event.y) } }
  if event is RawInput.KeyDown and event.key == KeyCode.space and !event.repeat { paused = !paused }
}

var frames = 0
var measuredAt = clock()
var rates = "measuring..."

// Draws the balls where the threads have put them.
fun frame() {
  val canvas = window.canvas()
  val w = canvas.width
  val h = canvas.height - statusHeight
  width = w
  height = h
  canvas.color = background
  canvas.fillRect(0, 0, w, h)
  for group in groups {
    for ball in group {
      canvas.color = ball.color
      canvas.fillOval(ball.x - ball.radius, ball.y - ball.radius, 2 * ball.radius, 2 * ball.radius)
    }
  }

  // Once a second: how many frames were drawn, and how often each thread moved its balls.
  frames += 1
  val now = clock()
  if now - measuredAt >= 1 {
    val seconds = now - measuredAt
    rates = "%.0f frames and %.0f moves a second".format(frames / seconds, steps.getAndSet(0) / seconds / threadCount)
    frames = 0
    measuredAt = now
  }
  val status = "$ballCount balls on $threadCount threads: $rates" + (paused ? " (paused)" : "") + ". Click for more; Space pauses."
  canvas.color = Color(0x101418)
  canvas.fillRect(0, h, w, statusHeight)
  canvas.color = Color(0xC9D1D9)
  canvas.font = statusFont
  canvas.drawString(status, 8, h + 16)
  window.present()
}


repeat(startingBalls) { addBall(Math.random() * width, Math.random() * height) }
// While an edge is dragged the window is drawn at every size it passes through, not only
// when the timer next comes round.
window.onResize = { width, height -> frame() }
window.show()
// Sixty times a second, or as often as the screen shows a new picture. When the window
// is closed the timer is called off, and with nothing left to wait for the program ends.
val timer = EventLoop.every(16, frame)
window.onCloseRequest = {
  timer.cancel()
  window.close()
}
