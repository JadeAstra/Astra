// bounce_parallel.astra's moving, without the window (M6.6 part 4): 200,000 balls moved by
// every core, 200 frames. Here Ball is a class, each ball an object of its own;
// bounce_values.astra and bounce_moved.astra are the same with Ball a value type. The time
// is that of the moving alone.

class Ball(var x : float, var y : float, var dx : float, var dy : float, val radius : float) {
  fun move(width : float, height : float) {
    x += dx
    y += dy
    if (x < radius) { x = radius; dx = -dx }
    if (x > width - radius) { x = width - radius; dx = -dx }
    if (y < radius) { y = radius; dy = -dy }
    if (y > height - radius) { y = height - radius; dy = -dy }
  }
}

val n = 200000
val balls : open List<Ball> = []
for (i in 0 ..< n) { balls.add(Ball((i * 7919 % 760) * 1.0 + 10.0, (i * 104729 % 520) * 1.0 + 10.0, (i % 13 - 6) * 0.75 + 0.5, (i % 11 - 5) * 0.75 + 0.5, 3.0 + i % 4)) }

val started = clock()
for (frame in 0 ..< 200) { balls.parallelStream().forEach { it.move(780.0, 560.0) } }
val took = clock() - started
var sum = 0.0
for (b in balls) { sum += b.x + b.y }
print("bounce_classes", sum.toInt(), took)
