// Field access: objects' fields read and written in a loop, as vector maths does.
class Vec(var x : float, var y : float, var z : float) {
  fun dot(o : Vec) : float => x * o.x + y * o.y + z * o.z
}

class Body(val position : Vec, val velocity : Vec, var mass : float)

val bodies : List<Body> = []
for i in 0..<100 { bodies.add(Body(Vec(i * 1.0, i * 2.0, i * 3.0), Vec(1.0, 0.5, 0.25), 1.0 + i)) }

val started = clock()
var energy = 0.0
for step in 0..<10000 {
  for b in bodies {
    b.position.x += b.velocity.x * 0.01
    b.position.y += b.velocity.y * 0.01
    b.position.z += b.velocity.z * 0.01
    energy += b.mass * b.velocity.dot(b.velocity) * 0.5
  }
}
val seconds = clock() - started
print("fields", int(energy), int(bodies[50].position.x * 1000), seconds)
