// A million points built, summed, sorted and walked (M6.6 part 3): with Point a value type, a
// List<Point> keeps them one after another, 16 bytes each. points_classes.astra is the same
// with a class. The phases' times are printed above the total.

value Point(val x : int, val y : int)

val n = 1000000
val started = clock()

var t = clock()
val pts : open List<Point> = []
for (i in 0 ..< n) { pts.add(Point(i * 7919 % n, i)) }
val built = clock() - t

t = clock()
var sum = 0
for (i in 0 ..< n) { sum += pts[i].x + pts[i].y }
val summed = clock() - t

t = clock()
val sorted = pts.sortedBy { it.x }
val sortTime = clock() - t

t = clock()
var walked = 0
for (p in sorted) { walked += p.x - p.y }
val walkTime = clock() - t

print("built", built, "summed", summed, "sorted", sortTime, "walked", walkTime)
print("points_values", sum % 1000003, walked % 1000003, sorted[17].x, clock() - started)
