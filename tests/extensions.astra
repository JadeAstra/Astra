// Extension functions: a function added to a type from outside. `this` is the value it runs on.

// A value whose type the checker does not see, for testing the checks made when running.
val unknown = { value -> value }

class Shape(val name : string, val w : int, val h : int) {
  fun area() => w * h
}
class Square(side : int) : Shape("square", side, side)

fun Shape.describe() => "$name of area ${area()}"      // bare names are the shape's members
fun Shape.scaled(by : int = 2) : Shape => Shape(name, w * by, h * by)
fun Shape.area() => -1                                  // a member of that name comes first

val s = Shape("rect", 2, 3)
print(s.describe(), s.scaled().describe(), s.scaled(by = 3).w, s.area())   // expect: rect of area 6 rect of area 24 6 6
print(Square(2).describe(), Square(2).scaled(5).area())   // expect: square of area 4 100

// As a value it is a function bound to the object, and ?. works on it.
val bound = s.describe
val missing : nothing? = null       // a value that is only ever null
print(bound(), missing?.describe(), [s, Square(1)].map { it.describe() })   // expect: rect of area 6 null ["rect of area 6", "square of area 1"]

// On the built-in types.
fun string.shout() => upper() + "!"                    // upper() is the string's own
fun string.words() => split(" ")
fun string.isLong(limit : int = 5) => size > limit
fun int.double() => this * 2
fun int.isEven() => this % 2 == 0
fun Number.half() => this / 2
fun float.rounded() => (this + 0.5).toInt()
fun bool.toInt() => this ? 1 : 0
fun List.second() => this[1]
fun List<int>.total() : int {
  var sum = 0
  for n in this { sum += n }
  return sum
}
fun Map.keyCount() => this.keys.size
fun Range.middle() => (start + end) / 2
fun Function.twice(x : int) => this(this(x))
print("hi".shout(), "a b c".words(), "hello!".isLong(), "hey".isLong(2), 21.double(), 3.isEven(), 4.isEven())   // expect: HI! ["a", "b", "c"] true true 42 false true
print(9.half(), 9.0.half(), 2.6.rounded(), true.toInt(), [1, 2, 3].second(), [1, 2, 3].total(), {"a": 1, "b": 2}.keyCount(), (0..10).middle())   // expect: 4 4.5 3 1 2 6 2 5
print({ it + 1 }.twice(5), "x".shout().shout(), [3, 4].total().double())   // expect: 7 X!! 14

// On every value, and on null.
fun any.tag() => "<" + this + ">"
fun string?.orNothing() => this == null ? "" : this
fun string?.isBlank() => this == null or this.trim().size == 0
print(5.tag(), "x".tag(), [1].tag(), s.name.tag(), missing.orNothing().size, "kept".orNothing(), missing.isBlank(), " ".isBlank(), "a".isBlank())   // expect: <5> <x> <[1]> <rect> 0 kept true true false

// On an interface, an enum, and a class declared inside another.
interface Named { val name : string }
class Pet(override val name : string) : Named
fun Named.greeting() => "hello, $name"
enum Way { up, down }
fun Way.opposite() : Way => this == up ? down : up
class Event { class Click(val x : int) }
fun Event.Click.where() => "at $x"
print(Pet("Rex").greeting(), Way.up.opposite(), Way.down.opposite().name, Event.Click(4).where())   // expect: hello, Rex down up at 4

// Inside a method, and inside a lambda run on an object, by its bare name.
fun Shape.label() => "[" + name + "]"
class Canvas {
  val shape = Shape("dot", 1, 1)
  fun draw() => shape.label() + " " + shape.apply { w }.describe()
  fun viaReceiver() => shape.run { label() + "/" + describe() }
}
print(Canvas().draw(), Canvas().viaReceiver())   // expect: [dot] dot of area 1 [dot]/dot of area 1

// Declared further down the file than where it is used; named and extra arguments.
print("abc".padded(6), "abc".padded(width = 5, fill = "*"), 7.clamp(0, 5), 7.clamp(low = 8, high = 9))   // expect: abc... abc** 5 8
fun string.padded(width : int, fill : string = ".") {
  var out = this
  while out.size < width { out += fill }
  return out
}
fun int.clamp(low : int, high : int) => this < low ? low : this > high ? high : this

// What has no such function says so.
try { unknown(5).shout() } catch (e) { print(e.message) }   // expect: undefined method 'shout' on a value of type int
try { unknown(s).total() } catch (e) { print(e.message) }   // expect: undefined method 'total' on Shape

// Many calls.
var sum = 0
for i in 1..20000 { sum += i.double() - i }
print(sum, "".tag())                        // expect: 200010000 <>
