// What tests show about a value: after `x != null`, `x is Box`, an early return, or giving
// it a value, a local has the narrower type for as long as that holds.

class Box(val item : int) {
  fun twice() : int => item * 2
}
class Crate(val items : List<Box>)

fun first(maybe : Box?) : int {
  if (maybe == null) { return 0 }
  return maybe.item
}
fun second(maybe : Box?) : int {
  if (maybe != null and maybe.item > 0) { return maybe.twice() }
  return maybe.item           // check: a Box? may be null, so .item cannot be used on it; use ?.item, or check it first
}
fun third(maybe : Box?) : int {
  val box = maybe ?: return 0
  return box.item
}
fun fourth(maybe : Box?) : int => maybe == null ? 0 : maybe.item
fun fifth(value : any) : int {
  if (value is Box) { return value.item }
  if (value !is Crate) { return 0 }
  return value.items.size
}
fun sixth(maybe : Box?) : int {
  var box = maybe
  box = Box(1)
  return box.item
}
fun seventh(maybe : Box?) : int {
  if (maybe == null) { throw Exception("none") }
  return maybe.item
}
fun eighth(maybe : Box?) : int {
  while (maybe != null) { return maybe.item }
  return 0
}
fun ninth(maybe : Box?) : int => when {
  maybe == null -> 0
  else -> 1
}

// Changing a place that may be null (L118): the `?` forms skip it when null or missing, and a
// map's index can say what a missing entry starts from.
fun counting(stock : open Map<string, int>, holder : Holder?) {
  stock["apples"]--             // check: stock["apples"] may be missing, so -- cannot change it; use --? to skip it when missing, stock["apples", default = 0] to start it from a value, or ?:
  stock["apples"] += 2          // check: stock["apples"] may be missing, so += cannot change it; use +=? to skip it when missing, stock["apples", default = 0] to start it from a value, or ?:
  stock["apples"]--?
  stock["apples", default = 0]++
  val n : int = stock["pears", default = 0]
  var count = 5
  count++?                      // check: 'count' is an int, never null; use ++
  stock["x", default = "none"]++   // check: the values of this map are an int; the default cannot be a string
  print(n, count)
}
class Holder(var count : int?)
fun held(h : Holder) {
  h.count++                     // check: h.count may be null, so ++ cannot change it; use ++? to skip it when null, or ?:
  h.count++?
  h.count -=? 1
}
