// The built-in types' methods are declared (src/std/builtins.astra), so a method that is not
// there is reported, and what one takes is checked. A class declared inside a function is
// its own, even when it has the name of one outside, and `this` narrows like a local.

fun names() : List<string> {
  val words = ["b", "a"]
  words.sort()
  print(words.size, "x".isLetter(), 5.coerceIn(1..3), 7.coerceIn(0.5, 9.5))
  print("x".shout())          // check: a string has no method 'shout'
  print(words.nope())         // check: a List<string> has no method 'nope'
  print("x".repeat("2"))      // check: repeat(...) takes an int for 'times', not a string
  return words
}

fun pairs() : List<string> {
  data Pair(val left : string, val right : string)
  val (l, r) = Pair("L", "R").copy(right = "r")
  print(Pair("a", "b").first)   // check: Pair has no member 'first'
  return [l, r]
}

fun string?.orEmpty() : string => this == null ? "" : this
fun string?.blank() : bool => this == null or this.trim().size == 0

class Level(val value : int) {
  op +(by : int) : Level => Level(this.value + by)
}
class Visits(var count : int)

fun counting(maybe : Visits?) {
  var level = Level(3)
  level++
  level--                     // check: Level has no operator - (op -(...) in the class)
  maybe?.count++
}

// A name with several forms: the call means the most specific one its arguments fit.
fun forms(words : List<string>) {
  val low : int = 5.coerceIn(1, 10)
  val ranged : int = 5.coerceIn(1..3)
  val mixed : int = 5.coerceIn(0.5, 9.5)   // check: 'mixed' is an int; it cannot start as a Number
  words.add("a")
  words.add(0, "b")
  words.add(1)                // check: no form of add(...) takes an int; there are List<string>.add(item : string) and List<string>.add(index : int, item : string)
  print(low, ranged, mixed, 5.coerceIn("a", "b"))   // check: no form of coerceIn(...) takes a string, a string; there are int.coerceIn(minimumValue : int, maximumValue : int), int.coerceIn(range : Range) and int.coerceIn(minimumValue : Number, maximumValue : Number)
}
