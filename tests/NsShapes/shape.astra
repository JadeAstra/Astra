val PI_ISH = 3
var created = 0

class Shape(val name) {
  fun init(name) {
    this.name = name
    created += 1
  }
  fun area() => 0
}

fun label(shape) => "<" + shape.name + ">"
fun largest(shapes) {
  var best = shapes[0]
  for shape in shapes { if shape.area() > best.area() { best = shape } }
  return best
}

private val secret = "shape's own"       // each file may have its own private `secret`
private fun hidden() => "not for others"
fun shapeSecret() => secret + ", " + hidden()

internal val registry = []
internal fun register(shape) {
  registry.push(shape.name)
  return shape
}

enum Fill { NONE, SOLID }
fun fillOf(shape, fill : Fill = NONE) => shape.name + ":" + fill
val title = "shapes"
