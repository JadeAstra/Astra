// Loop labels, do-while, downTo and step.

// break@name and continue@name reach a loop further out.
val found = []
outer@ for i in 1..4 {
  for j in 1..4 {
    if j == 3 { continue@outer }
    if i == 3 { break@outer }
    found.push("$i$j")
  }
}
print(found)                                // expect: ["11", "12", "21", "22"]

var steps = 0
rows@ while steps < 100 {
  var inner = 0
  cells@ while true {
    inner += 1
    steps += 1
    if inner == 3 { continue@rows }
    if steps > 7 { break@rows }
    if inner > 10 { break@cells }
  }
}
print(steps)                                // expect: 8

// With variables, half-built values and finally blocks on the way out.
val log = []
fun search(grid, wanted) {
  var at = null
  scan@ for row in grid {
    val label = "row"
    try {
      for cell in row {
        val seen = [label, cell ?: continue@scan]
        if cell == wanted {
          at = seen
          break@scan
        }
      }
    } finally {
      log.push("done " + row.length)
    }
  }
  return at
}
print(search([[1, null, 9], [2, 3], [4]], 3), log)   // expect: ["row", 3] ["done 3", "done 2"]
val made = []
all@ for a in [1, 2] {
  for b in [10, 20] {
    made.push(fun() => a + b)
    if b == 10 and a == 2 { break@all }
  }
}
print(made.map { it() })                    // expect: [11, 21, 12]

// do { } while: the body runs before the first test.
var n = 10
var runs = 0
do { runs += 1 } while n < 5
do {
  n -= 3
  if n == 4 { continue }
  runs += 10
} while n > 0
print(runs, n)                              // expect: 31 -2
var tries = 0
again@ do {
  tries += 1
  for k in 1..3 { if k == 2 and tries < 3 { continue@again } }
  break
} while true
print(tries)                                // expect: 3

// downTo counts down to its end; step takes every nth.
print((5 downTo 1).toList(), (1..10 step 3).toList(), (10 downTo 1 step 4).toList(), (0 until 10 step 5).toList(), (0..<7 step 2).toList())
// expect: [5, 4, 3, 2, 1] [1, 4, 7, 10] [10, 6, 2] [0, 5] [0, 2, 4, 6]
var total = 0
for i in 10 downTo 0 step 5 { total = total * 100 + i }
print(total, (3 downTo 5).toList(), 4 in 10 downTo 1 step 2, 3 in 10 downTo 1 step 2, (9 downTo 1).length)   // expect: 100500 [] true false 9
val by = 2
print((1..9 step by + 1).toList(), 6 downTo 4)   // expect: [1, 4, 7] 6..4 step -1
try { (1..5 step 0).toList() } catch (e) { print(e.message) }   // expect: the step of a range must be a positive int

// `do`, `step`, `downTo` and `until` are ordinary names elsewhere.
val step = 3
val downTo = "name"
fun do(x) => x * 2
print(step, downTo, do(4), (1..7 step step).toList())   // expect: 3 name 8 [1, 4, 7]
