// ++ and -- change a variable, a field or an element by one. They are statements: they
// stand on their own and have no value, and there is no ++x.
var i = 5
i++
i++
i--
print(i)                                         // expect: 6

// floats, and anything that has + and - of its own
var f = 1.5
f++
print(f)                                         // expect: 2.5
f--
f--
print(f)                                         // expect: 0.5
class Level(val value : int) {
  op +(by : int) : Level => Level(this.value + by)
  op -(by : int) : Level => Level(this.value - by)
  fun toString() : string => "L${this.value}"
}
var level = Level(3)
level++
level++
level--
print(level)                                     // expect: L4

// fields, properties, list elements and map entries
class Counter {
  var count : int = 0
  var hidden : int = 100
  get shown() : int => this.hidden
  set shown(value : int) { this.hidden = value }
  fun bump() { this.count++ }
  fun drop() { this.count-- }
}
val c = Counter()
c.count++
c.count++
c.bump()
c.drop()
print(c.count)                                   // expect: 2
c.shown--
c.shown--
c.shown++
print(c.shown, c.hidden)                         // expect: 99 99
val items = [10, 20, 30]
items[0]++
items[-1]--
print(items)                                     // expect: [11, 20, 29]
// A map's entry may be missing, so changing it says what to do then (L118): skip it with the
// `?` forms, or start it from a value written in the index.
val stock = {apples: 3}
stock["apples"]--?
stock["pears"] +=? 2
print(stock)                                     // expect: {"apples": 2}
val counts : Map<string, int> = {:}
for word in ["a", "b", "a"] { counts[word, default = 0]++ }
print(counts, counts["z", default = 0], counts["a", default = 0])   // expect: {"a": 2, "b": 1} 0 2
val groups : Map<string, List<int>> = {:}
for n in 1..5 { groups[n % 2 == 0 ? "even" : "odd", default = []] += [n] }
print(groups)                                    // expect: {"odd": [1, 3, 5], "even": [2, 4]}
class Visits(var count : int?)
val visits = Visits(null)
visits.count++?
visits.count *=? 3
print(visits.count)                              // expect: null
visits.count = 2
visits.count++?
visits.count *=? 3
print(visits.count)                              // expect: 9

// the target is worked out once
var calls = 0
fun slot() { calls++; return 0 }
val grid = [[1, 2], [3, 4]]
grid[slot()][slot() + 1]++
print(grid, calls)                               // expect: [[1, 3], [3, 4]] 2

// in loops, in one-line blocks, and in functions
var total = 0
var k = 0
while k < 5 {
  total += k
  k++
}
print(total, k)                                  // expect: 10 5
var down = 3
var steps = []
while down > 0 { steps.push(down); down-- }
print(steps, down)                               // expect: [3, 2, 1] 0
val bump = fun() { total++ }
bump(); bump()
print(total)                                     // expect: 12

// A value whose type the checker does not see, for testing the checks made when running.
val unknown = { value -> value }

fun attempt(f : () -> any?) {
  try { return f() } catch (e) { return e.message }
}

// typed variables keep their type; something that cannot be added to says so
var typed : int = 1
typed++
print(typed)                                     // expect: 2
var nothing = unknown(null)
print(attempt(fun() { nothing++ }))              // expect: unsupported operand types for '+': null and int

// << and >> shift the bits of an int
print(1 << 4, 256 >> 2, 5 << 0, -16 >> 2, -1 >> 60, 1 << 62)   // expect: 16 64 5 -4 -1 4611686018427387904
print(1 << 63, 1 << 64, 7 >> 64, -7 >> 64, 3 << 1 << 2)        // expect: -9223372036854775808 0 0 -1 24
print(1 + 2 << 3, 1 << 2 + 1, 16 >> 2 > 3, 1 << 3 == 8)        // expect: 24 8 true true
var bits = 1
bits <<= 5
bits >>= 2
print(bits, 0xFF >> 4, 0b1 << 3)                 // expect: 8 15 8
print(attempt(fun() => 1 << -1))                 // expect: cannot shift by a negative amount (-1)
print(attempt(fun() => unknown(1.5) << 1))                // expect: unsupported operand types for '<<': float and int
print(attempt(fun() => 1 >> unknown("2")))                // expect: unsupported operand types for '>>': int and string

// classes can define them
class Stream {
  val parts : List = []
  op <<(item) : Stream {
    this.parts.push(item)
    return this
  }
  op >>(count : int) : List => this.parts.slice(0, count)
}
val out = Stream() << "a" << "b" << 3
print(out.parts, out >> 2)                       // expect: ["a", "b", 3] ["a", "b"]

// shifts bind more tightly than ranges and comparisons, less tightly than + and -
for value in 1 << 1..<1 << 3 { steps.push(value) }
print(steps)                                     // expect: [3, 2, 1, 2, 3, 4, 5, 6, 7]
