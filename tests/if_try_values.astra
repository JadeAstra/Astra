// if and try where a value is expected: the value of the block that ran.

fun size(n : int) => if n > 100 { "big" } else if n > 10 { "medium" } else { "small" }
print(size(500), size(50), size(5))         // expect: big medium small

val wide = true
val width = if wide { 200 } else { 100 }
var label = "w" + if width > 150 { "ide" } else { "narrow" } + "!"
print(width, label, if false { 1 }, [1, if wide { 2 } else { 0 }, 3])   // expect: 200 wide! null [1, 2, 3]

// A block can do more before giving its value, and has its own variables.
fun describe(items : List<string>) {
  return if items.length == 0 {
    "nothing"
  } else {
    val first = items[0]
    val rest = items.length - 1
    "$first and $rest more"
  }
}
print(describe([]), describe(["a", "b", "c"]))   // expect: nothing a and 2 more

// try gives the value of its block, or of the catch that ran; finally still runs.
val log = []
fun parse(text : string) => try { int(text) } catch (e) { -1 }
fun guarded(text : string) {
  val n = 10 + try {
    val parsed = int(text)
    parsed * 2
  } catch (e) {
    log.push("bad " + text)
    0
  } finally {
    log.push("checked " + text)
  }
  return n
}
print(parse("42"), parse("x"), guarded("4"), guarded("y"), log)   // expect: 42 -1 18 10 ["checked 4", "bad y", "checked y"]

class Missing : Error { fun init() { super.init("missing") } }
fun lookup(table : Map<string, int>, key : string) => try {
  table[key] ?: throw Missing()
} catch (e : Missing) {
  "default"
}
print(lookup({"a": 1}, "a"), lookup({:}, "b"))   // expect: 1 default
try { print(try { throw "inner" } finally { log.push("finally") }) } catch (e) { print("caught", e, log.length) }   // expect: caught inner 4

// As the last thing in a lambda, in a when branch, and with jumps inside.
val grades = [95, 72, 40].map { if it >= 90 { "A" } else if it >= 60 { "C" } else { "F" } }
val parsed = ["1", "x", "3"].map { try { int(it) } catch (e) { 0 } }
fun kind(x : any?) => when (x) {
  null -> "none"
  else -> if x is string { "text" } else { "other" }
}
print(grades, parsed, kind(null), kind("s"), kind(1))   // expect: ["A", "C", "F"] [1, 0, 3] none text other

fun firstPositive(items : List<int?>) {
  for item in items {
    val checked = if item == null { continue } else if item < 0 { 0 } else { return item }
    log.push(checked)
  }
  return if items.length > 3 { "long" } else { "none" }
}
print(firstPositive([null, -1, 5]), firstPositive([null, -2]), firstPositive([-1, -1, -1, -1]))   // expect: 5 none long

// A function captures a variable of a branch.
val readers = []
for n in [1, 2] {
  val doubled = if n > 0 { val twice = n * 2; readers.push(fun() => twice); twice } else { 0 }
  readers.push(fun() => doubled + 100)
}
print(readers.map { it() })                 // expect: [2, 102, 4, 104]

// As statements they are what they always were.
var hits = 0
if wide { hits += 1 } else { hits -= 1 }
try { hits += 10 } finally { hits += 100 }
print(hits)                                 // expect: 111

// Many times over.
var total = 0
for i in 1..30000 {
  total += if i % 2 == 0 { 1 } else { try { if i % 3 == 0 { throw "odd" }; 2 } catch (e) { 3 } }
}
print(total)                                // expect: 50000
