// Sets and deques.

// A set holds each value once, in the order the values were first added.
val s = setOf(3, 1, 3, 2, 1)
print(s, s.size, s.length, emptySet(), mutableSetOf("a"), Set([1, 1]), Set(1..3), Set())   // expect: {3, 1, 2} 3 3 {} {"a"} {1} {1, 2, 3} {}
print(s is Set, s.contains(1), 2 in s, 9 in s, 9 !in s, s.containsAll([1, 2]), s.containsAll([1, 9]), s.isEmpty(), s.isNotEmpty(), Set().isEmpty())   // expect: true true true false true true false false true true

// add and remove say whether anything changed.
val m = mutableSetOf()
print(m.add("x"), m.add("x"), m.add("y"), m.addAll(["y", "z"]), m.addAll(["z"]), m)   // expect: true false true true false {"x", "y", "z"}
print(m.remove("x"), m.remove("x"), m.size)                  // expect: true false 2
m.addAll(1..6)
print(m.removeAll { it is int and it % 2 == 0 }, m.size, m.retainAll([1, 3, "y", "gone"]), m.toList())   // expect: true 5 true ["y", 1, 3]
print(m.removeAll(["y", 1]), m.removeIf { it == 99 }, m.toList())   // expect: true false [3]
m.clear()
print(m, m.size, m.isNullOrEmpty())                          // expect: {} 0 true

// Looping, and changing the set while looping over it.
val loop = setOf("a", "b", "c")
for item in loop {
  write(item)
  loop.remove("c")
  loop.add("d")
}
print("", loop)                                              // expect: abc {"a", "b", "d"}

// The algebra. Each gives a new set.
val a = setOf(1, 2, 3)
val b = setOf(3, 4)
print(a.union(b), a.intersect(b), a.subtract(b), a + b, a - b, a + 9, a - 1, a + [7, 8], a - (1..2))   // expect: {1, 2, 3, 4} {3} {1, 2} {1, 2, 3, 4} {1, 2} {1, 2, 3, 9} {2, 3} {1, 2, 3, 7, 8} {3}
print(a, a.plus(5).size, a.minus(1).size, a.intersect([2, 3, 9]), a.union([0]))   // expect: {1, 2, 3} 4 2 {2, 3} {1, 2, 3, 0}

// Two sets are equal if they hold the same items, in any order.
print(setOf(1, 2) == setOf(2, 1), setOf(1, 2) == setOf(1, 2, 3), setOf(1) != setOf(2), setOf(1) == [1], a.toSet() == a, a.toSet() === a)   // expect: true false true false true false

// Items are told apart as map keys are: by what they hold, for lists and data objects.
data Point(val x : int, val y : int)
val points = setOf(Point(1, 2), Point(1, 2), Point(2, 1), [1], [1])
print(points.size, Point(1, 2) in points, [1] in points, Point(9, 9) in points, setOf("1", 1, 1.0).size)   // expect: 3 true true false 2

// What a list has for reading.
val n = setOf(4, 1, 3)
print(n.toList(), n.toMutableList(), n.first(), n.last(), n.firstOrNull { it < 4 }, n.find { it > 9 }, n.lastOrNull(), Set().firstOrNull())   // expect: [4, 1, 3] [4, 1, 3] 4 3 1 null 3 null
print(n.map { it * 2 }, n.filter { it > 1 }, n.filterNot { it > 1 }, n.mapNotNull { it > 3 ? null : it }, n.flatMap { [it, it] }.size)   // expect: [8, 2, 6] [4, 3] [1] [1, 3] 6
print(n.any { it > 3 }, n.all { it > 3 }, n.none { it > 4 }, n.count { it > 1 }, n.count(), n.any(), Set().none())   // expect: true false true 2 3 true true
print(n.sum(), n.sumOf { it * 10 }, n.fold(0) { acc, x -> acc - x }, n.maxOrNull(), n.minOrNull(), n.maxOf { -it }, n.minOf { -it })   // expect: 8 80 -8 4 1 -1 -4
print(n.sorted(), n.sortedDescending(), n.sortedBy { -it }, n.sortedWith { x, y -> x - y }, n, n.joinToString("+"), n.joinToString { "<$it>" })   // expect: [1, 3, 4] [4, 3, 1] [4, 3, 1] [1, 3, 4] {4, 1, 3} 4+1+3 <4>, <1>, <3>
print(n.associateWith { it * it }, n.groupBy { it % 2 }, n.partition { it > 2 }.first, setOf(7).single(), n.singleOrNull())   // expect: {4: 16, 1: 1, 3: 9} {0: [4], 1: [1, 3]} [4, 3] 7 null
val visited = []
n.forEach { visited.add(it) }
print(visited, buildSet { add(1); add(1); add(2) }, [1, 2, 2].toMutableSet(), "hello".toSet().size, [3, 4].minus(setOf(3)))   // expect: [4, 1, 3] {1, 2} {1, 2} 4 [4]
try { Set().first() } catch (e) { print(e.message) }         // expect: first() of an empty set

// A deque: quick to add to and take from at both ends.
val d = Deque()
d.addLast(2)
d.addLast(3)
d.addFirst(1)
d.add(4)
print(d, d.size, d.first(), d.last(), d[0], d[3], d.get(1), d.getOrNull(9), d.lastIndex, d.indices, d.isEmpty(), d.isNotEmpty())   // expect: [1, 2, 3, 4] 4 1 4 1 4 2 null 3 0..<4 false true
print(d.removeFirst(), d.removeLast(), d.toList(), d.contains(2), 3 in d, 9 in d, d.indexOf(3), d.indexOf(9))   // expect: 1 4 [2, 3] true true false 1 -1
d[0] = 20
d.set(1, 30)
print(d.toList(), d.removeFirst(), d.removeFirst(), d.removeFirstOrNull(), d.removeLastOrNull(), d.firstOrNull(), d.lastOrNull(), d.size, d.isEmpty())   // expect: [20, 30] 20 30 null null null null 0 true
try { d.removeFirst() } catch (e) { print(e.message) }       // expect: removeFirst() from an empty deque
try { d.first() } catch (e) { print(e.message) }             // expect: first() of an empty deque
try { d.get(0) } catch (e) { print(e.message) }              // expect: get: index 0 is out of range (size 0)

// From a collection, and the list-like methods.
val q = Deque([5, 6, 7, 8])
print(q.map { it * 2 }, q.filter { it > 6 }, q.any { it == 5 }, q.all { it > 5 }, q.none { it > 9 }, q.count { it > 5 }, q.find { it > 6 }, q.reversed(), q.joinToString("-"))   // expect: [10, 12, 14, 16] [7, 8] true false true 3 7 [8, 7, 6, 5] 5-6-7-8
print(q.remove(6), q.remove(99), q.removeAt(1), q.toList(), q == Deque([5, 8]), q == Deque([8, 5]), q.addAll([1, 2]), q.size)   // expect: true false 7 [5, 8] true false true 4
var total = 0
for item in q { total += item }
q.forEach { total += it }
q.clear()
print(total, q.size, "$q")                                   // expect: 32 0 []

// Used as a queue and from the front, over many items: the order holds throughout.
val queue = Deque()
var checksum = 0
for i in 0..<2000 { queue.addLast(i) }
for i in 0..<1500 { checksum += queue.removeFirst() }
for i in 0..<1000 { queue.addFirst(-i) }
for i in 0..<500 { queue.addLast(i) }
print(checksum, queue.size, queue.first(), queue[999], queue[1000], queue.last())   // expect: 1124250 2000 -999 0 1500 499
while (queue.size > 3) {
  queue.removeFirst()
  if (queue.size > 3) { queue.removeLast() }
}
print(queue.toList(), queue.size)                            // expect: [0, 1500, 1501] 3
