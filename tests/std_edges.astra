// Edge cases of the standard library found while describing it for docs/language.html (2026-10-24).

// orEmpty() on null, where the variable's type says which orEmpty is meant.
var s : string? = null
var l : List<int>? = null
var m : Map<string, int>? = null
fun text(x : string?) : string => x.orEmpty()
print(s.orEmpty() == "", l.orEmpty().size, m.orEmpty().size, text(null) == "", text("a"))   // expect: true 0 0 true a
print("ab".orEmpty(), [1].orEmpty(), {"a": 1}.orEmpty())   // expect: ab [1] {"a": 1}

// average() of nothing is NaN.
val none : List<int> = []
print(none.average().isNaN(), [1, 2].average())   // expect: true 1.5

// A sum of nothing is a zero of the kind the items or the selector give.
val noFloats : List<float> = []
val noInts : Set<int> = setOf()
val noEntries : Map<string, int> = {:}
print(noFloats.sum(), none.sum(), none.sumOf { it * 0.5 }, none.sumOf { it }, noInts.sumOf { it * 0.5 })   // expect: 0.0 0 0.0 0 0.0
print(noEntries.sumOf { it.value * 0.5 }, (1..<1).sumOf { it * 0.5 }, none.asSequence().sumOf { it * 0.5 }, noFloats.asSequence().sum())   // expect: 0.0 0.0 0.0 0.0
print(none.parallelStream().sumOf { it * 0.5 }, [1.5, 2.0].sum(), [1, 2].sumOf { it * 2 }, (1..3).sumOf { it * 0.5 })   // expect: 0.0 3.5 6 3.0

// A StringBuilder's ranges are checked.
val sb = StringBuilder("abcdef")
try { sb.deleteRange(3, 1) } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: deleteRange(3, 1) is out of range for a text of 6 characters
try { sb.deleteAt(6) } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: index 6 is out of range for a text of 6 characters
try { sb.deleteCharAt(-1) } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: index -1 is out of range for a text of 6 characters
print(sb.deleteAt(0).toString(), sb.deleteRange(1, 99).toString())   // expect: bcdef b

// split() with no delimiter, and lastIndexOf without a start, as they are declared.
print(" a  b ".split(), "a,b,,c".split(","), "a b".split(' '))   // expect: ["a", "b"] ["a", "b", "", "c"] ["a", "b"]
print("Hello, World".lastIndexOf("o"), "Hello, World".lastIndexOf("o", 5), "Hello, World".lastIndexOf("O", ignoreCase = true), "Hello".lastIndexOf('l', null))   // expect: 8 4 8 3

// set gives the item it replaced.
val letters : open List<string> = ["a", "b"]
val replaced = letters.set(0, "z")
print(replaced, letters)   // expect: a ["z", "b"]

// The main thread, and threads given names, take no number of the Thread-N names.
print(Thread.currentThread().name)   // expect: main
val named = Thread({ }, "loader")
val first = Thread({ })
val second = Thread({ })
print(named.name, first.name, second.name)   // expect: loader Thread-1 Thread-2

// An image's hash comes from its pixels as well as its size, as its == does.
val dot = Image(3, 2)
val same = Image(3, 2)
val other = Image(3, 2)
dot[1, 1] = Color.red
same[1, 1] = Color.red
other[2, 0] = Color.red
print(dot == same, dot.hashCode() == same.hashCode(), dot == other, dot.hashCode() == other.hashCode(), dot.copy().hashCode() == dot.hashCode())   // expect: true true false false true

// A colour's saturation and brightness are from 0.0 to 1.0; its hue goes round, but is a number.
print(Color.HSBtoRGB(1.25, 1.0, 1.0) == Color.HSBtoRGB(0.25, 1.0, 1.0), Color.getHSBColor(0.0, 1.0, 1.0))   // expect: true Color(255, 0, 0)
try { Color.HSBtoRGB(0.5, 1.5, 1.0) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a colour's saturation is from 0.0 to 1.0, not 1.5
try { Color.getHSBColor(0.5, 1.0, -0.1) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a colour's brightness is from 0.0 to 1.0, not -0.1
try { Color.HSBtoRGB(0.0 / 0.0, 1.0, 1.0) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a colour's hue is a number that goes round, not nan
try { Color.RGBtoHSB(0, 256, 0) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a colour's green is from 0 to 255, not 256
try { Color(0.0 / 0.0, 0.0, 0.0) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a colour's red as a fraction is from 0.0 to 1.0, not nan

// single() of nothing is a NoSuchElementException, and of more than one an IllegalArgumentException, as in Kotlin.
val noWords : Set<string> = setOf()
try { noWords.single() } catch (e : NoSuchElementException) { print(e.message) }   // expect: single(): the set is empty
try { setOf(1, 2).single() } catch (e : IllegalArgumentException) { print(e.message) }   // expect: single(): expected one item but found 2
try { none.single() } catch (e : NoSuchElementException) { print(e.message) }   // expect: single(): the list is empty
try { [1, 2, 3].single { it > 5 } } catch (e : NoSuchElementException) { print(e.message) }   // expect: single(): no item meets the condition
try { [1, 2, 3].single { it > 1 } } catch (e : IllegalArgumentException) { print(e.message) }   // expect: single(): expected one item but found 2
try { setOf(1, 2).single { it > 5 } } catch (e : NoSuchElementException) { print(e.message) }   // expect: single(): no item meets the condition
print(setOf(4).single(), setOf(1, 2, 3).single { it == 2 }, [5].single())   // expect: 4 2 5
