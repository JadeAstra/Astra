// An enum entry can be written by its bare name wherever the destination is declared as that enum.

enum Way { up, down, left, right }
enum Fill { NONE, HORIZONTAL, VERTICAL, BOTH }
enum Side { left, right }                     // shares names with Way

// A variable: declared, then assigned.
var t : Way = up
print(t, t === Way.up)                      // expect: up true
t = down
print(t)                                    // expect: down
t = Way.right                               // the full name is always allowed
val fixed : Way? = left
var side : Side = left                      // the destination decides which `left`
print(t, fixed, side, fixed == Way.left, side == Side.left, side == fixed)   // expect: right left left true true false

// The other side of == and !=.
print(t == right, t != right, right == t, t == up, t != up)   // expect: true false true false true
if t == right { print("going right") }      // expect: going right

// Parameters: by position, by name, and with a default.
fun step(way : Way, fill : Fill = NONE) => "$way/$fill"
print(step(up), step(down, BOTH), step(way = left), step(fill = VERTICAL, way = right), step(Way.up, Fill.NONE))
// expect: up/NONE down/BOTH left/NONE right/VERTICAL up/NONE

// A function's result.
fun opposite(way : Way) : Way {
  if way == up { return down }
  if way == down { return up }
  return way == left ? Way.right : Way.left
}
fun vertical() : Way => up
print(opposite(up), opposite(down), opposite(left), opposite(Way.right), vertical())   // expect: down up right left up

// when, against a subject declared as the enum.
fun arrow(way : Way) => when (way) {
  up -> "^"
  down -> "v"
  left, right -> "-"
  else -> "?"
}
print(arrow(up), arrow(Way.down), arrow(left), arrow(right))   // expect: ^ v - -

// Fields: an initial value, the header, assignment, and a method's parameters.
class Cell(val content, var fill : Fill = NONE, var anchor : Way = up) {
  var last : Fill = BOTH
  var stretch : Fill? = null
  static var standard : Fill = HORIZONTAL

  fun widen() {
    last = fill
    fill = HORIZONTAL
    this.stretch = VERTICAL
    return this
  }
  fun move(to : Way) {
    anchor = to
    return this
  }
  fun isWide() => fill == HORIZONTAL or fill == BOTH
  fun describe() => "$content $fill $anchor $last $stretch"
}
print(Cell("a").describe())                 // expect: a NONE up BOTH null
print(Cell("b", BOTH).describe(), Cell("c", fill = VERTICAL, anchor = left).describe())   // expect: b BOTH up BOTH null c VERTICAL left BOTH null
val cell = Cell("d", anchor = down).widen().move(right)
print(cell.describe(), cell.isWide(), Cell.standard)   // expect: d HORIZONTAL right NONE VERTICAL true HORIZONTAL
Cell.standard = Fill.BOTH
print(Cell.standard)                        // expect: BOTH

// Methods called on an object, where only the call tells which method it is.
class Grid {
  val cells = []
  fun cell(content, fill : Fill = NONE, anchor : Way = up) {
    cells.push(Cell(content, fill, anchor))
    return this
  }
  fun add(vararg contents, fill : Fill = NONE) {
    for content in contents { cell(content, fill) }
    return this
  }
}
val grid = Grid().cell("x", HORIZONTAL).cell("y", anchor = left, fill = BOTH).add("p", "q", fill = VERTICAL)
print(grid.cells.map { it.describe() })
// expect: ["x HORIZONTAL up BOTH null", "y BOTH left BOTH null", "p VERTICAL up BOTH null", "q VERTICAL up BOTH null"]

// Lambdas and function values with typed parameters.
val pick = { way : Way -> way.ordinal }
val name = fun(fill : Fill) => fill.name.lower()
print(pick(right), name(BOTH), [1].map { step(left, HORIZONTAL) })   // expect: 3 both ["left/HORIZONTAL"]

// Anything that already has a meaning keeps it: a variable or a global called like an entry.
enum Tone { soft, loud }
val loud = "the global loud"
fun describeTone(tone : Tone) => "$tone"
fun shadowed(up) {
  val way : Way = Way.down
  val copy : Way = up                         // the parameter, not the entry
  return [copy, way]
}
print(loud, shadowed(Way.left))             // expect: the global loud [left, down]
try { describeTone(loud) } catch (e) { print(e.message) }   // expect: argument 'tone' of describeTone() must be Tone, got string
print(describeTone(Tone.loud), describeTone(soft))   // expect: loud soft

// With no enum-typed destination the full name is needed.
fun untyped(x) => x
fun typedOther(n : int) => n
fun takesShape(s : Cell) => s
try { untyped(up) } catch (e) { print(e.message) }       // expect: undefined variable 'up'
try { print(up) } catch (e) { print(e.message) }         // expect: undefined variable 'up'
try { [].push(down) } catch (e) { print(e.message) }     // expect: undefined variable 'down'
try { typedOther(up) } catch (e) { print(e.message) }    // expect: undefined variable 'up'
try { takesShape(up) } catch (e) { print(e.message) }    // expect: undefined variable 'up'
try { step(sideways) } catch (e) { print(e.message) }    // expect: 'sideways' is not an entry of enum Way
try { step(up, left) } catch (e) { print(e.message) }    // expect: 'left' is not an entry of enum Fill
try { Cell("z", up) } catch (e) { print(e.message) }     // expect: 'up' is not an entry of enum Fill
try { untyped(1, up) } catch (e) { print(e.message) }    // expect: untyped() expects 1 argument(s) but got 2
fun many(vararg ways) => ways
try { many(up, down) } catch (e) { print(e.message) }    // expect: undefined variable 'up'
print(many(Way.up, Way.down))               // expect: [up, down]

// After a failed call, later calls are unaffected.
print(step(up), untyped(5), pick(left))     // expect: up/NONE 5 2

// Inside the enum itself the entries are already in reach, typed or not.
enum Light {
  red, amber, green
  fun next() => when (this) {
    red -> green
    green -> amber
    else -> red
  }
  static fun first() => red
}
print(Light.first().next(), Light.green.next().next())   // expect: green red

// Declared further down the file than where it is used.
fun later() : Mood => calm
fun moodOf(mood : Mood) => mood.name
enum Mood { calm, wild }
print(later(), moodOf(wild))                // expect: calm wild

// Many calls.
var total = 0
for i in 1..20000 { total += opposite(up).ordinal + pick(left) }
print(total)                                // expect: 60000
