// A Window and what it makes of the keyboard and the pointer: which widget a press belongs
// to, what a drag and a release go to, who has the keyboard, what Tab does. The windows
// here are never shown (Jade.windowOpener is the one for tests); the events are sent the
// way the system sends them.
import Jade.*

Jade.windowOpener = HiddenWindowOpener()
val none = Modifiers.none

// A content that writes down what it is told, and can take the keyboard.
class Recorder(val name : string) : Content, FocusTarget, FocusAware, CursorProvider {
  override var owner : Component? = null
  val events = []
  var hasFocus = false
  override fun sizes() => Sizes(Size(40, 20), Size(120, 40), Size(1000, 1000))
  override fun paint(canvas : Canvas) {
    canvas.color = hasFocus ? Color.green : Color.gray
    canvas.fillRect(0, 0, canvas.width, canvas.height)
  }
  override fun onEvent(event : Event) {
    events.add(event)
  }
  override fun setFocused(focused : bool) {
    hasFocus = focused
  }
  override fun cursorAt(x : int, y : int) => x < 20 ? CursorKind.text : CursorKind.hand
  fun take() {
    val seen = events.toList()
    events.clear()
    return seen
  }
}

var pressed = 0
val first = Recorder("first")
val second = Recorder("second")
val a = Component(first).withId("first")
val b = Component(second).withId("second")
val ok = button("OK") { pressed += 1 }.withId("ok")
val root = grid {
  insets = Insets(10, 10, 10, 10)
  hgap = 10
  row { cell(a); cell(b); cell(ok) }
}

// -- A window opens nothing until it is shown --
val window = Window(root, "Host", 400, 100)
print(window, window.title, window.isShowing, window.handle, window.exitOnClose, window.initialWidth, window.resizable, window.root === root)   // expect: Window(Host) Host false null true 400 true true
print(window.size)   // expect: Size(400 x 100)
window.show()
val host = window.handle as WindowHost
print(window.isShowing, host is WindowHandle, host.native.isVisible, host.native.width, host.native.height, host.native.title)   // expect: true true false 400 100 Host
print(a.bounds, b.bounds, ok.bounds.x, ok.bounds.width == ok.prefSize().width)   // expect: Rect(10, 10, 120 x 40) Rect(140, 10, 120 x 40) 270 true
print(a.size, window.size, root.size == window.size, Surface(3, 2).size)   // expect: Size(120 x 40) Size(400 x 100) true Size(3 x 2)
window.title = "Renamed"
window.setTitle("Renamed twice")
print(window.title, host.native.title)   // expect: Renamed twice Renamed twice

// -- The picture: the tree painted over the window's own background --
val shot = host.snapshot()
print(shot, shot.get(15, 35).argb == 0xFF808080, shot.get(2, 2).argb == Palette.headerBg.argb, shot.get(145, 35).argb == 0xFF808080, shot.get(15, 60).argb == Palette.headerBg.argb)   // expect: Image(400 x 100) true true true true

// -- A press goes to the widget under it, in the widget's own coordinates --
host.send(RawInput.PointerDown(20, 40, PointerButton.left, none))
print(first.take(), second.take())   // expect: [Click(x=10, y=30, clicks=1, shift=false, ctrl=false)] []
// It holds the pointer: a drag and the release go to it wherever the pointer has gone.
host.send(RawInput.PointerMove(200, 60, 0, 0, setOf(PointerButton.left), none))
host.send(RawInput.PointerMove(-50, 500, 0, 0, setOf(PointerButton.left), Modifiers(shift = true)))
host.send(RawInput.PointerUp(200, 60, PointerButton.left, none))
print(first.take(), second.take())
// expect: [Drag(x=190, y=50, shift=false), Drag(x=-60, y=490, shift=true), Release(x=190, y=50, shift=false)] []
// A release with nothing pressed is nobody's.
host.send(RawInput.PointerUp(20, 40, PointerButton.left, none))
print(first.take())   // expect: []

// -- Presses close together in time and place count up; elsewhere, or with another button, they start again --
host.send(RawInput.PointerDown(100, 30, PointerButton.left, none))
host.send(RawInput.PointerUp(100, 30, PointerButton.left, none))
host.send(RawInput.PointerDown(101, 31, PointerButton.left, none))
host.send(RawInput.PointerUp(101, 31, PointerButton.left, none))
host.send(RawInput.PointerDown(102, 30, PointerButton.left, Modifiers(shift = true, ctrl = true)))
host.send(RawInput.PointerUp(102, 30, PointerButton.left, none))
host.send(RawInput.PointerDown(60, 40, PointerButton.left, none))
host.send(RawInput.PointerUp(60, 40, PointerButton.left, none))
print(first.take().filter { it is Event.Click }.map { [it.clicks, it.shift, it.ctrl] })   // expect: [[1, false, false], [2, false, false], [3, true, true], [1, false, false]]

// -- The other button: pressed, dragged, let go --
host.send(RawInput.PointerDown(150, 40, PointerButton.right, none))
host.send(RawInput.PointerMove(160, 45, 0, 0, setOf(PointerButton.right), none))
host.send(RawInput.PointerUp(160, 45, PointerButton.right, none))
print(second.take())   // expect: [Context(x=10, y=30, drag=false), Context(x=20, y=35, drag=true), Context(x=20, y=35, drag=true)]

// -- A button fires when it is let go while the pointer is still on it, and not otherwise --
val okX = ok.bounds.x + 5
val okY = ok.bounds.y + 5
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
print(pressed)                                                    // expect: 0
host.send(RawInput.PointerUp(okX, okY, PointerButton.left, none))
print(pressed)                                                    // expect: 1
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
host.send(RawInput.PointerMove(20, 40, 0, 0, setOf(PointerButton.left), none))     // dragged off it
host.send(RawInput.PointerUp(20, 40, PointerButton.left, none))
print(pressed, first.take().filter { it is Event.Click or it is Event.Release })   // expect: 1 []
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
host.send(RawInput.PointerMove(20, 40, 0, 0, setOf(PointerButton.left), none))     // off it,
host.send(RawInput.PointerMove(okX, okY, 0, 0, setOf(PointerButton.left), none))   // and back
host.send(RawInput.PointerUp(okX, okY, PointerButton.left, none))
print(pressed)                                                    // expect: 2
// While it is pressed it looks pressed.
val up = host.snapshot()
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
val down = host.snapshot()
host.send(RawInput.PointerMove(20, 40, 0, 0, setOf(PointerButton.left), none))
host.send(RawInput.PointerUp(20, 40, PointerButton.left, none))
print(up == down, host.snapshot() == up, pressed)   // expect: false true 2
first.take()

// -- The pointer moving with nothing pressed: hover, and the pointer's shape --
host.send(RawInput.PointerMove(15, 40, 0, 0, setOf(), none))
print(first.take(), host.cursor, host.native.cursor)   // expect: [Hover(x=5, y=30, shift=false, ctrl=false)] text text
host.send(RawInput.PointerMove(60, 40, 0, 0, setOf(), Modifiers(shift = true)))
print(first.take(), host.cursor)   // expect: [Hover(x=50, y=30, shift=true, ctrl=false)] hand
// Onto another widget: the one it left is told the pointer has gone.
host.send(RawInput.PointerMove(150, 40, 0, 0, setOf(), none))
print(first.take(), second.take())   // expect: [Hover(x=-1, y=-1, shift=false, ctrl=false)] [Hover(x=10, y=30, shift=false, ctrl=false)]
host.send(RawInput.PointerMove(5, 5, 0, 0, setOf(), none))         // onto the grid itself
print(second.take(), host.cursor)   // expect: [Hover(x=-1, y=-1, shift=false, ctrl=false)] default
host.send(RawInput.PointerMove(15, 40, 0, 0, setOf(), none))
host.send(RawInput.Hover(false))                                   // out of the window
print(first.take(), host.cursor)   // expect: [Hover(x=5, y=30, shift=false, ctrl=false), Hover(x=-1, y=-1, shift=false, ctrl=false)] default

// -- A button is lit while the pointer is over it, and no longer --
val plain = host.snapshot()
val edgeX = ok.bounds.x + ok.bounds.width / 2
host.send(RawInput.PointerMove(okX, okY, 0, 0, setOf(), none))
val lit = host.snapshot()
print(lit == plain, plain.get(edgeX, ok.bounds.y).argb == Palette.border.argb, lit.get(edgeX, ok.bounds.y).argb == Palette.accent.argb)   // expect: false true true
host.send(RawInput.PointerMove(5, 5, 0, 0, setOf(), none))         // onto the grid
print(host.snapshot() == plain)                                    // expect: true
host.send(RawInput.PointerMove(okX, okY, 0, 0, setOf(), none))
host.send(RawInput.Hover(false))                                   // out of the window
print(host.snapshot() == plain)                                    // expect: true
// Pressed and let go on it, the pointer is still there; dragged off and let go, it is not.
host.send(RawInput.PointerMove(okX, okY, 0, 0, setOf(), none))
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
host.send(RawInput.PointerUp(okX, okY, PointerButton.left, none))
print(host.snapshot() == lit, pressed)                             // expect: true 3
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
host.send(RawInput.PointerMove(5, 5, 0, 0, setOf(PointerButton.left), none))
host.send(RawInput.PointerUp(5, 5, PointerButton.left, none))
print(host.snapshot() == plain, pressed)                           // expect: true 3
// One that cannot be pressed is not lit.
ok.enabled = false
ok.invalidate()
val dull = host.snapshot()
host.send(RawInput.PointerMove(okX, okY, 0, 0, setOf(), none))
print(dull == plain, host.snapshot() == dull)                      // expect: false true
ok.enabled = true
ok.invalidate()
host.send(RawInput.PointerMove(5, 5, 0, 0, setOf(), none))
host.send(RawInput.Hover(false))
print(host.snapshot() == plain)                                    // expect: true

// -- The wheel goes to what is under the pointer: forty units a click, sideways with Shift --
host.send(RawInput.Wheel(150, 40, 0, 1, none))
host.send(RawInput.Wheel(150, 40, 0, -2.5, none))
host.send(RawInput.Wheel(150, 40, 1, 0, none))
host.send(RawInput.PointerMove(150, 40, 0, 0, setOf(), Modifiers(shift = true)))
host.send(RawInput.Wheel(150, 40, 0, 1, Modifiers(shift = true)))
print(second.take().filter { it is Event.Wheel }.map { [it.x, it.y, it.deltaY, it.deltaX, it.shift] })
// expect: [[10, 30, -40, 0, false], [10, 30, 100, 0, false], [10, 30, 0, -40, false], [10, 30, 0, -40, true]]
host.send(RawInput.PointerMove(150, 40, 0, 0, setOf(), none))
second.take()

// -- The keyboard belongs to what was pressed last, if that takes keys --
print(host.focused?.id, first.hasFocus, second.hasFocus)   // expect: second false true
host.send(RawInput.PointerDown(20, 40, PointerButton.left, none))
host.send(RawInput.PointerUp(20, 40, PointerButton.left, none))
print(host.focused?.id, first.hasFocus, second.hasFocus)   // expect: first true false
first.take()
// Pressing something that does not take keys (a button, the grid) leaves it where it was.
host.send(RawInput.PointerDown(okX, okY, PointerButton.left, none))
host.send(RawInput.PointerUp(okX, okY, PointerButton.left, none))
host.send(RawInput.PointerDown(3, 3, PointerButton.left, none))
host.send(RawInput.PointerUp(3, 3, PointerButton.left, none))
print(host.focused?.id, pressed)   // expect: first 4

// Keys with a name, typed text, and commands go to it.
host.send(RawInput.KeyDown(KeyCode.left, none))
host.send(RawInput.KeyUp(KeyCode.left, none))
host.send(RawInput.KeyDown(KeyCode.end, Modifiers(shift = true)))
host.send(RawInput.KeyDown(KeyCode.right, Modifiers(ctrl = true)))
host.send(RawInput.KeyDown(KeyCode.numpadEnter, none))
host.send(RawInput.KeyDown(KeyCode.a, none, false, "A"))            // a letter is not a key with a name
host.send(RawInput.Text("a"))
host.send(RawInput.Text("é"))
print(first.take())
// expect: [KeyPress(key=left, shift=false, ctrl=false), KeyPress(key=end, shift=true, ctrl=false), KeyPress(key=right, shift=false, ctrl=true), KeyPress(key=enter, shift=false, ctrl=false), KeyType(text="a"), KeyType(text="é")]
host.send(RawInput.KeyDown(KeyCode.c, Modifiers(ctrl = true), false, "C"))
host.send(RawInput.KeyDown(KeyCode.z, Modifiers(ctrl = true), false, "Z"))
host.send(RawInput.KeyDown(KeyCode.z, Modifiers(ctrl = true, shift = true), false, "Z"))
host.send(RawInput.KeyDown(KeyCode.space, Modifiers(ctrl = true)))
// By the letter the layout gives the key, not by where the key is: on a French keyboard
// the key in Q's place types A.
host.send(RawInput.KeyDown(KeyCode.q, Modifiers(ctrl = true), false, "A"))
print(first.take())
// expect: [Shortcut(command=copy), Shortcut(command=undo), Shortcut(command=redo), Shortcut(command=complete), Shortcut(command=selectAll)]
// With no letter from the layout, the key's own place says.
host.send(RawInput.KeyDown(KeyCode.v, Modifiers(ctrl = true)))
print(first.take())   // expect: [Shortcut(command=paste)]

// Tab moves the keyboard on to the next widget that takes it, and Shift+Tab back.
host.send(RawInput.KeyDown(KeyCode.tab, none))
print(host.focused?.id, first.hasFocus, second.hasFocus, first.take())   // expect: second false true []
host.send(RawInput.KeyDown(KeyCode.tab, none))
print(host.focused?.id)   // expect: first
host.send(RawInput.KeyDown(KeyCode.tab, Modifiers(shift = true)))
print(host.focused?.id, root.focusables().map { it.id })   // expect: second ["first", "second"]
// A component asks for the keyboard itself.
Jade.requestFocus(a)
print(host.focused?.id, first.hasFocus)   // expect: first true
// The widget with the keyboard is painted as having it.
print(host.snapshot().get(15, 35).argb == 0xFF00FF00, host.snapshot().get(145, 35).argb == 0xFF808080)   // expect: true true

// -- Every window hears of a repaint asked for; a frame is drawn once however often it is asked --
var paints = 0
class Painted : Content {
  override var owner : Component? = null
  override fun sizes() => Sizes(Size(10, 10), Size(10, 10), Size(10, 10))
  override fun paint(canvas : Canvas) {
    paints += 1
  }
}
val painted = Component(Painted())
(root.content as GridPane).add(painted, 1, 0)
host.frame()
val afterAdding = paints
host.frame()
host.frame()
print(afterAdding, paints, painted.bounds.y > a.bounds.y, painted.parent === root)   // expect: 1 1 true true
painted.invalidate()
painted.invalidate()
host.frame()
print(paints)   // expect: 2

// -- Another tree in the same window --
val other = label("another tree").withId("other")
window.root = other
host.frame()
print(window.root.id, host.shownTree.id, other.bounds, host.focused)   // expect: other other Rect(0, 0, 400 x 100) null
window.root = root
host.frame()

// -- A filter sees every named key first, and may keep it --
val filtered = []
val second2 = Window(label("filtered"), "Filter", 200, 60, keyFilter = { key, focused ->
  filtered.add(key.key)
  key.key == Key.escape
}, exitOnClose = false)
second2.show()
(second2.handle as WindowHost).send(RawInput.KeyDown(KeyCode.escape, none))
(second2.handle as WindowHost).send(RawInput.KeyDown(KeyCode.enter, none))
(second2.handle as WindowHost).send(RawInput.KeyDown(KeyCode.a, none))
print(filtered, Jade.windowOpener.opened.size)   // expect: [escape, enter] 2

// -- A window that belongs to another, sized to what it holds --
var closed = 0
val dialog = Window(button("Close me"), "Dialog", owner = window, dialog = true, sizeToContent = true, resizable = false, onClose = { closed += 1 })
print(dialog.exitOnClose, dialog.owner === window)   // expect: false true
dialog.show()
val pref = dialog.root.prefSize()
print((dialog.handle as WindowHost).native.height == pref.height, (dialog.handle as WindowHost).native.width >= pref.width, dialog.root.bounds.height == pref.height)   // expect: true true true
dialog.close()
dialog.close()
print(closed, dialog.isShowing, dialog.handle)   // expect: 1 false null
// Shown again, it is a new window.
dialog.show()
print(dialog.isShowing, closed)   // expect: true 1
(dialog.handle as WindowHost).native.sendCloseRequest()        // the X of its title bar
print(dialog.isShowing, closed)   // expect: false 2

// -- An opener of a test's own: nothing is made, and what was asked is written down --
class FakeHandle(val window : Window) : WindowHandle {
  val calls = []
  override fun setTitle(text : string) { calls.add("title: $text") }
  override fun toFront() { calls.add("toFront") }
  override fun close() {
    calls.add("close")
    window.closed()
  }
  override fun fitToContent() { calls.add("fit") }
  override fun requestRepaint() { calls.add("repaint") }
  override fun rootChanged(root : Component) { calls.add("root") }
}
class FakeOpener : WindowOpener {
  val opened = []
  override fun open(window : Window) {
    val handle = FakeHandle(window)
    opened.add(handle)
    return handle
  }
}
val real = Jade.windowOpener
val fake = FakeOpener()
Jade.windowOpener = fake
val pretend = Window(label("x"), "Pretend", 300, 200)
pretend.show()
pretend.show()                      // already open: brought to the front
pretend.title = "Other"
pretend.toFront()
pretend.bringToFront()
pretend.fitToContent()
pretend.requestRepaint()
pretend.root = label("y")
pretend.close()
print(fake.opened.size, fake.opened[0].window.initialWidth, fake.opened[0].calls, pretend.isShowing)
// expect: 1 300 ["toFront", "title: Other", "toFront", "toFront", "fit", "repaint", "root", "close"] false
Jade.windowOpener = real

// -- Something to do every frame --
var frames = 0
var lastTime : FrameTime? = null
val animate = { time ->
  frames += 1
  lastTime = time
}
Jade.onFrame(animate)
host.frame()
Thread.sleep(3.milliseconds)
host.frame()
Thread.sleep(3.milliseconds)
host.frame()
Jade.removeFrameHook(animate)
print(frames, lastTime!!.frame, lastTime!!.delta > 0.002, lastTime!!.time >= lastTime!!.delta, Jade.wantsFrames)   // expect: 3 2 true true false

// -- A dense screen: the same tree and the same numbers, more pixels --
Jade.windowOpener = HiddenWindowOpener(2)
var denseClicks = 0
val denseButton = button("Dense") { denseClicks += 1 }
val longText = "the same colours, by day and by night, in a line long enough for rounding to add up"
val longLabel = label(longText)
val dense = Window(grid { insets = Insets(10, 10, 10, 10); row { cell(denseButton, anchor = Anchor.west) }; row { cell(longLabel, anchor = Anchor.west) } }, "Dense", 600, 80, exitOnClose = false)
dense.show()
// Text is measured for the screen it is drawn on: at 2 pixels to the unit a line is a
// little wider, in units, than the same line on an ordinary screen, and the label asks
// for the room it really takes (it would be cut short otherwise).
val plainFont = Font(Font.sansSerif, 12)
val onDense = Math.ceil(plainFont.width(longText, 2) / 2.0).toInt()
print(longLabel.bounds.width * 2 >= plainFont.width(longText, 2) + 16, longLabel.bounds.width == onDense + 8, onDense > plainFont.width(longText))   // expect: true true true
val labelShot = (dense.handle as WindowHost).snapshot().crop(longLabel.bounds.x * 2, longLabel.bounds.y * 2, longLabel.bounds.width * 2, longLabel.bounds.height * 2)
val inked = labelShot.inkBox(Palette.headerBg)!!
print(inked.x >= 8, inked.x + inked.width <= labelShot.width - 4)   // expect: true true
val denseShot = (dense.handle as WindowHost).snapshot()
print(denseShot, (dense.handle as WindowHost).native.scale, denseButton.bounds.x, denseButton.bounds.y)   // expect: Image(1200 x 160) 2.0 10 10
// The button's edge is where it should be in the screen's pixels, and a press in units finds it.
print(denseShot.get(19, 40).argb == Palette.headerBg.argb, denseShot.get(24, 40).argb != Palette.headerBg.argb)   // expect: true true
(dense.handle as WindowHost).send(RawInput.PointerDown(15, 15, PointerButton.left, none))
(dense.handle as WindowHost).send(RawInput.PointerUp(15, 15, PointerButton.left, none))
print(denseClicks)   // expect: 1

// -- The dark theme reaches a window that is open --
val light = (dense.handle as WindowHost).snapshot()
Palette.dark = true
val dark = (dense.handle as WindowHost).snapshot()
Palette.dark = false
print(light == dark, dark.get(2, 2).blue < 80, light.get(2, 2).blue > 200, (dense.handle as WindowHost).snapshot() == light)   // expect: false true true true
dense.close()
Jade.windowOpener = real

// -- Closing: the tree is let go, and a hidden window keeps nothing going --
second2.close()
window.close()
print(window.isShowing, host.native.isOpen)   // expect: false false
host.frame()                                  // no harm
Jade.requestRepaint()

// A library's classes say it is where they come from (D184); the program's own say its name.
print(Window#.origin, Button#.origin, Recorder#.origin)   // expect: Jade Jade jade_host

print("done")   // expect: done
