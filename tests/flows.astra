// The event loop and flows.

val log = []

// ---- The event loop ----
// Posted tasks and timers run on the main thread, one at a time, after the script; run()
// lets a script carry on after them.
EventLoop.post { log.add("posted 1") }
EventLoop.post { log.add("posted 2") }
EventLoop.after(30) { log.add("after 30") }
EventLoop.after(5) { log.add("after 5") }
var ticks = 0
var ticker : Timer? = null
ticker = EventLoop.every(4) {
  ticks += 1
  if (ticks == 3) { ticker!!.cancel() }
}
val cancelled = EventLoop.after(1) { log.add("never") }
cancelled.cancel()
print(log, EventLoop.isLoopThread)                           // expect: [] true
EventLoop.run()
print(log, ticks)                                            // expect: ["posted 1", "posted 2", "after 5", "after 30"] 3

// A thread hands its result to the main thread by posting.
log.clear()
val worker = thread(name = "worker") {
  val onWorker = !EventLoop.isLoopThread
  EventLoop.post { log.add("from the worker: $onWorker, on the loop: ${EventLoop.isLoopThread}") }
}
EventLoop.run()                                              // waits for the thread, and then for what it posted
print(log, worker.isAlive)                                   // expect: ["from the worker: true, on the loop: true"] false

// ---- Flows ----
// A question whose answer comes later, through a callback. Here a timer stands for the user.
val questions = []
fun ask(question : string, callback : (string) -> unit) {
  questions.add(question)
  EventLoop.after(2) { callback(question.uppercase()) }
}

// The same question as a suspending function: it is called like any other.
suspend fun answerTo(question : string) : string => suspendCoroutine { continuation -> ask(question) { continuation.resume(it) } } as string

log.clear()
startCoroutine {
  log.add("start")
  val first = answerTo("one")
  log.add(first)
  val second = answerTo("two, after $first")
  log.add(second)
}
log.add("started")                    // the flow ran as far as its first question, then returned here
print(log, questions)                                        // expect: ["start", "started"] ["one"]
EventLoop.run()
print(log)                                                   // expect: ["start", "started", "ONE", "TWO, AFTER ONE"]

// An answer that is already there does not set the flow aside at all.
log.clear()
startCoroutine {
  val now = suspendCoroutine { c -> c.resume("at once") }
  log.add(now)
}
print(log)                                                   // expect: ["at once"]

// How a flow turned out is told to a completion.
var outcome : Result<any?>? = null
val exclaim = { answerTo("x") + "!" }
exclaim.startCoroutine(Continuation { result -> outcome = result })
print(outcome)                                               // expect: null
EventLoop.run()
print(outcome, outcome!!.isSuccess, outcome!!.getOrNull(), outcome!!.exceptionOrNull())   // expect: Success(X!) true X! null
val failing = { answerTo("y"); throw Error("went wrong") }
failing.startCoroutine(Continuation(EmptyCoroutineContext) { outcome = it })
EventLoop.run()
print(outcome!!.isFailure, (outcome!!.exceptionOrNull() as Error).message, outcome!!.getOrNull(), outcome!!.getOrDefault(0), outcome!!.getOrElse { "else: " + (it as Error).message })   // expect: true went wrong null 0 else: went wrong
try { outcome!!.getOrThrow() } catch (e) { print("rethrown:", e.message) }   // expect: rethrown: went wrong
print(runCatching { 6 * 7 }, runCatching { throw Error("no") }.isFailure, Result.success(1).onSuccess { log.add("ok") }.getOrThrow(), log.last())   // expect: Success(42) true 1 ok

// A wait can be answered with an error, which the flow can catch.
log.clear()
startCoroutine {
  try {
    suspendCoroutine { c -> EventLoop.post { c.resumeWithException(Error("refused")) } }
  } catch (e) {
    log.add("caught " + e.message)
  }
  log.add(suspendCoroutine { c -> EventLoop.post { c.resumeWith(Result.success("then went on")) } })
}
EventLoop.run()
print(log)                                                   // expect: ["caught refused", "then went on"]

// Without a completion, an error the flow does not catch goes to whoever was running it:
// here the callback that brought the answer.
var reached : string? = null
var held : Continuation? = null
startCoroutine {
  suspendCoroutine { c -> held = c }
  throw Error("after the answer")
}
try { held!!.resume(1) } catch (e) { reached = e.message }
print(reached)                                               // expect: after the answer
try { startCoroutine { throw Error("at once") } } catch (e) { print(e.message) }   // expect: at once

// A continuation is resumed once.
startCoroutine { suspendCoroutine { c -> held = c } }
held!!.resume(1)
try { held!!.resume(2) } catch (e) { print(e.message) }        // expect: this continuation has already been resumed

// A flow can be set aside inside a lambda given to a collection function, inside apply,
// with, let and run, and several calls deep.
class Form { var name = ""; var size = 0 }
fun deeper(p : string) {
  val inner = { q -> answerTo(p + q) }
  return inner("2")
}
log.clear()
startCoroutine {
  val answers = ["a", "b"].map { answerTo(it) }
  ["c"].forEach { log.add(answerTo(it)) }
  val form = Form().apply { name = answerTo("name") }
  with(form) { size = answerTo("12345").length }
  val viaLet = "q".let { answerTo(it) }
  val viaRun = form.run { answerTo(name) }
  val nested = deeper("1")
  val counted = (1..3).sumOf { answerTo("x").length }
  log.add([answers, form.name, form.size, viaLet, viaRun, nested, counted, {"k": 1}.map { answerTo(it.key) }])
}
EventLoop.run()
print(log)                                                   // expect: ["C", [["A", "B"], "NAME", 5, "Q", "NAME", "12", 3, ["K"]]]

// delay sets a flow aside for a time; other flows and the loop go on meanwhile.
log.clear()
startCoroutine { delay(30); log.add("slow") }
startCoroutine { delay(5); log.add("quick") }
EventLoop.run()
print(log)                                                   // expect: ["quick", "slow"]

// A flow can wait for work done on a thread without holding the main thread.
log.clear()
startCoroutine {
  val future = Future.supplyAsync { Thread.sleep(10); "worked on " + (EventLoop.isLoopThread ? "the loop" : "a thread") }
  log.add(future.await() + ", back on the loop: ${EventLoop.isLoopThread}")
  log.add((runCatching { Future.supplyAsync { throw Error("failed there") }.await() }.exceptionOrNull() as Error).message)
}
log.add("meanwhile")
EventLoop.run()
print(log)                                                   // expect: ["meanwhile", "worked on a thread, back on the loop: true", "failed there"]

// A flow started inside another runs until it is first set aside, then the outer one goes on.
log.clear()
startCoroutine {
  log.add("outer 1")
  startCoroutine { log.add("inner 1"); answerTo("i"); log.add("inner 2") }
  log.add("outer 2")
  answerTo("o")
  log.add("outer 3")
}
EventLoop.run()
print(log)                                                   // expect: ["outer 1", "inner 1", "outer 2", "inner 2", "outer 3"]

// On a thread that is not running a flow, a suspending function waits on that thread.
var onThread : any? = null
thread { onThread = suspendCoroutine { c -> EventLoop.post { c.resume("answered from the loop") } } }
EventLoop.run()
print(onThread)                                              // expect: answered from the loop

// A flow cannot be set aside from inside a built-in function that is calling back.
startCoroutine {
  try {
    [2, 1].sort { a, b -> answerTo("s").length }
  } catch (e) {
    print(e.message)
  }
}
// expect: the flow cannot be set aside here: it is inside a built-in function that is calling back into the program (a sort, or a property being read); wait outside it

// ---- Snips' Flows.kt, as it ports ----

fun flow(block : suspend () -> unit) {
  block.startCoroutine(Continuation(EmptyCoroutineContext) { r -> r.exceptionOrNull()?.let { throw it } })
}

fun flowNow(block : suspend () -> any?) : any? {
  var out : Result? = null
  block.startCoroutine(Continuation(EmptyCoroutineContext) { out = it })
  return out?.getOrThrow()
}

suspend fun await(ask : ((any) -> unit) -> unit) => suspendCoroutine { c ->
  var answered = false
  ask { if (!answered) { answered = true; c.resume(it) } }
}

fun answering(f : (string) -> string) => { a, done -> done(f(a)) }

// A dialog that answers later, and a stub that answers at once, as a test would give.
object dialog {
  fun prompt(title : string, done : (string) -> unit) { EventLoop.after(1) { done("$title?"); done("ignored") } }
}
suspend fun askText(title : string) => await { dialog.prompt(title, it) }

log.clear()
flow {
  val name = askText("name")
  val colour = askText("colour for $name")
  log.add(colour)
}
EventLoop.run()
val stub = answering { title -> "stubbed $title" }
print(log, flowNow { await { stub("x", it) } }, flowNow { askText("later") })   // expect: ["colour for name??"] stubbed x null
EventLoop.run()
