// Threads, locks and what is built on them (D85 to D90, D117, D118). Every line printed here is
// the same on every run: what the threads do is waited for before it is shown.

// A thread runs a function; join waits for it.
val log : open List<any?> = []
val first = Thread({ log.add("ran on " + Thread.currentThread().name) }, "worker-1")
print(first.name, first.isAlive, first.isDaemon)             // expect: worker-1 false false
first.start()
first.join()
print(log, first.isAlive)                                    // expect: ["ran on worker-1"] false
try { first.start() } catch (e) { print(e.message) }         // expect: thread 'worker-1' has already been started

// thread { } starts one at once and gives a Job of what the block returns.
val helper = thread(name = "helper") { log.add(Thread.currentThread().name); 6 * 7 }
print(helper.get(), log.last(), Thread.currentThread().name, Thread.currentThread() === Thread.currentThread())   // expect: 42 helper main true

// A class can extend Thread and say what it does itself.
class Counter(val upTo : int) : Thread(null, "counter") {
  var total = 0
  override suspend fun run() {
    for i in 1..upTo { total += i }
  }
}
val counting = Counter(100)
counting.start()
counting.join()
print(counting.total, counting)                              // expect: 5050 Thread(counter)

// ---- Locks (D86) ----
// Four threads adding to one number, each holding the lock's key while it does.
var shared = 0
val lock = Lock()
val adders = (1..4).map { n -> thread { for i in 1..500 { lock.useKey { shared += 1 } } } }
Job.all(adders).get()
print(shared)                                                // expect: 2000

// A thread that has the key may take it again; useKey gives what its block gives, and the key
// back however the block ends.
print(lock.useKey { lock.useKey { "twice" } })               // expect: twice
try { lock.useKey { throw IllegalStateException("inside") } } catch (e) { print(e.message) }   // expect: inside
var couldTake = false
thread { lock.useKey { couldTake = true } }.get()
print(couldTake)                                             // expect: true

// Data reached only with the key.
val counts : open Map<string, int> = {:}
val box = LockBox(counts)
Job.all((1..3).map { n -> thread { repeat(100) { box.useKey { it["clicks"] = (it["clicks"] ?: 0) + 1 } } } }).get()
print(box.useKey { it["clicks"] })                           // expect: 300

// waitUntil gives the key back until the condition holds: Java's wait and notify, with no
// notify to forget.
val gate = Lock()
var ready = false
val waiter = thread {
  gate.useKey {
    waitUntil { ready }
    log.add("woken")
  }
}
Thread.sleep(20.milliseconds)
gate.useKey { ready = true }
waiter.get()
print(log.last(), gate.useKey { waitUntil(timeout = 10.milliseconds) { false } })   // expect: woken false
try { waitUntil { true } } catch (e) { print(e.message) }    // expect: waitUntil is for inside useKey { }: it gives that key back while it waits

// ---- Atomic values (D85) ----
val hits = Atomic(0)
Job.all((1..4).map { thread { for i in 1..250 { hits.increment() } } }).get()
print(hits.get(), hits.add(5), hits.decrement(), hits.compareAndSet(1004, 0), hits.compareAndSet(1004, 1), hits.get())   // expect: 1000 1005 1004 true false 0
val flag = Atomic(false)
val holder = Atomic<string?>("a")
print(flag.compareAndSet(false, true), flag.get(), flag.exchange(false), holder.exchange("b"), holder.get(), holder.update { it + "c" }, hits)   // expect: true true true a b bc 0
try { Atomic(int.maxValue).increment() } catch (e : ArithmeticException) { print(e.message) }   // expect: 9223372036854775807 + 1 does not fit in an int; update { it &+ n } wraps around (D27)

// ---- Channels (D87) ----
// receive waits for an item; a for takes them until the channel is closed and empty.
val squares = Channel<int>(capacity = 2)
thread {
  for n in 1..5 { squares.send(n * n) }
  squares.close()
}
val taken : open List<int> = []
for (item in squares) { taken.add(item) }
print(taken, squares.isClosed, squares.tryReceive())          // expect: [1, 4, 9, 16, 25] true null
try { squares.send(1) } catch (e) { print(e.message) }       // expect: the channel is closed
try { squares.receive() } catch (e) { print(e.message) }     // expect: the channel is closed, and empty
// A full channel takes no more without waiting; an unbounded one takes any number.
val small = Channel<int>(capacity = 2)
print(small.trySend(1), small.trySend(2), small.trySend(3), small.tryReceive())   // expect: true true false 1
val filler = thread { small.send(3); small.send(4) }
Thread.sleep(20.milliseconds)
print(small.receive(), small.receive(), small.receive(), small.receive(timeout = 10.milliseconds))   // expect: 2 3 4 null
filler.get()
val any = Channel<string>.unbounded()
for word in ["a", "b", "c"] { any.send(word) }
print(any.tryReceive(), any.receive(), any.receive(timeout = 1.seconds))   // expect: a b c
// With capacity 0, each send waits for a receive to take it.
val handoff = Channel<int>(capacity = 0)
print(handoff.trySend(1))                                    // expect: false
val sender = thread { handoff.send(7); "taken" }
print(handoff.receive(), sender.get())                       // expect: 7 taken

// ---- Countdown (D118) ----
val done = Countdown(3)
for n in 1..3 { thread { Thread.sleep((n * 5).milliseconds); done.countDown() } }
print(Countdown(1).await(timeout = 10.milliseconds), done.await(), done.count, done.await(timeout = 1.seconds))   // expect: false true 0 true

// ---- Interrupting ----
// A thread waiting is woken with an error; one that is working sees the mark when it asks.
var caught : string? = null
val sleeper = thread {
  try { Thread.sleep(1.minutes) } catch (e : InterruptedException) { caught = e.message }
}
Thread.sleep(20.milliseconds)
sleeper.cancel(interrupt = true)
Thread.sleep(20.milliseconds)
print(caught, sleeper.isCancelled)                           // expect: the thread was interrupted true
var noticed = false
val started = Countdown(1)
val busyThread = Thread({
  started.countDown()
  while (!Thread.currentThread().isInterrupted) { Thread.yield() }
  noticed = Thread.interrupted()
  log.add(Thread.interrupted())
})
busyThread.start()
started.await()
busyThread.interrupt()
busyThread.join()
print(noticed, log.last(), busyThread.isInterrupted)         // expect: true false false

// join with a time limit comes back when the time is up.
val slow = Thread({ Thread.sleep(1.minutes) })
slow.isDaemon = true
slow.start()
print(slow.join(timeout = 20.milliseconds), slow.isAlive, slow.isDaemon)   // expect: false true true

// ---- Jobs (D89) ----
// A job a program completes itself; get waits for it, with a time limit if one is given.
val answer = Job<int>()
val completing = thread { Thread.sleep(5.milliseconds); answer.complete(42) }
print(answer.get(), completing.get(), answer.complete(43), answer.getOrNull(), Job<string>().getOrNull())   // expect: 42 true false 42 null
val failing = Job<int>()
failing.fail(IllegalStateException("job failed"))
try { failing.get() } catch (e : ExecutionException) { print(e.message, e.cause is IllegalStateException, failing.failed) }   // expect: job failed true true
try { Job<int>().get(timeout = 20.milliseconds) } catch (e : TimeoutException) { print(e.message) }   // expect: the time ran out
val stopped = Job<int>()
print(stopped.cancel(), stopped.isCancelled, stopped.cancel(), stopped.failed)   // expect: true true false true
try { stopped.get() } catch (e : CancellationException) { print(e.message) }   // expect: the task was cancelled
// Job.all gives every value in order, Job.any the first to succeed.
val parts = (1..4).map { n -> thread { Thread.sleep(((5 - n) * 3).milliseconds); n * n } }
print(Job.all(parts).get(), Job.any([failing, parts[2]]).get(), Job.all<int>([]).get())   // expect: [1, 4, 9, 16] 9 []
try { Job.all([parts[0], failing]).get() } catch (e : ExecutionException) { print(e.cause!!.message) }   // expect: job failed

// ---- Thread pools (D88) ----
val pool = ThreadPool(threads = 3, name = "workers")
val results = (1..6).map { n -> pool.submit { Thread.sleep(2.milliseconds); n * 10 } }
print(Job.all(results).get(), results.all { it.isDone })     // expect: [10, 20, 30, 40, 50, 60] true
val broken = pool.submit { throw IllegalStateException("job broke") }
try { broken.get() } catch (e : ExecutionException) { print(e.message, broken.failed) }   // expect: job broke true
val stuck = pool.submit { Thread.sleep(1.minutes); "never" }
try { stuck.get(timeout = 20.milliseconds) } catch (e : TimeoutException) { print(e.message, stuck.isDone) }   // expect: the time ran out false
print(stuck.cancel(interrupt = true), stuck.isCancelled, stuck.cancel())   // expect: true true false
// Timed jobs: once after a delay, and again and again until cancelled.
val once = pool.after(10.milliseconds) { "later" }
var times = 0
val repeating = pool.every(5.milliseconds) { times += 1 }
print(once.get(), once.isDone)                               // expect: later true
Thread.sleep(60.milliseconds)
repeating.cancel()
print(times >= 3)                                            // expect: true
pool.close()
print(pool.isClosed)                                         // expect: true
try { pool.submit { 1 } } catch (e) { print(e.message) }     // expect: the pool 'workers' is closed: it takes no more jobs

// One thread, jobs in order.
val queue = JobQueue("saver")
val order : open List<int> = []
val names : open List<string> = []
val jobs = (1..5).map { n -> queue.submit { order.add(n); names.add(Thread.currentThread().name); n } }
Job.all(jobs).get()
print(order, names.distinct())                               // expect: [1, 2, 3, 4, 5] ["saver-1"]
queue.submit { Thread.sleep(1.minutes) }
val waiting = queue.submit { "not run" }
Thread.sleep(20.milliseconds)
queue.closeNow()
print(waiting.isCancelled)                                   // expect: true

// ---- Durations (D90) ----
print(16.milliseconds, 1.5.seconds, 90.seconds, 2.hours + 30.minutes, 250.microseconds, 1.seconds / 60)   // expect: 16ms 1.5s 1m 30s 2h 30m 250us 16.666666ms
print(2.seconds > 1999.milliseconds, 1.5.seconds.inMilliseconds, (3.seconds * 2).inWholeMilliseconds, 1.minutes / 1.seconds, [3.seconds, 1.seconds].sorted())   // expect: true 1500.0 6000 60.0 [1s, 3s]

// An error that nothing catches ends its thread, not the program, and is reported; and a daemon
// thread still running at the end does not keep the program alive.
thread(daemon = true) { while (true) { Thread.sleep(1.seconds) } }
print("end of script")                                       // expect: end of script
