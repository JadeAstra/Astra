// Threads, locks and the things built on them. Every line printed here is the same on every
// run: the threads are waited for before their results are shown.

// A thread runs a function; join waits for it.
val log = []
val first = Thread({ log.add("ran on " + Thread.currentThread().name) }, "worker-1")
print(first.name, first.isAlive, first.isDaemon)             // expect: worker-1 false false
first.start()
first.join()
print(log, first.isAlive)                                    // expect: ["ran on worker-1"] false
try { first.start() } catch (e) { print(e.message) }         // expect: thread 'worker-1' has already been started

// The other ways of making one.
val second = Thread("named") { log.add(Thread.currentThread().name) }
second.start()
second.join()
val third = thread(name = "helper") { log.add(Thread.currentThread().name) }
val fourth = thread(start = false) { log.add("fourth") }
third.join()
print(log.drop(1), fourth.isAlive, log.size)                 // expect: ["named", "helper"] false 3
fourth.start()
fourth.join()
print(log.last(), Thread.currentThread().name, Thread.currentThread() === Thread.currentThread())   // expect: fourth main true

// A class can extend Thread and say what it does itself.
class Counter(val upTo : int) : Thread("counter") {
  var total = 0
  override fun run() {
    for i in 1..upTo { total += i }
  }
}
val counting = Counter(100)
counting.start()
counting.join()
print(counting.total, counting)                              // expect: 5050 Thread(counter)

// Threads share everything. Four of them adding to one number, under a lock.
var shared = 0
val lock = Lock()
val adders = (1..4).map { n -> thread { for i in 1..500 { synchronized(lock) { shared += 1 } } } }
adders.forEach { it.join() }
print(shared)                                                // expect: 2000

// Any object is a lock, and a thread may take one it already holds.
val anything = [1, 2]
print(synchronized(anything) { synchronized(anything) { anything.size } }, lock.withLock { "held: ${lock.isHeldByCurrentThread}" }, lock.isHeldByCurrentThread)   // expect: 2 held: true false
print(lock.tryLock(), lock.tryLock())                        // expect: true true
lock.unlock()
lock.unlock()
try { lock.unlock() } catch (e) { print(e.message) }         // expect: unlock: this thread does not hold the lock; it is held inside synchronized(lock) { ... }
try { synchronized(5) { 1 } } catch (e) { print(e.message) } // expect: a lock is an object, not a value of type int
// An error inside lets the lock go.
try { synchronized(lock) { throw RuntimeException("inside") } } catch (e) { print(e.message, lock.isHeldByCurrentThread) }   // expect: inside false
// While one thread holds a lock, another cannot take it.
lock.lock()
var couldTake : bool? = null
thread { couldTake = lock.tryLock() }.join()
lock.unlock()
print(couldTake)                                             // expect: false

// wait and notify: one thread waits for another to change something.
val gate = Lock()
var ready = false
val waiter = thread {
  gate.withLock {
    while (!ready) { gate.wait() }
    log.add("woken")
  }
}
Thread.sleep(20)
gate.withLock { ready = true; gate.notifyAll() }
waiter.join()
print(log.last(), gate.withLock { gate.wait(10) })           // expect: woken false
try { gate.wait() } catch (e) { print(e.message) }           // expect: wait: this thread does not hold the lock; it is held inside synchronized(lock) { ... }

// Values that change in one piece.
val hits = AtomicInteger()
val flag = AtomicBoolean()
val holder = AtomicReference("a")
(1..4).map { thread { for i in 1..250 { hits.incrementAndGet() } } }.forEach { it.join() }
print(hits.get(), hits.getAndAdd(5), hits.value, hits.compareAndSet(1005, 0), hits.compareAndSet(1005, 1), hits.decrementAndGet())   // expect: 1000 1000 1005 true false -1
print(flag.compareAndSet(false, true), flag.get(), flag.getAndSet(false), holder.getAndSet("b"), holder.get(), AtomicLong(7).incrementAndGet())   // expect: true true true a b 8

// A queue to hand things over on: take waits for an item.
val queue = BlockingQueue()
val squares = thread {
  for n in 1..5 { queue.put(n * n) }
  queue.put("done")
}
val taken = []
while (true) {
  val item = queue.take()
  if (item == "done") { break }
  taken.add(item)
}
squares.join()
print(taken, queue.size, queue.poll(), queue.poll(20), queue.isEmpty())   // expect: [1, 4, 9, 16, 25] 0 null null true
// With a capacity, put waits for room.
val small = BlockingQueue(2)
print(small.offer(1), small.offer(2), small.offer(3), small.size, small.peek())   // expect: true true false 2 1
val filler = thread { small.put(3); small.put(4) }
Thread.sleep(20)
print(small.take(), small.take(), small.take(), small.take())   // expect: 1 2 3 4
filler.join()

// A latch that opens when enough has happened.
val latch = CountDownLatch(3)
for n in 1..3 { thread { Thread.sleep(n * 5); latch.countDown() } }
print(CountDownLatch(1).await(10), latch.await(), latch.count, latch.await(1, TimeUnit.seconds))   // expect: false true 0 true

// Interrupting a thread that is waiting wakes it with an error; one that is working sees
// the mark when it asks.
var caught : string? = null
val sleeper = thread {
  try { Thread.sleep(60000) } catch (e : InterruptedException) { caught = e.message }
}
Thread.sleep(20)
sleeper.interrupt()
sleeper.join()
print(caught)                                                // expect: the thread was interrupted
var noticed = false
val started = CountDownLatch(1)
val busy = thread {
  started.countDown()
  while (!Thread.currentThread().isInterrupted) { Thread.yield() }
  noticed = Thread.interrupted()
  log.add(Thread.interrupted())
}
started.await()
busy.interrupt()
busy.join()
print(noticed, log.last(), busy.isInterrupted)               // expect: true false false

// join with a time limit comes back when the time is up.
val slow = thread(isDaemon = true) { Thread.sleep(60000) }
slow.join(20)
print(slow.isAlive, slow.isDaemon)                           // expect: true true

// An executor: threads that take tasks from a queue. A task gives a future.
val pool = Executors.newFixedThreadPool(3)
val results = (1..6).map { n -> pool.submit { Thread.sleep(2); n * 10 } }
print(results.map { it.get() }, results.all { it.isDone })   // expect: [10, 20, 30, 40, 50, 60] true
val failing = pool.submit { throw RuntimeException("task failed") }
try { failing.get() } catch (e : ExecutionException) { print(e.message, e.cause is Exception, failing.isCompletedExceptionally) }   // expect: task failed true true
val stuck = pool.submit { Thread.sleep(60000); "never" }
try { stuck.get(20, TimeUnit.milliseconds) } catch (e : TimeoutException) { print(e.message, stuck.isDone) }   // expect: the time ran out false
print(stuck.cancel(true), stuck.isCancelled, stuck.cancel(true))   // expect: true true false
try { stuck.get() } catch (e : CancellationException) { print(e.message) }   // expect: the task was cancelled
print(pool.submit { "still working" }.get())                 // expect: still working
pool.shutdown()
print(pool.isShutdown, pool.awaitTermination(5, TimeUnit.seconds), pool.isTerminated)   // expect: true true true
try { pool.submit { 1 } } catch (e) { print(e.message) }     // expect: the executor has been shut down

// One thread, tasks in order, made by a function of the program's own.
val names = []
val single = Executors.newSingleThreadExecutor { work -> Thread(work, "the-one").apply { isDaemon = true } }
val order = []
val jobs = (1..5).map { n -> single.submit { order.add(n); names.add(Thread.currentThread().name); n } }
jobs.forEach { it.get() }
print(order, names.distinct())                               // expect: [1, 2, 3, 4, 5] ["the-one"]
single.submit { Thread.sleep(60000) }
val waiting = single.submit { "not run" }
Thread.sleep(20)
print(single.shutdownNow().size, waiting.isCancelled, single.awaitTermination(5000))   // expect: 1 true true

// A future a program completes itself, and one for work on a thread of its own.
val answer = Future()
var told : any? = null
answer.whenComplete { value, error -> told = value }
val completing = thread { Thread.sleep(5); answer.complete(42) }
val got = answer.get()
completing.join()                     // the listener is told on that thread, just after
print(got, told, answer.complete(43), answer.getNow(0), Future().getNow("nothing yet"))   // expect: 42 42 false 42 nothing yet
print(Future.supplyAsync { 6 * 7 }.get(), (runCatching { Future.supplyAsync { throw RuntimeException("no") }.get() }.exceptionOrNull() as Exception).message)   // expect: 42 no

// An error that nothing catches ends its thread, not the program; and a daemon thread still
// running at the end does not keep the program alive.
thread(isDaemon = true) { while (true) { Thread.sleep(1000) } }
print("end of script")                                       // expect: end of script
