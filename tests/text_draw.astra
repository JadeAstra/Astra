// Drawing text into an image: where the pixels fall, and that they fall where measuring says.

val font = Font("Segoe UI", 16)

// How much is painted: the sum of every pixel's alpha.
fun ink(image : Image) {
  val bytes = image.pixels.bytes
  var total = 0
  var i = 3
  while (i < bytes.size) { total += bytes[i]; i += 4 }
  return total
}

fun drawn(text : string, f : Font, color : Color = Color.black, width : int = 300, height : int = 60, x : int = 10, y : int = 40) {
  val image = Image(width, height)
  val canvas = image.canvas()
  canvas.color = color
  canvas.font = f
  canvas.drawString(text, x, y)
  return image
}

// -- On the baseline, under the capital height --
// "H" stands on the baseline and reaches the capital height, both on pixel edges: its
// picture is exactly that tall, and its top and bottom rows are as strong as the rows next to them.
val h = drawn("H", font)
val box = h.inkBox()!!
print(box.y == 40 - font.capHeight, box.y + box.height == 40, box.x >= 10, box.x + box.width <= 10 + font.width("H"))   // expect: true true true true
var sharpTop = true
var sharpBottom = true
var stems = 0
for (x in 0..<h.width) {
  // As strong as the row next to it: the edge is on the pixel edge, not part way into the row.
  sharpTop = sharpTop and h[x, box.y] == h[x, box.y + 1]
  sharpBottom = sharpBottom and h[x, 39] == h[x, 38]
  if (h[x, box.y] != Color.clear) { stems += 1 }
}
print(sharpTop, sharpBottom, stems >= 2, h[box.x, box.y - 1], h[box.x, 40])   // expect: true true true Color(0, 0, 0, 0) Color(0, 0, 0, 0)
// "x" reaches the x-height, and a "p" hangs below the baseline.
val x = drawn("x", font).inkBox()!!
val p = drawn("p", font).inkBox()!!
print(x.y == 40 - font.xHeight, x.y + x.height == 40, p.y + p.height > 40, p.y + p.height <= 40 + font.descent)   // expect: true true true true

// -- The colour of the text --
// On a clear image every painted pixel is the text's colour, more or less see-through.
val red = drawn("Colour", font, Color(0xCC2200))
var others = 0
var painted = 0
for (y in 0..<red.height) {
  for (x in 0..<red.width) {
    val c = red[x, y]
    if (c != Color.clear) {
      painted += 1
      if (c.red != 0xCC or c.green != 0x22 or c.blue != 0) { others += 1 }
    }
  }
}
print(painted > 100, others)   // expect: true 0
// Black on white gives greys, and nothing else.
val page = Image(120, 40, Color.white)
val pageCanvas = page.canvas()
pageCanvas.font = font
pageCanvas.drawString("grey", 5, 28)
var greys = 0
var tinted = 0
var black = 0
for (y in 0..<page.height) {
  for (x in 0..<page.width) {
    val c = page[x, y]
    if (c.red != c.green or c.red != c.blue or c.alpha != 255) { tinted += 1 }
    if (c.red > 0 and c.red < 255) { greys += 1 }
    if (c.red < 100) { black += 1 }
  }
}
print(greys > 20, black > 20, tinted)   // expect: true true 0
// A half-clear colour paints half as much.
val half = drawn("Colour", font, Color(0x80CC2200, true))
print(Math.abs(ink(half) * 2 - ink(red)) < ink(red) / 50, ink(red) > 0)   // expect: true true

// -- Drawn where measured --
// A text drawn whole is the same picture as its characters drawn one at a time, each
// where the widths before it add up to.
var same = 0
for (f in [font, Font("Times New Roman", 19, italic = true), Font("Consolas", 11), Font("Bahnschrift", 23, weight = 600), Font("Segoe UI", 18, bold = true)]) {
  val text = "Drawn where 中文 measured 😀!"
  val whole = drawn(text, f, Color.black, 700, 80)
  val pieces = Image(700, 80)
  val canvas = pieces.canvas()
  canvas.font = f
  val offsets = f.offsets(text)
  var i = 0
  for (c in text) {
    canvas.drawString("$c", 10 + offsets[i], 40)
    i += 1
  }
  if (whole == pieces and ink(whole) > 0) { same += 1 }
}
print(same)   // expect: 5
// drawString gives the width back, and drawing the same again gives the same picture.
val once = Image(300, 60)
val onceCanvas = once.canvas()
onceCanvas.font = font
print(onceCanvas.drawString("again", 10, 40) == font.width("again"), once == drawn("again", font), onceCanvas.drawString("", 10, 40))   // expect: true true 0

// -- Past the edges: what is outside is not drawn, and nothing breaks --
val small = Image(20, 10)
val smallCanvas = small.canvas()
smallCanvas.font = font
smallCanvas.drawString("clipped at every edge", -30, 8)
smallCanvas.drawString("clipped", 15, 30)
smallCanvas.drawString("clipped", 5, -3)
smallCanvas.drawString("far away", 100000, 100000)
smallCanvas.drawString("far away", -100000, -100000)
val nothing = Image(0, 0).canvas()
nothing.font = font
print(ink(small) > 0, nothing.drawString("nothing to draw on", 0, 0) == font.width("nothing to draw on"))   // expect: true true

// -- Weights of a variable font: the heavier, the more ink --
val weights = [300, 400, 500, 600, 700].map { ink(drawn("Hamburgefonstiv", Font("Bahnschrift", 24, weight = it))) }
print(weights == weights.sorted(), weights.toSet().size, weights[4] > weights[0] * 3 / 2)   // expect: true 5 true
// And a bold or an italic the family lacks is made up.
val upright = drawn("made up", Font("Bahnschrift", 24))
val slanted = drawn("made up", Font("Bahnschrift", 24, italic = true))
val plainEmoji = drawn("made up", Font("Segoe UI Emoji", 24))
val thickened = drawn("made up", Font("Segoe UI Emoji", 24, bold = true))
print(slanted != upright, slanted.inkBox()!!.height == upright.inkBox()!!.height, ink(thickened) > ink(plainEmoji) * 11 / 10)   // expect: true true true

// -- Hinting: the top of an "x" is on a pixel edge at every size --
var crisp = 0
var sizes = 0
for (size in 9..<20) {
  val f = Font("Segoe UI", size)
  val rows = drawn("xz", f)
  val top = rows.inkBox()!!.y
  // With hinting, the row above the x-height is empty and the letter starts at full strength.
  sizes += 1
  if (top == 40 - f.xHeight) { crisp += 1 }
}
print(crisp == sizes)   // expect: true

// -- The other kind of outline (cubic curves), where a font with them is installed --
var cubic : Typeface? = null
for (face in Fonts.typefaces()) {
  if (cubic == null and face.hasCubicOutlines and face.has("o")) { cubic = face }
}
if (cubic != null) {
  val f = Font(cubic, 30)
  val o = drawn("o", f)
  val b = o.inkBox()!!
  // An "o" has a hole: its middle is clear, its sides are not.
  val midY = b.y + b.height / 2
  print(ink(o) > 0, o[b.x + b.width / 2, midY] == Color.clear, o[b.x + 1, midY].alpha > 100)   // expect: true true true
} else {
  print(true, true, true)
}

// -- Colour emoji: they bring their own colours, whatever the colour of the text --
val face = drawn("😀", Font("Segoe UI", 40), Color.black, 80, 60)
val colours = {:}
for (y in 0..<face.height) {
  for (x in 0..<face.width) {
    val c = face[x, y]
    if (c.alpha == 255) { colours[c.argb & 0xF0F0F0] = true }
  }
}
val faceBox = face.inkBox()!!
print(colours.size > 4, faceBox.width > 25, faceBox.height > 25, face == drawn("😀", Font("Segoe UI", 40), Color.green, 80, 60))   // expect: true true true true
// A see-through text colour makes an emoji see-through too.
print(ink(drawn("😀", Font("Segoe UI", 40), Color(0, 0, 0, 0x40), 80, 60)) < ink(face) / 3)   // expect: true

// -- A dense screen: at 2x the same text covers four times the area --
val one = ink(drawn("Scale", Font("Segoe UI", 15), Color.black, 300, 100, 10, 60))
val dense = Image(600, 200)
val denseCanvas = dense.canvasAt(300, 100, 2)
denseCanvas.font = Font("Segoe UI", 15)
val denseWidth = denseCanvas.drawString("Scale", 10, 60)
val two = ink(dense)
print(Math.abs(two - 4 * one) < one / 2, denseWidth == Math.ceil(Font("Segoe UI", 15).width("Scale", 2) / 2.0).toInt())   // expect: true true

// -- From several threads at once: every one gets the same picture --
val wanted = drawn("threads draw the same 中 😀", Font("Arial", 21), Color.black, 500, 60)
val results = []
val workers = []
val lock = Lock()
for (n in 0..<6) {
  workers.add(thread {
    val mine = drawn("threads draw the same 中 😀", Font("Arial", 21), Color.black, 500, 60)
    lock.useKey { results.add(mine == wanted) }
  })
}
for (w in workers) { w.get() }
print(results)   // expect: [true, true, true, true, true, true]
