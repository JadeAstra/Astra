class Point {
  var x : int
  var y : int
  var z : string? = null
  fun init(x : int, y : int) {
    this.x = x
    this.y = y
  }
  fun lengthSquared() { return this.x * this.x + this.y * this.y }
  fun toString() { return "Point(${this.x}, ${this.y})" }
}
var p = Point(3, 4)
print(p, p.x, p.lengthSquared())        // expect: Point(3, 4) 3 25
p.x = 10
p.z = "new field"
print(p.x, p.z)                         // expect: 10 new field
print(type(p), p is Point, Point)       // expect: Point true <class Point>

class Shape {
  var name : string
  fun init(name : string) { this.name = name }
  fun area() { return 0 }
  fun describe() { return "${this.name} with area ${this.area()}" }
}
class Rect : Shape {
  val w : int
  val h : int
  fun init(w : int, h : int) {
    super.init("rect")
    this.w = w
    this.h = h
  }
  override fun area() { return this.w * this.h }
}
class Square : Rect {
  fun init(side : int) { super.init(side, side); this.name = "square" }
  override fun describe() { return "[" + super.describe() + "]" }
}
var shapes = [Shape("blob"), Rect(2, 3), Square(4)]
for s in shapes { print(s.describe()) }
// expect: blob with area 0
// expect: rect with area 6
// expect: [square with area 16]
print(shapes[2] is Shape, shapes[2] is Rect, shapes[1] is Square, shapes[0] is Rect)   // expect: true true false false
print(1 is Shape, null is Shape)        // expect: false false

// an inherited initializer
class Base { val v : int; fun init(v : int) { this.v = v } }
class Derived : Base { fun get() { return this.v } }
print(Derived(7).get())                 // expect: 7

// a class with no initializer
class Empty { var tag = 0 }
var e = Empty()
e.tag = 1
print(e.tag, e)                         // expect: 1 <Empty instance>

// static members
class Counter {
  static fun create() {
    Counter.made += 1
    return Counter()
  }
  static fun describe() { return "made ${Counter.made}" }
}
Counter.made = 0
Counter.create(); Counter.create()
print(Counter.describe(), Counter.className) // expect: made 2 Counter

class Parent { static fun make() { return "parent-made" } }
class Child : Parent { }
print(Child.make())                     // expect: parent-made

// bound methods remember their receiver
var describe = shapes[1].describe
print(describe())                       // expect: rect with area 6

// functions stored in fields can be called like methods
class Button {
  val onClick : () -> string
  fun init() { this.onClick = fun() => "clicked" }
}
print(Button().onClick())               // expect: clicked

// an initializer returns the instance, even after a bare return
class Early {
  val flag : bool
  var extra : bool? = null
  fun init(flag : bool) {
    this.flag = flag
    if flag { return }
    this.extra = true
  }
}
print(Early(true).flag, Early(false).extra)   // expect: true true

// this and super inside a closure
class A { fun hello() { return "A.hello" } }
class B : A {
  override fun hello() {
    var f = fun() => super.hello() + " via " + type(this)
    return f()
  }
}
print(B().hello())                      // expect: A.hello via B

// classes are values and can be local
fun makeClass() {
  class Local {
    fun value() { return 42 }
  }
  return Local
}
print(makeClass()().value())            // expect: 42

// polymorphism through a shared interface
class Stack {
  var items : open List<int> = []
  fun init() { this.items = [] }
  fun add(x : int) { this.items.add(x); return this }
  fun take() { return this.items.removeLast() }
}
class Queue : Stack {
  override fun take() { return this.items.removeAt(0) }
}
fun drain(box : Stack) {
  var seen = []
  seen.add(box.take()); seen.add(box.take())
  return seen
}
print(drain(Stack().add(1).add(2).add(3)), drain(Queue().add(1).add(2).add(3)))   // expect: [3, 2] [1, 2]
