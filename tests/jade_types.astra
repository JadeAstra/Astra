// The types Jade's API takes from the JDK, under their names there: Color, Font,
// FontMetrics, Dimension, Point, Rectangle, Insets.
import Jade.*

// -- Color --
val orange = Color(255, 128, 0)
print(orange, orange.red, orange.green, orange.blue, orange.alpha, orange.rgb == 0xFFFF8000, orange.getRGB() == orange.rgb)   // expect: Color(255, 128, 0) 255 128 0 255 true true
print(Color(255, 128, 0, 64), Color(0xFF8000), Color(0x40FF8000, true), Color(0x40FF8000), Color(1.0, 0.5, 0.0))   // expect: Color(255, 128, 0, 64) Color(255, 128, 0) Color(255, 128, 0, 64) Color(255, 128, 0) Color(255, 128, 0)
print(Color(300, -5, 128), Color(0.5, 0.5, 0.5, 0.5), Color.decode("#FF8000"), Color.decode("0x0080FF"))   // expect: Color(255, 0, 128) Color(128, 128, 128, 128) Color(255, 128, 0) Color(0, 128, 255)
// The constants, and a constant and a part of a colour that share a name.
print(Color.white, Color.black, Color.red, Color.red.red, Color.red.green, Color.lightGray, Color.orange)   // expect: Color(255, 255, 255) Color(0, 0, 0) Color(255, 0, 0) 255 0 Color(192, 192, 192) Color(255, 200, 0)
print(Color(255, 0, 0) == Color.red, Color.red == Color.blue, Color.red != Color.blue, Color(255, 0, 0, 128) == Color.red, [Color.blue, Color.red].contains(Color(0xFF0000)))   // expect: true false true false true
print(Color(100, 150, 200).darker(), Color(100, 150, 200).brighter(), Color.black.brighter(), Color.white.darker(), Color(1, 1, 1).brighter())   // expect: Color(70, 105, 140) Color(142, 214, 255) Color(3, 3, 3) Color(178, 178, 178) Color(4, 4, 4)
print(Color.red.withAlpha(128), Color.red.withAlpha(128).rgb == 0x80FF0000)   // expect: Color(255, 0, 0, 128) true
// Hue, saturation and brightness.
print(Color.getHSBColor(0.0, 1.0, 1.0), Color.getHSBColor(1.0 / 3, 1.0, 1.0), Color.getHSBColor(0.5, 0.5, 0.5), Color.getHSBColor(0.7, 0.0, 0.25))   // expect: Color(255, 0, 0) Color(0, 255, 0) Color(64, 128, 128) Color(64, 64, 64)
val hsb = Color.RGBtoHSB(64, 128, 128)
val into = []
Color.RGBtoHSB(255, 0, 0, into)
print(hsb[0], hsb[1] > 0.49 and hsb[1] < 0.51, hsb[2] > 0.5 and hsb[2] < 0.51, into, Color(Color.HSBtoRGB(hsb[0], hsb[1], hsb[2])))   // expect: 0.5 true true [0.0, 1.0, 1.0] Color(64, 128, 128)
// As the key of a map a colour is itself, not its value: its number is the key to use.
val colours = {:}
colours[Color.red] = "the constant"
colours[Color.red.rgb] = "by number"
print(colours[Color(255, 0, 0)], colours[Color.red], colours[Color(255, 0, 0).rgb])   // expect: null the constant by number

// -- Font --
val font = Font("Segoe UI", Font.bold, 13)
print(font, font.name, font.style, font.size, font.isBold, font.isItalic, font.isPlain, font.family)   // expect: Font(Segoe UI, bold, 13) Segoe UI 1 13 true false false Segoe UI
print(Font.plain, Font.bold, Font.italic, Font.bold | Font.italic, Font("Arial", Font.bold | Font.italic, 9), Font("Arial"))   // expect: 0 1 2 3 Font(Arial, bolditalic, 9) Font(Arial, plain, 12)
// Another style, another size, or both: a whole number is a style and a decimal a size.
print(font.deriveFont(Font.italic), font.deriveFont(20.0), font.deriveFont(Font.plain, 9.5), font.deriveFont(Font.plain).isPlain)   // expect: Font(Segoe UI, italic, 13) Font(Segoe UI, bold, 20.0) Font(Segoe UI, plain, 9.5) true
print(font == Font("Segoe UI", Font.bold, 13), font == font.deriveFont(Font.plain), font.fontName, Font("Segoe UI", Font.italic, 13).fontName)   // expect: true false Segoe UI Bold Segoe UI Italic
// The names that mean the system's own font; one that is not installed gives the system's too.
print(Font(Font.monospaced, Font.plain, 12).textFont().typeface.isMonospace, Font("Dialog", 0, 12).family == Font("SansSerif", 0, 12).family, Font("No Such Font", 0, 12).family == Font(Font.sansSerif, 0, 12).family)   // expect: true true true

// -- FontMetrics --
val metrics = FontMetrics(font)
print(metrics.font == font, metrics.height == metrics.ascent + metrics.descent + metrics.leading, metrics.ascent > metrics.descent, metrics.getHeight() == metrics.height)   // expect: true true true true
print(metrics.stringWidth("") == 0, metrics.stringWidth("Hello") == metrics.charWidth("H") + metrics.stringWidth("ello"), metrics.stringWidth("Hello") == font.textFont().width("Hello"))   // expect: true true true
print(FontMetrics(font.deriveFont(26.0)).stringWidth("Hello") > metrics.stringWidth("Hello"), FontMetrics(font.deriveFont(Font.plain)).stringWidth("Hello") < metrics.stringWidth("Hello"))   // expect: true true
// On a dense screen the font is measured in the screen's pixels and the numbers divided,
// rounded up: never less than the text needs, and never a whole unit more.
val line = "The quick brown fox jumps over the lazy dog"
for (scale in [1.25, 1.5, 2, 3]) {
  val m = FontMetrics(font, scale)
  val device = m.deviceWidth(line)
  print(scale, m.stringWidth(line) * scale >= device, (m.stringWidth(line) - 1) * scale < device, m.deviceOffsets(line).last() == device, m.ascent * scale >= font.textFont(scale).ascent)
}
// expect: 1.25 true true true true
// expect: 1.5 true true true true
// expect: 2 true true true true
// expect: 3 true true true true

// -- Dimension, Point, Insets --
val d = Dimension(30, 20)
d.setSize(40, 25)
val p = Point(3, 4)
p.translate(10, -1)
print(d, d.width, d.getHeight(), d == Dimension(40, 25), Dimension(), p, p == Point(13, 3), Point())   // expect: Dimension(40 x 25) 40 25 true Dimension(0 x 0) Point(13, 3) true Point(0, 0)
val insets = Insets(1, 2, 3, 4)
print(insets, insets.top, insets.left, insets.bottom, insets.right, insets == Insets(1, 2, 3, 4), Insets())   // expect: Insets(top=1, left=2, bottom=3, right=4) 1 2 3 4 true Insets(top=0, left=0, bottom=0, right=0)

// -- Rectangle --
val r = Rectangle(10, 20, 100, 50)
print(r, r.x, r.y, r.width, r.height, r.maxX, r.maxY, r.centerX, r.isEmpty, r.location, r.size)   // expect: Rectangle(10, 20, 100 x 50) 10 20 100 50 110 70 60.0 false Point(10, 20) Dimension(100 x 50)
print(Rectangle(), Rectangle(30, 40), Rectangle(r) == r, Rectangle(r) === r, Rectangle().isEmpty, Rectangle(0, 0, 5, 0).isEmpty)   // expect: Rectangle(0, 0, 0 x 0) Rectangle(0, 0, 30 x 40) true false true true
// What is inside: the left and top edges are, the right and bottom ones are not.
print(r.contains(10, 20), r.contains(109, 69), r.contains(110, 69), r.contains(9, 20), r.contains(Point(50, 50)), r.contains(Rectangle(20, 30, 10, 10)), r.contains(20, 30, 200, 10))   // expect: true true false false true true false
val other = Rectangle(60, 0, 100, 40)
print(r.intersects(other), r.intersection(other), r.union(other), r.intersects(Rectangle(110, 20, 5, 5)), r.intersection(Rectangle(200, 200, 5, 5)).isEmpty)   // expect: true Rectangle(60, 20, 50 x 20) Rectangle(10, 0, 150 x 70) false true
// It can be moved and resized where it is.
val moving = Rectangle(r)
moving.translate(-10, -20)
moving.grow(2, 3)
print(moving, r)   // expect: Rectangle(-2, -3, 104 x 56) Rectangle(10, 20, 100 x 50)
moving.setBounds(1, 2, 3, 4)
moving.width = 30
moving.setLocation(5, 6)
print(moving, moving.bounds == moving, moving.bounds === moving)   // expect: Rectangle(5, 6, 30 x 4) true false

// -- Keys, buttons and modifiers --
print(KeyCode.a, KeyCode.pageUp.name, KeyCode.named("digit7"), KeyCode.named("shiftLeft") == KeyCode.shiftLeft, KeyCode.named("no such key"), KeyCode.entries.size)   // expect: a pageUp digit7 true unknown 119
print(PointerButton.entries, CursorKind.entries.size, CursorMode.entries)   // expect: [left, right, middle, back, forward, other] 9 [normal, hidden, locked]
val mods = Modifiers(shift = true, ctrl = true)
print(mods, mods.shift, mods.alt, mods.shortcut, Modifiers.none, Modifiers.ofBits(5), Modifiers.ofBits(mods.bits) == mods, Modifiers(ctrl = true, shortcut = false).shortcut)   // expect: Modifiers(shift+ctrl) true false true Modifiers() Modifiers(shift+alt) true false
print(RawInput.PointerDown(1, 2, PointerButton.left, Modifiers.none), RawInput.KeyDown(KeyCode.enter, mods) is RawInput, RawInput.Text("a") == RawInput.Text("a"))   // expect: PointerDown(x=1, y=2, button=left, mods=Modifiers(), clicks=1) true true
