// Jade's own small types: keys, pointer buttons, cursors and modifiers, and the raw input the
// native layer reports. (The graphics types it takes, Color, Font, Rect and the rest, are the
// standard library's: graphics.astra tests them.)
import Jade.*

// -- Keys, buttons and modifiers --
print(KeyCode.a, KeyCode.pageUp.name, KeyCode.named("digit7"), KeyCode.named("shiftLeft") == KeyCode.shiftLeft, KeyCode.named("no such key"), KeyCode.entries.size)   // expect: a pageUp digit7 true unknown 119
print(PointerButton.entries, CursorKind.entries.size, CursorMode.entries)   // expect: [left, right, middle, back, forward, other] 9 [normal, hidden, locked]
val mods = Modifiers(shift = true, ctrl = true)
print(mods, mods.shift, mods.alt, mods.shortcut, Modifiers.none, Modifiers.ofBits(5), Modifiers.ofBits(mods.bits) == mods, Modifiers(ctrl = true, shortcut = false).shortcut)   // expect: Modifiers(shift+ctrl) true false true Modifiers() Modifiers(shift+alt) true false
print(RawInput.PointerDown(1, 2, PointerButton.left, Modifiers.none), RawInput.KeyDown(KeyCode.enter, mods) is RawInput, RawInput.Text("a") == RawInput.Text("a"))   // expect: PointerDown(x=1, y=2, button=left, mods=Modifiers(), clicks=1) true true
