// Fields can be listed in a header after the class name.
class Vec2(val x : number, val y : number) {
  op +(other : Vec2) : Vec2 => Vec2(this.x + other.x, this.y + other.y)
  fun toString() : string => "(${this.x}, ${this.y})"
}
val v = Vec2(1, 2) + Vec2(3, 4.5)
print(v, v.x, v.y)                               // expect: (4, 6.5) 4 6.5

// a class can be just its header
class Student(var name : string, var grade : int)
val s = Student("Ann", 9)
s.grade += 1
print(s.name, s.grade, s is Student, type(s))    // expect: Ann 10 true Student

fun attempt(f) {
  try { return f() } catch (e) { return e.message }
}

// header fields are ordinary declared fields: typed, val or var, and nothing undeclared
print(attempt(fun() => Student("Bob")))          // expect: Student.init() expects 2 argument(s) but got 1
print(attempt(fun() => Student(7, 9)))           // expect: cannot assign a value of type int to field 'name' of Student, which is declared as string
print(attempt(fun() { s.grade = "A" }))          // expect: cannot assign a value of type string to field 'grade' of Student, which is declared as int
print(attempt(fun() { v.x = 0 }))                // expect: cannot assign to val field 'x' of Vec2
print(attempt(fun() { s.nickname = "A" }))       // expect: Student has no field 'nickname'; fields must be declared in the class with val or var

// header and body fields together; untyped and nullable header fields
class Order(val id : int, var note, var customer : string?) {
  var items : list = []
  val created : string = "today"
  fun add(item : string) : Order { this.items.push(item); return this }
  fun summary() : string => "#${this.id} for ${this.customer}: ${this.items.length} item(s), note=${this.note}"
}
val o = Order(7, [1, 2], null).add("tea").add("cake")
print(o.summary(), o.created)                    // expect: #7 for null: 2 item(s), note=[1, 2] today
o.customer = "ada"
o.note = null
print(o.summary())                               // expect: #7 for ada: 2 item(s), note=null

// a class that writes its own init keeps control; the header then only declares fields
class Temperature(val celsius : number, val label : string) {
  fun init(celsius : number) {
    this.celsius = celsius
    this.label = celsius > 25 ? "warm" : "cool"
  }
}
print(Temperature(30).label, Temperature(10).label)   // expect: warm cool
print(attempt(fun() => Temperature(30, "x")))    // expect: Temperature.init() expects 1 argument(s) but got 2
class Forgetful(val a : int, val b : int) {
  fun init(a : int) { this.a = a }
}
print(attempt(fun() => Forgetful(1)))            // expect: Forgetful.init() must set field 'b'

// inheritance: a header entry without val or var is only a parameter, and the arguments
// after the superclass name go to its initializer
class Animal(val name : string, var legs : int) {
  fun describe() : string => "${this.name} has ${this.legs} legs"
}
class Dog(name : string, val breed : string) : Animal(name, 4) {
  fun describe() : string => super.describe() + " and is a ${this.breed}"
}
class Puppy(name : string) : Dog(name, "mutt")
class Snake(name : string) : Animal(name, 0)
print(Dog("Rex", "collie").describe())           // expect: Rex has 4 legs and is a collie
print(Puppy("Bit").describe(), "/", Snake("Sid").describe())   // expect: Bit has 4 legs and is a mutt / Sid has 0 legs
print(Puppy("Bit") is Animal, Puppy("Bit").breed)    // expect: true mutt
print(attempt(fun() => Dog(5, "x")))             // expect: argument 'name' of Dog.init() must be string, got int
print(attempt(fun() => Dog("Rex", 5)))           // expect: cannot assign a value of type int to field 'breed' of Dog, which is declared as string
print(attempt(fun() { Snake("Sid").name = "x" }))    // expect: cannot assign to val field 'name' of Snake

// superclasses with a hand-written init, with no init at all, and one that needs arguments
class Base {
  var log : list = []
  fun init(tag : string) { this.log.push(tag) }
}
class Derived(val extra : int) : Base("from derived")
val d = Derived(3)
print(d.log, d.extra)                            // expect: ["from derived"] 3
class Plain { var on : bool = true }
class Child(val n : int) : Plain
class Child2(val n : int) : Plain()
print(Child(1).on, Child2(2).n)                  // expect: true 2
class NeedsArgs(val n : int) : Base
print(attempt(fun() => NeedsArgs(1)))            // expect: Base.init() expects 1 argument(s) but got 0
class TooMany(val n : int) : Plain(1)
print(attempt(fun() => TooMany(1)))              // expect: Plain() takes no arguments but got 1

// an empty header, a header spread over several lines, and a class with no body at all
class Marker()
class Wide(
  val a : int,
  val b : int,
) {
  fun sum() : int => this.a + this.b
}
class Bare
print(Marker() is Marker, Wide(1, 2).sum(), Bare() is Bare)   // expect: true 3 true

// superclass arguments are ordinary expressions over the header's names
class Scaled(factor : int) : Animal("scaled x$factor", factor * 2)
print(Scaled(3).describe())                      // expect: scaled x3 has 6 legs

// header entries can have default values, which makes those arguments optional
class Config(val host : string = "localhost", var port : int = 8080, val tags : list = [])
val c0 = Config()
val c1 = Config("example.org")
val c2 = Config("example.org", 443, ["tls"])
print(c0.host, c0.port, c0.tags)                 // expect: localhost 8080 []
print(c1.host, c1.port, c2.port, c2.tags)        // expect: example.org 8080 443 ["tls"]
c0.tags.push("x")
print(c0.tags, c1.tags)                          // expect: ["x"] []
print(attempt(fun() => Config("a", 1, [], 4)))   // expect: Config.init() expects 0 to 3 argument(s) but got 4
print(attempt(fun() => Config("a", "80")))       // expect: cannot assign a value of type string to field 'port' of Config, which is declared as int

// required entries come first; a default can use the entries before it
class Box(val width : number, val height : number = width, val label : string = "${width}x$height")
print(Box(2).label, Box(2, 3).label, Box(2, 3, "custom").label)   // expect: 2x2 2x3 custom
print(attempt(fun() => Box()))                   // expect: Box.init() expects 1 to 3 argument(s) but got 0

// defaults for plain parameters, together with a superclass
class Pet(name : string, sound : string = "...", val owner : string? = null) : Animal(name + " (" + sound + ")", 4)
print(Pet("Tom").describe(), Pet("Tom", "meow", "Ann").owner)   // expect: Tom (...) has 4 legs Ann
print(attempt(fun() => Pet("Tom", 5)))           // expect: argument 'sound' of Pet.init() must be string, got int

// a default that is only known when the program runs is still type-checked
var fallback = "eighty"
class Server(val port : int = fallback)
print(attempt(fun() => Server()), Server(1).port)    // expect: cannot assign a value of type string to field 'port' of Server, which is declared as int 1

// in a class with its own init, a header default is simply the field's initial value
class Stepper(var count : int = 10, val step : int = 2) {
  fun init(extra : int) { this.count += extra }
}
print(Stepper(5).count, Stepper(5).step)         // expect: 15 2

// lots of small objects
var total = 0
for i in 0..20000 { total += Student("s", i).grade - i + 1 }
print(total)                                     // expect: 20000
