// In a class that declares its fields, assigning to any other name through `this` is rejected
// before the program runs.
print("never runs")
class Point {
  var x : int = 0
  fun reset() {
    this.x = 0
    this.y = 0
  }
}
// expect compile error: error_undeclared.astra:8:10: error: Point has no field 'y'; fields must be declared in the class with val or var
