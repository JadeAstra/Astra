// A value whose type the checker does not see, for testing the checks made when running.
val unknown = { value -> value }

// val is immutable, var is mutable; the type after ':' is optional
val greeting = "hi"
var counter = 0
counter += 2
print(greeting, counter)                // expect: hi 2

val limit : int = 10
var ratio : float = 0.5
var label : string = "a"
var flag : bool = true
var items : List = [1, 2]
var table : Map = {k: 1}
var span : Range = 0..<3
var action : Function = fun(x) => x + 1
var amount : Number = 1
var anything : any = 1
amount = 2.5
anything = "now a string"
ratio = ratio * 2
label += "b"
print(limit, ratio, label, flag, items, table, span, action(1), amount, anything)
// expect: 10 1.0 ab true [1, 2] {"k": 1} 0..<3 2 2.5 now a string

// a typed var keeps its type for life; an untyped one takes anything
fun attempt(f : Function) {
  try { f(); return "ok" } catch (e) { return e.message }
}
print(attempt(fun() { counter = unknown("text") }))     // expect: ok
print(attempt(fun() { ratio = unknown(1) }))   // expect: cannot assign a value of type int to 'ratio', which is declared as float
print(attempt(fun() { label = unknown(null) }))         // expect: cannot assign a value of type null to 'label', which is declared as string
print(attempt(fun() { flag = unknown(0) }))    // expect: cannot assign a value of type int to 'flag', which is declared as bool
print(attempt(fun() { amount = unknown("7") }))         // expect: cannot assign a value of type string to 'amount', which is declared as Number
print(attempt(fun() { items = unknown({:}) }))  // expect: cannot assign a value of type Map to 'items', which is declared as List
print(attempt(fun() { action = print }))       // expect: ok
print(ratio, label, flag, amount)             // expect: 1.0 ab true 2.5

// a function compiled before the variable it assigns to is still checked
fun setLater() { later = unknown("wrong") }
var later : int = 1
print(attempt(setLater), later)               // expect: cannot assign a value of type string to 'later', which is declared as int 1

// nullable types
var maybe : int? = null
maybe = 5
maybe = null
var unset : string?
print(maybe, unset)                     // expect: null null

// a class type accepts instances of the class and of its subclasses
class Animal { val name : string; fun init(name : string) { this.name = name } }
class Dog : Animal { }
class Rock { }
var pet : Animal = Dog("Rex")
pet = Animal("Generic")
print(pet.name)                         // expect: Generic
print(attempt(fun() { pet = unknown(Rock()) }))   // expect: cannot assign a value of type Rock to 'pet', which is declared as Animal
print(attempt(fun() { pet = unknown(null) }))     // expect: cannot assign a value of type null to 'pet', which is declared as Animal
var next : Dog? = null
next = Dog("Fido")
print(attempt(fun() { next = unknown(Animal("x")) }))   // expect: cannot assign a value of type Animal to 'next', which is declared as Dog?
print(next!!.name)                      // expect: Fido

// the same rules hold for local variables and for variables captured by closures
fun locals() {
  val base : int = 10
  var total : int = base
  var owner : Animal? = null
  val bump = fun(by) { total += by }
  bump(5)
  owner = Dog("Local")
  val results = [total, owner.name]
  results.add(attempt(fun() { total = unknown(total / 2.0) }))
  results.add(attempt(fun() { owner = unknown("nobody") }))
  results.add(attempt(fun() { var bad : string = unknown(base) }))
  results.add(total)
  return results
}
for line in locals() { print(line) }
// expect: 15
// expect: Local
// expect: cannot assign a value of type float to 'total', which is declared as int
// expect: cannot assign a value of type string to 'owner', which is declared as Animal?
// expect: cannot assign a value of type int to 'bad', which is declared as string
// expect: 15

// an initializer whose type is only known at run time is checked then
fun make(kind : string) => kind == "n" ? 1 : "one"
var parsed : int = make("n")
print(parsed)                           // expect: 1
print(attempt(fun() { var wrong : int = make("s") }))   // expect: cannot assign a value of type string to 'wrong', which is declared as int

// a val fixes the variable, not the object it refers to
val bag = []
bag.add(1)
print(bag)                              // expect: [1]

// a type has to be a built-in type or a class
val notAType = 5
print(attempt(fun() { var x : notAType = make("n") }))   // expect: a type must be a class or a built-in type, not a value of type int
