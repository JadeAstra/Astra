import "strutil"

const TAU = 6.28

fun double(x : int) => x * 2

class Pile {
  var items : List<int> = []
  fun init() { this.items = [] }
  fun add(x : int) { this.items.push(x); return this }
  fun take() { return this.items.pop() }
  fun size() => this.items.length
}

loadLog.push("mathutil")         // declared by strutil.astra, in the same folder
