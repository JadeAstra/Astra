import "strutil"

const TAU = 6.28

fun double(x : int) => x * 2

class Pile {
  var items : open List<int> = []
  fun init() { this.items = [] }
  fun add(x : int) { this.items.add(x); return this }
  fun take() { return this.items.removeLast() }
  fun size() => this.items.size
}

loadLog.add("mathutil")         // declared by strutil.astra, in the same folder
