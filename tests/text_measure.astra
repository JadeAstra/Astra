// Measuring text: one rule. A character's width is a whole number of pixels, a text's
// width is the sum of its characters' widths, and that is where the text ends when drawn.

fun attempt(block : Function) {
  try { block(); return "no error" } catch (e) { return "Error: " + e.message }
}

val font = Font("Segoe UI", 13)
print(font, font.family, font.size, font.weight, font.isBold, font.isItalic)   // expect: Font(Segoe UI, 13) Segoe UI 13 400 false false

// -- The line --
print(font.ascent > 0, font.descent > 0, font.leading >= 0, font.lineHeight == font.ascent + font.descent + font.leading)   // expect: true true true true
print(font.xHeight > 0, font.xHeight < font.capHeight, font.capHeight < font.ascent, font.ascent is int, font.lineHeight is int)   // expect: true true true true true
val twice = Font("Segoe UI", 26)
print(Math.abs(twice.ascent - 2 * font.ascent) <= 1, Math.abs(twice.descent - 2 * font.descent) <= 1, Math.abs(twice.width("measure") - 2 * font.width("measure")) <= 7)   // expect: true true true

// -- The rule, in several fonts and sizes --
val texts = ["Hello, world", "The quick brown fox jumps over the lazy dog", "AVAWA To fi fl ffi 0123456789", "naïve café — “quoted” €5",
             "Ελληνικά Русский 中文 日本語 한국어", "emoji 😀🎉 and symbols ∑√♥", "", " ", "a"]
var checked = 0
val failed = []
val page = Image(4, 4)
val pageCanvas = page.canvas()
for (name in ["Segoe UI", "Arial", "Times New Roman", "Consolas", "Bahnschrift", "Segoe UI Emoji"]) {
  for (size in [8, 9, 11, 12, 13.5, 16, 31, 72]) {
    for (style in 0..<4) {
      val f = Font(name, size, bold = style & 1 == 1, italic = style & 2 == 2)
      pageCanvas.font = f
      for (text in texts) {
        val whole = f.width(text)
        var sum = 0
        for (c in text) { sum += f.width(c) }
        val offsets = f.offsets(text)
        val drawn = pageCanvas.drawString(text, 0, 2)
        var steps = true
        for (i in 0..<text.size) { steps = steps and offsets[i] == f.width(text[0..<i]) }
        checked += 1
        if (!(whole is int) or whole != sum or whole != drawn or offsets.size != text.size + 1 or offsets.last() != whole or !steps) {
          failed.add("$name $size $style: $text")
        }
      }
    }
  }
}
print(checked, failed)   // expect: 1728 []

print(font.width(""), font.offsets(""), font.offsets("ab") == [0, font.width('a'), font.width("ab")])   // expect: 0 [0] true
print(font.width('W') > font.width('i'), font.width("aaaa") == 4 * font.width('a'))   // expect: true true
// No pair of letters is nudged together: "AV" is as wide as "A" and "V".
print(font.width("AVAVAV") == 3 * (font.width('A') + font.width('V')))   // expect: true

// -- Characters that take no room: control characters, joiners, direction marks --
print(font.width("a\nb\tc") == font.width("abc"), font.width("a\u{200D}b\u{200B}c\u{FE0F}") == font.width("abc"), font.width("\u{200E}"))   // expect: true true 0

// -- Styles --
val bold = Font("Segoe UI", 13, bold = true)
val italic = Font("Segoe UI", 13, italic = true)
print(bold.isBold, bold.weight, bold.typeface.style, bold.width("measure") > font.width("measure"), italic.isItalic, italic.typeface.style)   // expect: true 700 Bold true true Italic
print(Font("Segoe UI", 13, weight = 600).typeface.style, Font("Segoe UI", 13, weight = 300).typeface.style)   // expect: Semibold Light
// A monospaced font: every character the same width.
val mono = Font("Monospaced", 13)
print(mono.width('i') == mono.width('W'), mono.width("0123456789") == 10 * mono.width('m'), mono.typeface.isMonospace)   // expect: true true true
// A variable font at any weight. (Bahnschrift keeps its widths; its strokes are what change.)
val thin = Font("Bahnschrift", 20, weight = 300)
val thick = Font("Bahnschrift", 20, weight = 700)
print(thin.weight, thick.weight, thin.typeface == thick.typeface, Font("Bahnschrift", 20, weight = 950).weight, Font("Bahnschrift", 20, bold = true).weight)   // expect: 300 700 true 700 700
// A style the family lacks is made up: a bold is thicker and so wider, an italic slanted.
val emoji = Font("Segoe UI Emoji", 14)
val fakeBold = Font("Segoe UI Emoji", 14, bold = true)
print(fakeBold.isBold, fakeBold.typeface == emoji.typeface, fakeBold.width("made up") > emoji.width("made up"), fakeBold.width(" ") > 0)   // expect: true true true true
val fakeItalic = Font("Bahnschrift", 14, italic = true)
print(fakeItalic.isItalic, fakeItalic.typeface.isItalic, fakeItalic.width("made up") == Font("Bahnschrift", 14).width("made up"))   // expect: true false true

// -- A family that is not installed gives the system's own --
val missing = Font("No Such Family", 12)
print(missing.family == Font("SansSerif", 12).family, missing.width("abc") == Font("SansSerif", 12).width("abc"))   // expect: true true

// -- From a typeface --
val face = Fonts.find("Arial")!!
val fromFace = Font(face, 15)
print(fromFace.typeface == face, face.font(15) == fromFace, face.font(15).width("abc") == fromFace.width("abc"), Font("Arial", 15).width("abc") == fromFace.width("abc"))   // expect: true true true true
print(Font(face, 15, bold = true).isBold, Font(face, 15, bold = true).width("abc") > fromFace.width("abc"))   // expect: true true
val bigger = font.copy(size = 20)
print(bigger.size, bigger.typeface == font.typeface, bigger.width("abc") > font.width("abc"), font.copy() == font)   // expect: 20 true true true

// -- Characters the font lacks come from one that has them --
print(font.typefaceFor('a') == font.typeface, font.typefaceFor('中') != font.typeface, font.typefaceFor('中')!!.has('中'), font.width('中') > 0)   // expect: true true true true
print(font.typefaceFor("😀")!!.hasColor, font.typefaceFor("\u{10FFFD}"))   // expect: true null
// One no font has is the font's own "missing" box, still measured and drawn by the rule.
print(font.width("a\u{10FFFD}b") == font.width("a") + font.width("\u{10FFFD}") + font.width("b"), font.width("\u{10FFFD}") >= 0)   // expect: true true

// -- A scale, for a dense screen: the numbers are in the screen's own pixels --
// At 2x a font of 12 is a font of 24: every number is the same.
val plain = Font("Segoe UI", 12)
val large = Font("Segoe UI", 24)
print(plain.ascent(2) == large.ascent, plain.descent(2) == large.descent, plain.lineHeight(2) == large.lineHeight, plain.width("The quick brown fox", 2) == large.width("The quick brown fox"))   // expect: true true true true
// So a line at 2x is as wide, in the layout's units, as its characters truly are to within
// a quarter of a pixel each; rounding in the layout's units would be twice as loose.
val line = "The quick brown fox jumps over the lazy dog"
var exact : Number = 0.0
for (c in line) { exact += plain.typeface.advance(plain.typeface.glyph(c)) * 12 / plain.typeface.unitsPerEm }
val at2 = Math.abs(plain.width(line, 2) / 2.0 - exact)
print(at2 <= line.size * 0.25, Math.abs(plain.width(line) - exact) <= line.size * 0.5)   // expect: true true
// Any scale will do, and the rule holds at each.
val small = Font("Segoe UI", 11)
for (scale in [1.25, 1.5, 1.75, 3]) {
  var sum = 0
  for (c in line) { sum += small.width(c, scale) }
  print(scale, small.width(line, scale) == sum, small.width(line, scale) is int, Math.abs(small.width(line, scale) / scale - small.width(line)) < line.size * 0.5)
}
// expect: 1.25 true true true
// expect: 1.5 true true true
// expect: 1.75 true true true
// expect: 3 true true true

// -- What cannot be a font --
print(attempt { Font("Segoe UI", 0) })       // expect: Error: a font's size is more than 0, not 0
print(attempt { font.width("a", 0) })        // expect: Error: a scale is more than 0

// -- Measuring in a parallel section: it changes nothing, so every core may --
val words = line.split(" ")
print(words.parallelStream().map { font.width(it) }.toList() == words.map { font.width(it) })   // expect: true
