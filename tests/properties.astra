// Properties: `get name()` computes a value when it is read, `set name(value)` runs when it
// is assigned. They are used like fields.
class Temperature(var celsius : Number) {
  var fahrenheit : Number
    get() => this.celsius * 9 / 5 + 32
    set(value : Number) { this.celsius = (value - 32) * 5 / 9 }

  val description : string
    get() => "${this.celsius} C"
}
val t = Temperature(100)
print(t.fahrenheit, t.description)               // expect: 212 100 C
t.fahrenheit = 32
print(t.celsius)                                 // expect: 0
t.fahrenheit += 18
print(t.celsius, t.fahrenheit)                   // expect: 10 50
print((t.fahrenheit = 212), t.celsius)           // expect: 212 100

// A value whose type the checker does not see, for testing the checks made when running.
val unknown = { value -> value }

fun attempt(f : () -> any?) {
  try { return f() } catch (e) { return "${e.message}" }
}

// a property with only a getter cannot be assigned, and its types are checked like a function's
print(attempt(fun() { t.description = "x" }))    // expect: property 'description' of Temperature cannot be assigned: it has no setter
print(attempt(fun() { t.description += "x" }))   // expect: property 'description' of Temperature cannot be assigned: it has no setter
print(attempt(fun() { t.fahrenheit = unknown("hot") }))   // expect: argument 'value' of Temperature.fahrenheit() must be Number, got string

// a setter can check and react before storing the value somewhere
class Account {
  var stored : Number = 0
  val history : open List = []

  var balance : Number
    get() => this.stored
    set(amount : Number) {
      if amount < 0 { throw Exception("balance cannot be negative") }
      if amount == this.stored { return }
      this.history.add(amount)
      this.stored = amount
    }

  fun deposit(amount : Number) { this.balance += amount }
}
val account = Account()
account.balance = 50
account.balance = 50
account.deposit(25)
print(account.balance, account.history)          // expect: 75 [50, 75]
print(attempt(fun() { account.balance = -1 }), account.balance)   // expect: balance cannot be negative 75

// a setter that keeps what it is given somewhere else, and a getter that reads it back (as in
// Kotlin, a property is read as well as set)
class Logger {
  val lines : open List = []
  var message : any?
    get() => lines.lastOrNull()
    set(text) { this.lines.add("log: $text") }
}
val logger = Logger()
logger.message = "started"
logger.message = 42
print(logger.lines)                              // expect: ["log: started", "log: 42"]
print(attempt(fun() => logger.message))          // expect: log: 42

// inheritance: properties are inherited, and a subclass replaces a whole one, reaching the one above
// with super
class Base {
  var raw = ""
  var text
    get() => this.raw
    set(value) { this.raw = "$value" }
}
class Loud : Base {
  override var text
    get() => super.text
    set(value) { this.raw = "$value".upper() + "!" }
}
class Quiet : Base {
  override var text
    get() => "(" + this.raw + ")"
    set(value) { super.text = value }
}
val loud = Loud()
val quiet = Quiet()
loud.text = "hello"
quiet.text = "hello"
print(loud.text, quiet.text)                     // expect: HELLO! (hello)

// a property alongside the fields it works on
class Open {
  val items : open List<any?> = []
  var extra = false
  fun init() { this.items.clear() }
  val count
    get() => this.items.size
  var last
    get() => this.items.size == 0 ? null : this.items[^1]
    set(value) { this.items.add(value) }
}
val open = Open()
open.last = "a"
open.last = "b"
open.extra = true
print(open.count, open.last, open.extra)         // expect: 2 b true

// a property that holds a function can be called directly
class Handlers {
  var count = 0
  val increment
    get() => fun(by) { this.count += by; return this.count }
}
val handlers = Handlers()
print(handlers.increment(5), handlers.increment(2))   // expect: 5 7

// `get` and `set` are only special at the start of a class member
class Store {
  val data : open Map = {:}
  fun get(key : string) => this.data.get(key, "missing")
  fun set(key : string, value : int) { this.data[key] = value }
  val size : int
    get() => this.data.size
}
val store = Store()
store.set("a", 1)
val get = store.get("a")
val set = store.get("b")
print(get, set, store.size)                      // expect: 1 missing 1

// string interpolation and methods see properties as values
class Circle(val radius : Number) {
  val area : Number
    get() => Math.pi * this.radius * this.radius
  val diameter : Number
    get() => this.radius * 2
  fun describe() : string => "circle of diameter ${this.diameter}"
}
val c = Circle(2)
print(c.describe(), "${c.diameter}", [Circle(1), Circle(3)].map(fun(x) => x.diameter))   // expect: circle of diameter 4 4 [2, 6]

// errors inside a getter or setter show up where the property is used
class Fragile {
  var value
    get() { throw Exception("cannot read") }
    set(v) { throw Exception("cannot write $v") }
}
print(attempt(fun() => Fragile().value))         // expect: cannot read
print(attempt(fun() { Fragile().value = 7 }))    // expect: cannot write 7
