// `x .= f(...)` is `x = x.f(...)`: a method that gives a new value, put back where the old
// one was (D156). It is written once, so a long place is not written twice.

var name = "  Ada Lovelace  "
name .= trim()
print("[$name]")   // expect: [Ada Lovelace]
// A chain of calls.
name .= upper().replace("ADA", "Augusta Ada")
print(name)   // expect: Augusta Ada LOVELACE

// Any place: a field, an element of a list, a property of a property.
class Person(var name : string, val tags : open List<string>)
val p = Person(" grace ", [" a ", "b "])
p.name .= trim()
p.tags[0] .= trim()
p.tags[1] .= trim().upper()
print("[${p.name}]", p.tags)   // expect: [grace] ["a", "B"]
val rows = [[3, 1, 2], [9, 8]]
rows[1] .= sorted()
print(rows)   // expect: [[3, 1, 2], [8, 9]]

// The place is worked out once: an index with a side effect runs once.
var calls = 0
fun which() : int {
  calls += 1
  return 0
}
val words = ["one", "two"]
words[which()] .= upper()
print(words, calls)   // expect: ["ONE", "two"] 1

// On a value type, a method that gives a changed copy.
val r = Rect(1, 2, 3, 4)
var moved = r
moved .= union(Rect(10, 10, 1, 1))
print(moved, r)   // expect: Rect(1, 2, 10 x 9) Rect(1, 2, 3 x 4)

