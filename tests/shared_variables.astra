// Variables shared with a thread need no mark: one thread runs Astra code at a time, so a
// variable is always seen whole by the others (@Volatile is an error: tests/annotation_jvm.astra).
// (`suspend` marks a function that may wait: tests/check/suspend.astra.)

var busy = false
private var progress : float = 0.0

class Job(var name : string) {
  private var done = false
  var note : string = ""

  suspend fun finish() { done = true }
  private suspend fun helper() => 1
  fun isDone() => done
}

val job = Job("render")
val worker = thread {
  busy = true
  progress = 0.5
  job.finish()
  job.note = "from the thread"
}
worker.get()
print(busy, progress, job.isDone(), job.note, job.name)      // expect: true 0.5 true from the thread render

suspend fun twice(x : int) => x * 2
val typed : suspend (int) -> int = { it + 1 }
print(twice(4), typed(4))                                    // expect: 8 5
