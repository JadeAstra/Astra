print(read, "pictures read,", wrong.size, "wrong", wrong)   // expect: 26 pictures read, 0 wrong []

// -- What is not a picture --
fun attempt(block : () -> unit) {
  try { block(); return "no error" } catch (e) { return (e is IOException ? "IOException: " : "Error: ") + e.message }
}
print(attempt { Picture.load(Bytes([1, 2, 3])) })          // expect: IOException: not a PNG picture
print(attempt { Picture.load(file.slice(0, 60)) })         // expect: IOException: damaged PNG picture
val cut = Bytes(file.slice(0, file.size - 40))
print(attempt { Picture.load(cut) } != "no error")         // expect: true
val spoiled = Bytes(file)
for (i in 60..<90) { spoiled[i] = (255 - spoiled[i]).toByte() }
print(attempt { Picture.load(spoiled) } != "no error")     // expect: true
print(attempt { Picture(3, 3, 0, Bytes(5)) })              // expect: Error: the pixels do not fit a picture of 3 by 3
print(attempt { Picture(0, 0).toPng() })                   // expect: Error: a picture with no pixels cannot be written as PNG

// -- Pixels, rectangles, parts --
val p = Picture(6, 4)
print(p.get(0, 0), p.inkBox())                             // expect: 0 null
p.fillRect(1, 1, 3, 2, 0xFF336699)
p.fillRect(-5, -5, 6, 6, 0x80FF0000)                       // clipped to the picture
print(p.get(0, 0) == 0x80FF0000, p.get(1, 1) == 0xFF336699, p.get(3, 2) == 0xFF336699, p.get(4, 2), p.inkBox())   // expect: true true true 0 [0, 0, 4, 3]
print(p.pixels.slice(0, 4), p.pixels.slice((1 * 6 + 1) * 4, (1 * 6 + 1) * 4 + 4))   // expect: Bytes[255, 0, 0, 128] Bytes[51, 102, 153, 255]
val part = p.crop(1, 1, 3, 2)
print(part, part.get(0, 0) == 0xFF336699, part.inkBox(), p.copy() == p, p.copy() === p, part == p)   // expect: Picture(3 x 2) true [0, 0, 3, 2] true false false

// Laying one colour over another: half-clear white over solid black is mid grey, and a
// see-through colour over nothing is itself.
val q = Picture(2, 1, Picture.black)
q.blendRect(0, 0, 1, 1, 0x80FFFFFF)
val r = Picture(1, 1)
r.blendRect(0, 0, 1, 1, 0x40102030)
print(q.pixels.slice(0, 4), q.pixels.slice(4, 8), r.get(0, 0) == 0x40102030)   // expect: Bytes[128, 128, 128, 255] Bytes[0, 0, 0, 255] true

// One picture laid over another.
val under = Picture(4, 4, Picture.white)
val over = Picture(2, 2, 0xFF0000FF)
over.set(1, 1, 0)
under.draw(over, 1, 1)
print(under.get(1, 1) == 0xFF0000FF, under.get(2, 2) == Picture.white, under.get(0, 0) == Picture.white, under.inkBox(Picture.white))   // expect: true true true [1, 1, 2, 2]
