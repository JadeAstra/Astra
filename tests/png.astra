// PNG pictures, read and written by Astra's own code.

fun fromHex(text : string) {
  val out = Bytes(text.length / 2)
  for (i in 0..<out.size) { out[i] = text.substring(i * 2, i * 2 + 2).toInt(16).toByte() }
  return out
}

// -- Writing and reading back: nothing is lost --
val made = Picture(37, 23)
for (y in 0..<made.height) {
  for (x in 0..<made.width) {
    made.set(x, y, Picture.rgb((x * 7) % 256, (y * 11) % 256, (x * y) % 256, (x + y) % 4 == 0 ? (x * 9) % 256 : 255))
  }
}
val file = made.toPng()
print(file.slice(0, 8))                              // expect: Bytes[137, 80, 78, 71, 13, 10, 26, 10]
val back = Picture.load(file)
print(back, back == made, back.pixels == made.pixels)   // expect: Picture(37 x 23) true true
print(made.get(3, 5) == Picture.rgb(21, 55, 15, 27), back.get(3, 5) == made.get(3, 5), made.get(4, 0), made.get(-1, 0), made.get(0, 99))   // expect: true true 605814784 0 0

// A picture with nothing see-through is written without its alpha, and comes back the same.
val solid = Picture(16, 9, Picture.rgb(10, 200, 30))
solid.fillRect(2, 2, 5, 3, Picture.black)
val solidFile = solid.toPng()
print(solidFile[25], file[25], Picture.load(solidFile) == solid)   // expect: 2 6 true

// It is compressed: a large plain picture is a small file.
val plain = Picture(400, 300, Picture.white)
print(plain.pixels.size, plain.toPng().size < 4000, Picture.load(plain.toPng()) == plain)   // expect: 480000 true true

// Through a file.
made.save("png_test_out.png")
print(Picture.load("png_test_out.png") == made, Picture.load(File("png_test_out.png")) == made)   // expect: true true
File("png_test_out.png").delete()

// -- Pictures of every kind the format has, written by Windows' own PNG writer --
// Each line is a picture's file and the pixels Windows' own reader gives for it: grey,
// palette, colour, with and without alpha, 1 to 16 bits, interlaced and not.
var read = 0
val wrong = []
fun check(name : string, colorType : int, depth : int, interlaced : int, png : string, pixels : string) {
  val data = fromHex(png)
  if (data[25] != colorType or data[24] != depth or data[28] != interlaced) { wrong.add(name + " (not the kind it says)") }
  val picture = Picture.load(data)
  read += 1
  if (picture.width != 8 or picture.height != 8 or picture.pixels != fromHex(pixels)) { wrong.add(name) }
}
check("rgba8", 6, 8, 0,
  "",
  "")
check("rgba8-interlaced", 6, 8, 1,
  "",
  "")
check("rgb8", 2, 8, 0,
