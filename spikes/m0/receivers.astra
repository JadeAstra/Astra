// Spike: blocks that run on an object (receiver lambdas), and the layout DSL they are for.
// The classes here stand in for jade's; the last part is the examples' Launcher, as it would port.

class Insets(val top : int, val left : int, val bottom : int, val right : int) {
  fun toString() => "Insets(${this.top}, ${this.left}, ${this.bottom}, ${this.right})"
}

class Component(val content) {
  var tip = null
  fun tooltip(text) { this.tip = text; return this }
  fun toString() => this.tip == null ? "${this.content}" : "${this.content} [tip: ${this.tip}]"
}

class RowScope(val grid, val row : int) {
  var col = 0
  fun cell(component, colSpan = 1, fill = "NONE", weightX = 0.0) {
    this.grid.add(component, this.row, this.col, fill, weightX)
    this.col += colSpan
    return component
  }
}

class Grid {
  var insets = Insets(0, 0, 0, 0)
  var hgap = 0
  var vgap = 0
  val cells : list = []
  var nextRow = 0

  // A property with a setter, to show that assignment through a block reaches it.
  var _id = null
  get viewId() => this._id
  set viewId(value) { this._id = "view:" + value }

  fun add(component, row, col, fill, weightX) {
    this.cells.push("r${row}c${col} ${component} fill=${fill} weightX=${weightX}")
    return component
  }
  fun row(build) {
    with(RowScope(this, this.nextRow), build)
    this.nextRow += 1
  }
}

// The Kotlin signature is grid(id: String? = null, build: JadeGrid.() -> Unit).
fun grid(id = null, build : Grid.() -> Unit) {
  val g = Grid()
  if id != null { g.viewId = id }
  g.apply(build)
  return g
}

fun label(text) => Component("label '${text}'")
fun button(text, onClick = {}) => Component("button '${text}'")
fun textField(text = "") => Component("textField '${text}'")

// ---- The names in a block are the object's -----------------------------------------------

val g = Grid()
with(g) {
  hgap = 8                       // a field of the grid
  vgap = hgap / 2                // read one, assign another
  viewId = "main"                // a property: runs the setter
}
print(g.hgap, g.vgap, g.viewId)                   // expect: 8 4 view:main

// A variable of the block, or of the function around it, wins over the object's member.
fun shadow() {
  val hgap = 99
  val grid = Grid()
  with(grid) { vgap = hgap }
  return grid.vgap
}
print(shadow())                                   // expect: 99

// A name the object does not have falls through to the globals.
var clicks = 0
with(g) { clicks += hgap }
print(clicks)                                     // expect: 8

// apply runs the block on the object and gives the object back; also and let pass it as `it`.
val configured = Grid().apply { hgap = 3 }
print(configured.hgap, 5.let { it + 1 }, [1].also { it.push(2) })   // expect: 3 6 [1, 2]

// ---- The layout DSL, as in the examples' Launcher.kt -------------------------------------

var status = label("clicks: 0")
val ui = grid {
  insets = Insets(14, 14, 14, 14)
  hgap = 8
  vgap = 8
  row {
    cell(label("Name:"))
    cell(textField("type here"), fill = "HORIZONTAL", weightX = 1.0)
  }
  row {
    cell(button("Click me") { clicks += 1 }.tooltip("Increments the click counter"))
    cell(status, fill = "HORIZONTAL", weightX = 1.0)
  }
  row {
    // A block inside a block still reaches the outer one's object.
    vgap = 10
    cell(label("wide"), colSpan = 2)
  }
}
print(ui.insets, ui.hgap, ui.vgap)                // expect: Insets(14, 14, 14, 14) 8 10
for line in ui.cells { print(line) }
// expect: r0c0 label 'Name:' fill=NONE weightX=0.0
// expect: r0c1 textField 'type here' fill=HORIZONTAL weightX=1.0
// expect: r1c0 button 'Click me' [tip: Increments the click counter] fill=NONE weightX=0.0
// expect: r1c1 label 'clicks: 0' fill=HORIZONTAL weightX=1.0
// expect: r2c0 label 'wide' fill=NONE weightX=0.0

// With an id, and the lambda after named and positional arguments.
val named = grid("sidebar") { hgap = 1 }
print(named.viewId, named.hgap)                   // expect: view:sidebar 1
