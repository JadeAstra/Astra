// Spike: tries the font reader on every font file named in a list (one path per line).
// Prints a tally and each file that could not be read, with the reason.
val lines = File.read(args()[0]).split("\n")
var readable = 0
var unreadable = 0
val reasons = {:}
val odd = []
for raw in lines {
  val path = raw.trim()
  if path.length == 0 { continue }
  val result = Spike.fontCheck(path, 0)
  if result.startsWith("ok") {
    readable += 1
    if result.contains("ok: 0 of") { odd.push(path + "  " + result) }
  } else {
    unreadable += 1
    reasons[result] = (reasons.has(result) ? reasons[result] : 0) + 1
  }
}
print("font files: ${readable + unreadable}, read and rasterised: $readable, not read: $unreadable")
for reason in reasons.keys() { print("  ${reasons[reason]} x $reason") }
print("read but with no Latin glyphs (symbol and non-Latin fonts): ${odd.length}")
