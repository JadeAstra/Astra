// Spike: what a name costs inside a lambda, where it may have to be looked up on an object.
class Box {
  var total = 0
  var step = 1
  fun bump() { this.total += this.step }
}

fun timed(name, count, f) {
  val start = clock()
  f()
  val ms = (clock() - start) * 1000
  print("$name: ${Math.round(ms)} ms, ${Math.round(count / ms)}k per ms... ${Math.round(ms * 1000000 / count)} ns each")
}

val n = 2000000
var counter = 0
fun work(x) => x + 1

// 1. A global read and written in an ordinary function: resolved when compiled.
timed("fun, global variable        ", n, fun() {
  var i = 0
  while i < n { counter = counter + 1; i += 1 }
})

// 2. The same in a lambda literal that runs on nothing: one check, then the global.
counter = 0
timed("lambda, global variable     ", n, {
  var i = 0
  while i < n { counter = counter + 1; i += 1 }
})

// 3. In a lambda run on an object that does not have the name: a failed lookup, then the global.
counter = 0
val box = Box()
timed("lambda on object, global    ", n, {
  with(box) {
    var i = 0
    while i < n { counter = counter + 1; i += 1 }
  }
})

// 4. A field of the object by its bare name.
timed("lambda on object, its field ", n, {
  with(box) {
    var i = 0
    while i < n { total = total + 1; i += 1 }
  }
})

// 5. The same field written out as this.total in a method.
class Loop {
  var total = 0
  fun run(n) {
    var i = 0
    while i < n { this.total = this.total + 1; i += 1 }
  }
}
val loop = Loop()
timed("method, this.field          ", n, fun() { loop.run(n) })

// 6. Calling a global function from a plain function and from a lambda on an object.
timed("fun, call a global function ", n, fun() {
  var i = 0
  while i < n { work(i); i += 1 }
})
timed("lambda on object, same call ", n, {
  with(box) {
    var i = 0
    while i < n { work(i); i += 1 }
  }
})

// 7. Calling the object's method by its bare name (makes a bound method each time) against this.bump().
timed("lambda on object, bump()    ", n, {
  with(box) {
    var i = 0
    while i < n { bump(); i += 1 }
  }
})
class Bumper : Box {
  fun run(n) {
    var i = 0
    while i < n { this.bump(); i += 1 }
  }
}
val bumper = Bumper()
timed("method, this.bump()         ", n, fun() { bumper.run(n) })
