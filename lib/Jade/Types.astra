// The small types everything else in Jade is written in terms of: sizes and style, the
// events a widget is told of, what a widget's content has to provide, the things a content
// may also be able to do, and the colours of the theme. (JadeUI: Jade.kt.)

// What a content says of its size: the least it can be, what it would like, and the most. A
// value type (M6.6 part 7): a component keeps the last ones inside itself.
value Sizes(val min : Size, val pref : Size, val max : Size)

// How a widget is to draw itself, handed down from what it is in: a background and a
// foreground to use where it has none of its own, whether it can be used, and whether it
// should draw its own frame.
data Style(val background : Color?, val foreground : Color?, val enabled : bool, val framed : bool = true)

// How a cell's widget takes up the room its cell has.
enum Fill { none, horizontal, vertical, both }

// Where in its cell a widget sits when it does not fill it.
enum Anchor { center, north, south, east, west, northwest, northeast, southwest, southeast }

// The keys a widget is told of by name.
enum Key { left, right, up, down, pageUp, pageDown, home, end, backspace, delete, enter, escape, tab, f2, f5, f10, f11 }

enum EditCommand { undo, redo, copy, cut, paste, selectAll, fillDown, fillRight, complete, pasteSeparate }

// What a widget is told has happened. Positions are from the widget's own top left corner.
interface Event {
  // A press of the main button. `clicks` is 2 for a double click.
  data Click(val x : int, val y : int, val clicks : int = 1, val shift : bool = false, val ctrl : bool = false) : Event
  // Typed text.
  data KeyType(val text : string) : Event
  data KeyPress(val key : Key, val shift : bool = false, val ctrl : bool = false) : Event
  // The pointer moved with the button held, and the button was let go.
  data Drag(val x : int, val y : int, val shift : bool = false) : Event
  data Release(val x : int, val y : int, val shift : bool = false) : Event
  data Wheel(val x : int, val y : int, val deltaY : int, val shift : bool = false, val deltaX : int = 0) : Event
  data Shortcut(val command : EditCommand) : Event
  // The other button: pressed, or (drag) moved while held.
  data Context(val x : int, val y : int, val drag : bool = false) : Event
  // The pointer is over the widget; (-1, -1) once it has left.
  data Hover(val x : int, val y : int, val shift : bool = false, val ctrl : bool = false) : Event
}

// What a widget is made of: it says how large it is, paints itself, and hears of events.
// A Component wraps one, and is its owner: the content tells it that it has changed, and paints
// in the style it says (owner.paintStyle, D132).
interface Content {
  var owner : Component?
  fun sizes() : Sizes
  fun paint(canvas : Canvas)
  fun onEvent(event : Event) {}
}

// ---- What a content may also be able to do ----

interface Bordered

// Takes the keyboard when pressed, though it is not a text field or a list.
interface FocusTarget

// Keeps the keyboard when something else is pressed, if it says so.
interface FocusHolder {
  fun holdsFocusOnPress(pressed : Component, x : int, y : int) : bool
}

// Is told when it gets and loses the keyboard, and may have a caret that blinks.
interface FocusAware {
  fun setFocused(focused : bool)
  fun blinkCaret() : bool => false
  fun caretGeneration() : int => 0
  fun showCaretSolid() {}
}

// Uses the Tab key itself, when it says so, instead of letting it move on to the next widget.
interface TabAware {
  fun acceptsTab() : bool
}

// Wants another pointer over parts of itself.
interface CursorProvider {
  fun cursorAt(x : int, y : int) : CursorKind
}

interface TooltipProvider {
  fun tooltipAt(x : int, y : int) : string?
}

// Has something drawn over it afresh every frame, never kept: a caret, a selection.
interface OverlayContent {
  fun paintOverlay(canvas : Canvas)
}

// Its height depends on the width it is given.
interface HeightForWidth {
  fun heightForWidth(width : int) : int
}


interface BandAware {
  var paintBand : Range?
}

// Opens a list of choices under itself when pressed.
interface DropdownProvider {
  val dropdownItems : List<string>
  val dropdownSelected : int
  fun dropdownChoose(index : int)
  fun isDropdownTrigger(x : int, y : int) : bool
}

interface EdgeEscape {
  var onEscape : ((bool) -> bool)?
  fun enterFromEdge(fromTop : bool) {}
}

interface TypesInPlace {
  val takesTyping : bool
}

// Takes the wheel itself; says whether it used it.
interface WheelTarget {
  fun wheel(event : Event.Wheel) : bool
}

interface DragTarget

// ---- The colours of the theme ----

// Colours are written as they are in the light theme and turned into the dark theme's when
// that is on: Palette.bg(0xFFFFFF) is white by day and near black by night.
object Palette {
  private val listeners = []
  private val memo = {:}

  var dark = false
    set(value) {
      if (field != value) {
        field = value
        memo.clear()
        Jade.invalidateRenderCaches()
        Jade.requestRepaint()
        for (hook in listeners.toList()) { hook() }
      }
    }

  fun onThemeChange(hook : () -> unit) {
    listeners.add(hook)
  }
  fun removeThemeHook(hook : () -> unit) {
    listeners.remove(hook)
  }

  // A background, a foreground (text, marks) and a line (borders, rules). With `themed`
  // false the colour is the same in both themes.
  fun bg(rgb : int, themed : bool = true) : Color => themed ? toned(rgb, 0) : Color(rgb & 0xFFFFFF)
  fun fg(rgb : int, themed : bool = true) : Color => themed ? toned(rgb, 1) : Color(rgb & 0xFFFFFF)
  fun line(rgb : int) : Color => toned(rgb, 2)

  private fun clamp(value : float) : float => value < 0.0 ? 0.0 : (value > 1.0 ? 1.0 : value)

  private fun toned(rgb : int, role : int) : Color {
    val key = (rgb & 0xFFFFFF) * 4 + role
    var made = memo[key]
    if (made != null) { return made }
    val c = Color(rgb & 0xFFFFFF)
    if (dark) {
      val hsb = Color.RGBtoHSB(c.red, c.green, c.blue)
      val h = hsb[0]
      val s = hsb[1]
      val b = hsb[2]
      if (role == 0) {
        made = Color.getHSBColor(h, s * 0.7, clamp(0.11 + (1.0 - b) * 0.85 + s * 0.18))
      } else if (role == 1) {
        made = s < 0.3 ? Color.getHSBColor(h, s, clamp(0.92 - b * 0.45)) : Color.getHSBColor(h, s * 0.75, Math.max(b, 0.88))
      } else {
        made = Color.getHSBColor(h, s * 0.6, clamp(0.24 + (1.0 - b) * 0.45))
      }
    } else {
      made = c
    }
    memo[key] = made
    return made
  }

  val surface : Color
    get() => bg(0xFFFFFF)
  val border : Color
    get() => line(0x808080)
  val headerBg : Color
    get() => bg(0xECECEC)
  val ink : Color
    get() => fg(0x1a2420)
  val disabled : Color
    get() => fg(0x909090)
  val selection : Color
    get() => bg(0xADD8E6)
  val accent : Color
    get() => fg(0x1565C0)
  val selectBlue : Color
    get() => fg(0x2D6CDF)
  val positive : Color
    get() => fg(0x0fa47f)
}

// ---- Measuring text for layout ----

internal val jadeMetrics = {:}

// The measurements of a font in layout units, for the screen being laid out for
// (Jade.layoutScale), kept once made.
internal fun metrics(font : Font) : TextUnits {
  val scale = Jade.layoutScale
  // Mostly the same font as last time (every label's is the default one): no key made, no hashing.
  val last = jadeLastMetrics
  if (last != null and last.font === font and last.scale == scale) { return last }
  val key = font to scale
  var found = jadeMetrics[key]
  if (found == null) {
    found = TextUnits(font, scale)
    jadeMetrics[key] = found
  }
  jadeLastMetrics = found as TextUnits
  return found as TextUnits
}
internal var jadeLastMetrics : TextUnits? = null

// A font's measurements in layout units on a screen of some scale: measured in that screen's
// own pixels and divided, rounded up, so that text always fits the room measured for it. At a
// scale of 1 the numbers are exact.
internal class TextUnits {
  val font : Font
  val scale : Number
  // The line, worked out once: it never changes.
  val ascent : int
  val descent : int
  val leading : int
  val height : int

  fun init(font : Font, scale : Number) {
    this.font = font
    this.scale = scale
    this.ascent = units(font.ascent(scale))
    this.descent = units(font.descent(scale))
    this.leading = units(font.leading(scale))
    this.height = ascent + descent + leading
  }

  private fun units(device : int) : int => scale == 1 ? device : Math.ceil(device / scale.toFloat()).toInt()
  fun stringWidth(text : string) : int => units(font.width(text, scale))
}

// A text cut short with "…" so that it fits a width; the whole text if it fits as it is.
fun elide(text : string, font : Font, maxWidth : int) : string {
  if (maxWidth <= 0) { return "" }
  val fm = metrics(font)
  if (fm.stringWidth(text) <= maxWidth) { return text }
  val ellipsis = "…"
  val room = maxWidth - fm.stringWidth(ellipsis)
  if (room <= 0) { return "" }
  var lo = 0
  var hi = text.size
  while (lo < hi) {
    val mid = (lo + hi + 1) / 2
    if (fm.stringWidth(text[0..<mid]) <= room) { lo = mid } else { hi = mid - 1 }
  }
  return text[0..<lo] + ellipsis
}

