// The simplest widgets: a label, a label that wraps, a button, a button with a picture,
// and the rule between groups of a toolbar. (JadeUI: Widgets.kt.)

internal val defaultFont = Font(Font.sansSerif, 12)

// The style a content paints in: its owner's, as the owner worked it out when it painted (D132).
internal fun styleOf(content : Content) : Style => content.owner?.paintStyle ?: Style(null, null, true)

// A colour part of the way from one to another: a share of 0 is the first, of 1 the second.
internal fun mixed(from : Color, to : Color, share : float) : Color =>
  Color((from.red + (to.red - from.red) * share).toInt(), (from.green + (to.green - from.green) * share).toInt(),
        (from.blue + (to.blue - from.blue) * share).toInt(), from.alpha)

// One line of text.
class Label : Content {
  override var owner : Component? = null
  var text : string = ""
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  var font : Font = defaultFont
    set(value) {
      field = value
      owner?.invalidateLayout()
    }

  fun init(text : string, font : Font? = null) {
    this.text = text
    this.font = font ?: defaultFont
  }

  override fun sizes() : Sizes {
    val fm = metrics(font)
    val pref = Size(fm.stringWidth(text) + 8, fm.height + 4)
    return Sizes(pref, pref, Size(int.maxValue, pref.height))
  }

  override fun paint(canvas : Canvas) {
    canvas.font = font
    canvas.color = styleOf(this).foreground ?: Palette.ink
    val m = canvas.measure(text, font)
    canvas.drawString(text, 4, (canvas.height - m.height) / 2 + m.ascent)
  }
}

// Text that goes on to further lines when it reaches the width it is given, and whose
// height therefore depends on that width.
class WrappedLabel : Content, HeightForWidth {
  override var owner : Component? = null
  var text : string = ""
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  var font : Font = defaultFont
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  // The width it asks for before it has been given one.
  var preferredWidth = 420
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  private var lastWidth = -1

  fun init(text : string, font : Font? = null) {
    this.text = text
    this.font = font ?: defaultFont
  }

  // The lines the text makes at a width: broken between words, a word too long for a
  // line left whole, and a line break in the text kept.
  fun wrap(width : int) : List<string> {
    if (text.isEmpty()) { return [] }
    if (width <= 0) { return [text] }
    val fm = metrics(font)
    val out : open List<string> = []
    for (paragraph in text.split("\n")) {
      if (paragraph.isEmpty()) {
        out.add("")
        continue
      }
      var line = ""
      for (word in paragraph.split(" ")) {
        val candidate = line.isEmpty() ? word : "$line $word"
        if (fm.stringWidth(candidate) <= width or line.isEmpty()) {
          line = candidate
        } else {
          out.add(line)
          line = word
        }
      }
      out.add(line)
    }
    return out
  }

  override fun heightForWidth(width : int) : int => Math.max(wrap(width).size, 1) * metrics(font).height + 4

  override fun sizes() : Sizes {
    val width = lastWidth > 0 ? lastWidth : preferredWidth
    val height = heightForWidth(width)
    return Sizes(Size(60, height), Size(width, height), Size(int.maxValue, int.maxValue))
  }

  override fun paint(canvas : Canvas) {
    if (canvas.width != lastWidth and canvas.width > 0) {
      lastWidth = canvas.width
      owner?.invalidateLayout()
    }
    canvas.font = font
    canvas.color = styleOf(this).foreground ?: Palette.ink
    val fm = metrics(font)
    var y = fm.ascent + 2
    for (line in wrap(canvas.width)) {
      canvas.drawString(line, 0, y)
      y += fm.height
    }
  }
}

fun wrappedLabel(text : string, font : Font? = null) : Component => Component(WrappedLabel(text, font))

// A button: it does what `onClick` says when it is pressed and let go while the pointer is
// still on it. While the pointer is over it, it is lit: its edge takes the accent colour
// and its body a little of it. (JadeUI's button has no such look; its icon button has.)
class Button : Content {
  override var owner : Component? = null
  var onClick : () -> unit
  var text : string = ""
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  var font : Font = defaultFont
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  private var armed = false       // pressed on this button and not yet let go
  private var pressed = false     // armed, and the pointer is over it: it looks pressed
  private var hovered = false     // the pointer is over it, as far as it has been told
  private var w = 0
  private var h = 0

  fun init(text : string, onClick : () -> unit = {}, font : Font? = null) {
    this.text = text
    this.onClick = onClick
    this.font = font ?: defaultFont
  }

  override fun sizes() : Sizes {
    val fm = metrics(font)
    val pref = Size(fm.stringWidth(text) + 24, fm.height + 12)
    val min = Size(fm.stringWidth(text) + 12, fm.height + 6)
    return Sizes(min, pref, Size(int.maxValue, pref.height))   // it may be made wider, not taller
  }

  override fun paint(canvas : Canvas) {
    w = canvas.width
    h = canvas.height
    val base = styleOf(this).background ?: Palette.bg(0xE0E0E0)
    val lit = hovered and styleOf(this).enabled
    canvas.color = pressed ? base.darker() : (lit ? mixed(base, Palette.accent, 0.12) : base)
    canvas.fillRoundRect(0, 0, canvas.width - 1, canvas.height - 1, 8, 8)
    canvas.color = lit ? Palette.accent : Palette.border
    canvas.drawRoundRect(0, 0, canvas.width - 1, canvas.height - 1, 8, 8)
    canvas.font = font
    canvas.color = styleOf(this).enabled ? (styleOf(this).foreground ?: Palette.ink) : Palette.disabled
    val m = canvas.measure(text, font)
    val down = pressed ? 1 : 0           // the text goes down a little while it is pressed
    canvas.drawString(text, (canvas.width - m.width) / 2, (canvas.height - m.height) / 2 + m.ascent + down)
  }

  override fun onEvent(event : Event) {
    if (event is Event.Click) {
      armed = true
      pressed = true
    } else if (event is Event.Drag) {
      if (armed) {
        pressed = isOver(event.x, event.y)
        if (!pressed) { setHovered(false) }                    // dragged off it
      }
    } else if (event is Event.Release) {
      val over = isOver(event.x, event.y)
      if (armed and over) { onClick() }                        // only if let go over it
      armed = false
      pressed = false
      if (!over) { setHovered(false) }
    } else if (event is Event.Hover) {
      setHovered(isOver(event.x, event.y))
    }
  }

  // The host repaints what the pointer comes onto and what it leaves; a button that learns
  // of it some other way asks for itself.
  private fun setHovered(now : bool) {
    if (now != hovered) {
      hovered = now
      owner?.invalidate()
    }
  }

  private fun isOver(x : int, y : int) : bool => x >= 0 and x < w and y >= 0 and y < h
}

// A button that shows a picture, for toolbars.
class IconButton(image : Image, onClick : () -> unit = {}, size : int = 30) : Content {
  override var owner : Component? = null
  var onClick : () -> unit = onClick
  var image : Image = image
    set(value) {
      field = value
      owner?.invalidate()
    }
  var size : int = size
    set(value) {
      field = value
      owner?.invalidateLayout()
    }
  var enabled = true
    set(value) {
      field = value
      if (!value) {
        armed = false
        pressed = false
      }
      owner?.invalidate()
    }
  private var armed = false
  private var pressed = false
  private var hovered = false
  private var w = 0
  private var h = 0
  private var fadedOf : Image? = null
  private var fadedSource : Image? = null

  override fun sizes() : Sizes {
    val d = Size(size, size)
    return Sizes(d, d, Size(d.width, d.height))
  }

  override fun paint(canvas : Canvas) {
    w = canvas.width
    h = canvas.height
    if (enabled and (pressed or hovered)) {
      canvas.color = pressed ? Palette.bg(0xC6D2E0) : Palette.bg(0xE2E7EC)
      canvas.fillRoundRect(1, 1, w - 3, h - 3, 6, 6)
    }
    canvas.draw(enabled ? image : faded(image), (w - image.width) / 2, (h - image.height) / 2)
  }

  // The picture as it looks when the button cannot be used: mostly see-through.
  private fun faded(source : Image) : Image {
    if (fadedSource === source) { return fadedOf!! }
    val out = Image(source.width, source.height)
    out.canvas().draw(source, 0, 0, alpha = 0.35)
    fadedSource = source
    fadedOf = out
    return out
  }

  override fun onEvent(event : Event) {
    if (!enabled) { return }
    if (event is Event.Click) {
      armed = true
      pressed = true
    } else if (event is Event.Drag) {
      if (armed) { pressed = isOver(event.x, event.y) }
    } else if (event is Event.Release) {
      if (armed and isOver(event.x, event.y)) { onClick() }    // only if let go over it
      armed = false
      pressed = false
    } else if (event is Event.Hover) {
      hovered = isOver(event.x, event.y)
    }
  }

  private fun isOver(x : int, y : int) : bool => x >= 0 and x < w and y >= 0 and y < h
}

fun iconButton(image : Image, onClick : () -> unit = {}) : Component => Component(IconButton(image, onClick))

// The thin upright rule between groups of buttons in a toolbar.
class ToolbarSeparator : Content {
  override var owner : Component? = null
  private val color : Color?
  private val height : int

  fun init(color : Color? = null, height : int = 20) {
    this.color = color
    this.height = height
  }

  override fun sizes() : Sizes {
    val d = Size(9, height)
    return Sizes(d, d, Size(d.width, int.maxValue))
  }

  override fun paint(canvas : Canvas) {
    val h = Math.min(canvas.height, height)
    val top = (canvas.height - h) / 2
    canvas.color = color ?: Palette.line(0xC8CED4)
    canvas.fillRect(canvas.width / 2, top, 1, h)
  }
}

fun toolbarSeparator() : Component => Component(ToolbarSeparator())

// Takes up room and draws nothing but a background, if it is given one.
internal class Spacer : Content {
  override var owner : Component? = null
  private val w : int
  private val h : int

  fun init(w : int = 0, h : int = 0) {
    this.w = w
    this.h = h
  }

  override fun sizes() : Sizes => Sizes(Size(w, h), Size(w, h), Size(int.maxValue, int.maxValue))

  override fun paint(canvas : Canvas) {
    val fill = owner?.paintStyle?.background
    if (fill != null) {
      canvas.color = fill
      canvas.fillRect(0, 0, canvas.width, canvas.height)
    }
  }
}
