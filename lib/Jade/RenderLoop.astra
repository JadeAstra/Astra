// What a window has to keep track of between frames: whether anything needs drawing,
// whether the tree needs laying out again, and how small a part of the picture can be
// drawn when only a part has changed. (JadeUI: RenderLoop.kt.)

class RenderLoop {
  private var needsLayout = true
  private var lastW = -1
  private var lastH = -1
  private var dirty = true
  private var damage = null      // the part that has changed, if it is known to be only a part

  // One frame's plan: whether the tree is laid out first, and the part to draw (null: all).
  class Frame(val layout, val partial)

  get isDirty() => dirty

  fun requestLayout() {
    needsLayout = true
  }

  // Everything has to be drawn again.
  fun markDirty() {
    dirty = true
    damage = null
  }

  // Only a rectangle has changed. Several add up to the rectangle that holds them all; a
  // markDirty before or after makes it everything.
  fun markDamage(r) {
    if (dirty and damage == null) { return }
    damage = damage == null ? Rectangle(r) : damage.union(r)
    dirty = true
  }

  fun layoutDue(w, h) => needsLayout or w != lastW or h != lastH

  // Lays the tree out if its size has changed or something asked for it.
  fun ensureLayout(root, w, h) {
    if (w <= 0 or h <= 0 or !layoutDue(w, h)) { return }
    root.layout(w, h)
    laidOut(w, h)
  }

  // What the next frame has to do. Only a part is drawn if only a part was damaged and
  // nothing else forces a whole frame: a layout, or a picture of another size.
  fun plan(w, h, buffersResized) {
    val layout = layoutDue(w, h)
    var partial = null
    if (damage != null and !layout and !buffersResized) {
      val within = damage.intersection(Rectangle(0, 0, w, h))
      if (!within.isEmpty) { partial = within }
    }
    return Frame(layout, partial)
  }

  // The frame that was planned has been drawn.
  fun drawn(frame, w, h) {
    if (frame.layout) { laidOut(w, h) }
    dirty = false
    damage = null
  }

  // Whether there is nothing to do until something happens.
  fun mayIdle(holding) => !dirty and !holding

  // Plans a frame, paints the tree into a picture, and notes it as drawn.
  fun renderFrame(root, buf, w, h, sx = 1.0, sy = 1.0) {
    val frame = plan(w, h, false)
    root.renderInto(buf, w, h, sx, sy, frame.layout, frame.partial)
    drawn(frame, w, h)
    return frame
  }

  private fun laidOut(w, h) {
    lastW = w
    lastH = h
    needsLayout = false
  }
}
