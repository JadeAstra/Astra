// The object called like the library: what belongs to the toolkit as a whole and not to
// any one widget or window. Widgets ask it for a repaint or a layout; windows listen.
// (JadeUI: the object JadeUi.)
//
//   Jade.requestRepaint()
//   Jade.onFrame { time -> spin(time.delta) }
//   Jade.windowOpener = HiddenWindowOpener()      // in a test: windows that are never shown

// The time handed to a frame hook: seconds since the first frame, seconds since the last,
// and how many frames there have been.
class FrameTime(val time : float, val delta : float, val frame : int)

object Jade {
  // Runs a task after a delay, in milliseconds. The window that is in front sets it.
  var scheduler : ((int, () -> unit) -> unit)? = null

  // How many of the screen's pixels there are to a layout unit where text is now being
  // measured for layout: the scale of the window being laid out or painted, which sets it.
  // Text is measured in the screen's own pixels and the result rounded up to units, so
  // what a widget asks for is room its text really fits in on that screen.
  var layoutScale : Number = 1

  // Whether the key that commands go with (Ctrl) is held: a link shows a hand only then.
  var shortcutDown = false

  // Goes up whenever something happened that may have changed how any widget looks. A
  // widget's kept picture is good only for the number it was painted at.
  var renderGeneration = 0
    private set
  fun invalidateRenderCaches() {
    renderGeneration += 1
  }

  // ---- Asking for a repaint and a layout ----

  private val repaintHooks = []
  private val layoutHooks = []

  fun onRepaintNeeded(hook : () -> unit) {
    repaintHooks.add(hook)
  }
  fun removeRepaintHook(hook : () -> unit) {
    repaintHooks.remove(hook)
  }
  // Has every window draw a frame soon.
  fun requestRepaint() {
    for (hook in repaintHooks.toList()) { hook() }
  }

  fun onLayoutNeeded(hook : () -> unit) {
    layoutHooks.add(hook)
  }
  fun removeLayoutHook(hook : () -> unit) {
    layoutHooks.remove(hook)
  }
  // Has every window lay its tree out again before its next frame.
  fun requestLayout() {
    for (hook in layoutHooks.toList()) { hook() }
    requestRepaint()
  }

  fun clearHostHooks() {
    repaintHooks.clear()
    layoutHooks.clear()
    frameNeededHooks.clear()
    focusHook = null
  }

  // ---- Windows ----

  // What turns a Window into a window on the screen when it is shown. A test puts another
  // here: HiddenWindowOpener, or one of its own that makes nothing and records what it was asked.
  private var opener : WindowOpener? = null
  get windowOpener() : WindowOpener {
    val kept = opener
    if (kept != null) { return kept }
    val made = NativeWindowOpener()
    opener = made
    return made
  }
  set windowOpener(value) {
    opener = value
  }

  // ---- Something to do every frame ----

  private val frameNeededHooks = []
  private val frameHooks = []
  private var clockStart = 0
  private var lastFrameAt = 0
  private var frameCount = 0

  fun onFrameNeeded(hook : () -> unit) {
    frameNeededHooks.add(hook)
  }
  fun removeFrameNeededHook(hook : () -> unit) {
    frameNeededHooks.remove(hook)
  }
  fun requestFrame() {
    for (hook in frameNeededHooks.toList()) { hook() }
  }

  // Calls the hook before every frame from now on, with a FrameTime: for an animation.
  fun onFrame(hook : (FrameTime) -> unit) {
    frameHooks.add(hook)
    requestFrame()
  }
  fun removeFrameHook(hook : (FrameTime) -> unit) {
    frameHooks.remove(hook)
  }
  get wantsFrames() : bool => !frameHooks.isEmpty()

  fun runFrameHooks(nowNanos : int) {
    if (frameHooks.isEmpty()) { return }
    if (clockStart == 0) { clockStart = nowNanos }
    if (lastFrameAt != 0 and nowNanos - lastFrameAt < 1000000) { return }
    val delta = lastFrameAt == 0 ? 0.0 : (nowNanos - lastFrameAt) / 1e9
    lastFrameAt = nowNanos
    val t = FrameTime((nowNanos - clockStart) / 1e9, delta, frameCount)
    frameCount += 1
    for (hook in frameHooks.toList()) { hook(t) }
  }

  // ---- The pointer ----

  // What the back and forward buttons of a mouse do.
  var navigate : ((bool) -> unit)? = null

  private val pressListeners = []
  fun onPointerPressed(listener : (int, int) -> unit) {
    pressListeners.add(listener)
  }
  fun removePointerPressed(listener : (int, int) -> unit) {
    pressListeners.remove(listener)
  }
  fun pointerPressed(x : int, y : int) {
    for (listener in pressListeners.toList()) { listener(x, y) }
  }

  private var pointerExitHook : (() -> unit)? = null
  fun onPointerExit(hook : () -> unit) {
    pointerExitHook = hook
  }
  fun pointerExited() {
    val hook = pointerExitHook
    if (hook != null) { hook() }
  }

  // ---- Things shown over the window ----

  private var overlayHook : ((Component?, int, int) -> unit)? = null
  fun onOverlayNeeded(hook : (Component?, int, int) -> unit) {
    overlayHook = hook
  }
  fun showOverlay(comp : Component?, x : int = 0, y : int = 0) {
    val hook = overlayHook
    if (hook != null) { hook(comp, x, y) }
  }

  private var tipHook : ((Component?, int, int) -> unit)? = null
  fun onTipNeeded(hook : (Component?, int, int) -> unit) {
    tipHook = hook
  }
  fun showTip(comp : Component?, x : int = 0, y : int = 0) {
    val hook = tipHook
    if (hook != null) { hook(comp, x, y) }
  }

  // ---- The keyboard ----

  private var focusHook : ((Component) -> unit)? = null
  fun onFocusRequested(hook : (Component) -> unit) {
    focusHook = hook
  }
  // Gives a component the keyboard.
  fun requestFocus(comp : Component) {
    val hook = focusHook
    if (hook != null) {
      hook(comp)
      return
    }
    val c = comp.content
    if (c is FocusAware) { c.setFocused(true) }
  }

  // ---- Grids by name ----

  private val registry = {:}
  fun register(id : string, grid : Grid) {
    registry[id] = grid
  }
  fun registeredGrids() : List<Grid> => registry.values.toList()
}
