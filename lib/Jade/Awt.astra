// The types JadeUI's API takes from the JDK, under the names they have there, so that code
// written against JadeUI in Kotlin reads the same here: Color, Font, FontMetrics, Dimension,
// Point, Rectangle, Insets, BufferedImage. Each has the members JadeUI and its apps use, not
// the whole of the JDK's. Constants are in camelCase like every other: Font.bold, Color.white.

// ---- Color ----

// A colour: red, green and blue from 0 to 255, and how solid it is (alpha: 255 solid, 0 clear).
//
//   Color(255, 128, 0)            Color(255, 128, 0, 128)      half see-through
//   Color(0xFF8000)               Color(0x80FF8000, true)      one number, with its alpha
//   Color(1.0, 0.5, 0.0)          parts from 0.0 to 1.0
class Color {
  val red : int
  val green : int
  val blue : int
  val alpha : int

  fun init(r : Number, g : any? = null, b : Number? = null, a : Number? = null) {
    if (g == null or g is bool) {
      // One number, 0xRRGGBB, or 0xAARRGGBB if its alpha counts.
      val rgb = r as int
      red = (rgb >> 16) & 255
      green = (rgb >> 8) & 255
      blue = rgb & 255
      alpha = g == true ? (rgb >> 24) & 255 : 255
    } else if (r is float or g is float or b is float) {
      red = Color.part(r * 255)
      green = Color.part((g as Number) * 255)
      blue = Color.part((b as Number) * 255)
      alpha = a == null ? 255 : Color.part(a * 255)
    } else {
      red = Color.part(r)
      green = Color.part(g as Number)
      blue = Color.part(b as Number)
      alpha = a == null ? 255 : Color.part(a)
    }
  }

  private static fun part(value : Number) : int {
    val whole = int(Math.round(value))
    return whole < 0 ? 0 : (whole > 255 ? 255 : whole)
  }

  // The colour as one number, 0xAARRGGBB.
  get rgb() => (alpha << 24) | (red << 16) | (green << 8) | blue
  fun getRGB() : int => rgb
  fun getRed() : int => red
  fun getGreen() : int => green
  fun getBlue() : int => blue
  fun getAlpha() : int => alpha

  // A lighter and a darker shade, by the steps Java takes.
  fun brighter() : Color {
    val least = 3
    if (red == 0 and green == 0 and blue == 0) { return Color(least, least, least, alpha) }
    val up = { v -> Math.min(int((v > 0 and v < least ? least : v) / 0.7), 255) }
    return Color(up(red), up(green), up(blue), alpha)
  }
  fun darker() : Color => Color(int(red * 0.7), int(green * 0.7), int(blue * 0.7), alpha)

  // The same colour, as see-through as `alpha` says.
  fun withAlpha(alpha : int) : Color => Color(red, green, blue, alpha)

  op ==(other : any?) : bool => other is Color and other.rgb == rgb
  fun hashCode() : int => rgb
  override fun toString() : string => alpha == 255 ? "Color($red, $green, $blue)" : "Color($red, $green, $blue, $alpha)"

  static val white = Color(255, 255, 255)
  static val lightGray = Color(192, 192, 192)
  static val gray = Color(128, 128, 128)
  static val darkGray = Color(64, 64, 64)
  static val black = Color(0, 0, 0)
  static val red = Color(255, 0, 0)
  static val pink = Color(255, 175, 175)
  static val orange = Color(255, 200, 0)
  static val yellow = Color(255, 255, 0)
  static val green = Color(0, 255, 0)
  static val magenta = Color(255, 0, 255)
  static val cyan = Color(0, 255, 255)
  static val blue = Color(0, 0, 255)

  // "#RRGGBB" or "0xRRGGBB".
  static fun decode(text : string) : Color {
    val digits = text.startsWith("#") ? text.substring(1) : (text.startsWith("0x") or text.startsWith("0X") ? text.substring(2) : text)
    return Color(digits.toInt(16))
  }

  // From hue, saturation and brightness, each from 0.0 to 1.0, as one number (0xFFRRGGBB).
  static fun HSBtoRGB(hue : float, saturation : float, brightness : float) : int {
    var r = brightness
    var g = brightness
    var b = brightness
    if (saturation != 0) {
      val h = (hue - Math.floor(hue)) * 6.0
      val f = h - Math.floor(h)
      val p = brightness * (1.0 - saturation)
      val q = brightness * (1.0 - saturation * f)
      val t = brightness * (1.0 - saturation * (1.0 - f))
      val sector = int(h)
      if (sector == 0) { r = brightness; g = t; b = p }
      else if (sector == 1) { r = q; g = brightness; b = p }
      else if (sector == 2) { r = p; g = brightness; b = t }
      else if (sector == 3) { r = p; g = q; b = brightness }
      else if (sector == 4) { r = t; g = p; b = brightness }
      else { r = brightness; g = p; b = q }
    }
    return 0xFF000000 | (int(r * 255 + 0.5) << 16) | (int(g * 255 + 0.5) << 8) | int(b * 255 + 0.5)
  }
  static fun getHSBColor(hue : float, saturation : float, brightness : float) : Color => Color(Color.HSBtoRGB(hue, saturation, brightness))

  // The other way: [hue, saturation, brightness]. (Java fills an array given to it; here
  // the list is the result, and a list given as the fourth argument is filled as well.)
  static fun RGBtoHSB(r : int, g : int, b : int, into : List<float>? = null) : List<float> {
    val most = Math.max(r, Math.max(g, b))
    val least = Math.min(r, Math.min(g, b))
    val brightness = most / 255.0
    val saturation = most != 0 ? (most - least) / float(most) : 0.0
    var hue = 0.0
    if (saturation != 0) {
      val span = float(most - least)
      val rc = (most - r) / span
      val gc = (most - g) / span
      val bc = (most - b) / span
      if (r == most) { hue = bc - gc } else if (g == most) { hue = 2.0 + rc - bc } else { hue = 4.0 + gc - rc }
      hue = hue / 6.0
      if (hue < 0) { hue = hue + 1.0 }
    }
    val result = [hue, saturation, brightness]
    if (into != null) {
      for (i in 0..<3) {
        if (i < into.size) { into[i] = result[i] } else { into.add(result[i]) }
      }
    }
    return result
  }
}

// ---- Font ----

// A font by family, style and size: Font("Segoe UI", Font.bold, 13). The family may be one
// of the names that mean the system's own: "Dialog", "SansSerif", "Serif", "Monospaced".
// The size is the height of the font's em in layout units.
class Font {
  static const plain = 0
  static const bold = 1
  static const italic = 2
  static const dialog = "Dialog"
  static const dialogInput = "DialogInput"
  static const sansSerif = "SansSerif"
  static const serif = "Serif"
  static const monospaced = "Monospaced"

  val name : string
  val style : int
  val size : Number

  fun init(name : string?, style : int = 0, size : Number = 12) {
    this.name = name ?: "Dialog"
    this.style = style & 3
    this.size = size
  }

  get isPlain() : bool => style == 0
  get isBold() : bool => style & 1 != 0
  get isItalic() : bool => style & 2 != 0
  get size2D() : float => float(size)
  fun getSize() : Number => size
  fun getStyle() : int => style
  fun getName() : string => name

  // The family actually used: the one asked for if it is installed, the system's if not.
  get family() : string => textFont(1).family
  get fontName() : string => textFont(1).typeface.fullName

  // The same font in another style or size: deriveFont(Font.bold), deriveFont(14.0),
  // deriveFont(Font.bold, 14.0). A whole number alone is a style and a decimal one a size,
  // as in Java, where the two are told apart by int and float.
  fun deriveFont(first : Number, second : Number? = null) : Font {
    if (second != null) { return Font(name, first as int, second) }
    return first is float ? Font(name, style, first) : Font(name, first as int, size)
  }

  op ==(other : any?) : bool => other is Font and other.name == name and other.style == style and other.size == size
  fun hashCode() : int => name.hashCode() * 31 + style * 7 + int(size * 16)
  override fun toString() : string => "Font($name, ${isBold ? (isItalic ? "bolditalic" : "bold") : (isItalic ? "italic" : "plain")}, $size)"

  // The engine's font for this one on a screen of some scale: what measures and draws it.
  private static val made = {:}
  fun textFont(scale : Number = 1) : TextFont {
    val key = "$name|$style|$size|$scale"
    var found = Font.made[key]
    if (found == null) {
      found = TextFont(name, size, isBold, isItalic, null, scale)
      Font.made[key] = found
    }
    return found
  }
}

// The measurements of a font, in layout units. On a screen with a scale the font is
// measured in the screen's own pixels and the numbers divided, rounded up: text always fits
// the room measured for it, and at a scale of 1 the numbers are exact.
class FontMetrics {
  val font : Font
  val scale : Number
  private val engine : TextFont

  fun init(font : Font, scale : Number = 1) {
    this.font = font
    this.scale = scale
    this.engine = font.textFont(scale)
  }

  private fun units(device : int) : int => scale == 1 ? device : int(Math.ceil(device / float(scale)))

  get ascent() : int => units(engine.ascent)
  get descent() : int => units(engine.descent)
  get leading() : int => units(engine.leading)
  get height() : int => units(engine.ascent) + units(engine.descent) + units(engine.leading)
  get maxAscent() : int => ascent
  get maxDescent() : int => descent
  fun stringWidth(text : string) : int => units(engine.width(text))
  fun charWidth(character : string) : int => units(engine.charWidth(character))
  fun getAscent() : int => ascent
  fun getDescent() : int => descent
  fun getLeading() : int => leading
  fun getHeight() : int => height
  fun getFont() : Font => font

  // The widths in the screen's own pixels, which add up exactly.
  fun deviceWidth(text : string) : int => engine.width(text)
  fun deviceOffsets(text : string) : List<int> => engine.offsets(text)
}

// ---- Geometry ----
//
// Value types (M6.6 part 7): a Dimension, a Point, an Insets or a Rectangle is what it holds,
// and is copied where Java's would be shared. Kept in a component's field, it is kept inside the
// component; changing one, `bounds.translate(1, 1)` or `size.width = 4`, changes the one in that
// place and no other. Two are == when their fields are.

value Dimension(var width : int = 0, var height : int = 0) {
  fun getWidth() : int => width
  fun getHeight() : int => height
  mutating fun setSize(width : int, height : int) {
    this.width = width
    this.height = height
  }
  override fun toString() : string => "Dimension($width x $height)"
}

value Point(var x : int = 0, var y : int = 0) {
  mutating fun translate(dx : int, dy : int) {
    x += dx
    y += dy
  }
  mutating fun setLocation(x : int, y : int) {
    this.x = x
    this.y = y
  }
  override fun toString() : string => "Point($x, $y)"
}

// Top, left, bottom, right: the order Java gives them in.
value Insets(var top : int = 0, var left : int = 0, var bottom : int = 0, var right : int = 0) {
  override fun toString() : string => "Insets(top=$top, left=$left, bottom=$bottom, right=$right)"
}

// A rectangle: its top left corner and its size, always all four: Rectangle(x, y, width,
// height). (Java's Rectangle(width, height) is Rectangle(0, 0, width, height); its copy,
// Rectangle(other), is the value itself, which is copied wherever it is kept.)
value Rectangle(var x : int, var y : int, var width : int, var height : int) {
  get isEmpty() : bool => width <= 0 or height <= 0
  get location() : Point => Point(x, y)
  get size() : Dimension => Dimension(width, height)
  get bounds() : Rectangle => this
  get minX() : int => x
  get minY() : int => y
  get maxX() : int => x + width
  get maxY() : int => y + height
  get centerX() : float => x + width / 2.0
  get centerY() : float => y + height / 2.0

  // Whether a point, or the whole of another rectangle, is inside.
  fun contains(px : any, py : int? = null, w : int? = null, h : int? = null) : bool {
    if (px is Point) { return contains(px.x, px.y) }
    if (px is Rectangle) { return contains(px.x, px.y, px.width, px.height) }
    if (width <= 0 or height <= 0) { return false }
    val cx = px as int
    val cy = py as int
    if (w == null or h == null) { return cx >= x and cy >= y and cx < x + width and cy < y + height }
    return w > 0 and h > 0 and cx >= x and cy >= y and cx + w <= x + width and cy + h <= y + height
  }
  fun intersects(other : Rectangle) : bool =>
    other.width > 0 and other.height > 0 and width > 0 and height > 0 and
    other.x < x + width and other.x + other.width > x and other.y < y + height and other.y + other.height > y

  // The part two rectangles share; an empty one if they share none.
  fun intersection(other : Rectangle) : Rectangle {
    val left = Math.max(x, other.x)
    val top = Math.max(y, other.y)
    val right = Math.min(x + width, other.x + other.width)
    val bottom = Math.min(y + height, other.y + other.height)
    return Rectangle(left, top, right - left, bottom - top)
  }
  // The smallest rectangle holding both.
  fun union(other : Rectangle) : Rectangle {
    val left = Math.min(x, other.x)
    val top = Math.min(y, other.y)
    val right = Math.max(x + width, other.x + other.width)
    val bottom = Math.max(y + height, other.y + other.height)
    return Rectangle(left, top, right - left, bottom - top)
  }

  mutating fun translate(dx : int, dy : int) {
    x += dx
    y += dy
  }
  mutating fun grow(horizontal : int, vertical : int) {
    x -= horizontal
    y -= vertical
    width += 2 * horizontal
    height += 2 * vertical
  }
  mutating fun setBounds(r : Rectangle) {
    setBounds(r.x, r.y, r.width, r.height)
  }
  mutating fun setBounds(x : int, y : int, width : int, height : int) {
    this.x = x; this.y = y; this.width = width; this.height = height
  }
  mutating fun setLocation(x : int, y : int) {
    this.x = x
    this.y = y
  }
  mutating fun setSize(width : int, height : int) {
    this.width = width
    this.height = height
  }

  override fun toString() : string => "Rectangle($x, $y, $width x $height)"
}

// ---- BufferedImage ----

// A picture of so many pixels, each a colour that may be see-through: what a program makes,
// changes a pixel at a time, draws on, and draws with. A colour here is one number,
// 0xAARRGGBB, as in Java.
//
// It lives in two places: as pixels in memory, which getRGB and setRGB work on, and on the
// graphics card, where it is drawn on and drawn from. Each is brought up to date from the
// other only when it is asked for after the other has changed, so a picture that is only
// ever drawn is sent to the card once.
class BufferedImage {
  static const typeIntRgb = 1       // no alpha: every pixel solid
  static const typeIntArgb = 2

  val width : int
  val height : int
  val type : int
  private var held : Picture   // the pixels in memory
  private var card : Surface? = null      // the same on the graphics card, as a Surface, once wanted
  private var memoryNewer = true
  private var cardNewer = false

  fun init(width : int, height : int, type : int = 2, picture : Picture? = null) {
    if (width < 1 or height < 1) { throw Error("a BufferedImage is at least 1 pixel each way, not $width by $height") }
    this.width = width
    this.height = height
    this.type = type
    this.held = picture ?: Picture(width, height, type == 1 ? 0xFF000000 : 0)
  }

  // From and to the engine's own kind of picture (a PNG file read with Picture.load, say).
  static fun fromPicture(picture : Picture) : BufferedImage => BufferedImage(picture.width, picture.height, 2, picture.copy())
  fun toPicture() : Picture => memory().copy()

  fun getWidth() : int => width
  fun getHeight() : int => height
  fun getType() : int => type

  fun getRGB(x : int, y : int) : int {
    if (x < 0 or y < 0 or x >= width or y >= height) { throw Error("pixel ($x, $y) is outside the picture, which is $width by $height") }
    return memory().get(x, y)
  }
  fun setRGB(x : int, y : int, color : int) {
    if (x < 0 or y < 0 or x >= width or y >= height) { throw Error("pixel ($x, $y) is outside the picture, which is $width by $height") }
    memory().set(x, y, type == 1 ? color | 0xFF000000 : color)
    memoryNewer = true
  }

  // A copy of a part of it. (In Java the part shares its pixels with the whole; here it
  // is a picture of its own.)
  fun getSubimage(x : int, y : int, w : int, h : int) : BufferedImage => BufferedImage(w, h, type, memory().crop(x, y, w, h))

  // Something to draw on it with: the canvas of the toolkit, one unit to the pixel.
  fun canvas() => onCard().canvas(this)

  // The same for a picture that stands for `width` by `height` units, at `scale` of its
  // pixels to the unit: what a window's picture is on a dense screen.
  fun canvasAt(width : int, height : int, scale : Number) => onCard().canvasAt(width, height, scale, this)

  fun save(path : any) {
    memory().save(path)
  }

  // The pixels in memory, brought up to date if the picture has been drawn on since.
  private fun memory() : Picture {
    val c = card
    if (cardNewer and c != null) {
      held = c.toPicture()
      cardNewer = false
    }
    return held
  }

  // Called by a canvas each time it draws on the picture: pixels set since the card last
  // had them go there first, and from then on the card's is the newer.
  fun drawnOn() {
    val c = card
    if (memoryNewer and !cardNewer and c != null) { c.upload(held) }
    memoryNewer = false
    cardNewer = true
  }

  // The picture on the graphics card, brought up to date if pixels have been set since.
  fun onCard() : Surface {
    val c = card ?: Surface(width, height)
    if (card == null) {
      card = c
      memoryNewer = true
    }
    if (memoryNewer and !cardNewer) {
      c.upload(held)
    }
    memoryNewer = false
    return c
  }

  override fun toString() : string => "BufferedImage($width x $height)"
}
