// The native layer as the rest of Jade uses it: a window on the screen, pictures on the
// graphics card, and the canvas that draws on either. All of it is drawn with OpenGL by the
// built-in __jade (src/jade), and text by Astra's own text engine.
//
//   val window = NativeWindow("Hello", 400, 200)
//   window.onResize = { w, h -> paint(window) }
//   window.show()
//
//   fun paint(window) {
//     val canvas = window.canvas()
//     canvas.color = Color.white
//     canvas.fillRect(0, 0, canvas.width, canvas.height)
//     canvas.color = Color.black
//     canvas.font = Font("Segoe UI", 20, bold = true)
//     canvas.drawString("Hello", 20, 40)
//     window.present()
//   }
//
// Everything a program gives and gets here is in layout units: the pixels of an ordinary
// screen. On a dense screen a window has a scale (1.5, 2) and draws that many of the
// screen's pixels to the unit, with edges still on pixel edges.
//
// Windows and drawing belong to the main thread. A program with a window showing goes on
// until its windows are closed: the events come through the same loop as EventLoop's tasks
// and timers, which is how an animation is made (EventLoop.every).

// ---- The system ----

object Native {
  // Why there are no windows or drawing here, or null if there are.
  fun problem() : string? => __jade.problem()
  val isAvailable : bool
    get() => __jade.problem() == null

  // Which OpenGL is drawing, on which graphics card.
  fun describe() : string => __jade.describe()

  // A clock that only goes forwards, in nanoseconds.
  fun nanoTime() : int => __jade.nanos()

  // How long two presses may be apart, in milliseconds, and still be a double click.
  val doubleClickTime : int
    get() => __jade.doubleClickTime()

  // How many of the main screen's pixels make a layout unit.
  val screenScale : float
    get() => __jade.screenScale()

  // The text on the clipboard ("" if it holds none).
  var clipboardText : string
    get() => __jade.clipboardGet()
    set(text : any?) { __jade.clipboardSet("$text") }

  // For tests: a clipboard of the program's own, so that the system's is left alone.
  fun useOwnClipboard(own : bool = true) {
    __jade.clipboardOwn(own)
  }

  // [shapes sent to the graphics card, batches they went in, surfaces there now are].
  fun counters() : List<int> => __jade.counters()

  // Sends what has been drawn so far to the graphics card.
  fun flush() {
    __jade.flush()
  }
}

// The canvas being drawn with: the native layer keeps its place, clip, colour and font, and
// is told again only when another canvas draws.
internal var jadeActiveCanvas : NativeCanvas? = null

internal val jadeWindows : open Map<int, NativeWindow> = {:}

internal fun jadeDispatch(id : int, kind : string, x : int, y : int, n1 : int, n2 : int, f1 : float, f2 : float, extra : any?) {
  val window = jadeWindows[id]
  if (window != null) { window.deliver(kind, x, y, n1, n2, f1, f2, extra) }
}

// ---- A picture on the graphics card ----

// A picture that is drawn on and drawn from on the graphics card: what a widget keeps of itself
// so as not to draw it again, and heavy drawing off the screen (D123). Its size is in layout
// units; with a scale it has that many pixels to the unit, to match the screen it will be drawn
// on. Its pixels come back to memory as an Image.
class Surface : Drawable, ToImage {
  override val width : int
  override val height : int
  val scale : Number
  val deviceWidth : int
  val deviceHeight : int
  val handle : any  // the native layer's name for it

  fun init(width : int, height : int, scale : Number = 1) {
    if (width < 1 or height < 1) { throw IllegalArgumentException("a Surface is at least 1 unit each way, not $width by $height") }
    this.width = width
    this.height = height
    this.scale = scale
    this.deviceWidth = Math.max(1, Math.round(width * scale).toInt())
    this.deviceHeight = Math.max(1, Math.round(height * scale).toInt())
    this.handle = __jade.surfaceCreate(deviceWidth, deviceHeight)
  }

  static {
    // A surface holding an Image, pixel for pixel.
    fun of(image : Image) : Surface {
      val made = Surface(image.width, image.height)
      made.upload(image)
      return made
    }
  }
  // Its width and height in units (D152).
  val size : Size
    get() => Size(width, height)

  // Something to draw on it with. Every pixel starts clear.
  fun canvas() : NativeCanvas => NativeCanvas(handle, width, height, scale, 0, 0, 0, 0, deviceWidth, deviceHeight)

  // A canvas of another size in units over the same pixels: `scale` pixels to the unit.
  fun canvasAt(width : int, height : int, scale : Number) : NativeCanvas => NativeCanvas(handle, width, height, scale, 0, 0, 0, 0, deviceWidth, deviceHeight)

  // What it holds, as an Image of its pixels.
  override fun toImage() : Image => Image.of(deviceWidth, deviceHeight, __jade.surfaceRead(handle))

  // Replaces what it holds with an Image of the same number of pixels.
  fun upload(image : Image) {
    if (image.width != deviceWidth or image.height != deviceHeight) {
      throw IllegalArgumentException("an image of ${image.width} by ${image.height} does not fit a surface of $deviceWidth by $deviceHeight pixels")
    }
    __jade.surfaceUpload(handle, image.pixels.bytes)
  }

  fun save(path : Path | string) throws IOException {
    toImage().save(path)
  }

  // Gives its memory on the graphics card back now. Without this it is given back when
  // nothing refers to the surface any more.
  fun dispose() {
    __jade.surfaceDispose(handle)
  }

  override fun toString() : string => "Surface($width x $height" + (scale == 1 ? ")" : ", scale $scale)")
}

// ---- The canvas ----

// Draws on a window or a surface, on the graphics card. Shapes have smoothed edges; straight
// lines and rectangles sit on pixel edges. An Image drawn here is drawn from a copy of it on the
// card, which the native layer keeps up to date from what has changed in it (D124).
class NativeCanvas : Canvas {
  private val target : any
  private var sentColor : Color? = null
  private var sentFont : Font? = null

  fun init(target : any, width : int, height : int, scale : Number, originX : int, originY : int, clipLeft : int, clipTop : int, clipRight : int, clipBottom : int) {
    super.init(width, height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom)
    this.target = target
  }

  protected override fun another(width : int, height : int, originX : int, originY : int, clipLeft : int, clipTop : int, clipRight : int, clipBottom : int) : Canvas =>
    NativeCanvas(target, width, height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom)

  // Tells the native layer where drawing now goes, unless this canvas was the last to draw,
  // and the colour, if it has changed since it was last told.
  private fun use() {
    if (jadeActiveCanvas !== this) {
      jadeActiveCanvas = this
      __jade.target(target, originX, originY, scale, clipLeft, clipTop, clipRight, clipBottom)
      sentColor = null
      sentFont = null
    }
    if (sentColor != color) {
      __jade.color(color.argb)
      sentColor = color
    }
  }

  override fun fillRect(x : Number, y : Number, w : Number, h : Number) {
    use()
    __jade.fillRect(x, y, w, h)
  }
  override fun drawRect(x : Number, y : Number, w : Number, h : Number) {
    use()
    __jade.drawRect(x, y, w, h)
  }
  override fun clearRect(x : Number, y : Number, w : Number, h : Number) {
    use()
    __jade.clearRect(x, y, w, h)
  }
  override fun fillRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number) {
    use()
    __jade.roundRect(x, y, w, h, arcW, arcH, true)
  }
  override fun drawRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number) {
    use()
    __jade.roundRect(x, y, w, h, arcW, arcH, false)
  }
  override fun fillOval(x : Number, y : Number, w : Number, h : Number) {
    use()
    __jade.oval(x, y, w, h, true)
  }
  override fun drawOval(x : Number, y : Number, w : Number, h : Number) {
    use()
    __jade.oval(x, y, w, h, false)
  }
  override fun drawLine(x1 : Number, y1 : Number, x2 : Number, y2 : Number) {
    use()
    __jade.line(x1, y1, x2, y2)
  }
  override fun drawPolyline(xs : List<Number>, ys : List<Number>, n : int? = null) {
    use()
    __jade.polygon(xs, ys, n ?: xs.size, false, false)
  }
  override fun drawPolygon(xs : List<Number>, ys : List<Number>, n : int? = null) {
    use()
    __jade.polygon(xs, ys, n ?: xs.size, false, true)
  }
  override fun fillPolygon(xs : List<Number>, ys : List<Number>, n : int? = null) {
    use()
    __jade.polygon(xs, ys, n ?: xs.size, true, true)
  }

  override fun drawString(text : string, x : Number, y : Number) : int {
    use()
    if (sentFont != font) {
      __jade.font(font, scale)   // the native layer finds the engine's font for it (D125)
      sentFont = font
    }
    val device : int = __jade.text("$text", x, y)
    return scale == 1 ? device : Math.ceil(device / scale.toFloat()).toInt()
  }

  // An Image (from its copy on the card) or a Surface at (x, y), at its own size or scaled
  // into w by h units; `alpha` from 0.0 (not drawn) to 1.0 (solid) makes it see-through.
  protected override fun drawPicture(picture : Drawable, x : Number, y : Number, w : Number?, h : Number?, alpha : Number) {
    if (picture is Surface) {
      use()
      if (w == null and h == null) {
        if (picture.scale == scale) {
          __jade.blit(picture.handle, x, y, alpha)   // pixel for pixel
        } else {
          __jade.image(picture.handle, 0, 0, picture.deviceWidth, picture.deviceHeight, x, y, picture.width, picture.height, alpha)
        }
      } else {
        __jade.image(picture.handle, 0, 0, picture.deviceWidth, picture.deviceHeight, x, y, w ?: picture.width, h ?: picture.height, alpha)
      }
      return
    }
    if (picture is Image) {
      val card = __jade.imageCard(picture)
      if (card == null) { return }
      use()
      __jade.image(card, 0, 0, picture.width, picture.height, x, y, w ?: picture.width, h ?: picture.height, alpha)
      return
    }
    throw IllegalArgumentException("a NativeCanvas draws an Image or a Surface, not $picture")
  }
  protected override fun drawPicturePart(picture : Drawable, sourceX : Number, sourceY : Number, sourceW : Number, sourceH : Number, x : Number, y : Number,
                                         w : Number, h : Number, alpha : Number) {
    val source = picture is Surface ? picture.handle : (picture is Image ? __jade.imageCard(picture) : null)
    if (source == null) { return }
    use()
    __jade.image(source, sourceX, sourceY, sourceW, sourceH, x, y, w, h, alpha)
  }
}

// ---- A window ----

// A window of the system's, with nothing in it but what the program draws. It keeps its
// picture: the program draws on it when something changes and calls present(), and the
// window shows that picture again by itself whenever the system asks.
//
// What happens to it arrives through the functions the program sets:
//
//   onInput = { event -> }               a RawInput: pointer, wheel, keys, text, focus
//   onResize = { width, height -> }      it has another size; draw it again and present()
//   onScaleChanged = { scale -> }        it is now on a screen of another density
//   onCloseRequest = { }                 the user asked for it to close; if this is not set, it closes
//   onFilesDropped = { paths, x, y -> }
class NativeWindow {
  val id : int
  private var currentTitle : string
  private var currentCursor : CursorKind = CursorKind.default
  private var currentCursorMode : CursorMode = CursorMode.normal
  private var canResize : bool
  private var inside = false
  var onInput : ((RawInput) -> unit)? = null
  var onResize : ((int, int) -> unit)? = null
  var onScaleChanged : ((float) -> unit)? = null
  var onCloseRequest : (() -> unit)? = null
  var onFilesDropped : ((List<string>, int, int) -> unit)? = null

  // The size is of what can be drawn on. `owner` is a window this one belongs to and stays
  // in front of. `scale` is for tests: it stands in for the screen's.
  fun init(title : string = "", width : int = 900, height : int = 640, resizable : bool = true, dialog : bool = false, owner : NativeWindow? = null,
           scale : Number? = null) {
    __jade.setDispatcher(jadeDispatch)
    this.currentTitle = "$title"
    this.canResize = resizable
    this.id = __jade.windowCreate(currentTitle, width, height, resizable, dialog, owner == null ? 0 : owner.id, scale ?: 0)
    jadeWindows[id] = this
  }

  val isOpen : bool
    get() => __jade.windowIsOpen(id)
  val isVisible : bool
    get() => isOpen and __jade.windowState(id)[0]
  val isFocused : bool
    get() => isOpen and __jade.windowState(id)[1]

  var title : string
    get() => currentTitle
    set(text) {
      currentTitle = "$text"
      __jade.windowTitle(id, currentTitle)
    }
  fun setTitle(text : string) {
    title = text
  }

  // The size of what can be drawn on, and the screen's pixels to the unit.
  val width : int
    get() => __jade.windowInfo(id)[0]
  val height : int
    get() => __jade.windowInfo(id)[1]
  val deviceWidth : int
    get() => __jade.windowInfo(id)[2]
  val deviceHeight : int
    get() => __jade.windowInfo(id)[3]
  val scale : float
    get() => __jade.windowInfo(id)[4]
  val size : Size
    get() => Size(width, height)
  fun setSize(width : int, height : int) {
    __jade.windowSetSize(id, width, height)
  }

  // Where its outer corner is on the screen, in the screen's own pixels.
  val position : Point
    get() {
      val at = __jade.windowPosition(id)
      return Point(at[0], at[1])
    }
  fun setPosition(x : int, y : int) {
    __jade.windowSetPosition(id, x, y)
  }

  // The least and the most it can be made by dragging; 0 for no limit.
  fun setLimits(minWidth : int = 0, minHeight : int = 0, maxWidth : int = 0, maxHeight : int = 0) {
    __jade.windowLimits(id, minWidth, minHeight, maxWidth, maxHeight)
  }
  var resizable : bool
    get() => canResize
    set(value) {
      canResize = value
      __jade.windowResizable(id, value)
    }

  fun show() {
    __jade.windowShow(id)
  }
  fun hide() {
    __jade.windowHide(id)
  }
  // Closes it for good. A program whose last showing window is closed, with nothing else
  // going on, ends.
  fun close() {
    __jade.windowClose(id)
    jadeWindows.remove(id)
  }
  fun toFront() {
    __jade.windowToFront(id)
  }
  // Flashes its place in the task bar.
  fun requestAttention() {
    __jade.windowAttention(id)
  }

  // The picture for its title bar and the task bar.
  fun setIcon(image : Image) {
    __jade.windowIcon(id, image.pixels.bytes, image.width, image.height)
  }

  var cursor : CursorKind
    get() => currentCursor
    set(kind : CursorKind) {
      if (kind != currentCursor) {
        currentCursor = kind
        __jade.windowCursor(id, kind.ordinal)
      }
    }
  var cursorMode : CursorMode
    get() => currentCursorMode
    set(mode : CursorMode) {
      if (mode != currentCursorMode) {
        currentCursorMode = mode
        __jade.windowPointerMode(id, mode.ordinal)
      }
    }

  // Something to draw on the window's picture with. Nothing shows until present().
  fun canvas() : NativeCanvas {
    val info = __jade.windowInfo(id)
    return NativeCanvas(info[5], info[0], info[1], info[4], 0, 0, 0, 0, info[2], info[3])
  }

  // Shows what has been drawn.
  fun present() {
    __jade.windowPresent(id)
  }

  // The window's picture as it now is, whether or not the window is showing.
  fun snapshot() : Image {
    val info = __jade.windowInfo(id)
    return Image.of(info[2] as int, info[3] as int, __jade.surfaceRead(info[5]))
  }

  // An event made up, which then goes the way a real one does: for tests.
  fun send(event : any) {
    when (event) {
      is RawInput.PointerMove -> __jade.windowSend(id, "pointerMove", event.x, event.y, NativeWindow.buttonBits(event.buttons), event.mods.bits, 0.0, 0.0, null)
      is RawInput.PointerDown -> __jade.windowSend(id, "pointerDown", event.x, event.y, event.button.ordinal, event.mods.bits, 0.0, 0.0, null)
      is RawInput.PointerUp -> __jade.windowSend(id, "pointerUp", event.x, event.y, event.button.ordinal, event.mods.bits, 0.0, 0.0, null)
      is RawInput.Wheel -> __jade.windowSend(id, "wheel", event.x, event.y, 0, event.mods.bits, event.dx.toFloat(), event.dy.toFloat(), null)
      is RawInput.KeyDown -> __jade.windowSend(id, "keyDown", event.letter == null ? 0 : event.letter[0].code, 0, event.repeat ? 1 : 0, event.mods.bits, 0.0, 0.0, event.key.name)
      is RawInput.KeyUp -> __jade.windowSend(id, "keyUp", event.letter == null ? 0 : event.letter[0].code, 0, 0, event.mods.bits, 0.0, 0.0, event.key.name)
      is RawInput.Text -> __jade.windowSend(id, "text", 0, 0, 0, 0, 0.0, 0.0, event.text)
      is RawInput.Focus -> __jade.windowSend(id, "focus", 0, 0, event.focused ? 1 : 0, 0, 0.0, 0.0, null)
      is RawInput.Hover -> {
        if (event.inside) { inside = true; input(event) } else { __jade.windowSend(id, "pointerLeave", 0, 0, 0, 0, 0.0, 0.0, null) }
      }
      else -> { throw IllegalArgumentException("not an event a window can be sent: $event") }
    }
  }
  // The same for what is not a RawInput.
  fun sendCloseRequest() {
    __jade.windowSend(id, "close", 0, 0, 0, 0, 0.0, 0.0, null)
  }
  fun sendFilesDropped(paths : List<string>, x : int, y : int) {
    __jade.windowSend(id, "filesDropped", x, y, 0, 0, 0.0, 0.0, paths)
  }

  // For tests: a message put in the window's queue as the system puts them, which arrives
  // when the event loop next looks, not from inside this call. "moveBegan" and "moveEnded"
  // are what the system says around a drag of the title bar; "close" is a close request.
  fun postForTest(what : string) {
    __jade.windowPost(id, what)
  }

  static {
    private fun buttonBits(buttons : Set<PointerButton>) : int {
      var bits = 0
      for (button in buttons) { bits = bits | (1 << button.ordinal) }
      return bits
    }
    private fun buttonSet(bits : int) : Set<PointerButton> {
      val held = mutableSetOf()
      for (button in PointerButton.entries) {
        if (bits & (1 << button.ordinal) != 0) { held.add(button) }
      }
      return held
    }
  }
  private fun input(event : RawInput) {
    onInput?.invoke(event)
  }

  // What the native layer reports, turned into the toolkit's types and handed on.
  fun deliver(kind : string, x : int, y : int, n1 : int, n2 : int, f1 : float, f2 : float, extra : any?) {
    when (kind) {
      "pointerMove" -> {
        if (!inside) {
          inside = true
          input(RawInput.Hover(true))
        }
        input(RawInput.PointerMove(x, y, f1, f2, NativeWindow.buttonSet(n1), Modifiers.ofBits(n2)))
      }
      "pointerDown" -> input(RawInput.PointerDown(x, y, PointerButton.entries[n1], Modifiers.ofBits(n2)))
      "pointerUp" -> input(RawInput.PointerUp(x, y, PointerButton.entries[n1], Modifiers.ofBits(n2)))
      "pointerLeave" -> {
        inside = false
        input(RawInput.Hover(false))
      }
      "wheel" -> input(RawInput.Wheel(x, y, f1, f2, Modifiers.ofBits(n2)))
      "keyDown" -> input(RawInput.KeyDown(KeyCode.named(extra as string), Modifiers.ofBits(n2), n1 != 0, x == 0 ? null : x.char.toString()))
      "keyUp" -> input(RawInput.KeyUp(KeyCode.named(extra as string), Modifiers.ofBits(n2), x == 0 ? null : x.char.toString()))
      "text" -> input(RawInput.Text(extra as string))
      "focus" -> input(RawInput.Focus(n1 != 0))
      "resize" -> {
        // The picture has another size, and a canvas made for the old size is void.
        jadeActiveCanvas = null
        onResize?.invoke(x, y)
      }
      "scale" -> {
        onScaleChanged?.invoke(f1)
      }
      "close" -> {
        val handler = onCloseRequest
        if (handler != null) { handler() } else { close() }
      }
      "filesDropped" -> {
        onFilesDropped?.invoke(extra as List<string>, x, y)
      }
    }
  }

  override fun toString() : string => "NativeWindow($currentTitle)"
}
