// The native layer as the rest of Jade uses it: a window on the screen, pictures on the
// graphics card, and the canvas that draws on either. All of it is drawn with OpenGL by the
// built-in __jade (src/jade), and text by Astra's own text engine.
//
//   val window = NativeWindow("Hello", 400, 200)
//   window.onResize = { w, h -> paint(window) }
//   window.show()
//
//   fun paint(window) {
//     val canvas = window.canvas()
//     canvas.color = Color.white
//     canvas.fillRect(0, 0, canvas.width, canvas.height)
//     canvas.color = Color.black
//     canvas.font = Font("Segoe UI", Font.bold, 20)
//     canvas.drawString("Hello", 20, 40)
//     window.present()
//   }
//
// Everything a program gives and gets here is in layout units: the pixels of an ordinary
// screen. On a dense screen a window has a scale (1.5, 2) and draws that many of the
// screen's pixels to the unit, with edges still on pixel edges.
//
// Windows and drawing belong to the main thread. A program with a window showing goes on
// until its windows are closed: the events come through the same loop as EventLoop's tasks
// and timers, which is how an animation is made (EventLoop.every).

// ---- The system ----

object Native {
  // Why there are no windows or drawing here, or null if there are.
  fun problem() => __jade.problem()
  get isAvailable() => __jade.problem() == null

  // Which OpenGL is drawing, on which graphics card.
  fun describe() => __jade.describe()

  // A clock that only goes forwards, in nanoseconds.
  fun nanoTime() => __jade.nanos()

  // How long two presses may be apart, in milliseconds, and still be a double click.
  get doubleClickTime() => __jade.doubleClickTime()

  // How many of the main screen's pixels make a layout unit.
  get screenScale() => __jade.screenScale()

  // The text on the clipboard ("" if it holds none).
  get clipboardText() => __jade.clipboardGet()
  set clipboardText(text) { __jade.clipboardSet(str(text)) }

  // For tests: a clipboard of the program's own, so that the system's is left alone.
  fun useOwnClipboard(own = true) {
    __jade.clipboardOwn(own)
  }

  // [shapes sent to the graphics card, batches they went in, surfaces there now are].
  fun counters() => __jade.counters()

  // Sends what has been drawn so far to the graphics card.
  fun flush() {
    __jade.flush()
  }
}

// The canvas being drawn with: the native layer keeps its place, clip, colour and font, and
// is told again only when another canvas draws.
internal var jadeActiveCanvas = null

internal val jadeWindows = {:}

internal fun jadeDispatch(id, kind, x, y, n1, n2, f1, f2, extra) {
  val window = jadeWindows[id]
  if (window != null) { window.deliver(kind, x, y, n1, n2, f1, f2, extra) }
}

// ---- A picture on the graphics card ----

// A picture that is drawn on and drawn from: what a widget keeps of itself so as not to
// draw it again, and what a test reads back. Its size is in layout units; with a scale it
// has that many pixels to the unit, to match the screen it will be drawn on.
class Surface {
  val width
  val height
  val scale
  val deviceWidth
  val deviceHeight
  val handle        // the native layer's name for it

  fun init(width, height, scale = 1) {
    if (width < 1 or height < 1) { throw Error("a Surface is at least 1 unit each way, not $width by $height") }
    this.width = width
    this.height = height
    this.scale = scale
    this.deviceWidth = Math.max(1, int(Math.round(width * scale)))
    this.deviceHeight = Math.max(1, int(Math.round(height * scale)))
    this.handle = __jade.surfaceCreate(deviceWidth, deviceHeight)
  }

  // A surface holding a Picture, pixel for pixel.
  static fun of(picture) {
    val made = Surface(picture.width, picture.height)
    made.upload(picture)
    return made
  }

  // Something to draw on it with. Every pixel starts clear.
  fun canvas(owner = null) => NativeCanvas(handle, width, height, scale, 0, 0, 0, 0, deviceWidth, deviceHeight, owner)

  // What it holds, as a Picture of its pixels.
  fun toPicture() => Picture(deviceWidth, deviceHeight, 0, __jade.surfaceRead(handle))

  // Replaces what it holds with a Picture of the same number of pixels.
  fun upload(picture) {
    if (picture.width != deviceWidth or picture.height != deviceHeight) {
      throw Error("a picture of ${picture.width} by ${picture.height} does not fit a surface of $deviceWidth by $deviceHeight pixels")
    }
    __jade.surfaceUpload(handle, picture.pixels)
  }

  fun save(path) {
    toPicture().save(path)
  }

  // Gives its memory on the graphics card back now. Without this it is given back when
  // nothing refers to the surface any more.
  fun dispose() {
    __jade.surfaceDispose(handle)
  }

  override fun toString() => "Surface($width x $height" + (scale == 1 ? ")" : ", scale $scale)")
}

// What a text takes up in a font, in layout units.
data TextMetrics(val width, val ascent, val descent, val height)

// ---- The canvas ----

// Draws on a window or a surface. The operations are the ones of JadeUI's canvas, with
// Java's meanings: fillRect(x, y, w, h) covers w by h units; drawRect(x, y, w, h) is an
// outline one unit thick that covers w + 1 by h + 1; drawString puts the text's baseline
// at y. Shapes have smoothed edges; straight lines and rectangles sit on pixel edges.
class NativeCanvas {
  val width
  val height
  val scale
  private val target
  private val originX      // in the target's own pixels
  private val originY
  private val clipLeft
  private val clipTop
  private val clipRight
  private val clipBottom
  private val owner        // a BufferedImage being drawn on, which is told that it has changed
  private var currentColor = Color.black
  private var currentFont = Font("Dialog", Font.plain, 12)
  private var fontSent = false

  fun init(target, width, height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, owner = null) {
    this.target = target
    this.width = width
    this.height = height
    this.scale = scale
    this.originX = originX
    this.originY = originY
    this.clipLeft = clipLeft
    this.clipTop = clipTop
    this.clipRight = clipRight
    this.clipBottom = clipBottom
    this.owner = owner
  }

  get deviceScaleX() => float(scale)
  get deviceScaleY() => float(scale)

  get color() => currentColor
  set color(value) {
    currentColor = value
    if (jadeActiveCanvas === this) { __jade.color(value.rgb) }
  }

  get font() => currentFont
  set font(value) {
    currentFont = value
    fontSent = false
  }

  // Tells the native layer where drawing now goes, unless this canvas was the last to draw.
  private fun use() {
    if (owner != null) { owner.drawnOn() }
    if (jadeActiveCanvas === this) { return }
    jadeActiveCanvas = this
    __jade.target(target, originX, originY, scale, clipLeft, clipTop, clipRight, clipBottom)
    __jade.color(currentColor.rgb)
    fontSent = false
  }

  fun fillRect(x, y, w, h) {
    use()
    __jade.fillRect(x, y, w, h)
  }
  fun drawRect(x, y, w, h) {
    use()
    __jade.drawRect(x, y, w, h)
  }
  // Makes a rectangle clear again: what is under the picture shows through it.
  fun clearRect(x, y, w, h) {
    use()
    __jade.clearRect(x, y, w, h)
  }
  fun fillRoundRect(x, y, w, h, arcW, arcH) {
    use()
    __jade.roundRect(x, y, w, h, arcW, arcH, true)
  }
  fun drawRoundRect(x, y, w, h, arcW, arcH) {
    use()
    __jade.roundRect(x, y, w, h, arcW, arcH, false)
  }
  fun fillOval(x, y, w, h) {
    use()
    __jade.oval(x, y, w, h, true)
  }
  fun drawOval(x, y, w, h) {
    use()
    __jade.oval(x, y, w, h, false)
  }
  fun drawLine(x1, y1, x2, y2) {
    use()
    __jade.line(x1, y1, x2, y2)
  }
  fun drawPolyline(xs, ys, n = null) {
    use()
    __jade.polygon(xs, ys, n ?: xs.size, false, false)
  }
  fun drawPolygon(xs, ys, n = null) {
    use()
    __jade.polygon(xs, ys, n ?: xs.size, false, true)
  }
  fun fillPolygon(xs, ys, n = null) {
    use()
    __jade.polygon(xs, ys, n ?: xs.size, true, true)
  }

  // Text in the canvas's font and colour, starting at x with its baseline at y. Returns
  // the width it took.
  fun drawString(text, x, y) {
    use()
    val engine = currentFont.textFont(scale)
    if (!fontSent) {
      __jade.font(engine.handle)
      fontSent = true
    }
    val device = __jade.text(str(text), x, y)
    return scale == 1 ? device : int(Math.ceil(device / float(scale)))
  }

  // A BufferedImage or a Surface at (x, y): at its own size, or scaled into w by h units.
  // `alpha` from 0.0 to 1.0 makes it see-through.
  fun drawImage(image, x, y, w = null, h = null, alpha = 1.0) {
    val source = image is Surface ? image : image.onCard()
    use()
    if (w == null) {
      if (source.scale == scale) {
        __jade.blit(source.handle, x, y, alpha)   // pixel for pixel
      } else {
        __jade.image(source.handle, 0, 0, source.deviceWidth, source.deviceHeight, x, y, source.width, source.height, alpha)
      }
    } else {
      __jade.image(source.handle, 0, 0, source.deviceWidth, source.deviceHeight, x, y, w, h, alpha)
    }
  }

  // A part of a picture, given in its own pixels, scaled into a rectangle.
  fun drawImagePart(image, sourceX, sourceY, sourceW, sourceH, x, y, w, h, alpha = 1.0) {
    val source = image is Surface ? image : image.onCard()
    use()
    __jade.image(source.handle, sourceX, sourceY, sourceW, sourceH, x, y, w, h, alpha)
  }

  // What a text takes up in a font, on this canvas's screen.
  fun measure(text, font) {
    val m = FontMetrics(font, scale)
    return TextMetrics(m.stringWidth(text), m.ascent, m.descent, m.height)
  }
  fun getFontMetrics(font = null) => FontMetrics(font ?: currentFont, scale)

  // The part of the canvas that can be drawn on: the rest is clipped away.
  get visibleBounds() {
    val left = Math.max(0, int(Math.floor((clipLeft - originX) / float(scale))))
    val top = Math.max(0, int(Math.floor((clipTop - originY) / float(scale))))
    val right = Math.min(width, int(Math.ceil((clipRight - originX) / float(scale))))
    val bottom = Math.min(height, int(Math.ceil((clipBottom - originY) / float(scale))))
    return Rectangle(left, top, Math.max(0, right - left), Math.max(0, bottom - top))
  }

  // A canvas for a part of this one: its (0, 0) is at (x, y) here, and nothing it draws
  // lands outside the part.
  fun sub(x, y, width, height) {
    val left = originX + int(Math.round(x * scale))
    val top = originY + int(Math.round(y * scale))
    val right = originX + int(Math.round((x + width) * scale))
    val bottom = originY + int(Math.round((y + height) * scale))
    val child = NativeCanvas(target, width, height, scale, left, top,
                             Math.max(clipLeft, left), Math.max(clipTop, top), Math.min(clipRight, right), Math.min(clipBottom, bottom), owner)
    child.color = currentColor
    child.font = currentFont
    return child
  }

  fun dispose() {}
}

// ---- A window ----

// A window of the system's, with nothing in it but what the program draws. It keeps its
// picture: the program draws on it when something changes and calls present(), and the
// window shows that picture again by itself whenever the system asks.
//
// What happens to it arrives through the functions the program sets:
//
//   onInput = { event -> }               a RawInput: pointer, wheel, keys, text, focus
//   onResize = { width, height -> }      it has another size; draw it again and present()
//   onScaleChanged = { scale -> }        it is now on a screen of another density
//   onCloseRequest = { }                 the user asked for it to close; if this is not set, it closes
//   onFilesDropped = { paths, x, y -> }
class NativeWindow {
  val id
  private var currentTitle
  private var currentCursor : CursorKind = CursorKind.default
  private var currentCursorMode : CursorMode = CursorMode.normal
  private var canResize
  private var inside = false
  var onInput = null
  var onResize = null
  var onScaleChanged = null
  var onCloseRequest = null
  var onFilesDropped = null

  // The size is of what can be drawn on. `owner` is a window this one belongs to and stays
  // in front of. `scale` is for tests: it stands in for the screen's.
  fun init(title = "", width = 900, height = 640, resizable = true, dialog = false, owner = null, scale = null) {
    __jade.setDispatcher(jadeDispatch)
    this.currentTitle = str(title)
    this.canResize = resizable
    this.id = __jade.windowCreate(currentTitle, width, height, resizable, dialog, owner == null ? 0 : owner.id, scale ?: 0)
    jadeWindows[id] = this
  }

  get isOpen() => __jade.windowIsOpen(id)
  get isVisible() => isOpen and __jade.windowState(id)[0]
  get isFocused() => isOpen and __jade.windowState(id)[1]

  get title() => currentTitle
  set title(text) {
    currentTitle = str(text)
    __jade.windowTitle(id, currentTitle)
  }
  fun setTitle(text) {
    title = text
  }

  // The size of what can be drawn on, and the screen's pixels to the unit.
  get width() => __jade.windowInfo(id)[0]
  get height() => __jade.windowInfo(id)[1]
  get deviceWidth() => __jade.windowInfo(id)[2]
  get deviceHeight() => __jade.windowInfo(id)[3]
  get scale() => __jade.windowInfo(id)[4]
  get size() => Dimension(width, height)
  fun setSize(width, height) {
    __jade.windowSetSize(id, width, height)
  }

  // Where its outer corner is on the screen, in the screen's own pixels.
  get position() {
    val at = __jade.windowPosition(id)
    return Point(at[0], at[1])
  }
  fun setPosition(x, y) {
    __jade.windowSetPosition(id, x, y)
  }

  // The least and the most it can be made by dragging; 0 for no limit.
  fun setLimits(minWidth = 0, minHeight = 0, maxWidth = 0, maxHeight = 0) {
    __jade.windowLimits(id, minWidth, minHeight, maxWidth, maxHeight)
  }
  get resizable() => canResize
  set resizable(value) {
    canResize = value
    __jade.windowResizable(id, value)
  }

  fun show() {
    __jade.windowShow(id)
  }
  fun hide() {
    __jade.windowHide(id)
  }
  // Closes it for good. A program whose last showing window is closed, with nothing else
  // going on, ends.
  fun close() {
    __jade.windowClose(id)
    jadeWindows.remove(id)
  }
  fun toFront() {
    __jade.windowToFront(id)
  }
  // Flashes its place in the task bar.
  fun requestAttention() {
    __jade.windowAttention(id)
  }

  // The picture for its title bar and the task bar: a Picture or a BufferedImage.
  fun setIcon(image) {
    val picture = image is Picture ? image : image.toPicture()
    __jade.windowIcon(id, picture.pixels, picture.width, picture.height)
  }

  get cursor() : CursorKind => currentCursor
  set cursor(kind : CursorKind) {
    if (kind != currentCursor) {
      currentCursor = kind
      __jade.windowCursor(id, kind.ordinal)
    }
  }
  get cursorMode() : CursorMode => currentCursorMode
  set cursorMode(mode : CursorMode) {
    if (mode != currentCursorMode) {
      currentCursorMode = mode
      __jade.windowPointerMode(id, mode.ordinal)
    }
  }

  // Something to draw on the window's picture with. Nothing shows until present().
  fun canvas() {
    val info = __jade.windowInfo(id)
    return NativeCanvas(info[5], info[0], info[1], info[4], 0, 0, 0, 0, info[2], info[3])
  }

  // Shows what has been drawn.
  fun present() {
    __jade.windowPresent(id)
  }

  // The window's picture as it now is, whether or not the window is showing.
  fun snapshot() {
    val info = __jade.windowInfo(id)
    return Picture(info[2], info[3], 0, __jade.surfaceRead(info[5]))
  }

  // An event made up, which then goes the way a real one does: for tests.
  fun send(event) {
    when (event) {
      is RawInput.PointerMove -> __jade.windowSend(id, "pointerMove", event.x, event.y, NativeWindow.buttonBits(event.buttons), event.mods.bits, 0.0, 0.0, null)
      is RawInput.PointerDown -> __jade.windowSend(id, "pointerDown", event.x, event.y, event.button.ordinal, event.mods.bits, 0.0, 0.0, null)
      is RawInput.PointerUp -> __jade.windowSend(id, "pointerUp", event.x, event.y, event.button.ordinal, event.mods.bits, 0.0, 0.0, null)
      is RawInput.Wheel -> __jade.windowSend(id, "wheel", event.x, event.y, 0, event.mods.bits, float(event.dx), float(event.dy), null)
      is RawInput.KeyDown -> __jade.windowSend(id, "keyDown", event.letter == null ? 0 : ord(event.letter), 0, event.repeat ? 1 : 0, event.mods.bits, 0.0, 0.0, event.key.name)
      is RawInput.KeyUp -> __jade.windowSend(id, "keyUp", event.letter == null ? 0 : ord(event.letter), 0, 0, event.mods.bits, 0.0, 0.0, event.key.name)
      is RawInput.Text -> __jade.windowSend(id, "text", 0, 0, 0, 0, 0.0, 0.0, event.text)
      is RawInput.Focus -> __jade.windowSend(id, "focus", 0, 0, event.focused ? 1 : 0, 0, 0.0, 0.0, null)
      is RawInput.Hover -> {
        if (event.inside) { inside = true; input(event) } else { __jade.windowSend(id, "pointerLeave", 0, 0, 0, 0, 0.0, 0.0, null) }
      }
      else -> { throw Error("not an event a window can be sent: $event") }
    }
  }
  // The same for what is not a RawInput.
  fun sendCloseRequest() {
    __jade.windowSend(id, "close", 0, 0, 0, 0, 0.0, 0.0, null)
  }
  fun sendFilesDropped(paths, x, y) {
    __jade.windowSend(id, "filesDropped", x, y, 0, 0, 0.0, 0.0, paths)
  }

  // For tests: a message put in the window's queue as the system puts them, which arrives
  // when the event loop next looks, not from inside this call. "moveBegan" and "moveEnded"
  // are what the system says around a drag of the title bar; "close" is a close request.
  fun postForTest(what) {
    __jade.windowPost(id, what)
  }

  private static fun buttonBits(buttons) {
    var bits = 0
    for (button in buttons) { bits = bits | (1 << button.ordinal) }
    return bits
  }
  private static fun buttonSet(bits) {
    val held = mutableSetOf()
    for (button in PointerButton.entries) {
      if (bits & (1 << button.ordinal) != 0) { held.add(button) }
    }
    return held
  }

  private fun input(event) {
    if (onInput != null) { onInput(event) }
  }

  // What the native layer reports, turned into the toolkit's types and handed on.
  fun deliver(kind, x, y, n1, n2, f1, f2, extra) {
    when (kind) {
      "pointerMove" -> {
        if (!inside) {
          inside = true
          input(RawInput.Hover(true))
        }
        input(RawInput.PointerMove(x, y, f1, f2, NativeWindow.buttonSet(n1), Modifiers.ofBits(n2)))
      }
      "pointerDown" -> input(RawInput.PointerDown(x, y, PointerButton.entries[n1], Modifiers.ofBits(n2)))
      "pointerUp" -> input(RawInput.PointerUp(x, y, PointerButton.entries[n1], Modifiers.ofBits(n2)))
      "pointerLeave" -> {
        inside = false
        input(RawInput.Hover(false))
      }
      "wheel" -> input(RawInput.Wheel(x, y, f1, f2, Modifiers.ofBits(n2)))
      "keyDown" -> input(RawInput.KeyDown(KeyCode.named(extra), Modifiers.ofBits(n2), n1 != 0, x == 0 ? null : chr(x)))
      "keyUp" -> input(RawInput.KeyUp(KeyCode.named(extra), Modifiers.ofBits(n2), x == 0 ? null : chr(x)))
      "text" -> input(RawInput.Text(extra))
      "focus" -> input(RawInput.Focus(n1 != 0))
      "resize" -> {
        // The picture has another size, and a canvas made for the old size is void.
        jadeActiveCanvas = null
        if (onResize != null) { onResize(x, y) }
      }
      "scale" -> {
        if (onScaleChanged != null) { onScaleChanged(f1) }
      }
      "close" -> {
        if (onCloseRequest != null) { onCloseRequest() } else { close() }
      }
      "filesDropped" -> {
        if (onFilesDropped != null) { onFilesDropped(extra, x, y) }
      }
    }
  }

  override fun toString() => "NativeWindow($currentTitle)"
}
