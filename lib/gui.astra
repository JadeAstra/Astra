// The Astra GUI library:  import "gui"
//
//   val window = Window("Hello")
//   val label = window.label("Clicks: 0")
//   var clicks = 0
//   window.button("Click me", fun() {
//     clicks += 1
//     label.text = "Clicks: $clicks"
//   })
//   window.show()
//   App.run()
//
// A Window is a column of widgets. Rows and columns nest (window.row(), row.column()) and
// place their widgets automatically; nothing is positioned by hand. Sizes are in pixels.
// The widgets are native Windows controls, created through the built-in GuiBackend class.

// ---- Connecting native events to objects ----

val __guiObjects = {:}   // id -> Window or Widget
val __guiTimers = {:}    // timer id -> [action, repeats]

fun __guiDispatch(id, event, a, b, c) {
  if id == 0 {
    if event == "timer" { App.fire(a) }
    return null
  }
  val target = __guiObjects[id]
  if target == null { return null }
  return target.handle(event, a, b, c)
}
GuiBackend.setDispatcher(__guiDispatch)

// ---- Colours, as 0xRRGGBB ----

class Color {
  static fun rgb(red : int, green : int, blue : int) : int => red * 65536 + green * 256 + blue
}
Color.black = 0x000000
Color.white = 0xFFFFFF
Color.gray = 0x808080
Color.lightGray = 0xD9D9D9
Color.darkGray = 0x404040
Color.red = 0xE53935
Color.green = 0x43A047
Color.blue = 0x1E88E5
Color.yellow = 0xFDD835
Color.orange = 0xFB8C00
Color.purple = 0x8E24AA
Color.cyan = 0x00ACC1
Color.pink = 0xD81B60

// ---- The application: the event loop, timers and message boxes ----

class App {
  // Handles events until every window has been closed.
  static fun run() { GuiBackend.run() }

  // Closes every window, which ends run().
  static fun quit() { GuiBackend.quit() }

  // Runs `action` once after `ms` milliseconds, or again and again every `ms`. Both return
  // a timer that cancel() stops. Timers only run while App.run() does.
  static fun after(ms : int, action : function) : int => App.schedule(ms, action, false)
  static fun every(ms : int, action : function) : int => App.schedule(ms, action, true)
  static fun cancel(timer : int) {
    GuiBackend.cancelTimer(timer)
    __guiTimers.remove(timer)
  }

  static fun alert(message, title : string = "Astra") { GuiBackend.alert(title, str(message)) }
  static fun confirm(message, title : string = "Astra") : bool => GuiBackend.confirm(title, str(message))

  static fun schedule(ms : int, action : function, repeats : bool) : int {
    val timer = GuiBackend.timer(ms)
    __guiTimers[timer] = [action, repeats]
    return timer
  }

  static fun fire(timer : int) {
    val entry = __guiTimers[timer]
    if entry == null { return }
    if !entry[1] { App.cancel(timer) }
    entry[0]()
  }
}

// ---- Layout ----

// Anything a row or column can hold.
class Element {
  // An element that fills takes its container's spare space, shared with any others.
  var fill : bool = false

  fun measure() : list => [0, 0]                                      // the size it would like
  fun place(x : int, y : int, width : int, height : int) { }          // the space it is given
}

// Empty space that grows: in a row, it pushes what follows to the far end.
class Spacer : Element {
  fun init() { this.fill = true }
}

// A row or a column. Its children sit one after another with `spacing` between them and
// `padding` around the whole group. The methods below add children and return them.
class Box(val window, val vertical : bool, var padding : int = 0, var spacing : int = 8) : Element {
  val children : list = []

  fun add(child : Element) : Element {
    this.children.push(child)
    if child is Widget {
      __guiObjects[child.id] = child
      this.window.widgetIds.push(child.id)
    }
    if this.window.shown { this.window.layout() }
    return child
  }

  fun column(padding : int = 0, spacing : int = 8, fill : bool = false) : Box {
    val box = Box(this.window, true, padding, spacing)
    box.fill = fill
    return this.add(box)
  }

  fun row(padding : int = 0, spacing : int = 8, fill : bool = false) : Box {
    val box = Box(this.window, false, padding, spacing)
    box.fill = fill
    return this.add(box)
  }

  fun spacer() : Spacer => this.add(Spacer())

  fun label(text = "", width : int = 0) : Label => this.add(Label(this.window, str(text), width))

  fun button(text, onClick : function? = null, width : int = 0) : Button =>
    this.add(Button(this.window, str(text), onClick, width))

  fun checkBox(text, checked : bool = false, onChange : function? = null) : CheckBox {
    val box = CheckBox(this.window, str(text), onChange)
    if checked { box.checked = true }
    return this.add(box)
  }

  fun textBox(text = "", onChange : function? = null, width : int = 0, fill : bool = false) : TextBox {
    val box = TextBox(this.window, str(text), onChange, width)
    box.fill = fill
    return this.add(box)
  }

  fun textArea(text = "", onChange : function? = null, width : int = 0, height : int = 0, fill : bool = false) : TextArea {
    val area = TextArea(this.window, str(text), onChange, width, height)
    area.fill = fill
    return this.add(area)
  }

  fun listBox(items : list = [], onSelect : function? = null, width : int = 0, height : int = 0, fill : bool = false) : ListBox {
    val box = ListBox(this.window, onSelect, width, height)
    box.fill = fill
    box.setItems(items)
    return this.add(box)
  }

  fun canvas(width : int = 300, height : int = 200, fill : bool = false) : Canvas {
    val canvas = Canvas(this.window, width, height)
    canvas.fill = fill
    this.add(canvas)
    // Sized straight away, so that it can be drawn on before the window is shown.
    if !this.window.shown { GuiBackend.move(canvas.id, 0, 0, width, height) }
    return canvas
  }

  override fun measure() : list {
    var along = 0
    var across = 0
    for child in this.children {
      val size = child.measure()
      along += this.vertical ? size[1] : size[0]
      across = Math.max(across, this.vertical ? size[0] : size[1])
    }
    if this.children.length > 1 { along += this.spacing * (this.children.length - 1) }
    val edges = this.padding * 2
    return this.vertical ? [across + edges, along + edges] : [along + edges, across + edges]
  }

  override fun place(x : int, y : int, width : int, height : int) {
    // Space left over goes to the children that fill.
    val wanted = this.measure()
    val spare = this.vertical ? height - wanted[1] : width - wanted[0]
    var fillers = 0
    for child in this.children { if child.fill { fillers += 1 } }
    val share = fillers > 0 and spare > 0 ? spare / fillers : 0

    var position = (this.vertical ? y : x) + this.padding
    for child in this.children {
      val size = child.measure()
      var length = this.vertical ? size[1] : size[0]
      if child.fill { length += share }
      if this.vertical {
        child.place(x + this.padding, position, width - this.padding * 2, length)
      } else {
        child.place(position, y + this.padding, length, height - this.padding * 2)
      }
      position += length + this.spacing
    }
  }
}

// ---- Windows ----

// A window is the outermost column. Create widgets with its methods (window.button(...)),
// call show(), then App.run().
class Window : Box {
  val id : int
  val widgetIds : list = []
  var shown : bool = false
  var fitContent : bool = false
  var defaultButton                       // the Button that Enter clicks; see Button.makeDefault()

  var onClose : function? = null          // fun(): return false to keep the window open
  var onResize : function? = null         // fun(width, height)
  var onEscape : function? = null         // fun(): the Escape key

  // With no width or height, the window is made just large enough for its contents.
  fun init(title : string = "Astra", width : int = 0, height : int = 0, padding : int = 12, spacing : int = 8) {
    super.init(this, true, padding, spacing)
    this.fitContent = width <= 0 or height <= 0
    this.id = GuiBackend.window(title, width > 0 ? width : 320, height > 0 ? height : 200)
    __guiObjects[this.id] = this
  }

  fun show() : Window {
    if this.fitContent and !this.shown {
      val wanted = this.measure()
      GuiBackend.setWindowSize(this.id, Math.max(wanted[0], 220), Math.max(wanted[1], 60))
    }
    this.shown = true
    this.layout()
    GuiBackend.show(this.id, true)
    return this
  }

  // Places every widget again. Happens by itself when the window is resized.
  fun layout() {
    val size = GuiBackend.windowSize(this.id)
    this.place(0, 0, size[0], size[1])
  }

  fun close() { GuiBackend.close(this.id) }
  get title() : string => GuiBackend.getText(this.id)
  set title(value) { GuiBackend.setText(this.id, str(value)) }
  fun size() : list => GuiBackend.windowSize(this.id)
  fun setSize(width : int, height : int) { GuiBackend.setWindowSize(this.id, width, height) }

  // Saves a picture of the window's contents as a .bmp file. The window must be showing.
  fun saveImage(path : string) { GuiBackend.saveImage(this.id, path) }

  fun handle(event, a, b, c) {
    if event == "resize" {
      if this.shown { this.layout() }
      if this.onResize != null { this.onResize(a, b) }
    } else if event == "close" {
      if this.onClose != null { return this.onClose() }
    } else if event == "closed" {
      for widget in this.widgetIds { __guiObjects.remove(widget) }
      __guiObjects.remove(this.id)
    } else if event == "enter" {
      if this.defaultButton != null { this.defaultButton.click() }
    } else if event == "escape" {
      if this.onEscape != null { this.onEscape() }
    }
    return null
  }
}

// ---- Widgets ----

// What all widgets share. `width` and `height` are sizes asked for by the program; 0 means
// "whatever suits the content".
class Widget(val window, val id : int, var width : int = 0, var height : int = 0) : Element {
  fun natural() : list => [80, 24]         // the size that suits the content
  fun stretchesWide() : bool => true       // uses all the width it is given?
  fun stretchesTall() : bool => false      // uses all the height it is given?

  override fun measure() : list {
    val natural = this.natural()
    return [this.width > 0 ? this.width : natural[0], this.height > 0 ? this.height : natural[1]]
  }

  override fun place(x : int, y : int, width : int, height : int) {
    val wanted = this.measure()
    val w = this.stretchesWide() ? width : Math.min(wanted[0], width)
    val h = this.stretchesTall() ? height : Math.min(wanted[1], height)
    GuiBackend.move(this.id, x, y + (height - h) / 2, w, h)
  }

  // The text it shows. Used like a field: label.text = "Done", or input.text to read it.
  get text() : string => GuiBackend.getText(this.id)
  set text(value) { GuiBackend.setText(this.id, str(value)) }

  fun enable(on : bool = true) { GuiBackend.enable(this.id, on) }
  fun disable() { GuiBackend.enable(this.id, false) }
  fun focus() { GuiBackend.focus(this.id) }

  fun handle(event, a, b, c) { return null }
}

class Label(window, text : string, width : int = 0) : Widget(window, GuiBackend.control("label", window.id, text), width) {
  override fun natural() : list {
    val size = GuiBackend.textSize(this.text)
    return [size[0] + 4, size[1] + 4]
  }

  // A label takes the room its text needs, so new text can move its neighbours.
  override set text(value) {
    GuiBackend.setText(this.id, str(value))
    if this.window.shown { this.window.layout() }
  }
}

class Button(window, text : string, var onClick : function? = null, width : int = 0)
    : Widget(window, GuiBackend.control("button", window.id, text), width) {
  override fun stretchesWide() : bool => false

  override fun natural() : list {
    val size = GuiBackend.textSize(this.text)
    return [Math.max(size[0] + 28, 84), size[1] + 12]
  }

  // As if the user had clicked it.
  fun click() { GuiBackend.click(this.id) }

  // Makes Enter, pressed anywhere in the window, click this button.
  fun makeDefault() : Button {
    this.window.defaultButton = this
    return this
  }

  override fun handle(event, a, b, c) {
    if event == "click" and this.onClick != null { this.onClick() }
    return null
  }
}

class CheckBox(window, text : string, var onChange : function? = null)
    : Widget(window, GuiBackend.control("checkbox", window.id, text)) {
  override fun natural() : list {
    val size = GuiBackend.textSize(this.text)
    return [size[0] + 26, size[1] + 6]
  }

  get checked() : bool => GuiBackend.isChecked(this.id)
  set checked(on : bool) { GuiBackend.setChecked(this.id, on) }
  fun click() { GuiBackend.click(this.id) }

  override fun handle(event, a, b, c) {
    if event == "click" and this.onChange != null { this.onChange(this.checked) }
    return null
  }
}

// A single line of editable text. onChange(text) runs when the user edits it.
class TextBox(window, text : string, var onChange : function? = null, width : int = 0)
    : Widget(window, GuiBackend.control("textbox", window.id, text), width) {
  override fun natural() : list => [170, GuiBackend.textSize("Ag")[1] + 10]

  override fun handle(event, a, b, c) {
    if event == "change" and this.onChange != null { this.onChange(this.text) }
    return null
  }
}

// Several lines of editable text.
class TextArea(window, text : string, var onChange : function? = null, width : int = 0, height : int = 0)
    : Widget(window, GuiBackend.control("textarea", window.id, text), width, height) {
  override fun natural() : list => [260, 110]
  override fun stretchesTall() : bool => true

  override fun handle(event, a, b, c) {
    if event == "change" and this.onChange != null { this.onChange(this.text) }
    return null
  }
}

// A list to pick from. onSelect(index, item) runs when the selection changes.
class ListBox(window, var onSelect : function? = null, width : int = 0, height : int = 0)
    : Widget(window, GuiBackend.control("listbox", window.id, ""), width, height) {
  val items : list = []

  override fun natural() : list => [170, 120]
  override fun stretchesTall() : bool => true

  fun add(item) {
    this.items.push(item)
    GuiBackend.listAdd(this.id, str(item))
  }

  fun setItems(items : list) {
    this.clear()
    for item in items { this.add(item) }
  }

  fun remove(index : int) {
    this.items.removeAt(index)
    GuiBackend.listRemove(this.id, index)
  }

  fun clear() {
    this.items.clear()
    GuiBackend.listClear(this.id)
  }

  get count() : int => this.items.length

  // Which item is selected, counting from 0; -1 when none is. Assign it to select an item.
  get selectedIndex() : int => GuiBackend.listSelected(this.id)
  set selectedIndex(index : int) { GuiBackend.listSelect(this.id, index) }

  // The selected item itself, or null.
  get selected() {
    val index = this.selectedIndex
    return index < 0 ? null : this.items[index]
  }

  override fun handle(event, a, b, c) {
    if event == "select" and this.onSelect != null { this.onSelect(this.selectedIndex, this.selected) }
    return null
  }
}

// A surface to draw on. What is drawn stays until it is drawn over or cleared.
// Positions are in pixels from the top-left corner; colours are 0xRRGGBB (see Color).
class Canvas(window, width : int = 300, height : int = 200)
    : Widget(window, GuiBackend.control("canvas", window.id, ""), width, height) {
  var currentWidth : int = 0
  var currentHeight : int = 0

  var onMouseDown : function? = null      // fun(x, y, button): button is 1 left, 2 right, 3 middle
  var onMouseUp : function? = null        // fun(x, y, button)
  var onMouseMove : function? = null      // fun(x, y, button): button is the one held down, or 0
  var onKeyDown : function? = null        // fun(key): "A", "Left", "Space", "Enter", ...
  var onKeyUp : function? = null          // fun(key)
  var onResize : function? = null         // fun(width, height)

  override fun natural() : list => [300, 200]
  override fun stretchesTall() : bool => true

  // The size it currently has on screen.
  fun size() : list => [this.currentWidth, this.currentHeight]

  fun clear(color : int = 0xFFFFFF) { GuiBackend.canvasClear(this.id, color) }

  fun line(x1 : number, y1 : number, x2 : number, y2 : number, color : int = 0, width : number = 1) {
    GuiBackend.canvasLine(this.id, x1, y1, x2, y2, color, width)
  }

  fun rect(x : number, y : number, width : number, height : number, color : int = 0, lineWidth : number = 1) {
    GuiBackend.canvasRect(this.id, x, y, width, height, color, lineWidth, false)
  }

  fun fillRect(x : number, y : number, width : number, height : number, color : int = 0) {
    GuiBackend.canvasRect(this.id, x, y, width, height, color, 1, true)
  }

  fun ellipse(x : number, y : number, width : number, height : number, color : int = 0, lineWidth : number = 1) {
    GuiBackend.canvasEllipse(this.id, x, y, width, height, color, lineWidth, false)
  }

  fun fillEllipse(x : number, y : number, width : number, height : number, color : int = 0) {
    GuiBackend.canvasEllipse(this.id, x, y, width, height, color, 1, true)
  }

  // Circles are given by their centre.
  fun circle(x : number, y : number, radius : number, color : int = 0, lineWidth : number = 1) {
    GuiBackend.canvasEllipse(this.id, x - radius, y - radius, radius * 2, radius * 2, color, lineWidth, false)
  }

  fun fillCircle(x : number, y : number, radius : number, color : int = 0) {
    GuiBackend.canvasEllipse(this.id, x - radius, y - radius, radius * 2, radius * 2, color, 1, true)
  }

  fun drawText(x : number, y : number, text, color : int = 0, size : int = 12) {
    GuiBackend.canvasText(this.id, x, y, str(text), color, size)
  }

  // Saves the drawing as a .bmp file.
  fun saveImage(path : string) { GuiBackend.saveImage(this.id, path) }

  override fun handle(event, a, b, c) {
    if event == "mouseDown" {
      if this.onMouseDown != null { this.onMouseDown(a, b, c) }
    } else if event == "mouseUp" {
      if this.onMouseUp != null { this.onMouseUp(a, b, c) }
    } else if event == "mouseMove" {
      if this.onMouseMove != null { this.onMouseMove(a, b, c) }
    } else if event == "keyDown" {
      if this.onKeyDown != null { this.onKeyDown(a) }
    } else if event == "keyUp" {
      if this.onKeyUp != null { this.onKeyUp(a) }
    } else if event == "resize" {
      this.currentWidth = a
      this.currentHeight = b
      if this.onResize != null { this.onResize(a, b) }
    }
    return null
  }
}
